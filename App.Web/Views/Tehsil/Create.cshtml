@model App.Data.Entities.MasterTehsil

@{
    ViewBag.Title = "Create";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline headlineMonthlyPensionSummary">
            Add Details
            @*<ul class="tool-bar">

                </ul>*@
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Create", "Tehsil", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "IdTehsil_Create" }))
        {
            @Html.AntiForgeryToken()
            @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
            <div class="row">
                <div class="col-sm-5">
                    <div class="form-group">
                        @Html.LabelFor(model => model.District, new { @class = "col-sm-4 control Color-Red-asterisk" })
                        <div class="col-sm-8">
                            @Html.DropDownListFor(m => m.DistrictId, null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })
                            @Html.ValidationMessageFor(model => model.DistrictId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Name, new { @class = "col-sm-4 control Color-Red-asterisk" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Enter Tehsil" })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @*<div class="form-group">
                          <label for="IsActive" class="col-sm-4 control-label">Status:</label>
                          <div class="col-sm-8">
                            <div class="checkbox">
                              @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm"})
                            </div>
                          </div>
                        </div>*@




                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <button type="submit" id="IdTehsilCreate" class="btn btn-success"><i class="fa fa-save"> </i> Create </button>
                            <button type="button" class="btn btn-success px-5 height display-none" title="Please Wait While We Process Your Request" id="btn_TehsilCreate_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                            <a href="/Tehsil/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>
@section scripts{

    <script src="~/Scripts/Master.js"></script>

    <script nonce="@ViewBag.StyleNonce">

    $(document).ready(function () {
      $('form').submit(function () {
          $('#IdTehsilCreate').hide();
          $('#btn_TehsilCreate_loading').show();
          var form = $("#IdTehsil_Create");
          if (!form.valid()) {
              $('#IdTehsilCreate').show();
              $('#btn_TehsilCreate_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdTehsilCreate').show();
            $('#btn_TehsilCreate_loading').hide();
        }
        $('#btn_TehsilCreate_loading').hide();
    });
    </script>







