@model App.Data.Entities.MasterCountry

@{
    ViewBag.Title = "Create";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline headline-countrycreate" >
            Add Details
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Create", "Country", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id="Create_country" }))
        {
            @Html.AntiForgeryToken()
            @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
            <div class="row">
                <div class="col-sm-6" id="print">
                    <div class="form-group">
                        @Html.LabelFor(model => model.CountryCode, new { @class = "col-sm-4 control Color-Red-asterisk" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.CountryCode, new { @class = "form-control input-sm", placeholder = "Country Abbreviation" })
                            @Html.ValidationMessageFor(model => model.CountryCode, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Name, new { @class = "col-sm-4 control Color-Red-asterisk" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Country" })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.ISDCode, new { @class = "col-sm-4 control Color-Red-asterisk" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.ISDCode, new { @class = "form-control input-sm", placeholder = "ISD Code" })
                            @Html.ValidationMessageFor(model => model.ISDCode, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @*<div class="form-group">
                          <label for="IsActive" class="col-sm-4 control-label">Status:</label>
                          <div class="col-sm-8">
                            <div class="checkbox">
                              @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm"})
                            </div>
                          </div>
                        </div>*@


                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <button type="submit" id="Idsearch" class="btn btn-success"><i class="fa fa-save"></i> Create</button>
                            <button type="button" class="btn btn-success px-5 height button-countrycreate"  title="Please Wait While We Process Your Request" id="btn_CreateCountry_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                            <a href="/Country/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>

                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>
@section scripts{

    <script src="~/Scripts/Master.js"></script>
    <script nonce="@ViewBag.StyleNonce">

    $(document).ready(function () {
      $('form').submit(function () {
          $('#Idsearch').hide();
          $('#btn_CreateCountry_loading').show();
          var form = $("#Create_country");
          if (!form.valid()) {
              $('#Idsearch').show();
              $('#btn_CreateCountry_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#Idsearch').show();
            $('#btn_CreateCountry_loading').hide();
        }
        $('#btn_CreateCountry_loading').hide();
    });
    </script>













