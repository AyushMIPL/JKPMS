@model IEnumerable<App.Data.Entities.MasterCountry>

@{
  ViewBag.Title = "Index";
}
<style>
  a.disabled {
    color: gray;
    pointer-events: none;
    opacity: .8;
  }

  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-countryindex">
      Country List

      @*<ul class="tool-bar">

        <li>
          <a href="/Country/Create"
             data-toggle="tooltip"
             class="@(ViewBag.AddPermission == true ? "" : "disabled")"
             data-placement="bottom"
             title="Add details"
             data-original-title="Add Details">
            <i class="fa fa-plus"></i>
          </a>
        </li>




      </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tblCountry">
      <thead>
        <tr>

          <th>Country Abbreviations</th>
          <th>Country</th>
          <th>ISD Code</th>
          <th>Status</th>
          <th class="button-countryindex"></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section scripts{

  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });

    var CountryTableIds = [];

    function doBindData() {
      debugger
      var oTable = $('#tblCountry').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
        "sAjaxSource": "/Country/AjaxHandler",

        "fnDrawCallback": function (setting) {
          debugger;

          CountryTableIds.forEach(function (item,index) {
            debugger
            if (document.getElementById("EditCountryBtn_" + item) != null && document.getElementById("EditCountryBtn_" + item) != undefined) {
              document.getElementById("EditCountryBtn_" + item).addEventListener("click", function () {
                EditCountry(item);
              });
            }
            if (document.getElementById("DetailsCountryBtn_" + item) != null && document.getElementById("DetailsCountryBtn_" + item) != undefined) {
              document.getElementById("DetailsCountryBtn_" + item).addEventListener("click", function () {
                DetailsCountry(item);
              });
            }
            if (document.getElementById("DeleteCountryBtn_" + item) != null && document.getElementById("DeleteCountryBtn_" + item) != undefined) {
              document.getElementById("DeleteCountryBtn_" + item).addEventListener("click", function () {
                del(item);
              });
            }

          });

        },
        "aoColumns": [

            { "sName": "CountryCode" },
            { "sName": "Name" },
            { "sName": "ISDCode" },
            {
              "sName": "ActiveStatus",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                if (oObj.aData[3] == "False")
                  return '<span class="badge badge-danger">inactive</span>';
                else
                  return '<span class="badge badge-success">active</span>';
              }
            },
            {
              "sName": "ID",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {

                var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
                var ViewPermission = ("@ViewBag.ViewPermission").toLowerCase();
                var DeletePermission = ("@ViewBag.DeletePermission").toLowerCase();

                //var strString = '<button id="EditCountryBtn_' + oObj.aData[4] +'" onclick="EditCountry(\'' + oObj.aData[4] + '\');" class="btn btn-info btn-xs ' + (EditPermission == 'false' ? 'disabled' : '') + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

                //strString += '&nbsp;<button id="DetailsCountryBtn_' + oObj.aData[4] +'" onclick="DetailsCountry(\'' + oObj.aData[4] + '\');" class="btn btn-xs btn-primary  ' + (ViewPermission == 'false' ? 'disabled' : '') + '" title="Detail"><i class="fa fa-list"></i> Detail</button>';

                //strString += '&nbsp;<button id="DeleteCountryBtn_' + oObj.aData[4] +'" href="javascript:;" onclick="javascript:del(\'' + oObj.aData[4] + '\');" class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';


                var strString = '';

                //var strString = '<button id="EditCountryBtn_' + oObj.aData[4] + '" class="btn btn-info btn-xs ' + (EditPermission == 'false' ? 'disabled' : '') + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

                strString += '&nbsp;<button id="DetailsCountryBtn_' + oObj.aData[4] + '" class="btn btn-xs btn-primary  ' + (ViewPermission == 'false' ? 'disabled' : '') + '" title="Detail"><i class="fa fa-list"></i> Detail</button>';

                //strString += '&nbsp;<button id="DeleteCountryBtn_' + oObj.aData[4] + '" href="javascript:;" class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';

                CountryTableIds.push(oObj.aData[4]);

                return strString;
              }
            }
        ]
      });
    }

    ////  ***** Code By Himanshu Rajput *****

    function EditCountry(id) {
     window.location.href = "@Url.Action("Edit", "Country")?Id=" + id ;
}


     function DetailsCountry(id) {
     window.location.href = "@Url.Action("Details", "Country")?Id=" + id ;
}




    function del(ctrlId) {
      debugger
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
    }
    function onDeleteConfirm() {
      debugger
      var id = $("#hdDocumentId").val();
      var name = "CountryId";
      $.ajax({
        url: "@Url.Action("RemoveAjax", "Country")?Id=" + id + "&name=" + name,
        type: "GET",
      })
    .done(function (result) {
      var actionRes = result;
      if (actionRes == "0") {
        toasterErrorMessage("There is some error, please try again.");
        return actionRes;
      }
      else if (actionRes == "1") {
        toasterSuccessMessage("Status changed sucessfully.");
        $('#confirmDelete').popup("hide");
        doBindData();
      }
      else {
        //toasterErrorMessage("Already in Use.");
        //$('#confirmDelete').popup("hide");
        toasterSuccessMessage("Record deleted successfully.");
        $('#confirmDelete').popup("hide");
        doBindData();
      }
    });
    }
    const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
    debugger
    Confirm_Delete_ClassBtn.forEach(button => {
      button.addEventListener('click', onDeleteConfirm);
    });
  </script>
}
