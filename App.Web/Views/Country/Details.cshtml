@model App.Data.Entities.MasterCountry


@{
  ViewBag.Title = "Details";
}


<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-countrydetails">
      Country Details
      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <div class="row">
      <div class="col-sm-4">
        <dl class="dl-horizontal">
          <dt>
            @Html.DisplayNameFor(model => model.CountryCode)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.CountryCode)
          </dd>

          <dt>
            @Html.DisplayNameFor(model => model.Name)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.Name)
          </dd>
          <dt>
            @Html.DisplayNameFor(model => model.ISDCode)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.ISDCode)
          </dd>
          <dt>@Html.DisplayNameFor(model => model.IsActive)</dt>

          <dd>
            @if (Model.IsActive)
            {<span class='badge badge-success'>Active</span>}
          </dd>
        </dl>
      </div>

    </div>
  </div>
  <div class="panel-footer">

    @*<a href="/Country/Edit/@ViewBag.EncryptedId" class="btn btn-info  @(ViewBag.EditPermission == true ? "" : "disabled")"><i class="fa fa-pencil"> </i> Edit</a>*@
    <a href="/Country/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>

  </div>
</div>

