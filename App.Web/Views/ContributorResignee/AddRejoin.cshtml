@section Scripts {
    <script src="~/Scripts/FileUpload.js"></script>
    <script src="~/Scripts/ContributorDetails.js"></script>
    <script nonce="@ViewBag.StyleNonce">
        function RejoinCont() {
            if ($("#form1").valid()) {
                $("#statusRecord").text("Are you sure want to Rejoin this Employee? Please make sure you must have to add job details for this contributor.");
                $('#confirmCancel').popup("show");
            }
      }
      const onConfirmSelect_ClassBtn = document.querySelectorAll('.onConfirmSelect_Class');
      onConfirmSelect_ClassBtn.forEach(button => {
        button.addEventListener('click', onConfirmSelect);
      });

        function onConfirmSelect() {
            $('#form1').submit();
            $('#confirmCancel').popup("hide");
      }
      const onCancel_ClassBtn = document.querySelectorAll('.onCancel_class');
      onCancel_ClassBtn.forEach(button => {
        button.addEventListener('click', onCancel);
      });
        function onCancel() {
            $('#confirmCancel').popup("hide");
        }
        $("#CountryID").change(function () {
            country();
        })
        function country() {
            var id = $("#CountryID").val();
            if (id != "") {
                $.ajax({
                    type: 'Get',
                    url: '/Employers/CityAjax?Id=' + id,
                    dataType: 'json'
                }).done(function (result) {
                    $("#PermanentCityID").select2("val", "");
                    $("#PermanentCityID").empty();
                    $('#PermanentCityID').append($('<option />').attr("value", "").text("---Select---"));
                    $.each(result, function (i, city) {
                        $('#PermanentCityID').append($('<option />').attr("value", city.Value).text(city.Text));
                    });
                });
            }
            else {
                toasterErrorMessage("Please Select Country.");
                $("#PermanentCityID").select2("val", "");
                $("#PermanentCityID").empty();
                $('#PermanentCityID').append($('<option />').attr("value", "").text("---Select---"));
            }
        }

        $("#Email").on('blur', function () {
            var PersonID = $("#PersonID").val();
            var OldPersonID = $("#OldPersonID").val();
            var email = $("#Email").val();
            if (email != "") {
                $.ajax({
                    type: 'Get',
                    url: '/ContributorPersonalDetails/EmailAjax?Email=' + email + "&personID=" + PersonID + "&oldPersonID=" + OldPersonID,
                    dataType: 'json'
                }).done(function (result) {
                    if (result != "0") {
                        toasterErrorMessage("This Email Id already exist");
                        $("#Email").val("");
                    }
                });
            }
            else {
                toasterErrorMessage("Please enter EmailId");

            }
        })

    </script>
