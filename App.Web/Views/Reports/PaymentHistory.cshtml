@section Scripts {
  <script src="~/Content/endless/LatestJS/pdfmake.min.js"></script>
  <script src="~/Content/endless/LatestJS/html2canvas.min.js"></script>
  <link href="~/Content/endless/css/newdatatablemodified.css" rel="stylesheet" />
  <script src="~/Content/endless/LatestJS/jquery.dataTables.min.js"></script>
  <script nonce="@ViewBag.StyleNonce">
    let cristalreportDisplay;
      document.getElementById("SearchQuery").addEventListener("click", function () {
        ShowReport(this, false);
      });


    var financialYear = '@FinancialYear';
    if (financialYear == '' || financialYear == null || financialYear == undefined) {
        financialYear = new Date().getFullYear();
    }
    var startDate = new Date(parseInt(financialYear),3,1);
    var endDate = new Date(parseInt(financialYear) + 1, 2, 31);
    $('.input-group.date').datepicker("destroy");
    $('.input-group.date').datepicker({
      format: 'dd/mm/yyyy',
      autoclose: true,
      todayHighlight: true,
      startDate: startDate,
      endDate: endDate,
    });


        jQuery(document).ready(function ($) {
            debugger
            BindDropDown($("#Criteria"));

            $("#Criteria").on("change", function () {
                BindDropDown(this);
            });

            $("#Equality").on("change", function () {
                ChangeInputField(this);
            });

            $("#Operator").on("change", function () {
                enableAddMorebutton();
            });

            ShowReport("", true);
        });

    var ExcelNPdf = "";
    $(function () {
      $(".alert-warning").hide();
      $.ajax({
        url: "@Url.Action("GetQueryCriteriaAjax", "Reports")",
        success: function (res) {
          var DropDown = $("#Criteria");
          DropDown.empty();
          DropDown.append($("<option value='' selected>---Select---</option>"));
          JSON.parse(res).forEach((data, index) => {
              DropDown.append($("<option disabled class='font-weight-bold'></option>").text(data.Item1));
            data.Item2.forEach((obj) => {
              DropDown.append($("<option></option>").attr("value", obj.Item2).text(obj.Item1));
            });
          });
        },
        error: function (error) {
          // Handle any errors here
        }
      });
      var Counter = 1;
      $("#AddMore").on("click", function (el, ind) {
        debugger;
          //var HtmlString = '<div class="col-sm-1"><a href="#" class="btn btn-primary" id="removeDiv_' + Counter + '" onclick="removeDiv(this)"><i class="fa fa-trash"></i></a></div>';
          var HtmlString = '<div class="col-sm-1"><a href="#" class="btn btn-primary" id="removeDiv_' + Counter + '"><i class="fa fa-trash"></i></a></div>';
        var Original = $(el.target).parents("div.row").parents("div").find("div.AppendDiv");
        if (Original.find("select[name*='Operator']").is("[required]"))
          Original.find("select[name*='Operator']").removeAttr("required");
        var ClonedDiv = Original.clone();
        Original.find("select[name*='Operator']").attr("required", "required");
        var AllDiv = $(el.target).parents("div.panel-body").children("div.row");
        if ((AllDiv.length - 1) >= 2)
          $(AllDiv[AllDiv.length - 2]).find("select[name*='Operator']").attr("required", "required");
        ClonedDiv.removeClass("AppendDiv");
        ClonedDiv.find("select,input").each(function (ind, obj) {
          $(obj).parents("div").find("label").remove();
          var NewId = $(obj).attr("id") + "_" + Counter;
          var NewName = $(obj).attr("name") + "_" + Counter;
          $(obj).attr("id", NewId);
          $(obj).attr("name", NewName);
          if (NewId.includes("CriteriaDateValue")) {
            $(obj).datepicker({
              format: 'dd/mm/yyyy',
              autoclose: true,
              todayHighlight: true,
              startDate: startDate,
              endDate: endDate,
            });
            $(obj).val("");
          }
          else if (NewId.includes("CriteriaValue")) {
            $(obj).val("");
            }
        });
        var LastDiv = $(ClonedDiv.find("div.col-sm-3")[3]);
        LastDiv.attr("class", "col-sm-2");
        LastDiv.after(HtmlString);
        var AppendDiv = $(el.target).parents("div.row").prev("div");
          $(AppendDiv).after(ClonedDiv);

          // bind click event to removeDiv button
          $("#removeDiv_" + Counter).on("click", function () {
            removeDiv(this);
          });

        $(ClonedDiv).find("select").each(function (ind, el) {
          $(el).removeClass("select2-hidden-accessible");
          $(el).next("span.select2-container--default").remove();
            $(el).select2();

            // bind onchange events
            if (el.id.includes("Criteria_")) {
                debugger
                $("#" + el.id).on("change", function () {
                    BindDropDown(this);
                });
            }

            if (el.id.includes("Equality_")) {
                debugger
                $("#" + el.id).on("change", function () {
                    ChangeInputField(this);
                });
            }

            if (el.id.includes("Operator_")) {
                debugger
                $("#" + el.id).on("change", function () {
                    enableAddMorebutton(this);
                });
            }
        });
          Counter++;
          $("#AddMore").prop("disabled", true);
      });
    });

        function enableAddMorebutton() {
            debugger
            var dropdown = $("#Operator").val();

            if (dropdown != "") {
                $("#AddMore").prop("disabled", false);
            } else {
                $("#AddMore").prop("disabled", true);
            }

        }

      function removeDiv(el, ind) {
        debugger;
      if ($(el).parents("div.row").is(':nth-last-child(2)')) {
        $(el).parents("div.row").prev("div").find("select[name*='Operator']").removeAttr("required");
        $(el).parents("div.row").prev("div").find("label[id*='-error']").remove();
      }
        $(el).parents("div.row").remove();
        //$("#AddMore").prop("disabled", true);
      if ($(el).parents("div.row").is(':nth-last-child(2)')) {
        var dropdown = $(el).parents("div.row").prev("div").find("select[name*='Operator']").val();

        if (dropdown != null && dropdown != undefined && dropdown != "") {
          $("#AddMore").prop("disabled", false);
        } else {
          $("#AddMore").prop("disabled", true);
        }
      }


      if (dropdown == "And" || dropdown == "Or" || dropdown == "Not") {
        $("#AddMore").prop("disabled", true);
      }
      else {
        $("#AddMore").prop("disabled", false);
      }
    }
      function ShowReport(element,ispageLoad) {

        debugger
        if (ispageLoad == true) {
          debugger
          var oTable = $('#tblPaymentHistory').dataTable({
            "bJQueryUI": true,
            "sPaginationType": "full_numbers",
            "bServerSide": true,
            "bDestroy": true,
            "bAutoWidth": false,
            "iDisplayLength": 50,  // Set the page size to 10 records per page
            "sAjaxSource": "/Reports/PaymentHistoryAjax",
            "fnDrawCallback": function (oSettings) {
              debugger
              cristalreportDisplay = oSettings.aoData.length;
              var api = this.api();
              var rows = api.rows({ page: 'current' }).nodes();
              var last = null;
            },
            "columnDefs": [
              {
                "targets": [14], // Index of the column to hide
                "visible": false // Set visibility to false
              }
            ],
            "aoColumns": [

              { "sName": "District" },
              { "sName": "ApplicationReferenceNo" },
              { "sName": "ApplicantName" },
              { "sName": "AccountNo" },
              { "sName": "BankName" },
              { "sName": "IFSC_Code" },
              { "sName": "Gender" },
              { "sName": "Age_InYears" },
              { "sName": "SchemeType" },
              { "sName": "Amount" },
              {
                "sName": "PaidOn",
                "bSearchable": false,
                "bSortable": false,
                "fnRender": function (oObj) {

                  var strString = (oObj.aData[10].split(" ")[0]).split("-").reverse().join("-");

                  return strString;
                }
              },
              { "sName": "Status" },
              { "sName": "Reason" },
              { "sName": "TransactionRefrenceNo" },
              {
                "sName": "Action",
                "bSearchable": false,
                "bSortable": false,
                "fnRender": function (oObj) {

                  var strString = "<td class='hidden'><button class='btn btn-success dropdown-toggle' type='button' onclick='showPaymentStatusPopup(" + oObj.aData[14] + "," + oObj.aData[15] + ")'>Edit</button></td>";

                  return strString;
                }
              }
            ]
          });
          //.rowGrouping({
          //        bExpandableGrouping: true,
          //        iGroupingColumnIndex: 0,
          //      bHideGroupingColumn: true,
          //      asExpandedGroups: null // Avoid unnecessary redraw triggers
          //    });

              $("#tblPaymentHistory").hide();
          }
          else {
              if ($("#Form").valid()) {
                  $("i.fa-spinner").show();
                  var WhereClause = "";
                  if (ShowReport != null && ShowReport != "" && ShowReport != undefined) {
                      var DataDiv = $(element).parents("div.panel-body").children("div.row");
                      var DivCount = $(element).parents("div.panel-body").children("div.row").length - 1;
                      for (i = 0; i < DivCount; i++) {
                          var DataType = $(DataDiv[i]).find("select[name^=Criteria] option:selected").val();
                          var Criteria = DataType.split("|")[1].toLowerCase().trim();
                          if (DataType.toLowerCase().trim().includes("masteremployee"))
                              Criteria = "me." + Criteria;
                          else if (DataType.toLowerCase().trim().includes("masterempbankdetails"))
                              Criteria = "eb." + Criteria;
                          else if (DataType.toLowerCase().trim().includes("process_directdeposit_details"))
                              Criteria = "pe." + Criteria;
                          else if (DataType.toLowerCase().trim().includes("masteremptype"))
                              Criteria = "et." + Criteria;
                          var Equality = $(DataDiv[i]).find("select[name^=Equality] option:selected").val();
                          var Operator = $(DataDiv[i]).find("select[name^=Operator] option:selected").val();
                          var CriteriaValue = "";
                          var AssignmentOperator = ['=', '>', '<', "<=", ">=", "NOT"];
                          if (AssignmentOperator.includes(Equality)) {
                              switch (DataType.split("_")[0].toLowerCase().trim()) {
                                  case "string":
                                      if (Criteria.includes("gender"))
                                          CriteriaValue = $(DataDiv[i]).find("select[name^='Gender']").val();
                                      else if (Criteria.includes("district"))
                                          CriteriaValue = $(DataDiv[i]).find("select[name^='District']").val();
                                      else if (Criteria.includes("Age_InYears"))
                                          CriteriaValue = $(DataDiv[i]).find("select[name^='Age_InYears']").val();
                                      else
                                          CriteriaValue = $(DataDiv[i]).find("input[name^='CriteriaValue']").val();
                                      break;
                                  case "datetime":
                                  CriteriaValue = $(DataDiv[i]).find("input[name^='CriteriaDateValue']").val();
                                  CriteriaValue = convertDateFormatToYYYY_mm_dd(CriteriaValue);
                                      break;
                                  case "bit":
                                      CriteriaValue = $(DataDiv[i]).find("input[name^='CriteriaValue']").val();
                                      break;
                                  default:
                                      CriteriaValue = $(DataDiv[i]).find("input[name^='CriteriaValue']").val();
                                      break;
                              }
                          } else {
                              CriteriaValue = $(DataDiv[i]).find("input[name^='CriteriaValue']").val();
                        }
                        if (CriteriaValue != "" && CriteriaValue != null && CriteriaValue != undefined) {
                          CriteriaValue = CriteriaValue.trim();
                        }


                          switch (Equality) {
                              case "Like":
                                  CriteriaValue = '%' + CriteriaValue + '%';
                                  break;
                              case "Starts With":
                                  Equality = "Like";
                                  CriteriaValue = CriteriaValue + '%';
                                  break;
                              case "Ends With":
                                  Equality = "Like";
                                  CriteriaValue = '%' + CriteriaValue;
                                  break;
                              case "NOT":
                                  Equality = "!=";
                                  break;
                          }
                          WhereClause += ` ${Criteria} ${Equality} '${CriteriaValue}' ${i < DivCount - 1 ? Operator : ''}`;
                          ExcelNPdf = WhereClause;
                      }
                  }
                  $("#btn_paymentHistory_loading").show();
                  $("#SearchQuery").hide();

                  // Jquery datatable call
                var oTable = $('#tblPaymentHistory').dataTable({
                  "bJQueryUI": true,
                  "sPaginationType": "full_numbers",
                  "bServerSide": true,
                  "bDestroy": true,
                  "bAutoWidth": false,
                  "iDisplayLength": 50,  // Set the page size to 10 records per page
                  "fnDrawCallback": function (oSettings) {
                    cristalreportDisplay = oSettings.aoData.length;
                    // Total number of records across all pages
                    var totalRecords = oSettings.fnRecordsTotal();
                    if (totalRecords > 0) {
                      $("#reportData").show();
                      $(".alert-warning").hide();
                      $('#reportData').attr('src', '/ReportForms/ContributionByEmployer.aspx');
