@{
  ViewBag.Title = "PaymentHistory";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
  ViewBag.Title = "MonthlyPensionSummary";
  int FinancialYear = DateTime.Now.Year;
  if (Session["FinancialYear"] != null)
  {
    FinancialYear = Convert.ToInt32(Session["FinancialYear"]);
  }
}

<style>
  label[id*="-error"] {
    color: red;
  }

  .dropdown-menu {
    right: 0 !important;
    left: auto;
  }

  .select2-container--default .select2-results__option[aria-disabled=true] {
    color: #999;
    background-color: #edeaea;
  }

  select.input-sm {
    height: 30px;
    line-height: 30px;
    border: 1px solid #aaa;
    font-size: 16px !important;
    border-radius: 20px !important;
    -moz-border-radius: 20px !important;
    -webkit-border-radius: 20px !important;
    margin: 0;
    padding: 6px 10px;
    box-shadow: inset 3px 3px 6px #BFC3CF, inset -3px -3px 6px #ffffff;
    background-color: transparent !important;
    box-shadow: inset 3px 3px 6px #BFC3CF, inset -3px -3px 6px #ffffff;
    cursor: default;
    display: -ms-flexbox;
    -ms-flex-wrap: wrap;
    -webkit-justify-content: space-between;
    -ms-flex-pack: justify;
    -webkit-transition: all 100ms;
    transition: all 100ms;
    border: none !important;
    height: 40px !important;
    color: #aeadad !important;
  }

  label#Equality-error, label#District-error, label#Criteria-error, label#Gender-error, label#CriteriaValue-error {
    position: absolute;
    bottom: -34px;
    left: 18px;
  }

  label[id*="-error"] {
    color: red;
    position: absolute;
    display: block;
    bottom: -33px;
  }
</style>
<div class="panel panel-default">
  @using (Html.BeginForm("", "", FormMethod.Post, new { @id = "Form" }))
  {
    <div class="panel-body">
      <div class="row pb-4 AppendDiv">
        <div class="col-sm-12">
          <div class="form-group">
            <div class="row">
              <div class="col-sm-3 mb-3">
                <label>Criteria</label>
                @Html.DropDownList("Criteria", null, "---Select---", new { @class = "form-control select-sm", @autocomplete = "off", required = "required" })

              </div>
              <div class="col-sm-3 mb-3">
                <label>Equality</label>

                @Html.DropDownList("Equality", null, "---Select---", new { @class = "form-control", @autocomplete = "off", required = "required" })

              </div>
              <div class="col-sm-3 mb-3">
                <label>Value</label>

                @Html.TextBox("CriteriaValue", "", new { @class = "form-control", @placeholder = "Enter Criteria Value", @id = "CriteriaValue", required = "required" })
                <div class="genderdiv display-none">
                  @Html.DropDownList("Gender", new List<SelectListItem> {
                    new SelectListItem { Text = "---Select---", Value = "" },
                    new SelectListItem { Text = "Male", Value = "M" },
                    new SelectListItem { Text = "Female", Value = "F" },
                    new SelectListItem { Text = "Transgender", Value = "T" }
                  }, new { @class = "form-control select-sm width-100", @placeholder = "Select Gender", required = "required" })
                </div>
                <div class="DistrictDiv display-none">
                  @Html.DropDownList("District", null, "---Select---", new { @class = "form-control select-sm width-100", required = "required" })
                </div>
                <div class="input-group date display-none">
                  @Html.TextBox("CriteriaDateValue", "", new { @class = "form-control", @placeholder = "Enter Date", @id = "CriteriaDateValue", required = "required" })
                  <span class="input-group-addon">
                    <i class="fa fa-calendar"></i>
                  </span>
                </div>
              </div>
              <div class="col-sm-3 mb-3">
                <label>Logic Operator</label>
                @Html.DropDownList("Operator", new List<SelectListItem> {
                  new SelectListItem { Text = "Select", Value = "" },
                  new SelectListItem { Text = "And", Value = "And" },
                  new SelectListItem { Text = "Or", Value = "Or" },
                  //new SelectListItem { Text = "Not", Value = "Not" }
                }, new { @class = "form-control select-sm", @placeholder = "select Operator" })
              </div>
            </div>
            @*<div class="row">
                  <div class="col-sm-3 mt-5 mb-3">
                      <label>Age</label>
                      @Html.TextBox("AgeInYears", "", new { @class = "form-control", placeholder = "Age (In Years)", min = "0", type = "number", step = "1", @id = "AgeInYears" })
                  </div>
              </div>*@

          </div>
        </div>
      </div>
      <div class="row pb-4">
        <div class="col-sm-12">
          <div class="col-sm-3 text-align-left">
            <button type="button" class="btn btn-success px-5 height display-none" title="Please Wait While We Process Your Request" id="btn_paymentHistory_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
            <button type="button" class="btn btn-success height px-5" id="SearchQuery"><i class="fa fa-search fa-1x"></i> Search Query</button>
          </div>
          <div class="col-sm-3"></div>
          <div class="col-sm-3"></div>
          <div class="col-sm-3 text-align-right">
            @*<button type="button" class="btn btn-success height px-5" id="AddMore"><i class="fa fa-plus fa-1x"></i>Add More</button>*@
            <button type="button" class="btn btn-success height px-5" id="AddMore" disabled><i class="fa fa-plus fa-1x"></i>Add More</button>
          </div>
        </div>
      </div>
    </div>
  }
</div>




