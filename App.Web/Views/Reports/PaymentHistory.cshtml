                            //$(element).parents("div.form-group").find("div.DistrictDiv").attr("class", "display-none");
                            $(element).parents("div.form-group").find("div.DistrictDiv").each(function () {
                                if ($(this).attr("class")) {
                                    $(this).addClass("display-none");
                                } else {
                                    $(this).attr("class", "display-none");
                                }
                            });
                            //$(element).parents("div.form-group").find("div.input-group").hide();
                            $(element).parents("div.form-group").find("div.input-group").each(function () {
                                if ($(this).attr("class")) {
                                    $(this).addClass("display-none");
                                    $(this).removeClass("display-table-important");
                                } else {
                                    $(this).attr("class", "display-none");
                                }
                            });
                            break;
                    }
                }
            }
        }
    //This is the code for the edit
      function showPaymentStatusPopup(EmplCode, PayDocNo) {

        $.ajax({
          url: "/MasterPensioner/GetPaymentdetailsAjax?EmplCode=" + EmplCode + "&PayDocNo=" + PayDocNo,
          method: "GET",
          success: function (data) {

            if (data && data.length > 0) {
              var firstRecord = data[0];
              //$('#PaymentStatusAccountNo').val(accountNo);
              $("#PaymentStatusEmplcode").val(EmplCode);
              $("#APPLICATION_REFERENCE_NO").val(firstRecord.ApplicationReferenceNo);

              // Extract the numeric part of the timestamp string
              if (firstRecord.TransactionDate != "") {
                var timestamp = parseInt(firstRecord.TransactionDate.match(/\d+/)[0], 10);
                var currentDate = new Date(timestamp);
                var formattedDate = $.datepicker.formatDate('yy-mm-dd', currentDate);
                $('#TransactionDate').val(formattedDate);
              }

              //$("#TransactionDate").val(firstRecord.TransactionDate);
              $("#TransactionNo").val(firstRecord.TransactionRefrenceNo);
              /* $("#TransactionNo").val(firstRecord.TransactionNo);*/
              $("#RemarksId").val(firstRecord.Remarks);
              $("#Name").val(firstRecord.FullName);
              $("#paymentStatus").val(firstRecord.Status);
              $("#PayDocNo").val(firstRecord.PayDocNo);
              $("#PopUpPaymentStatus").popup('show');
            }
            else {
              toasterInfoMessage("No payroll found");
              return;
            }
          },
          error: function (xhr, textStatus, errorThrown) {

            console.log("AJAX Request Failed", textStatus, errorThrown);
          }
        });
      }

    function oncancelPayment() {

      $('#error-message').hide();
      $('#PopUpPaymentStatus').popup("hide");;
    }


      function onclickPaymentStatus() {

        var emplcode = $("#PaymentStatusEmplcode").val();
        var Remark = $("#RemarksId").val();
        var TransactionDate = $("#TransactionDate").val();
        var paymentStatus = $("#paymentStatus").val();
        var ApplicationReferenceNo = $("#APPLICATION_REFERENCE_NO").val();
        var accountno = $('#PaymentStatusAccountNo').val();
        var TransactionNo = $("#TransactionNo").val();
        if (!Remark) {

          $('#error-RemarksId').text('Remark is required.');
          return;
        }
        if (paymentStatus == 0) {

          $('#error-paymentStatus').text('Payment Status is required.');
          return;
        }
        if (paymentStatus == 'Ok') {
          if (TransactionNo == "") {
            $('#error-TransactionNo').text('Transaction no is required.');
            return;
          }
        }
        $.ajax({
          type: "POST",
          url: "/MasterPensioner/UpdatePaymentStatusAjax",
          data: {
            emplcodes: emplcode,
            Remarks: Remark,
            TransactionDates: TransactionDate,
            paymentStatuses: paymentStatus,
            ApplicationReferenceNo: ApplicationReferenceNo,
            accountNos: accountno,
            TransactionNos: TransactionNo,
            PayDocNo: $("#PayDocNo").val()
          },
          success: function (result) {
            if (result.Status == true) {
              toasterSuccessMessage(result.Message);
            }
            location.reload();
          },
          error: function (xhr, status, error) {
            console.error("Ajax request failed", error);
            $('#btn_HoldPayment_loading').hide();
            $('#IdHoldPayment').show();
          }
        });
        $('#PopUpHoldPayment').hide();
      }

