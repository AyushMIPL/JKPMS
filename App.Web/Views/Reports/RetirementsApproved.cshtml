    function ShowReport() {
      debugger;
      var Date1 = $("#From").val();
      var Date2 = $("#to").val();
      var Contributorid = $("#ContributorId").val();
      var EmplrId = $("#EmployeeId").val();
      $.ajax({
        url: "@Url.Action("RetirementsApprovedAjax", "Reports")?emplrId=" + EmplrId + "&contributorid=" + Contributorid + "&date1=" + Date1 + "&date2=" + Date2,
        type: "GET",
      }).done(function (result) {
        var actionRes = result;
        if (actionRes == "1") {
          $('#reportData').attr('src', '/ReportForms/ContributionByEmployer.aspx');
          return false;
        }
        else {
