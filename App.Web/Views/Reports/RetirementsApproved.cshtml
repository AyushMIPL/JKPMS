@{
  ViewBag.Title = "RetirementApproved";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Retirement Approved
      
      @*<ul class="tool-bar">
        
      </ul>*@
    </h4>
  </div>
  @using (Html.BeginForm())
  {
    <div class="panel-body">
      <div class="row">
        <div class="col-sm-12">
          <div class="form-group">
            <div class="col-sm-3">
              @Html.DropDownList("EmployeeId", null, "---Select---", new { @class = "form-control select-sm", @id = "EmployeeId" })
            </div>
            <div class="col-sm-3">
              @Html.DropDownList("ContributorId", null, "---Select---", new { @class = "form-control select-sm", @id = "ContributorId" })
            </div>
            <div class="col-sm-2">
              <div class="input-group date" id="validateFrom">
                @Html.TextBox("SelectFrom ", "", new { @class = "form-control", @placeholder = "Select Start Date", @id = "From" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>
            <div class="col-sm-2">
              <div class="input-group date" id="validateTo">
                @Html.TextBox("SelectTo ", "", new { @class = "form-control", @placeholder = "Select End Date", @id = "to" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>

            <div class="col-sm-2">
              <button type="button" class="btn btn-success btn-group-sm" onclick="javascript:return ShowReport()"><i class="fa fa-search"></i> Search</button>
            </div>
          </div>
        </div>
      </div>
    </div> 
  }
</div>
   
