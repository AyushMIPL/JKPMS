      function downloadExcel(evt) {
          debugger

          try {
              $(evt.target).find("i.fa-spinner").show();
              $('#btn_downloadExcel_loading').show();
              $('#IddownloadExcel').hide();
                     $.ajax({
                         type: "POST",
                       /*data: {Tehsil: $("#Tehsil").val(), BeneficiariesType: $("#BeneficiariesType").val(), Gender: $("#Gender").val(), RegionNames: $("#RegionNames").val(),isDownload: true },*/
                         data: { Tehsil: $("#Tehsil").val(), BeneficiariesType: $("#BeneficiariesType").val(), Gender: '@ViewBag.Gender', RegionNames: $("#RegionNames").val(), AccountStatus:'@ViewBag.ACCOUNT_STATUS', bank_acct_no: $("#bank_acct_no").val(), APPLICATION_REFERENCE_NO: $("#APPLICATION_REFERENCE_NO").val(), isDownload: true },
                       url: '@Url.Action("PaymentsSummaryAjaxHandler", "Reports")',
                         cache: false,
                         success: function (result) {
                             $('#IddownloadExcel').show();
                             $('#btn_downloadExcel_loading').hide();
                             if (result != null) {
                                 var bytes = new Uint8Array(result.FileContents);
                                 var blob = new Blob([bytes], { type: '@System.Net.Mime.MediaTypeNames.Application.Octet' });
                                 if (window.navigator.msSaveOrOpenBlob) {
                                     // IE11
                                     window.navigator.msSaveOrOpenBlob(blob, result.FileDownloadName);
                                 } else {
                                     debugger
                                     // Google chome, Firefox, ....
                                     var link = document.createElement('a');
                                     link.href = window.URL.createObjectURL(blob);
                                     link.download = result.FileDownloadName;
                                     link.click();
                                     $(evt.target).find("i.fa-spinner").hide();
                                 }
                             }
                             else {

                             }
                         },
                         error: function (xhr, status, error) {
                         }
                     });

                 } catch (e) {
                 }
    }

      function AddMasterEmployeeExcelDatabase() {
      if ($("#formattedName").val() == "" || $("#formattedName").val() == null || $("#formattedName").val() == undefined || $("#formattedName").val() == "undefined") {
        toasterWarningMessage("First upload the file then save.");
        return false;
      }
      // Create FormData object
      var fileData = new FormData();
      // Adding one more key to FormData object
      fileData.append('formattedName', $("#formattedName").val());
      $.ajax({
        type: "POST",
        url: "@Url.Action("AddMasterEmployeeExcelDatabase", "MasterPensioner")",
        contentType: false, // Not to set any content header
        processData: false, // Not to process data
        data: fileData,
        success: function (data) {
          if (data == "1") {
            toasterSuccessMessage("Save Successfully.");
            location.reload();
          } else {
            toastr.error("Opps! Something went wrong. Please try again.");

          }
        }
      });
    }



    function MasterEmployeeExcelCancelUpload() {
      window.location.reload();
    }
    function MasterEmployeeExcelUpload() {
      var IsFile = $("#file").val();
      if (IsFile != null && IsFile != "" && IsFile != undefined) {
        var fileUpload = $("#file").get(0);
        var files = fileUpload.files;
        // Create FormData object
        var fileData = new FormData();
        // Looping over all files and add it to FormData object
        for (var i = 0; i < files.length; i++) {
          fileData.append(files[i].name, files[i]);
        }
        $.ajax({
          type: "POST",
          url: "@Url.Action("MasterEmployeeExcelUpload", "MasterPensioner")",
          contentType: false, // Not to set any content header
          processData: false, // Not to process data
          data: fileData,
          success: function (data) {
            if (data != "") {
              $("#formattedName").val(data);
              $("#MasterEmployeeExcelUpload").toggle();
              $("#MasterEmployeeExcelSave").toggle();
              $("#MasterEmployeeExcelCancel").toggle();
              toasterSuccessMessage("Upload Successfully.");
            } else {
              toastr.error("Opps! Somthing went wrong. Please try again.");
            }
          }
        });
      }
    }
    function MasterEmployeeExcelDownload() {
      try {
        var ApplicantIFSCCode = $("#ApplicantIFSCCode").val();
        if (ApplicantIFSCCode == "" || ApplicantIFSCCode == undefined || ApplicantIFSCCode == "undefined") {
           toasterErrorMessage("Select IFSC code before download.");
        } else {

          var xhr = new XMLHttpRequest();
          xhr.open('GET', '/MasterPensioner/MasterEmployeeExcelDownloadAjax?ApplicantIFSCCode=' + ApplicantIFSCCode, true);
          xhr.responseType = 'blob';
          xhr.onload = function () {
            if (xhr.status === 200) {
              var blob = xhr.response;
              var url = window.URL.createObjectURL(blob);
              var a = document.createElement('a');
              a.href = url;
              var name = xhr.getResponseHeader('Content-Disposition').split(" ")[1];
              if (name.indexOf("filename") > -1) {
                name = name.split("=")[1];
              }
              a.download = name;
              a.style.display = 'none';
              document.body.appendChild(a);
              a.click();
              window.URL.revokeObjectURL(url);
            } else {
              console.error('Request failed with status:', xhr.status);
            }
          };
          xhr.onerror = function () {
            console.error('Request error');
          };
          xhr.send();
        }
      } catch(e) {

      }
    }

    //hold payment
    function showHoldPaymentPopup(detailsLink, id) {
      var Id = detailsLink.split('/');
    var EncryptId=  Id.filter(segment => segment !== '').pop();
      $('#hiddenIdField').val(EncryptId);
      $('#PopUpHoldPayment').popup("show");
    }

    function oncancelHoldPayment() {
      $('#holdPaymentReason').removeClass('error');
      $('#error-message').hide();
      $('#PopUpHoldPayment').popup("hide");;
    }

    function OnclickHoldPayment() {
        $('#btn_HoldPayment_loading').show();
        $('#IdHoldPayment').hide();
      var holdPaymentReason = $('#holdPaymentReason').val();
      if (!holdPaymentReason.trim()) {
        $('#holdPaymentReason').addClass('error');
          $('#error-message').text('Please enter a reason').show();
          $('#btn_HoldPayment_loading').hide();
          $('#IdHoldPayment').show();
        return;
      }
      else {
        $('#holdPaymentReason').removeClass('error');
          $('#error-message').hide();
          $('#btn_HoldPayment_loading').hide();
          $('#IdHoldPayment').show();
      }

      var Id = $('#hiddenIdField').val();
      var paymentStatus = "Y";
      $.ajax({
        type: "POST",
        url: "/MasterPensioner/HoldPaymentStatusAjax",
        data: {
          id: Id,
          HoldPaymentReason: holdPaymentReason,
          holdpaymentStatus: paymentStatus,
        },
        success: function (result) {
            $('#btn_HoldPayment_loading').hide();
            $('#IdHoldPayment').show();
          if (result.Status == true) {
            toasterSuccessMessage(result.Message)
            location.reload();
          }
        },
        error: function (xhr, status, error) {
            console.error("Ajax request failed", error);
            $('#btn_HoldPayment_loading').hide();
            $('#IdHoldPayment').show();
        }
      });
      $('#PopUpHoldPayment').hide();
    }


