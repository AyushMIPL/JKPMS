@model JKPS.COMMON.DVOMasterEmployee
@{
    ViewBag.Title = "MonthlyPensionSummary";
}
<div class="panel panel-default">

    @using (Html.BeginForm())
    {
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <label>Scheme</label>
                            @Html.DropDownList("EmplCode", null, "---Select---", new { @class = "form-control select-sm", @id = "EmplCode" })
                        </div>
                        <div class="col-sm-3">
                            <label>Gender</label>
                            <div class="form-group h_select">
                                @Html.DropDownList("Gender", null, "---Select---", new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Gender", @id = "Gender" })
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <label>Beneficiary</label>
                            @Html.DropDownList("EmployeeId", null, new { @class = "form-control select-sm", @id = "EmployeeId", @multiple = "multiple" })
                        </div>
                        <div class="col-sm-3">
                            <label>Date From</label>
                            <div class="input-group date" id="validateFrom">
                                @Html.TextBox("SelectFrom ", "", new { @class = "form-control", @placeholder = "Select Start Date", @id = "From" })
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <label>To</label>
                            <div class="input-group date" id="validateTo">
                                @Html.TextBox("SelectTo ", "", new { @class = "form-control", @placeholder = "Select End Date", @id = "to" })
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <label>Age</label>
                            @Html.TextBoxFor(m => m.AgeInYears, new { @class = "form-control", placeholder = "Age (In Years)", min = "0", type = "number", step = "1", @id = "AgeInYears" })
                        </div>
                        <div class="col-sm-2">
                            <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
                            <button type="button" class="btn btn-success px-5 height" style="display: none;" title="Please Wait While We Process Your Request" id="btn_Deposits_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                            <button type="button" class="btn btn-success height px-5" id="IdSearch" onclick="javascript: return ShowReportData(event)"><i class="fa fa-search"></i> Search</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Direct Deposit To Bank

            <ul class="tool-bar">
            </ul>
        </h4>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-12">
                <div class="alert alert-warning" style="display:none;">
                    <h4 class="mb-0"> There is no Record Found</h4>
                </div>
                <iframe id="reportData" style="border: 0px;height:700px;width:100%;"></iframe>
            </div>
        </div>
    </div>

</div>@section Scripts {
    <script nonce="@ViewBag.StyleNonce">
      $(function () {
        $(".alert-warning").hide();
      });
  function ShowReport() {
      debugger;
      var Date1 = $("#From").val();
      var Date2 = $("#to").val();
      var BeneficiariesId = $("#EmployeeId").val();
        var SchemeType = $("#EmplCode").val();
        var Gender = $("#Gender").val();
      var AgeInYears = $("#AgeInYears").val();
      $.ajax({
            url: "@Url.Action("DirectDepositsToBankAjax", "Reports")?emplrId=" + SchemeType + "&empl_code=" + BeneficiariesId + "&date1=" + Date1 + "&date2=" + Date2 + "&gender=" + Gender + "&ageInYears=" + AgeInYears,
        type: "GET",
      }).done(function (result) {
        var actionRes = result;
        if (actionRes == "1") {
          $('#reportData').show();
          $(".alert-warning").hide();
          $('#reportData').attr('src', '/ReportForms/ContributionByEmployer.aspx');
          return false;
        }
        else {
          $(".alert-warning").show();
          $('#reportData').hide();
          toasterInfoMessage("Result not found on this search criteria.");
          return false;
        }
        });


  }
      function ShowReportData(evt) {
      debugger;
     $(evt.target).find("i.fa-spinner").show();
    var Date1 = $("#From").val();
    var Date2 = $("#to").val();
    var SchemeType = $("#EmplCode").val();
    var Gender = $("#Gender").val();
    var AgeInYears = $("#AgeInYears").val();
    var BeneficiariesId = $("#EmployeeId option:selected").map(function (ind, _el) {
        return $(_el).val();
        $(evt.target).find("i.fa-spinner").hide();
    });
          $('#btn_Deposits_loading').show();
          $('#IdSearch').hide();
      $.ajax({
        url: "@Url.Action("DirectDepositsToBankAjax", "Reports")?emplrId=" + SchemeType + "&empl_code=" + $.makeArray(BeneficiariesId) + "&date1=" + Date1 + "&date2=" + Date2 + "&gender=" + Gender + "&ageInYears=" + AgeInYears,
        type: "GET",
      }).done(function (result) {
          $('#IdSearch').show();
          $('#btn_Deposits_loading').hide();
        var actionRes = result;
        if (actionRes == "1") {
          $('#reportDataAction').show();
          $(".alert-warning").hide();
            $('#reportData').attr('src', '/ReportForms/ContributionByEmployer.aspx');
            $(evt.target).find("i.fa-spinner").hide();
          return false;
        }
        else {
          $(".alert-warning").show();
          $('#reportData').hide();
            toasterInfoMessage("Result not found on this search criteria.");
            $(evt.target).find("i.fa-spinner").hide();
        }
      });
      }
      $("#EmplCode").on('change', function () {
        var SchemeType = $("#EmplCode option:selected").val();
        var data = $("#Gender");
        data.empty();
        if (SchemeType != null && SchemeType != undefined && SchemeType != "") {
          data.append($("<option value='' selected>---Select---</option>"));
          data.append($("<option></option>").attr("value", "Male").text("Male"));
          data.append($("<option></option>").attr("value", "Female").text("Female"));
          data.append($("<option></option>").attr("value", "Transgender").text("Transgender"));
          $("#Gender").val("");
        }
      });
      $("#Gender").on('change', function () {
      debugger
      $('#select2-EmployeeId-container').text('---Select---');
      var seletedType = $("#EmplCode option:selected").text();
      var parts = seletedType.split(" | ");
      var BeneficiaryType = parts[0].trim();
      var Gender = $("#Gender").val();
      $.ajax({
        url: "@Url.Action("PensionerSearchAjax", "Reports")?seletedType=" + BeneficiaryType + "&Gender=" + Gender,
        success: function (res) {
          debugger
          var data = $("#EmployeeId");
          data.empty();
          $.each(res, function (index, item) {
              debugger
              data.append($("<option></option>").attr("value", item.Key).text(item.Value));
          });
          $("#EmployeeId").multiselect("destroy");
          $("#EmployeeId").multiselect({
            includeSelectAllOption: true,
            buttonWidth: '300px'
          });
        },
        error: function (error) {
            // Handle any errors here
        }
      });
    });
    </script>
}
