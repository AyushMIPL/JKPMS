@model JKPS.COMMON.DVOMasterEmployee
@{
    ViewBag.Title = "YearlyPensionSummary";
    var Group = @Html.Raw(Json.Encode(ViewBag.Group));
}
<div class="panel panel-default">

    @using (Html.BeginForm())
    {
        <div class="panel-body">
            <div class="row pb-4">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <label>Scheme</label>
                            @Html.DropDownList("EmplCode", null, "---Select---", new { @class = "form-control select-sm", @id = "EmplCode" })
                        </div>
                        <div class="col-sm-3 hidden">
                            <label>Gender</label>
                            <div class="form-group h_select">
                                @Html.DropDownList("Gender", null, "---Select---", new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Gender", @id = "Gender" })
                            </div>


                        </div>
                        @*<div class="col-sm-3">
                              <label>Beneficiary</label>
                              @Html.DropDownList("EmployeeId", null, "---Select---", new { @class = "form-control select-sm", @id = "EmployeeId", @multiple = "multiple" })
                            </div>*@
                        <div class="col-sm-3">
                            <label>District</label>
                            @Html.TextBox("RegionNames", "", new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Regions" })
                        </div>
                        <div class="col-sm-3">
                            <label>Date From</label>
                            <div class="input-group date" id="validateFrom">
                                @Html.TextBox("SelectFrom ", "", new { @class = "form-control", @placeholder = "Select Start Date", @id = "From" })
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="col-sm-3">
                            <label>To</label>
                            <div class="input-group date" id="validateTo">
                                @Html.TextBox("SelectTo ", "", new { @class = "form-control", @placeholder = "Select End Date", @id = "to" })
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-3 hidden">
                            <label>Age</label>
                            @Html.TextBoxFor(m => m.AgeInYears, new { @class = "form-control", placeholder = "Age (In Years)", min = "0", type = "number", step = "1", @id = "AgeInYears" })
                        </div>
                        <div class="col-sm-2">
                            <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
                            <button type="button" class="btn btn-success px-5 height" style="display: none;" title="Please Wait While We Process Your Request" id="btn_Yearly_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                            <button type="button" class="btn btn-success height px-5" id="Idbtnyearly" onclick="javascript: return ShowReportData(this)"><i class="fa fa-search"></i> Search </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Failure Payment Summary

            <ul class="tool-bar">
            </ul>
        </h4>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-12">
                <div class="alert alert-warning" style="display:none;">
                    <h4 class="mb-0"> There is no Record Found</h4>
                </div>
                <iframe id="reportData" style="border: 0px;height:700px;width:100%;"></iframe>
            </div>
        </div>
    </div>

</div>@section Scripts {
    <script nonce="@ViewBag.StyleNonce">
    $(function () {
      debugger
      $(".alert-warning").hide();
    });

    jQuery(document).ready(function ($) {
            comboTree = $('#RegionNames').comboTree({
                source: @Group,
                isMultiple: true,
                cascadeSelect: true,
                collapse: false
            });
        });

      function ShowReportData(evt) {
        debugger;
        $(evt).find("i.fa-spinner").show();
      var Date1 = $("#From").val();
      var Date2 = $("#to").val();
      var SchemeType = $("#EmplCode").val();
      var Gender = $("#Gender").val();
      var AgeInYears = $("#AgeInYears").val();
      var BeneficiaryId = $("#EmployeeId").val();
      var BeneficiariesId = $("#EmployeeId option:selected").map(function (ind, _el) {
        debugger
          return $(_el).val();
          $(evt).find("i.fa-spinner").hide();
      });

          $("#btn_Yearly_loading").show();
          $("#Idbtnyearly").hide();
      $.ajax({
        url: "@Url.Action("PensionByYearAjax", "Reports")?emplrId=" + SchemeType + "&empl_code=" + $.makeArray(BeneficiariesId) + "&date1=" + Date1 + "&date2=" + Date2 + "&gender=" + Gender + "&ageInYears=" + AgeInYears,
        type: "GET",
      }).done(function (result) {
          $("#Idbtnyearly").show();
          $("#btn_Yearly_loading").hide();
        var actionRes = result;
        $(evt).find("i.fa-spinner").hide();
        if (actionRes == "1") {
          $('#reportData').show();
          $(".alert-warning").hide();
            $('#reportData').attr('src', '/ReportForms/ContributionByEmployer.aspx');
            $(evt).find("i.fa-spinner").hide();
          return false;
        }
        else {
          $(".alert-warning").show();
          $('#reportData').hide();
            toasterInfoMessage("Result not found on this search criteria.");
            $(evt).find("i.fa-spinner").hide();
        }
      });
    }
    $("#EmplCode").on('change', function () {
      var SchemeType = $("#EmplCode option:selected").val();
      var data = $("#Gender");
      data.empty();
      if (SchemeType != null && SchemeType != undefined && SchemeType != "") {
        data.append($("<option value='' selected>---Select---</option>"));
        data.append($("<option></option>").attr("value", "Male").text("Male"));
        data.append($("<option></option>").attr("value", "Female").text("Female"));
        data.append($("<option></option>").attr("value", "Transgender").text("Transgender"));
        $("#Gender").val("");
      }
    });
