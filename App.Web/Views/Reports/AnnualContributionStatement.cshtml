@model App.Data.ViewModels.AnnualContributionStatementModel
@{
  ViewBag.Title = "AnnualContributionStatement";
}
<div class="panel panel-default">

  @using (Html.BeginForm())
  {
    <div class="panel-body">
      <div class="row">
      
            <div class="col-sm-3">
            
                @Html.LabelFor(model => model.EmployeeId, new { @class = "col-sm-3 control-label" })
            
                  @Html.DropDownListFor(model => model.EmployeeId, ViewBag.EmployeeId as SelectList, "--Select--", new { @class = "form-control input-sm" })
                </div>
             
            <div class="col-sm-3">
             
                @Html.LabelFor(model => model.ContributorId, new { @class = "col-sm-3 control-label" })
               
                  @Html.DropDownListFor(model => model.ContributorId, ViewBag.ContributorId as SelectList, "--Select--", new { @class = "form-control input-sm" })
                </div>
            
            <div class="col-sm-3">
          
                @Html.LabelFor(model => model.Year, new { @class = "col-sm-1 control-label" })
              
                  @Html.DropDownListFor(model => model.Year, ViewBag.Year as SelectList, "--Select--", new { @class = "form-control input-sm" })
                </div>
             
            <div class="col-sm-3">
              <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
              <button type="button" class="btn btn-success height px-5" onclick="javascript:return ShowReport()"><i class="fa fa-search"></i> Search</button>
            </div>
          </div>
        </div>
  }
      </div>
 

 
 



    <div class="panel panel-default">
      <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
          Annual Beneficiary Statement

          @*<ul class="tool-bar">

    </ul>*@
        </h4>
      </div>
      <div class="panel-body">
        <div class="row">
          @*<div class="col-sm-2">
        </div>*@
          <div class="col-sm-12">
            <div class="alert alert-warning">
              <h4 class="mb-0"> There is no Record Found</h4>
            </div>
            @*<iframe id="reportData" style="border: 0px;height:700px;width:100%;"></iframe>*@
          </div>
        </div>
      </div>
   
    </div>@section Scripts {
      <script nonce="@ViewBag.StyleNonce">
    $(function () {
    //  debugger
    //  var Date1 = $("#From").val();
    //  var Date2 = $("#to").val();
    //  if (Date1 == "" && Date2 == "") {
    //    var date = new Date();
    //    var LastDate = new Date(date.getFullYear(), date.getMonth() + 1, 0);
    //    var Date1 = (LastDate.getMonth() + 1) + "/" + 01 + "/" + (LastDate.getFullYear());
    //    var Date2 = (LastDate.getMonth() + 1) + "/" + LastDate.getDate() + "/" + (LastDate.getFullYear());
    //    $("#From").val(Date1);
    //    $("#to").val(Date2);
    //  }
      ShowReport();
      $("#EmployeeId").on('change', function () {
        $("#ContributorId").select2("val", "");
        $("#ContributorId").empty();
        $('#ContributorId').append($('<option/>').attr("value", "").text("---Select---"));
        if ($(this).val() != "") {
          var eid = $(this).val();

          $.ajax({
            url: "@Url.Action("ContributiorSearchAjax", "Reports")?EId=" + eid,
            type: "GET",
            async: true,
          }).done(function (result) {
            $.each(result, function (i, contributor) {
              $('#ContributorId').append($('<option/>').attr("value", contributor.Id).text(contributor.Name));
            });
          })
        }
      });
    })

    function ShowReport() {
      debugger;
      //var Date1 = $("#From").val();
      //var Date2 = $("#to").val();
      var Contributorid = $("#ContributorId").val();
      var EmplrId = $("#EmployeeId").val();
      var Year = $("#Year").val();
      if (Contributorid != "" && EmplrId != "" && Year != "") {
        $.ajax({
          url: "@Url.Action("AnnualContributionStatementAjax", "Reports")?emplrId=" + EmplrId + "&contributorid=" + Contributorid + "&Year=" + Year,
          type: "GET",
        }).done(function (result) {
          var actionRes = result;
          if (actionRes == "1") {
            $('#reportData').attr('src', '/ReportForms/ContributionByEmployer.aspx');
            return false;
          }
          else {
            toasterInfoMessage("Result not found on this search criteria.");
            return false;
          }
        });
      }
      else {
        toasterInfoMessage("All Fields Are Mandatory to Search.");
      }
    }

      </script>
    }
