@model JKPS.COMMON.DVOMediaDownloads

@{
    ViewBag.Title = "MediaDownloads";
}


<div class="panel panel-default">
    @using (Html.BeginForm())
    {
        <div class="panel-body">
            <div class="row pb-4">
                <div class="col-sm-12">
                    <div class="form-group">


                        <div class="col-sm-4">
                            <label>From Date</label>
                            <div class="input-group date" id="validateFrom">
                                @Html.TextBox("SelectFrom ", "", new { @class = "form-control", @placeholder = "Select Start Date", @id = "From" })
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-4">
                            <label>To Date</label>
                            <div class="input-group date" id="validateTo">
                                @Html.TextBox("SelectTo ", "", new { @class = "form-control", @placeholder = "Select End Date", @id = "to" })
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
                            <button type="button" class="btn btn-success px-5 height" style="display: none;" title="Please Wait While We Process Your Request" id="btn_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                            <button type="submit" id="btn" class="btn btn-success height px-5" onclick="ShowMediaDownloadReport(event)"><i class="fa fa-search"></i> Search </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Notification Downloads
            <ul class="tool-bar" style="margin-top: 0px;">
                <li><a href="" title="Refresh" data-original-title="Refresh"><i class="fa fa-refresh"></i></a></li>
            </ul>
        </h4>
    </div>
    <table class="table dataTable" id="tblMediaDownload">
        <thead>
            <tr>
                <th>File Name</th>
                <th>Has Downoaded</th>
                <th>Is Processed</th>
                <th>Created On</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>



@section Scripts {

    <script nonce="@ViewBag.StyleNonce">

    $(function () {
        $(".alert-warning").hide();
        ShowMediaDownloadReport();
     });
        function ShowMediaDownloadReport() {
      debugger;
        Date1 = $("#From").val();
            Date2 = $("#to").val();
        var sName = $('#tblMediaDownload').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": true,
        "sAjaxSource": "@Url.Action("MediaDownloadsAjax", "Reports")?Date1=" + Date1 + "&Date2=" + Date2,
        "aoColumns": [

        { "sName": "FileName" },
            { "sName": "HasDownoaded" },
            { "sName": "IsProcessed" },
            { "sName": "CreatedOn" }
        ]
      });
    }

    </script>



}


