@{
  ViewBag.Title = "Arear";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Arear
    </h4>
    <div class="row pb-4">
      <div class="col-sm-3">
        <div class="form-group">
          <label>Beneficiaries Type</label>
          @Html.DropDownList("BeneficiariesType", null, "Select Type", new { @class = "form-control", @autocomplete = "off", @placeholder = "Beneficiaries Type" })
        </div>
      </div>
      <div class="col-sm-3">
        <div class="form-group">
          <label>Deduction Type</label>
          @Html.DropDownList("DeductionType", null, "Select Type", new { @class = "form-control", @autocomplete = "off", @placeholder = "Deduction Type" })
        </div>
      </div>
      <div class="col-sm-3"></div>
      <div class="col-sm-3">
        <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
        <button type="button" class="btn btn-success height px-5" onclick="BindArearData()"><i class="fa fa-search"></i> Search</button>
      </div>
      @*<div class="col-sm-3">
          <label>Date From</label>
          <div class="input-group date" id="validateFrom">
            @Html.TextBox("SelectFrom ", "", new { @class = "form-control", @placeholder = "Select Start Date", @id = "From" })
            <span class="input-group-addon">
              <i class="fa fa-calendar"></i>
            </span>
          </div>
        </div>
        <div class="col-sm-3">
          <label>To</label>
          <div class="input-group date" id="validateTo">
            @Html.TextBox("SelectTo ", "", new { @class = "form-control", @placeholder = "Select End Date", @id = "to" })
            <span class="input-group-addon">
              <i class="fa fa-calendar"></i>
            </span>
          </div>
        </div>*@
    </div>
  </div>
  <div class="panel-body">
    <div class="row pb-4">
      <div class="form-group">
        <table class="table" id="ArearTable" border="1">
          <thead>
            <tr>
              <th width="10%" rowspan="2">ApplicationReferenceNo</th>
              <th width="10%" rowspan="2">Name</th>
              <th colspan="12" style="text-align:center" width="70%">Month</th>
              <th width="10%" rowspan="2">Gross Amount</th>
            </tr>
            <tr>
              <th>Jan</th>
              <th>Feb</th>
              <th>Mar</th>
              <th>Apr</th>
              <th>May</th>
              <th>Jun</th>
              <th>Jul</th>
              <th>Aug</th>
              <th>Sep</th>
              <th>Oct</th>
              <th>Nov</th>
              <th>Dec</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script nonce="@ViewBag.StyleNonce">
    $(document).ready(function () {
      BindArearData()
    });
    function BindArearData() {
      var BeneficiariesType = $("#BeneficiariesType option:selected").val();
      var SchemeType = (BeneficiariesType == null && BeneficiariesType == undefined && BeneficiariesType == "") ? "" : BeneficiariesType
      $('#ArearTable').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/Reports/ArearAjax?SchemeType=" + SchemeType,
        "aoColumns": [
          { "sname": "ApplicationReferenceNo" },
          { "sname": "ApplicantName" },
          { "sname": "Jan" },
          { "sname": "Feb" },
          { "sname": "Mar" },
          { "sname": "Apr" },
          { "sname": "May" },
          { "sname": "Jun" },
          { "sname": "Jul" },
          { "sname": "Aug" },
          { "sname": "Sep" },
          { "sname": "Oct" },
          { "sname": "Nov" },
          { "sname": "Dec" },
          { "sname": "GrossAmount" }
        ]
      });
    }
  </script>
}