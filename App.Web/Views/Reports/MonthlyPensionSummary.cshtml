@model JKPS.COMMON.DVOMasterEmployee
@using JKPS.COMMON
@{
    ViewBag.Title = "MonthlyPensionSummary";
    var Group = @Html.Raw(Json.Encode(ViewBag.Group));
}
<style>
    /* Hide the remove (x) icon */
    .select2-selection__clear {
        display: none;
    }
    
    #DownloadOptions li a {
        color: #000 !important;
        cursor: pointer;
        padding: 8px 15px;
        display: block;
    }
    #DownloadOptions li a:hover {
        background-color: #f1f1f1 !important;
        color: #000 !important;
    }
    #DownloadOptions li a i {
        margin-right: 5px;
    }
</style>

<div class="panel panel-default">
    @using (Html.BeginForm())
    {
        <div class="panel-body">
            <div class="row pb-4">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="col-sm-4">
                            <label class="districtMonthlyPensionSummary">District</label>
                            @Html.TextBox("RegionNames", "", new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Regions", @id = "RegionNames" })
                        </div>
                        <div class="col-sm-4">
                            <label>Scheme</label>
                            @Html.DropDownList("EmplCode", null, "---Select---", new { @class = "form-control select-sm", @id = "EmplCode" })
                        </div>
                        <div class="col-sm-2">
                            <label>Gender</label>
                            <div class="form-group h_select">
                                @Html.DropDownList("Gender", null, "---Select---", new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Gender", @id = "Gender" })
                            </div>
                        </div>

                        <div class="col-sm-2">
                            <label>Age</label>
                            @Html.TextBoxFor(m => m.AgeInYears, new { @class = "form-control", placeholder = "Age(In Years)", @value = "0", min = "0", step = "1", @id = "AgeInYears", @type = "text", @inputmode = "numeric", @pattern = "[0-9]*", @onkeypress = "return event.charCode >= 48 && event.charCode <= 57" })
                        </div>

                        <div class="col-sm-4">
                            <label>Pay Period</label>
                            <select class="form-control" id="PayPeriod" onchange="ShowTheMonthOrYear()">
                                <option value="">Select Pay Period</option>
                                @*<option value="ByFinancialYear">Financial Year</option>*@
                                <option value="ByMonth">Date Range</option>
                            </select>
                        </div>
                        <div id="FinancialYearDiv" class="hidden">
                            <div class="col-md-4">
                                <label>Years</label>
                                <select class="form-control FinancialYearDropdownMonthlyPensionSummary" id="FinancialYearDropdown" onchange="SetFromAndToDateValues('ByFinancialYear')">
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Months</label>
                                <select class="form-control FinancialMonthDropdownMonthlyPensionSummary" id="FinancialMonthDropdown" onchange="SetFromAndToDateValues('ByFinancialYearMonth')">
                                    <option value="-1">All</option>
                                    <option value="0">January</option>
                                    <option value="1">February</option>
                                    <option value="2">March</option>
                                    <option value="3">April</option>
                                    <option value="4">May</option>
                                    <option value="5">June</option>
                                    <option value="6">July</option>
                                    <option value="7">August</option>
                                    <option value="8">September</option>
                                    <option value="9">October</option>
                                    <option value="10">November</option>
                                    <option value="11">December</option>
                                </select>
                            </div>
                        </div>
                        <div id="formToDateDiv" class="hidden">
                            <div class="col-sm-4">
                                <label>Date From</label>
                                <div>
                                    <input type="date" id="From" class="form-control" placeholder="select date" onchange="validateDateRange()">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label>To</label>
                                <div>
                                    <input type="date" id="to" class="form-control" placeholder="select date" onchange="validateDateRange()">
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
            <div class="row pb-4">
                <div class="col-sm-12">
                    <div class="form-group">
                        @*<div class="col-sm-3">
                                <label>To</label>
                                <div class="input-group date" id="validateTo">
                                    @Html.TextBox("SelectTo ", "", new { @class = "form-control", @placeholder = "Select End Date", @id = "to" })
                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </span>
                                </div>
                            </div>*@

                        <div class="col-sm-3">
                            <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
                            <button type="button" class="btn btn-success px-5 height btn_loadingMonthlyPensionSummary" title="Please Wait While We Process Your Request" id="btn_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                            <button type="button" id="btnsubmit" class="btn btn-success height px-5"><i class="fa fa-search"></i> Search </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline headlineMonthlyPensionSummary">
            Success Payment Summary <span id="recordCountSpan" class="badge badge-info" style="margin-left: 10px;"></span>
            <ul class="tool-bar">
                <li class="dropdown">
                    <a class="dropdown-toggle DownloadDropdown" data-toggle="dropdown" href="#">
                        <span><i class="fa fa-ellipsis-v fa-2x"></i></span>
                    </a>
                    <ul class="dropdown-menu" id="DownloadOptions">
                        <li>
                            <a tabindex="-1" id="ExcelDownload" onclick="PensionSummaryExcelDownload()"><i class="fa fa-file-excel-o" aria-hidden="true"></i> Excel</a>
                        </li>
                        <li>
                            <a tabindex="-1" id="PdfDownload" onclick="PensionSummaryPdfDownload()"><i class="fa fa-file-pdf-o" aria-hidden="true"></i> Pdf</a>
                        </li>
                    </ul>
                </li>
            </ul>
        </h4>
    </div>
    <div class="panel-body">
        <div class="row py-3">
            <div class="col-sm-12">
                <div class="alert alert-warning alert-warningMonthlyPensionSummary display-none">
                    <h4 class="mb-0"> There is no Record Found</h4>
                </div>
            </div>
        </div>
        <div class="table-responsive" id="PayHistoryList">
            <table class="table dataTable display-none" id="tblMonthlyPensionSummary" style="width:100%">
                <thead>
                    <tr>
                        <th data-searchable="true">District</th>
                        <th data-searchable="true">Application Reference Number</th>
                        <th data-searchable="true">Applicant Name</th>
                        <th data-searchable="true">Account No</th>
                        <th data-searchable="true">Bank Name</th>
                        <th data-searchable="true">IFSC Code</th>
                        <th data-searchable="true">Gender</th>
                        <th data-searchable="true">Age</th>
                        <th data-searchable="true">Scheme</th>
                        <th data-searchable="true">Amount</th>
                        <th data-searchable="true">Pension Generated On</th>
                        <th data-searchable="true">Status</th>
                        <th data-searchable="true">Reason</th>
                        <th data-searchable="true">Transaction Reference No</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div id="loader-container">
    <div id="loader">
        <div class="loader-inner"></div>
    </div>
</div>


@section Scripts {
    <link href="~/Content/endless/css/newdatatablemodified.css" rel="stylesheet" />
