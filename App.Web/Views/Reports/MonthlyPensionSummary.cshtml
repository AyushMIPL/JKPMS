    function BindFinancialYear() {
      // Get Current Month
      var currentMonth = new Date().getMonth();
      // Get the current year
      var currentYear = new Date().getFullYear();
      // Set start financial years
      var financialYearCount = currentYear - 2022;
      if (currentMonth < 3) {
        currentYear = currentYear - 1;
      }
      // Create a dropdown element
      var dropdown = $('#FinancialYearDropdown');
      // Populate the dropdown with the last 10 years
      for (var i = 0; i < financialYearCount; i++) {
        var year = currentYear - i;
        dropdown.append($('<option>', { value: year + '_' + (year + 1), text: year + '-' + (year + 1) }));
      }
    }

    function ShowTheMonthOrYear() {
      var selectedPeriod = $("#PayPeriod").val();
      if (selectedPeriod == "ByFinancialYear") {
        $("#formToDateDiv").addClass("hidden");
        $("#FinancialYearDiv").removeClass("hidden");
      } else if (selectedPeriod == "ByMonth") {
        $("#FinancialYearDiv").addClass("hidden");
        $("#formToDateDiv").removeClass("hidden");
      } else {

      }
      SetFromAndToDateValues(selectedPeriod);
    }
      function SetFromAndToDateValues(selectedPeriod) {
          debugger
      if (selectedPeriod == "ByFinancialYear" || selectedPeriod == "ByFinancialYearMonth") {
        var finacialYear = $("#FinancialYearDropdown").val().split('_');
        // Create a new Date object
        var specificDate = new Date();
        // Set the year to 2020
        specificDate.setFullYear(finacialYear[0]);
        //// Set the month to 3 (April, zero-based index)
        //specificDate.setMonth(3);
        var selectedMonth = $("#FinancialMonthDropdown").val();

        if (selectedPeriod == "ByFinancialYearMonth" && selectedMonth != "-1") {
          if (selectedMonth < 3) {
            specificDate.setFullYear(finacialYear[1]);
          }
          specificDate.setMonth(selectedMonth);
        } else {
          specificDate.setMonth(3);
        }
        // Set the date to 1
        specificDate.setDate(1);
        // Format the date as a string (optional)
        //var formattedDate = specificDate.toDateString();
        var formattedFirstDay = $.datepicker.formatDate('yy-mm-dd', specificDate);
        $('#From').val(formattedFirstDay);
        // Create a new Date object
        var specificDateL = new Date();
        // Set the year to 2020
        specificDateL.setFullYear(finacialYear[1]);
        //// Set the month to 2 (March, zero-based index)
        //specificDateL.setMonth(2);
        //// Set the date to 31
        //specificDateL.setDate(31);
        if (selectedPeriod == "ByFinancialYearMonth" && selectedMonth != "-1") {
          if (selectedMonth > 2) {
            specificDateL.setFullYear(finacialYear[0]);
          }
          specificDateL.setMonth(selectedMonth);
        } else {
          specificDateL.setMonth(2);
        }

        var lastDay = new Date(specificDateL.getFullYear(), specificDateL.getMonth() + 1, 0).getDate();
        // Set the date to 31
        specificDateL.setDate(lastDay);
        // Format the date as a string (optional)
        //var formattedDateL = specificDateL.toDateString();
        var formattedLastDay = $.datepicker.formatDate('yy-mm-dd', specificDateL);
        $('#to').val(formattedLastDay);


      } else if (selectedPeriod == "ByMonth") {
        // Get the current date
        var currentDate = new Date();
        // Get the first day of the current month
        var firstDay = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
        // Get the last day of the current month
        var lastDay = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
        // Format the dates if needed
        var formattedFirstDay = $.datepicker.formatDate('yy-mm-dd', firstDay);
          var formattedLastDay = $.datepicker.formatDate('yy-mm-dd', lastDay);

        //$('#From').val(formattedFirstDay);
        //$('#to').val(formattedLastDay);

      } else {
        // Get the current date
        var currentDate = new Date();
        // Get the first day of the current month
        var firstDay = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
        // Get the last day of the current month
          var lastDay = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);

        // Format the dates if needed
        //var formattedFirstDay = $.datepicker.formatDate('yy-mm-dd', firstDay);
        //  var formattedLastDay = $.datepicker.formatDate('yy-mm-dd', lastDay);

          var formattedFirstDay = $("#hdn_FinancialYearStartDate").val();
          var formattedLastDay = $("#hdn_FinancialYearEndDate").val();
        $('#From').val(formattedFirstDay);
        $('#to').val(formattedLastDay);
      }

    }

        function ShowReport(evt) {

            var Date1 = $("#From").val();
            var Date2 = $("#to").val();
            var SchemeType = $("#EmplCode").val() || "";
            var Gender = $("#Gender").val() || "";
            var AgeInYears = $("#AgeInYears").val() || "";
            var RegionNames = $("#RegionNames").val() || "";
            var FinacialYear = $("#hdn_FinancialYear").val() || "";
            var BeneficiariesId = $("#RegionNames option:selected").map(function (ind, _el) {
                return $(_el).val();
            });
            var benefIdArray = $.makeArray(BeneficiariesId);
            
            $("#btn_loading").show();
            $("#btnsubmit").hide();

            var ajaxUrl = "@Url.Action("PensionByMonthAjax", "Reports")?emplrId=" + SchemeType + "&empl_code=" + benefIdArray + "&date1=" + Date1 + "&date2=" + Date2 + "&gender=" + Gender + "&ageInYears=" + AgeInYears + "&regionNames=" + RegionNames + "&finacialYear=" + FinacialYear;

            $('#tblMonthlyPensionSummary').dataTable({
                "bJQueryUI": true,
                "sPaginationType": "full_numbers",
                "bServerSide": true,
                "bDestroy": true,
                "bAutoWidth": false,
                "iDisplayLength": 10,
                "sAjaxSource": ajaxUrl,
                "fnDrawCallback": function (oSettings) {
                    var totalRecords = oSettings.fnRecordsTotal();
                    if (totalRecords > 0) {
                        $("#tblMonthlyPensionSummary").show();
                        $(".alert-warning").hide();
                        $("#recordCountSpan").text("(" + totalRecords + " Records)");
                    } else {
                        $("#tblMonthlyPensionSummary").hide();
                        $(".alert-warning").show();
                        $("#recordCountSpan").text("");
                    }
                    $("#btnsubmit").show();
                    $("#btn_loading").hide();
                },
                "aoColumns": [
                    { "sName": "District" },
                    { "sName": "ApplicationReferenceNo" },
                    { "sName": "ApplicantName" },
                    { "sName": "AccountNo" },
                    { "sName": "BankName" },
                    { "sName": "IFSC_Code" },
                    { "sName": "Gender" },
                    { "sName": "Age_InYears" },
                    { "sName": "SchemeType" },
                    { "sName": "Amount" },
                    {
                        "sName": "PaidOn",
                        "bSearchable": false,
                        "bSortable": false,
                        "render": function (data, type, row, meta) {
                            if (!row[10]) return "";
                            var strString = (row[10].split(" ")[0]).split("-").reverse().join("-");
                            return strString;
                        }
                    },
                    { "sName": "Status" },
                    { "sName": "Reason" },
                    { "sName": "TransactionRefrenceNo" }
                ]
            });
        }
        
        function PensionSummaryExcelDownload() {
            var Date1 = $("#From").val();
            var Date2 = $("#to").val();
            var SchemeType = $("#EmplCode").val() || "";
            var Gender = $("#Gender").val() || "";
            var AgeInYears = $("#AgeInYears").val() || "";
            var RegionNames = $("#RegionNames").val() || "";
            var FinacialYear = $("#hdn_FinancialYear").val() || "";
            var BeneficiariesId = $("#RegionNames option:selected").map(function (ind, _el) {
                return $(_el).val();
            });
            var benefIdArray = $.makeArray(BeneficiariesId);
            
            var url = "@Url.Action("PensionByMonthExcelAjax", "Reports")?emplrId=" + SchemeType + "&empl_code=" + benefIdArray + "&date1=" + Date1 + "&date2=" + Date2 + "&gender=" + Gender + "&ageInYears=" + AgeInYears + "&regionNames=" + RegionNames + "&finacialYear=" + FinacialYear;
            window.location.href = url;
        }

        function PensionSummaryPdfDownload() {
            var Date1 = $("#From").val();
            var Date2 = $("#to").val();
            var SchemeType = $("#EmplCode").val() || "";
            var Gender = $("#Gender").val() || "";
            var AgeInYears = $("#AgeInYears").val() || "";
            var RegionNames = $("#RegionNames").val() || "";
            var FinacialYear = $("#hdn_FinancialYear").val() || "";
            var BeneficiariesId = $("#RegionNames option:selected").map(function (ind, _el) {
                return $(_el).val();
            });
            var benefIdArray = $.makeArray(BeneficiariesId);
            
            var url = "@Url.Action("PensionByMonthPdfAjax", "Reports")?emplrId=" + SchemeType + "&empl_code=" + benefIdArray + "&date1=" + Date1 + "&date2=" + Date2 + "&gender=" + Gender + "&ageInYears=" + AgeInYears + "&regionNames=" + RegionNames + "&finacialYear=" + FinacialYear;
            
            $("#btn_loading").show();
            toasterInfoMessage("Generating PDF, please wait...");
            $.get(url, function (data) {
                if(data && data.length > 0) {
                    var docDefinition = {
                        pageOrientation: 'landscape',
                        pageSize: 'A4',
                        content: [
                            { text: 'Success Payment Summary Report', style: 'header', alignment: 'center', margin: [0, 0, 0, 10] },
                            {
                                style: 'tableExample',
                                table: {
                                    headerRows: 1,
                                    widths: ['auto', 'auto', 'auto', 'auto', 'auto', 'auto', 'auto', 'auto', 'auto', 'auto', 'auto', 'auto'],
                                    body: [
                                        [
                                            {text: 'District', style: 'tableHeader'},
                                            {text: 'App Ref', style: 'tableHeader'},
                                            {text: 'Name', style: 'tableHeader'},
                                            {text: 'Account No', style: 'tableHeader'},
                                            {text: 'Bank', style: 'tableHeader'},
                                            {text: 'IFSC', style: 'tableHeader'},
                                            {text: 'Gender', style: 'tableHeader'},
                                            {text: 'Age', style: 'tableHeader'},
                                            {text: 'Scheme', style: 'tableHeader'},
                                            {text: 'Amount', style: 'tableHeader'},
                                            {text: 'Date', style: 'tableHeader'},
                                            {text: 'Status', style: 'tableHeader'}
                                        ]
                                    ]
                                }
                            }
                        ],
                        styles: {
                            header: { fontSize: 16, bold: true },
                            tableHeader: { bold: true, fontSize: 10 },
                            tableExample: { fontSize: 8 }
                        }
                    };
                    
                    data.forEach(function (row) {
                        docDefinition.content[1].table.body.push([
                            (row.District || '').toString(), 
                            (row.ApplicationReferenceno || '').toString(), 
                            (row.ApplicantName || '').toString(), 
                            (row.bank_acct_no || '').toString(), 
                            (row.BankName || '').toString(), 
                            (row.IFSCCode || '').toString(), 
                            (row.Gender || '').toString(), 
                            (row.Age_InYears || '').toString(), 
                            (row.type_code || '').toString(), 
                            (row.amount || '').toString(), 
                            (row.pay_date || '').toString(), 
                            (row.Status || '').toString()
                        ]);
                    });
                    pdfMake.createPdf(docDefinition).download("SuccessPaymentSummary.pdf");
                } else {
                    toasterInfoMessage("No records found to generate PDF.");
                }
                $("#btn_loading").hide();
            }).fail(function() {
                toasterErrorMessage("Failed to generate PDF.");
                $("#btn_loading").hide();
            });
        }
