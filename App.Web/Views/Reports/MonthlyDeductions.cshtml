@section Scripts {
  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      //ShowReport();
    })

    function ShowReport() {
      debugger;
      var EmpType = $("#EmpType").val();
      //var Months = $("#Months").val();
        //var Years = $("#Years").val();
      var Date1 = $("#From").val();
      var Date2 = $("#to").val();
      if (Date1 == "" && Date2 == "") {
          var date = new Date();
          var LastDate = new Date(date.getFullYear(), date.getMonth() + 1, 0);
          Date1 = (LastDate.getMonth() + 1) + "/" + 01 + "/" + (LastDate.getFullYear());
          Date2 = (LastDate.getMonth() + 1) + "/" + LastDate.getDate() + "/" + (LastDate.getFullYear());
      //    $("#From").val(Date1);
      //    $("#to").val(Date2);
      }
      var DeductionType = $("#DeductionType").val();
      $.ajax({
          url: "@Url.Action("MonthlyDeductionsAjax", "Reports")?EmpType=" + EmpType + "&datefrom=" + Date1 + "&dateto=" + Date2 + "&DeductionType=" + DeductionType,
        type: "GET",
      }).done(function (result) {
        var actionRes = result;
        if (actionRes == "1") {
          $('#reportData').attr('src', '/ReportForms/ContributionByEmployer.aspx');
          return false;
        }
        else {
          toasterInfoMessage("Result not found on this search criteria.");
          return false;
        }
      });
    }

  </script>
}
