@model List<App.Data.Entities.AuditLogs>
@{
  ViewBag.Title = "TransactionHistory";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
  .dataTables_wrapper .dt-buttons {
    float: none;
    text-align: left;
  }
</style>
<div class="panel panel-default">

  @using (Html.BeginForm())
  {
    <div class="panel-body">
      <div class="row">
        <div class="col-sm-12">
          <div class="form-group">
            <div class="col-sm-3">
              <label>Name</label>

              @Html.DropDownList("updlogid", null, "Select User", new { @class = "form-control select-sm", @id = "updlogid" })
            </div>

            <div class="col-sm-3">
              <label>Date From</label>
              <div class="input-group date" id="validateFrom">

                @Html.TextBox("Select Date", "", new { @class = "form-control", @Value = DateTime.Now.ToString("MM/dd/yyyy"), @id = "From" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>
            <div class="col-sm-3">
              <label>To</label>
              <div class="input-group date" id="validateTo">

                @Html.TextBox("Select Date ", "", new { @class = "form-control", @Value = DateTime.Now.ToString("MM/dd/yyyy"), @id = "ToDate" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
              </div>
              <div class="col-sm-6 text-right">
                <button type="button" class="btn btn-success height px-5" style="text-align: right;" onclick="dobind()">
                  <i class="fa fa-search"></i> Search
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  }
</div>
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Transaction History
      <ul class="tool-bar">
      </ul>
    </h4>
    <button class="btn btn-success" style="float: right; text-align: right;" onclick="downloadExcel()">Download Excel</button>
      
  </div>

  <div class="panel-body">
    <div>
      <ul style="display: flex; list-style-type: none;">
      </ul>
    </div>
    <div class="table-responsive">
      <table id="reportData" class="display nowrap" cellspacing="0" width="100%">
        @*<table class="table" id="reportData">*@
        <thead>
          <tr>
            <th>Created By</th>
            <th>Created On</th>
            <th>Modified By</th>
            <th>Modified On</th>
            <th>Event Type</th>
            <th>Table Name</th>
            <th>Column Name</th>
            <th>Old Value</th>
            <th>New Value</th>
            <th>Url</th>
            <th>Controller</th>
            <th>Action</th>
            <th>Area</th>
            <th>IP Address</th>
            <th>Record Id</th>
            <th>Old SystemId</th>
            <th>Message</th>

          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>
@section Scripts {

  <script nonce="@ViewBag.StyleNonce">

    $(function () {
        $(".alert-warning").hide();
      dobind();
     });
    function dobind() {
      debugger;
      Username = $("#updlogid").val();
      Date1 = $("#From").val();
      Date2 = $("#ToDate").val();
      var sName = $('#reportData').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": true,
        "sAjaxSource": "@Url.Action("TransactionHistoryAjax", "Reports")?Date1=" + Date1 + "&Date2=" + Date2 + "&Username=" + Username + "",
        "aoColumns": [

        { "sName": "CreatedBy" },
        { "sName": "CreatedOn" },
        { "sName": "ModifiedBy" },
        { "sName": "ModifiedOn" },
        { "sName": "EventType" },
        { "sName": "TableName" },
        { "sName": "ColumnName" },
        { "sName": "OldValue" },
        { "sName": "NewValue" },
        { "sName": "Url" },
        { "sName": "Controller" },
        { "sName": "Action" },
        { "sName": "Area" },
        { "sName": "IPAddress" },
        { "sName": "RecordId" },
        { "sName": "OldSystemId" },
        { "sName": "Message" }

        ]@*,
        dom:  'Bflrtip',
        buttons: [
          {
          //  extend: 'excelHtml5',
          //  title: 'Excel',
          //  text: 'Export to excel'
          //},

             text: 'Download Excel',
             autoFilter: true,
             action: function (e, dt, node, config) {
                 try {
                     $.ajax({
                         type: "POST",
                       data: { param: dt.ajax.params(), Date1: $("#From").val(), Date2: $("#ToDate").val(), Username: $("#updlogid").val(),isDownload: true },
                       url: '@Url.Action("TransactionHistoryAjax", "Reports")',
                         cache: false,
                         success: function (result) {
                             if (result != null) {
                                 var bytes = new Uint8Array(result.FileContents);
                                 var blob = new Blob([bytes], { type: '@System.Net.Mime.MediaTypeNames.Application.Octet' });
                                 if (window.navigator.msSaveOrOpenBlob) {
                                     // IE11
                                     window.navigator.msSaveOrOpenBlob(blob, result.FileDownloadName);
                                 } else {
                                     // Google chome, Firefox, ....
                                     var link = document.createElement('a');
                                     link.href = window.URL.createObjectURL(blob);
                                     link.download = result.FileDownloadName;
                                     link.click();
                                 }
                             }
                             else {

                             }
                         },
                         error: function (xhr, status, error) {
                         }
                     });

                 } 
           catch (e) {
                 }
             }
          },



        ]*@
      });
    }
    function downloadExcel() {
      debugger;
      $.ajax({
        type: "POST",
        data: { Date1: $("#From").val(), Date2: $("#ToDate").val(), Username: $("#updlogid").val(), isDownload: true },
        url: '@Url.Action("TransactionHistoryAjax", "Reports")',
        cache: false,
        success: function (result) {
          if (result != null) {
            var bytes = new Uint8Array(result.FileContents);
            var blob = new Blob([bytes], { type: '@System.Net.Mime.MediaTypeNames.Application.Octet' });
            if (window.navigator.msSaveOrOpenBlob) {
              // IE11
              window.navigator.msSaveOrOpenBlob(blob, result.FileDownloadName);
            } else {
              // Google chome, Firefox, ....
              var link = document.createElement('a');
              link.href = window.URL.createObjectURL(blob);
              link.download = result.FileDownloadName;
              link.click();
            }
          }
          else {

          }
        },
       
          error: function (xhr, status, error) {
          }
        });
    }
  </script>




}