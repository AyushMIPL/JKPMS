@model App.Data.Entities.MasterProcessKey

@{
    ViewBag.Title = "Create Master Process Key";
}

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline">
            Create Master Process Key
            <ul class="tool-bar">
                <li><a href="@Url.Action("Index")" class="btn btn-default btn-xs"><i class="fa fa-arrow-left"></i> Back to List</a></li>
            </ul>
        </h4>
    </div>
    
    <div class="panel-body">
        @using (Html.BeginForm()) 
        {
            @Html.AntiForgeryToken()
            
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                
                <div class="form-group row">
                    @Html.LabelFor(model => model.ProcessKeyName, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-6">
                        @Html.EditorFor(model => model.ProcessKeyName, new { htmlAttributes = new { @class = "form-control", @required="required" } })
                        @Html.ValidationMessageFor(model => model.ProcessKeyName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row mt-4">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Create" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>
