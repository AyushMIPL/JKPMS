@model App.Data.Entities.MasterStatus

@{
  ViewBag.Title = "Create";
}

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-masterstatuscreate" >
      Add Status
      @*<ul class="tool-bar">
        
      </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Create", "MasterStatus", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="row">
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "col-sm-4 control Color-Red-asterisk" })
            <div class="col-sm-8">
              @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Status" })

            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.StatusCode, new { @class = "col-sm-4 control" })
            <div class="col-sm-8">
              @Html.TextBoxFor(m => m.StatusCode, new { @class = "form-control input-sm", placeholder = "Status Code" })

            </div>
          </div>
          
          <div class="form-group">
            <label for="IsActive" class="col-sm-4 control">Status:</label>
            <div class="col-sm-8">
              <div class="checkbox">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
              <button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Create</button>
              @Html.ActionLink("Back to List", "Index", "MasterStatus", null, new { @class = "btn btn-primary" })
            </div>
          </div>
        </div>
      </div>

    }
  </div>
</div>
@section scripts{

  <script src="~/Scripts/Master.js"></script>
}