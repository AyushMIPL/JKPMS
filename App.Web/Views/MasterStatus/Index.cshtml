@model IEnumerable<App.Data.Entities.MasterStatus>

@{
  ViewBag.Title = "Index";
}
<style>
  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-masterstatusindex">
      Status
      

      <ul class="tool-bar">
        <li><a href="/MasterStatus/Create" data-toggle="tooltip" data-placement="bottom" title="Add details" data-original-title="Add Details"><i class="fa fa-plus"></i></a></li>
        
      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>

          <th class="action-buttonname" >Name</th>
          <th class="action-buttonstatus" >Status</th>
          <th class="action-buttonaction" ></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {

  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });

    var MasterStatusTableId = [];

    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/MasterStatus/AjaxHandler",

        "fnDrawCallback": function (setting) {
          debugger;

          MasterStatusTableId.forEach(function (item, index) {
            debugger
            if (document.getElementById("DeleteMasterStatusBtn_" + item) != null && document.getElementById("DeleteMasterStatusBtn_" + item) != undefined) {
              document.getElementById("DeleteMasterStatusBtn_" + item).addEventListener("click", function () {
                del(item);
              });
            }
          });

        },


        "aoColumns": [

						{ "sName": "Name" },
						{
						  "sName": "ActiveStatus",
						  "bSearchable": false,
						  "bSortable": false,
						  "fnRender": function (oObj) {
						    if (oObj.aData[1] == "False")
						      return '<span class="badge badge-danger">inactive</span>';
						    else
						      return '<span class="badge badge-success">active</span>';
						  }
						},
						{
						  "sName": "ID",
						  "bSearchable": false,
						  "bSortable": false,
						  "fnRender": function (oObj) {
						    //var strString = '<a href="/MasterStatus/Edit/' + oObj.aData[2] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';
						    //strString += '&nbsp;<a href="/MasterStatus/Details/' + oObj.aData[2] + '\" class="btn btn-xs btn-primary" title="Detail"><i class="fa fa-list"></i> Details</a>';
          //      /* strString += '&nbsp;<a href="javascript:;"  btn-xs" onclick="javascript:del(' + oObj.aData[2] + ');" class="btn btn-xs btn-danger"> <i class="fa fa-trash-o fa-lg"></i> Delete</a>';*/
          //      strString += '&nbsp;<a href="javascript:;" onclick="javascript:del(\'' + oObj.aData[2] + '\');" class="btn btn-xs btn-danger" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</a>';



                var strString = '<a href="/MasterStatus/Edit/' + oObj.aData[2] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';
                strString += '&nbsp;<a href="/MasterStatus/Details/' + oObj.aData[2] + '\" class="btn btn-xs btn-primary" title="Detail"><i class="fa fa-list"></i> Details</a>';
                 
                strString += '&nbsp;<a id="DeleteMasterStatusBtn_' + oObj.aData[2] + '\" class="btn btn-xs btn-danger" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</a>';
                MasterStatusTableId.push(oObj.aData[2]);
						    return strString;
						  }
						}
        ]
      });
    }

    function del(ctrlId) {
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
    }
    const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
    debugger
    Confirm_Delete_ClassBtn.forEach(button => {
      button.addEventListener('click', onDeleteConfirm);
    });
    function onDeleteConfirm() {
      var id = $("#hdDocumentId").val();
      $.ajax({
        url: "@Url.Action("Remove", "MasterStatus")?Id=" + id + "",
        type: "GET",
      })
		.done(function (result) {
		  var actionRes = result;
		  if (actionRes == "0") {
		    toasterErrorMessage("There is some error, please try again.");
		    return actionRes;
		  }
		  else {
        toasterSuccessMessage("Record deleted successfully.");
		    $('#confirmDelete').popup("hide");
		    doBindData();
		  }
		});
    }
  </script>
}
