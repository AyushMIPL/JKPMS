@model App.Data.Entities.ApprovalProcessAssignedUser

@{
  ViewBag.Title = "Edit";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Update Details
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "ApprovalPermission", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "form1" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      @Html.HiddenFor(model => model.ApprovalProcessLevelId)
      @Html.HiddenFor(m => m.IsActive)
      <div class="row">
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.ApprovalProcessId, "Level Name", new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              @Html.DropDownList("ApprovalProcessId", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.ApprovalUser, "Username", new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              @Html.DropDownList("ApprovalUser", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
              <input type="button" class="btn btn-success" value="Update" id="saveDetails"/>
              <a href="/ApprovalPermission/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
              @*@Html.ActionLink("Back to List", "Index", "ApprovalPermission", null, new { @class = "btn btn-primary" })*@
            </div>
          </div>
        </div>
        <div class="col-sm-2">

          <span class="field-validation-error text-danger" id="fileValidate"></span>

        </div>
      </div>
    }
  </div>
</div>
@section scripts{
  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      $("#ApprovalProcessId").prop("disabled", true);      
    })
    $("#saveDetails").click(function () {
      $("#ApprovalProcessId").prop("disabled", false);
      $("#form1").submit();
    })
  </script>
}
