
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Deduction Codes

      <ul class="tool-bar">
        <li><a href="/MasterDeductionCode/Create" data-toggle="tooltip" data-placement="bottom" title="Add details" data-original-title="Add Details"><i class="fa fa-plus"></i></a></li>

      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>

          <th>Code</th>
          <th>Description</th>
          <th>Type</th>
          <th></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {

  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });


    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/MasterDeductionCode/AjaxHandler",
        "aoColumns": [

						{ "sName": "Code" },
            { "sName": "Description" },
            { "sName": "Type" },
						{
						  "sName": "ID",
						  "bSearchable": false,
						  "bSortable": false,
						  "fnRender": function (oObj) {
						    var strString = '<a href="/MasterDeductionCode/Edit/' + oObj.aData[3] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';
						    strString += '&nbsp;<a href="/MasterDeductionCode/Details/' + oObj.aData[3] + '\" class="btn btn-xs btn-primary" title="Detail"><i class="fa fa-list"></i> Details</a>';
						    
						    return strString;
						  }
						}
        ]
      });
    }

    
  </script>
}
