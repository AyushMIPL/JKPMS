@model IEnumerable<App.Data.Entities.MasterRegion>

@{
    ViewBag.Title = "Index";
}

<style>
  a.disabled {
    color: gray;
    pointer-events: none;
    opacity: .8;
  }
  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
  text-align: left !important;
}
</style> 

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline headline-regionindex" >
            Region

            @*<ul class="tool-bar">
                <li><a href="/Region/Create" class="@(ViewBag.AddPermission == true ? "" : "disabled")"
                       data-placement="bottom"
                       title="Add details"
                       data-original-title="Add Details"><i class="fa fa-plus"></i>
                   </a>
                </li>

            </ul>*@
        </h4>
    </div>
    <div class="panel-body">
        <table class="table dataTable" id="tbl">
            <thead>
                <tr>

                    <th>State</th>
                    <th>Region</th>
                    <th>Status</th>
                    <th class="button-regionaction"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
@section Scripts {

    <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });

      var MasterRegionTableId = [];

    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
        "sAjaxSource": "/Region/AjaxHandler",

        "fnDrawCallback": function (setting) {
          debugger;

          MasterRegionTableId.forEach(function (item, index) {
            debugger
            if (document.getElementById("EditRegionBtn_" + item) != null && document.getElementById("EditRegionBtn_" + item) != undefined) {
              document.getElementById("EditRegionBtn_" + item).addEventListener("click", function () {
                EditRegion(item);
              });
            }
            if (document.getElementById("DetailsRegionBtn_" + item) != null && document.getElementById("DetailsRegionBtn_" + item) != undefined) {
              document.getElementById("DetailsRegionBtn_" + item).addEventListener("click", function () {
                DetailsRegion(item);
              });
            }
            if (document.getElementById("DeleteRegionBtn_" + item) != null && document.getElementById("DeleteRegionBtn_" + item) != undefined) {
              document.getElementById("DeleteRegionBtn_" + item).addEventListener("click", function () {
                del(item);
              });
            }
          });

        },


        "aoColumns": [

          { "sName": "Name" },
          { "sName": "Region" },
						{
						  "sName": "ActiveStatus",
						  "bSearchable": false,
						  "bSortable": false,
						  "fnRender": function (oObj) {
						    if (oObj.aData[2] == "False")
						      return '<span class="badge badge-danger">inactive</span>';
						    else
						      return '<span class="badge badge-success">active</span>';
						  }
						},
						{
						  "sName": "ID",
						  "bSearchable": false,
						  "bSortable": false,
              "fnRender": function (oObj) {
                var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
                var DeletePermission = ("@ViewBag.DeletePermission").toLowerCase();

                //  var strString = '<button onclick="EditRegion(\'' + oObj.aData[3] + '\');" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';
                //  strString += '&nbsp;<button onclick="DetailsRegion(\'' + oObj.aData[3] + '\');" class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';
                ///*  strString += '&nbsp;<a href="javascript:;"  onclick="javascript:del(' + oObj.aData[3] + ');" class="btn btn-xs btn-danger" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</a>';*/
                //  strString += '&nbsp;<button href="javascript:;" onclick="javascript:del(\'' + oObj.aData[3] + '\');" class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';



                var strString = '';
                //var strString = '<button id="EditRegionBtn_' + oObj.aData[3] + '" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';
                strString += '&nbsp;<button id="DetailsRegionBtn_' + oObj.aData[3] + '"  class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';
                //strString += '&nbsp;<button id="DeleteRegionBtn_' + oObj.aData[3] + '" href="javascript:;"  class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';


                MasterRegionTableId.push(oObj.aData[3]);
						    return strString;
						  }
						}
        ]
      });
      }

      /// **** Code By Himanshu Rajput *****

        function EditRegion(id) {
     window.location.href = "@Url.Action("Edit", "Region")?Id=" + id ;
}

        function DetailsRegion(id) {
     window.location.href = "@Url.Action("Details", "Region")?Id=" + id ;
}


    function del(ctrlId) {
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
    }
    function onDeleteConfirm() {
      var id = $("#hdDocumentId").val();
      var name = "RegionId";
      $.ajax({
        url: "@Url.Action("RemoveAjax", "Region")?Id=" + id + "&name=" + name,
        type: "GET",
      })
		.done(function (result) {
		  var actionRes = result;
		  if (actionRes == "0") {
		    toasterErrorMessage("There is some error, please try again.");
		    return actionRes;
		  }
		  else if (actionRes == "1") {
		    toasterSuccessMessage("Status changed sucessfully.");
		    $('#confirmDelete').popup("hide");
		    doBindData();
		  } else {
        toasterSuccessMessage("Record Deleted successfully.");
        $('#confirmDelete').popup("hide");
        doBindData();
		  }
		});
      }
      const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
      debugger
      Confirm_Delete_ClassBtn.forEach(button => {
        button.addEventListener('click', onDeleteConfirm);
      });
    </script>
}
