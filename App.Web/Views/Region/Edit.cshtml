@model App.Data.Entities.MasterRegion

@{
  ViewBag.Title = "Edit";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-regionedit">
      Update Details

      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "Region", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "IdRegion_Edit" }))
    {
      @Html.AntiForgeryToken()
      @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
      @Html.HiddenFor(model => model.Id)
      <div class="row">
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.StateId, new { @class = "col-sm-4 control Color-Red-asterisk " })
            <div class="col-sm-8">
              @Html.DropDownListFor(m => m.StateId, null, "---Select---", htmlAttributes: new { @class = "form-control", @Required = "true" })
              @Html.ValidationMessageFor(model => model.StateId, "", new { @class = "text-danger" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "col-sm-4 control Color-Red-asterisk" })
            <div class="col-sm-8">
              @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Enter Region", @Required = "true" })
              @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
            </div>
          </div>

          @*<div class="form-group">
              <label for="IsActive" class="col-sm-4 control-label">Status:</label>
              <div class="col-sm-8">
                <div class="checkbox">
                  @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
                </div>
              </div>
            </div>*@
          @*<hr>*@
          <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
              <button type="submit" id="IdRegionEdit" class="btn btn-success"><i class="fa fa-save"> </i> Update </button>
              <button type="button" class="btn btn-success px-5 height button-regioneditloader" title="Please Wait While We Process Your Request" id="btn_Region_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
              <a href="/Region/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
            </div>
          </div>
        </div>
        <div class="col-sm-2">

          <span class="field-validation-error text-danger" id="fileValidate"></span>

        </div>
      </div>
    }
  </div>
</div>
@section scripts{

  <script src="~/Scripts/Master.js"></script>
  @Scripts.Render("~/bundles/jqueryval")
  <script nonce="@ViewBag.StyleNonce">
    document.getElementById("IdRegionEdit").addEventListener("click", EditResionSubmit);
    async function EditResionSubmit() {
      $('#IdRegionEdit').hide();
      $('#btn_Region_loading').show();
      var form = $("#IdRegion_Edit");
      if (!form.valid()) {
        $('#IdRegionEdit').show();
        $('#btn_Region_loading').hide();
        return false;
      }
    }

    $(document).ready(function () {
      //$('form').submit(function () {
      //    $('#IdRegionEdit').hide();
      //    $('#btn_Region_loading').show();
      //    var form = $("#IdRegion_Edit");
      //    if (!form.valid()) {
      //        $('#IdRegionEdit').show();
      //        $('#btn_Region_loading').hide();
      //        return false;
      //    }
      //});
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdRegionEdit').show();
            $('#btn_Region_loading').hide();
        }
        $('#btn_Region_loading').hide();
    });
  </script>



  @*<script nonce="@ViewBag.StyleNonce">

        $("#IdUpdate").on('click', function () {
            $("i.fa-spinner").show();
            setTimeout(function () {
                $("i.fa-spinner").hide();
            }, 1000);
        });

    </script>*@

}

