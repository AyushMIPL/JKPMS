@model IEnumerable<App.Data.Entities.MasterPensionerType>

@{
    ViewBag.Title = "Index";
}


<style>
  a.disabled {
    color: gray;
    pointer-events: none;
    opacity: .8;
  }

  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-pensionertypeindex" >
      Pension Types
      
      <ul class="tool-bar">
        <li><a href="/PensionerType/Create" class="@(ViewBag.AddPermission == true ? "" : "disabled")"
              data-placement="bottom"
              title="Add details"
              data-original-title="Add Details"><i class="fa fa-plus"></i>
            </a>
        </li>
        
      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>

          <th>Name</th>
          <th>Status</th>
          <th class="pensionertype-action"></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {
<script src="~/Content/endless/js/jquery.dataTables.min.js"></script>
<script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });

  var PensionerTypeTableId = [];

    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/PensionerType/AjaxHandler",

        "fnDrawCallback": function (setting) {
          debugger;

          PensionerTypeTableId.forEach(function (item, index) {
            debugger
            if (document.getElementById("EditPensionerTypeBtn_" + item) != null && document.getElementById("EditPensionerTypeBtn_" + item) != undefined) {
              document.getElementById("EditPensionerTypeBtn_" + item).addEventListener("click", function () {
                EditPensionerType(item);
              });
            }
            if (document.getElementById("DetailsPensionerTypeBtn_" + item) != null && document.getElementById("DetailsPensionerTypeBtn_" + item) != undefined) {
              document.getElementById("DetailsPensionerTypeBtn_" + item).addEventListener("click", function () {
                DetailsPensionerType(item);
              });
            }
            if (document.getElementById("DeletePensionerTypeBtn_" + item) != null && document.getElementById("DeletePensionerTypeBtn_" + item) != undefined) {
              document.getElementById("DeletePensionerTypeBtn_" + item).addEventListener("click", function () {
                del(item);
              });
            }
          });

        },

        "aoColumns": [

						{ "sName": "Name" },
						{
						  "sName": "ActiveStatus",
						  "bSearchable": false,
						  "bSortable": false,
						  "fnRender": function (oObj) {
						    if (oObj.aData[1] == "False")
						      return '<span class="badge badge-danger">inactive</span>';
						    else
						      return '<span class="badge badge-success">active</span>';
						  }
						},
						{
						  "sName": "ID",
						  "bSearchable": false,
						  "bSortable": false,
              "fnRender": function (oObj) {
                var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
                var DeletePermission = ("@ViewBag.DeletePermission").toLowerCase();

                //  var strString = '<button onclick="EditPensionerType(\'' + oObj.aData[2] + '\');" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';
                //  strString += '&nbsp;<button onclick="DetailsPensionerType(\'' + oObj.aData[2] + '\');" class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';
                ///* strString += '&nbsp;<a href="javascript:;"  onclick="javascript:del(' + oObj.aData[2] + ');" class="btn btn-xs btn-danger"> <i class="fa fa-trash-o fa-lg"></i> Delete</a>';*/
                //  strString += '&nbsp;<button href="javascript:;" onclick="javascript:del(\'' + oObj.aData[2] + '\');" class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';

                var strString = '<button id="EditPensionerTypeBtn_' + oObj.aData[2] + '"  class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';
                strString += '&nbsp;<button id="DetailsPensionerTypeBtn_' + oObj.aData[2] + '"   class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';
 
                strString += '&nbsp;<button id="DeletePensionerTypeBtn_' + oObj.aData[2] + '"   class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';
                PensionerTypeTableId.push(oObj.aData[2]);
                return strString;
						  }
						}
        ]
      });
    }


    /// **** Code By Himanshu Rajput *****

    function EditPensionerType(id) {
     window.location.href = "@Url.Action("Edit", "PensionerType")?Id=" + id ;
}

    function DetailsPensionerType(id) {
     window.location.href = "@Url.Action("Details", "PensionerType")?Id=" + id ;
}

    function del(ctrlId) {
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
  }
  const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
  debugger
  Confirm_Delete_ClassBtn.forEach(button => {
    button.addEventListener('click', onDeleteConfirm);
  });
    function onDeleteConfirm() {
      var id = $("#hdDocumentId").val();
      var name = "PensionerTypeId";
      $.ajax({
        url: "@Url.Action("RemoveAjax", "PensionerType")?Id=" + id + "&name=" + name,
        type: "GET",
      })
		.done(function (result) {
		  var actionRes = result;
		  if (actionRes == "0") {
		    toasterErrorMessage("There is some error, please try again.");
		    return actionRes;
		  }
		  else if (actionRes == "1") {
		    toasterSuccessMessage("Status changed sucessfully.");
		    $('#confirmDelete').popup("hide");
		    doBindData();
		  } else {
        toasterSuccessMessage("Record deleted successfully.");
        $('#confirmDelete').popup("hide");
        doBindData();
		  }
		});
    }
</script>
}


