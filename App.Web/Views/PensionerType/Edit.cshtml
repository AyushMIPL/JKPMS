@model App.Data.Entities.MasterPensionerType

@{
    ViewBag.Title = "Edit";
}

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline headline-pensionertypeedit" >
            Update Details

            @*<ul class="tool-bar">

                </ul>*@
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Edit", "PensionerType", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "IdPensionerType_Edit" }))
        {
            @Html.AntiForgeryToken()
            @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
            @Html.HiddenFor(model => model.Id)
            <div class="row">
                <div class="col-sm-4">

                    @Html.LabelFor(model => model.Name, new { @class = "control mb-2 Color-Red-asterisk" })

                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Pensioner Type" })
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>

                @*<div class="form-group">
                      <label for="IsActive" class="col-sm-4 control-label">Status:</label>
                      <div class="col-sm-8">
                        <div class="checkbox">
                          @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
                        </div>
                      </div>
                    </div>*@
                @*<hr>*@


            <div class="col-sm-4">
                <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
                <button type="submit" id="IdPensionerTypeEdit" class="btn btn-success px-5 height"><i class="fa fa-save"> </i> Update </button>
                <button type="button" class="btn btn-success px-5 height button-pensionertypeeditloader"  title="Please Wait While We Process Your Request" id="btn_PensionerType_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                <a href="/PensionerType/Index" class="btn btn-primary height border-radius line-height"><i class="fa fa-reply"> </i> Back to List</a>
            </div>

                <div class="col-sm-2">

                    <span class="field-validation-error text-danger" id="fileValidate"></span>

                </div>
            </div>
        }
    </div>
</div>
@section scripts{

    <script src="~/Scripts/Master.js"></script>
    <script nonce="@ViewBag.StyleNonce">

    $(document).ready(function () {
      $('form').submit(function () {
          $('#IdPensionerTypeEdit').hide();
          $('#btn_PensionerType_loading').show();
          var form = $("#IdPensionerType_Edit");
          if (!form.valid()) {
              $('#IdPensionerTypeEdit').show();
              $('#btn_PensionerType_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdPensionerTypeEdit').show();
            $('#btn_PensionerType_loading').hide();
        }
        $('#btn_PensionerType_loading').hide();
    });
    </script>




    @*<script nonce="@ViewBag.StyleNonce">

            $("#IdUpdate4").on('click', function () {
                $("i.fa-spinner").show();
                setTimeout(function () {
                    $("i.fa-spinner").hide();
                }, 1000);
            });

        </script>*@

}