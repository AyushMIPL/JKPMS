@model App.Data.Entities.MasterEmployer
@{
  ViewBag.Title = "Edit";
}
<style>
  #EmployerSummary li:hover {
    background-color: rgba(204, 204, 204, 0.48);
  }

  #EmployerSummary li {
    border-bottom: 2px rgba(113, 112, 117, 0.31) solid !important;
  }
</style>
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Update Details

      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "Employers", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "form1" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      @Html.HiddenFor(model => model.Id)
      @Html.HiddenFor(model => model.OldPFRateID)
      @Html.Hidden("EId")
      <div class="row">
        <div class="col-sm-12">
          <div class="form-group">
            @Html.LabelFor(model => model.UniqueID, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.TextBoxFor(m => m.UniqueID, new { @class = "form-control input-sm", @readonly = "readonly" })
            </div>
          </div>

          @*<div class="form-group">
              @Html.Label("RetirementAge", "Retirement Age", new {@id="RetirementAge", @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.TextBox("RetirementAge", new { @id = "txtRetirementAge", @class = "form-control input-sm", placeholder = "Retirement Age", @readonly = "readonly" })
              </div>
            </div>*@
          @*@*<div class="form-group">
              @Html.LabelFor(model => model.EmployerType, new { @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.EditorFor(model => model.EmployerType, new { htmlAttributes = new { @class = "form-control" } })
              </div>
            </div>*@
          <div class="form-group">
            @Html.LabelFor(model => model.EmployerName, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.TextBoxFor(m => m.EmployerName, new { @class = "form-control input-sm txtEdit", placeholder = "Employer Name" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.EmployerTypeID, "Employer Type *", new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6" id="EType">
              @Html.DropDownList("EmployerTypeID", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.EmployerAddress, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.TextBoxFor(m => m.EmployerAddress, new { @class = "form-control input-sm txtEdit", placeholder = "Employer Address" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.CountryID, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.DropDownList("CountryID", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.CityID, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.DropDownList("CityID", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>
          @*<div class="form-group">
              @Html.LabelFor(model => model.ZipCode, new { @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.TextBoxFor(m => m.ZipCode, new { @class = "form-control input-sm", placeholder = "ZipCode" })
              </div>
            </div>*@
          <div class="form-group">
            @Html.LabelFor(model => model.POBoxNo, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.TextBoxFor(m => m.POBoxNo, new { @class = "form-control input-sm txtEdit", placeholder = "PO.Box No." })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.ContactPerson, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.TextBoxFor(m => m.ContactPerson, new { @class = "form-control input-sm txtEdit", placeholder = "Contact Person" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.Mobile, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control input-sm txtEdit", placeholder = "Mobile" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.PFRateID, "PF For *", new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.DropDownList("PFRateID", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.PFRate, new { @class = "col-sm-2 control-label" })
            <div class="col-sm-6">
              @Html.TextBoxFor(m => m.PFRate, new { @class = "form-control input-sm txtEdit", placeholder = "PF Rate", @readonly = "readonly" })
            </div>
          </div>
          @if (Model.ShowTable)
          {
            <div class="form-group">
              <label class="col-sm-2 control-label"></label>
              <div class="col-sm-10">
                <ul class="list-group collapse in" id="EmployerSummary">
                  <li class="list-group-item clearfix">
                    <table style="width:100%;margin:5px;">
                      <tr>
                        <th style="width:30%;">Pf For</th>
                        @*<th style="width:10%;">Employee Pf(%)</th>*@
                        <th style="width:10%;">PF Rate</th>
                        <th style="width:30%;">Effective Date</th>
                        <th style="width:15%;">Created On</th>
                        <th style="width:15%;">Modified On</th>
                      </tr>
                    </table>
                  </li>
                  @foreach (var List in ViewBag.ChangedPfRateList)
                  {
                    <li class="list-group-item clearfix">
                      <table style="width:100%;margin:5px;">
                        <tr>
                          <th style="width:30%;">
                            @if (List.IsApplied)
                            {
                              <i class="fa fa-check-circle text-success fa-lg" style="margin-right:5px;" title="Applied"></i>
                            }
                            @if (List.IsExpired)
                            {
                              <i class="fa fa-times-circle text-danger fa-lg" style="margin-right:5px;" title="PF Rate has been expired"></i>
                            }
                            @List.PfRateName
                          </th>
                          <th style="width:10%;">@List.PFRate</th>
                          <th style="width:30%;">@List.StringEffiectiveDate - @List.StringEffectiveEndDate</th>
                          <th style="width:15%;">@List.StringCreatedOn</th>
                          <th style="width:15%;">
                            @List.StringModifiedOn
                          </th>
                        </tr>
                      </table>
                    </li>
                  }

                </ul>
              </div>
            </div>
          }
          <div class="form-group">
            <label for="IsActive" class="col-sm-2 control-label">Status:</label>
            <div class="col-sm-6">
              <div class="checkbox">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
              </div>
            </div>
          </div>
          @*<hr>*@
          <div class="form-group">
            <label class="col-sm-2 control-label"></label>
            <div class="col-sm-6">
              <button type="submit" class="btn btn-success" id="btnEditInfo" onclick="javascript: return DoEdit();"><i class="fa fa-pencil"></i> Edit</button>
              <button type="button" class="btn btn-success" id="btnSaveInfo"><i class="fa fa-save"></i> Update</button>
              <a href="/Employers/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
            </div>
          </div>
        </div>
        <div class="col-sm-2">

          <span class="field-validation-error text-danger" id="fileValidate"></span>

        </div>
      </div>
    }
  </div>
</div>
@section scripts{
  <script src="~/Scripts/Employers.js"></script>
  <script src="~/Scripts/Master.js"></script>
  <script nonce="@ViewBag.StyleNonce">

    $(document).ready(function () {
      $('select').select2({
        placeholder: "---Select---",
        allowClear: true
      });
      DisableContrls();
    });
    $("#btnSaveInfo").click(function () {
      $("#EmployerTypeID").prop("disabled", false);
      $("#form1").submit();
    })


    //$("#EmployerTypeID").on('change', function () {
    //  var id = $("#EId").val();
    //  if (id != "") {
    //    $("#EmployerTypeID").val(id);
    //    toasterErrorMessage("This EmployerType Cant Be Changed As Alrady In Use");
    //  }
    //})


  </script>
}






