@model IEnumerable<App.Data.Entities.MasterEmployer>

@{
  ViewBag.Title = "Index";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Employers      
      <ul class="tool-bar">
        <li><a href="/Employers/Create" data-toggle="tooltip" data-placement="bottom" title="Add details" data-original-title="Add Details"><i class="fa fa-plus"></i></a></li>
      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>
          <th>ID</th>
          <th>Employer Name</th>
          <th>Employer Address</th>
          @*<th>City</th>*@
          @*<th>ZipCode</th>*@
          <th>PO.Box No.</th>
          <th>Contact Person</th>
          <th>Mobile</th>
          <th>PF Rate</th>
          <th>Effective Date</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {
  
  <script nonce="@ViewBag.StyleNonce">
    $(function () {

      debugger
      doBindData();
    });
    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        //"bProcessing": true,
        "sAjaxSource": "/Employers/AjaxHandler",
        "aoColumns": [
          { "sName": "ID" },
            { "sName": "EmployerName" },
            { "sName": "EmployerAddress" },
            //{ "sName": "City" },
            /*{ "sName": "ZipCode" },*/
            { "sName": "POBoxNo" },
            { "sName": "ContactPerson" },
            { "sName": "Mobile" },
            //{ "sName": "PFRate" },
            {
              "sName": "Pf Rate",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = "";
                strString += oObj.aData[6];
                if (oObj.aData[9] == "True")
                  strString += '<span class="fa fa-times text-danger fa-lg" title="PF Rate has been expired" style="margin-left:10px;"></span>';
                else
                  strString += '<span class="fa fa-check-circle text-success fa-lg" title="Active" style="margin-left:10px;"></span>';
                return strString;
              }
            },
            {
              "sName": "Effective Date",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = "";
                strString += oObj.aData[10] + " - " + oObj.aData[11];
                //if(oObj.aData[12]=="True")
                //  strString+='<span class="fa fa-times text-danger fa-lg" title="Expired"></span>';
                //else
                //  strString+='<span class="fa fa-check-circle text-success fa-lg" title="Active"></span>';
                return strString;
              }
            },
            {
              "sName": "ActiveStatus",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                if (oObj.aData[7] == "False")
                  return '<span class="badge badge-danger">inactive</span>';
                else
                  return '<span class="badge badge-success">active</span>';
              }
            },
            {
              "sName": "ID",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = '<a href="/Employers/Edit/' + oObj.aData[12] + '\" class="btn btn-primary btn-xs" title="Edit"><i class="fa fa-list"></i> Details</a>';
                //strString += '&nbsp;<a href="/Employers/Details/' + oObj.aData[9] + '\" class="btn btn-primary btn-xs"> Details</a>';
                //strString += '&nbsp;<a href="javascript:;" class="btn btn-danger btn-xs" onclick="javascript:del(' + oObj.aData[9] + ');"> Delete</a> ';

                return strString;
              }
            }
        ]
      });
    }

    @*function del(ctrlId) {
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
    }
    function onDeleteConfirm() {
      var id = $("#hdDocumentId").val();
      $.ajax({
        url: "@Url.Action("Remove", "Employers")?Id=" + id + "",
        type: "GET",
      })
    .done(function (result) {
      var actionRes = result;
      if (actionRes == "0") {
        toasterErrorMessage("There is some error, please try again.");
        return actionRes;
      }
      else {
        toasterSuccessMessage("Status changed sucessfully.");
        $('#confirmDelete').popup("hide");
        doBindData();
      }
    });
    }*@
  </script>
}
