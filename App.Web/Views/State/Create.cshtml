@model App.Data.Entities.MasterState

@{
    ViewBag.Title = "Create";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline headline-statecreate" >
            Add Details
             
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Create", "State", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "IdCreate_State" }))
        {
            @Html.AntiForgeryToken()
            @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.CountryId, new { @class = "col-sm-4 control Color-Red-asterisk" })
                        <div class="col-sm-8">
                            @Html.DropDownListFor(model => model.CountryId, null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })
                            @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Name, new { @class = "col-sm-4 control Color-Red-asterisk" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "State" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>


                    @*<div class="form-group">
                          <label for="IsActive" class="col-sm-4 control-label">Status:</label>
                          <div class="col-sm-8">
                            <div class="checkbox">
                              @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
                            </div>
                          </div>
                        </div>*@


                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <button type="submit" id="IdCreateState" class="btn btn-success"><i class="fa fa-save"> </i> Create</button>
                            <button type="button" class="btn btn-success px-5 height button-statecreate"  title="Please Wait While We Process Your Request" id="btn_CreateState_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                            <a href="/State/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>

                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>
@section scripts{

    <script src="~/Scripts/Master.js"></script>
    <script nonce="@ViewBag.StyleNonce">

    $(document).ready(function () {
      $('form').submit(function () {
          $('#IdCreateState').hide();
          $('#btn_CreateState_loading').show();
          var form = $("#IdCreate_State");
          if (!form.valid()) {
              $('#IdCreateState').show();
              $('#btn_CreateState_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdCreateState').show();
            $('#btn_CreateState_loading').hide();
        }
        $('#btn_CreateState_loading').hide();
    });
    </script>




    @*<script nonce="@ViewBag.StyleNonce">
            $("#IdCreate").on('click', function () {
                $("i.fa-spinner").show();
                setTimeout(function () {
                    $("i.fa-spinner").hide();
                }, 1000);
            });
        </script>*@
}

