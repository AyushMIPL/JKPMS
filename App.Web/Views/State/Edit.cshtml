@model App.Data.Entities.MasterState

@{
  ViewBag.Title = "Edit";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-ststeedit">
      Update Details

      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "State", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "EditState" }))
    {
      @Html.AntiForgeryToken()
      @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
      @Html.HiddenFor(model => model.Id)
      <div class="row">
        <div class="col-sm-4">



          @Html.LabelFor(model => model.CountryId, new { @class = " control mb-2 Color-Red-asterisk" })
          @Html.DropDownListFor(model => model.CountryId, null, "---Select---", htmlAttributes: new { @class = "form-control", @Required = "true" })
          @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
        </div>



        <div class="col-sm-4">
          @Html.LabelFor(model => model.Name, new { @class = "control mb-2 Color-Red-asterisk" })
          @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Enter State", @Required = "true" })
          @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>


        @*<div class="form-group">
            <label for="IsActive" class="col-sm-4 control-label">Status:</label>
            <div class="col-sm-8">
              <div class="checkbox">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
              </div>
            </div>
          </div>*@
        @*<hr>*@


        <div class="col-sm-4">
          <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
          <button type="submit" id="IdUpdateState" class="btn btn-success px-5 height"><i class="fa fa-save"> </i> Update </button>
          <button type="button" class="btn btn-success px-5 height button-statecreate" title="Please Wait While We Process Your Request" id="btn_EditState_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
          <a href="/State/Index" class="btn btn-primary height border-radius"><i class="fa fa-reply"> </i> Back to List</a>

        </div>

      </div>
      <div class="col-sm-2">

        <span class="field-validation-error text-danger" id="fileValidate"></span>

      </div>

    }
  </div>
</div>
@section scripts{

  <script src="~/Scripts/Master.js"></script>
  @Scripts.Render("~/bundles/jqueryval")
  <script nonce="@ViewBag.StyleNonce">

    document.getElementById("IdUpdateState").addEventListener("click", EditStateSubmit);
    async function EditStateSubmit() {
      $('#IdUpdateState').hide();
      $('#btn_EditState_loading').show();
      var form = $("#EditState");
      if (!form.valid()) {
        $('#IdUpdateState').show();
        $('#btn_EditState_loading').hide();
        return false;
      }
    }


      $(document).ready(function () {
      //$('form').submit(function () {
      //    $('#IdUpdateState').hide();
      //    $('#btn_EditState_loading').show();
      //    var form = $("#EditState");
      //    if (!form.valid()) {
      //        $('#IdUpdateState').show();
      //        $('#btn_EditState_loading').hide();
      //        return false;
      //    }
      //});
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdUpdateState').show();
            $('#btn_EditState_loading').hide();
        }
        $('#btn_EditState_loading').hide();
    });
  </script>





