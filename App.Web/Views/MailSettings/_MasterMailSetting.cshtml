@model App.Data.Entities.MailSettings
<style>
  .dropdownRadius{
    border-radius:20px!important;
  }
</style>
@using (Html.BeginForm("Create", "MailSettings", FormMethod.Post, new { role = "form", Id = "MasterBankForm" }))
{
  @Html.AntiForgeryToken()
  <div class="modal-body">
    <div class="form-horizontal">
      @Html.ValidationSummary(true, "", new { @class = "text-danger" })
      <div class="row">
        <div class="col-md-12">
          @Html.HiddenFor(model => model.Id, new { id = "modelid", @Value = Model.Id })

          @Html.HiddenFor(model => model.CreatedBy)
          @Html.HiddenFor(model => model.CreatedOn)
          @Html.HiddenFor(model => model.IsActive)
          <div class="form-group row">

            @Html.LabelFor(model => model.ProcessName, htmlAttributes: new { @class = "control col-md-4 Color-Red-asterisk" })
            <div class="col-md-8 form-group">
              @if (Model.Id == 0)
              {
                @Html.EditorFor(model => model.ProcessName, new { htmlAttributes = new { @class = "form-control" } })
              }
              else
              {
                @Html.EditorFor(model => model.ProcessName, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
              }
              @Html.ValidationMessageFor(model => model.ProcessName, "", new { @class = "text-danger" })
            </div>

            @Html.LabelFor(model => model.Priority, htmlAttributes: new { @class = "control col-md-4 Color-Red-asterisk" })
            <div class="col-md-8 form-group">
              @Html.DropDownListFor(model => model.Priority, null, new { @class = "form-control dropdownRadius" })
              @Html.ValidationMessageFor(model => model.Priority, "", new { @class = "text-danger" })
            </div>

            @Html.LabelFor(model => model.MailTo, htmlAttributes: new { @class = "control col-md-4 Color-Red-asterisk" })
            <div class="col-md-8 form-group">
              @Html.TextAreaFor(model => model.MailTo, new { @class = "form-control" })
              @Html.ValidationMessageFor(model => model.MailTo, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.CC, htmlAttributes: new { @class = "control col-md-4" })
            <div class="col-md-8 form-group">
              @Html.TextAreaFor(model => model.CC, new { @class = "form-control" })
              @Html.ValidationMessageFor(model => model.CC, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.BCC, htmlAttributes: new { @class = "control col-md-4" })
            <div class="col-md-8 form-group">
              @Html.TextAreaFor(model => model.BCC, new { @class = "form-control" })
              @Html.ValidationMessageFor(model => model.BCC, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.Subject, htmlAttributes: new { @class = "control col-md-4" })
            <div class="col-md-8 form-group">
              @Html.EditorFor(model => model.Subject, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.Subject, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.Contents, htmlAttributes: new { @class = "control col-md-4" })
            <div class="col-md-8 form-group">
              @Html.EditorFor(model => model.Contents, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.Contents, "", new { @class = "text-danger" })
            </div>

            <div class="col-md-4"></div>
            <div class="col-md-8 form-group text-left">
              <div class="checkbox">
                @Html.EditorFor(model => model.IsSendNotificationAlert, new { htmlAttributes = new { @class = "" } })
                @Html.LabelFor(model => model.IsSendNotificationAlert, htmlAttributes: new { @class = "control" })
                @Html.ValidationMessageFor(model => model.IsSendNotificationAlert, "", new { @class = "text-danger" })
              </div>
            </div>

            <div class="col-md-4"></div>
            <div class="col-md-8 form-group text-left">
              <div class="checkbox">
                @Html.EditorFor(model => model.IsInstantMailing, new { htmlAttributes = new { @class = "" } })
                @Html.LabelFor(model => model.IsInstantMailing, htmlAttributes: new { @class = "control" })
                @Html.ValidationMessageFor(model => model.IsInstantMailing, "", new { @class = "text-danger" })
              </div>
            </div>
            @Html.LabelFor(model => model.ProcessWillStartAt, htmlAttributes: new { @class = "control col-md-4" })
            <div class="col-md-8 form-group">
              @Html.TextBoxFor(model => model.ProcessWillStartAt, new { @class = "form-control", @type = "date" } )
              @Html.ValidationMessageFor(model => model.ProcessWillStartAt, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.DelayTime, htmlAttributes: new { @class = "control col-md-4 Color-Red-asterisk" })
            <div class="col-md-8 form-group">
              @Html.EditorFor(model => model.DelayTime, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.DelayTime, "", new { @class = "text-danger" })
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
}
<script src="/Scripts/jquery.validate.js" type="text/javascript"></script>
<script src="/Scripts/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script nonce="@ViewBag.StyleNonce">
  $(document).ready(function () {
    $("label:contains('*')").each(function () {
      $(this).html($(this).html().replace("*", "<span style='color:red'>*</span>"));
    })
  });

