@section Scripts {
  @Scripts.Render("~/bundles/jqueryval")
  <script nonce="@ViewBag.StyleNonce">
      function ClosePopupWindow() {
        $("#modal-formPopUp").popup("hide");
      }
    $(function () {
      doBindData();
    });

      document.getElementById("model_formPopUp_MailSetting").addEventListener("click", ClosePopupWindow);
      document.getElementById("model_formPopUp_MailSetting1").addEventListener("click", ClosePopupWindow);

      document.getElementById("AddButton_MailSetting").addEventListener("click", AddForm);


      var MailSettingTableId = [];

    function doBindData() {
      var oTable = $('#MailSettingstbl').dataTable({
    "bJQueryUI": true,
    "sPaginationType": "full_numbers",
    "bServerSide": true,
    "bDestroy": true,
    "bAutoWidth": false,
        "sAjaxSource": "@Url.Action("MailSettingListAjax", "MailSettings")",

        "fnDrawCallback": function (setting) {
          debugger;

          MailSettingTableId.forEach(function (item, index) {
            debugger
            var id = item.split('~')[0];
            var status = item.split('~')[1];

            if (document.getElementById("EditFormBtn_" + item) != null || document.getElementById("EditFormBtn_" + item) != undefined) {
              document.getElementById("EditFormBtn_" + item).addEventListener("click", function () {
                EditForm(id);
              });
            }
            if (status == "True") {
              if (document.getElementById("ChangeMailConfirmBtn_" + item) != null || document.getElementById("ChangeMailConfirmBtn_" + item) != undefined) {
                document.getElementById("ChangeMailConfirmBtn_" + item).addEventListener("click", function () {
                  ChangeConfirm(id);
                });
              }
            }
            else {
              if (document.getElementById("ChangeConfirmBtn_" + item) != null || document.getElementById("ChangeConfirmBtn_" + item) != undefined) {
                document.getElementById("ChangeConfirmBtn_" + item).addEventListener("click", function () {
                  ChangeConfirm(id);
                });
              }
            }
          });

        },

    "aoColumns": [

          { "sName": "ProcessName" },
          //{ "sName": "MailTo" },
          //{ "sName": "CC" },
          //{ "sName": "BCC" },
          {
            "sName": "MailTo",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {
              var strString = '';
              strString += 'TO <i class="fa fa-envelope" aria-hidden="true"></i> : ' + full[1].split(",").join("<br/>");

              if (full[2] == null || full[2] == '') strString += full[2];
              else strString += '<br/>CC <i class="fa fa-envelope" aria-hidden="true"></i> : ' + full[2].split(",").join("<br/>");

              if (full[3] == null || full[3] == '') strString += full[3];
              else strString += '<br/>BCC <i class="fa fa-envelope" aria-hidden="true"></i> : ' + full[3].split(",").join("<br/>");
              return strString;
            }
          },
          //{
          //  "sName": "CC",
          //  "bSearchable": false,
          //  "bSortable": false,
          //  "render": function (data, type, full, meta) {
          //    var strString = '';
          //    if (full[2] == null || full[2] == '') strString += full[2];
          //    else strString += '<br/>CC: <i class="fa fa-envelope" aria-hidden="true"></i>' + full[2].split(",").join("\n");
          //    return strString;
          //  }
          //},
          //{
          //  "sName": "BCC",
          //  "bSearchable": false,
          //  "bSortable": false,
          //  "render": function (data, type, full, meta) {
          //    var strString = '';
          //    if (full[3] == null || full[3] == '') strString += full[3];
          //    else strString += '<br/>BCC: <i class="fa fa-envelope" aria-hidden="true"></i>' + full[3].split(",").join("\n");
          //    return strString;
          //  }
          //},
          {
            "sName": "Subject",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {
              var strString = '';
              strString += full[4];
              return strString;
            }
          },
          {
            "sName": "Contents",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {
              var strString = '';
              strString += full[5];
              return strString;
            }
          },
          //{ "sName": "IsSendNotificationAlert" },
          {
            "sName": "IsSendNotificationAlert",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {

              var strString = '';
              if (full[6] == 'True') strString += '<i class="fa fa-check text-success" aria-hidden="true"></i>' //+ full[6];
              else strString += '<i class="fa fa-times-circle text-danger"></i>' //+ full[6];
              return strString;
            }
          },
          {
            "sName": "ProcessWillStartAt",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {
              var strString = '';
              strString += full[7];
              return strString;
            }
          },
          {
            "sName": "DelayTime",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {
              var strString = '';
              strString += full[8];
              return strString;
            }
          },
          {
            "sName": "Instant Mail",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {
              var strString = '';
              if (full[11] == 'True')
                strString += '<i class="fa fa-check text-success" aria-hidden="true"></i>'; //'<input type="checkbox" onclick="return this.checked = !this.checked;" checked/>';
              else
                strString += '<i class="fa fa-times-circle text-danger"></i>'; //'<input type="checkbox" onclick="return this.checked = !this.checked;"/>'
              return strString;
            }
          },
          {
            "sName": "Action",
            "bSearchable": false,
            "bSortable": false,
            "mRender": function (data, type, full, meta) {
              var strString = '';
              var msg = '';
              var d = full[10] + "~" + full[9];
              strString += '<a  id="EditFormBtn_' + d + '" class="btn btn-info btn-xs progressbtn" title="Edit" ><i class="fa fa-pencil"></i> Edit </a>';
              if (full[9] == "True") {
                msg = "Do you want to de-activate this record..?";
                strString += '&nbsp;<a id="ChangeMailConfirmBtn_' + d+'"  class="btn btn-xs btn-success" title="Active">Active</a>';
              }
              else {
                msg = "Do you want to activate this record..?";
                strString += '&nbsp;<a id="ChangeConfirmBtn_' + d + '"  class="btn btn-xs btn-danger" title="Active">In Active</a>';
              }
              MailSettingTableId.push(d);

              return strString;
            }
          },
        ]
  });
}

  document.getElementById("ChangeStatus").addEventListener("click", function () {
      ChangeStatus();
    })
    function ChangeStatus() {
      var id = $("#ApproveId").val();
      $.ajax({
        url: "@Url.Action("DeleteAjax", "MailSettings")?Id=" + id,
        success: function (result) {
          //if (result == "1") {
          //  toasterSuccessMessage("Status Changed Successfully");
          //  $("#MailSettingstbl").dataTable().fnDraw();
          //}
          //else {
          //  toasterErrorMessage("No Data Found");
          //}
          $('.confirmClass').popup('hide');
          toasterSuccessMessage("Status Changed Successfully");
          $("#MailSettingstbl").dataTable().fnDraw();
        }
      });
    }
    function EditForm(id) {
      $("#formPopUpDiv").html('');
      $.ajax({
        url: "@Url.Action("EditAjax", "MailSettings")?Id=" + id,
        success: function (result) {
          $("#formPopUpDiv").html(result);
          $("#modal-formPopUp").popup("show");
        }
      });
    }
    function AddForm() {
      $("#formPopUpDiv").html('');
      $.ajax({
        url: "@Url.Action("CreateAjax", "MailSettings")",
        success: function (result) {
          $("#formPopUpDiv").html(result);
          $("#modal-formPopUp").popup("show");
        }
      });
    }

    function ChangeConfirm(Id, msg) {
      $("#ApproveId").val(Id);
      $("#Layout_Header").html(msg);
      $("#modal-Approve").popup("show");
    }


 document.getElementById("MasterbankForm-submit").addEventListener("click", Sendmail);
 function Sendmail () {
       debugger 
   var form = $('#MasterBankForm');
   //$.validator.unobtrusive.parse(form);
   if (!form.valid()) {
      return;
    }
    var formData = form.serialize();
    $("#btn_submit").hide();
    $("#btn_loading").show();
    var modelID = $("#modelid").val();

    if (modelID == 0)
    {
      $.ajax({
        url: "@Url.Action("CreateAjax", "MailSettings")",
        type: 'POST',
        data: formData,//JSON.stringify(formData),
        //dataType: 'json',
        //contentType: 'Application/json',
        //processData: false,
        success: function (res) {
          debugger
          $("#btn_submit").show();
          $("#btn_loading").hide();
          if (res.status) {
            toasterSuccessMessage(res.msg);
            $("#modal-formPopUp").popup("hide");
            $("#MailSettingstbl").dataTable().fnDraw();
          }
          else {
            toasterErrorMessage(res.msg);
          }
        }
      });
    }
    else{
      $.ajax({
        url: "@Url.Action("Edit", "MailSettings")",
        type: 'POST',
        data: formData,//JSON.stringify(formData),
        //dataType: 'json',
        //contentType: 'Application/json',
        //processData: false,
        success: function (res) {
          $("#btn_submit").show();
          $("#btn_loading").hide();
          if (res.status) {
            toasterSuccessMessage(res.msg);
            $("#modal-formPopUp").popup("hide");
            $("#MailSettingstbl").dataTable().fnDraw();
          }
          else {
            toasterErrorMessage(res.msg);
          }
        }
      });
    }
    }


