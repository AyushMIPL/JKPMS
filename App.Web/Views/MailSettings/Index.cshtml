@model IEnumerable<App.Data.Entities.MailSettings>

@{
  ViewBag.Title = "Mail Settings";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headlineMonthlyPensionSummary">
      Mail Settings

      <ul class="tool-bar">
        <li>
          <a id="AddButton_MailSetting" class="btn btn_table progressbtn"
             data-placement="bottom"
             title="Add details"
             data-original-title="Add Details">
            <i class="fa fa-plus"></i>
          </a>
        </li>
      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <div class="table-responsive height">
      <table class="table dataTable" id="MailSettingstbl">
        <thead>
          <tr>
            <th>Process Name</th>
            <th>Mail To</th>
            @*<th>CC</th>
              <th>BCC</th>*@
            <th>Subject</th>
            <th>Contents</th>
            <th>Is Send Notification Alert</th>
            <th>Process Will Start At</th>
            @* <th>Process Will Start AtStr</th>*@
            <th>Delay Time</th>
            <th>Is Instant Mail</th>
            <th class="MailSettingstbl-thclass">Action</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<div class="custom-popup confirmClass confirmClass-MailSetting p-0" data-keyboard="false" data-backdrop="static" id="modal-formPopUp">
  <div>
    <h3 class="m-top-none py-3 text-white MHeader-MailSetting" id="MHeader">
      <i class="fa fa-check-circle"></i> Mail Settings
      <button id="model_formPopUp_MailSetting" type="button" class="close close-Mheader-MailSetting MPSClose" title="Close" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </h3>
    <!-- Header Section -->
    <div class="row formPopUpDiv-MailSetting">
      <div id="formPopUpDiv"></div>
    </div>
  </div>
  <div class="modal-footer">
    <div class="col-md-12 text-right" id="btn_submit">
      <button id="MasterbankForm-submit" title="Save" class="btn btn-success"><i class="fa fa-save"></i> Save</button>
      <a id="model_formPopUp_MailSetting1" class="btn btn-danger" title="Cancel"><i class="fa fa-remove"></i>&nbsp; Cancel</a>
    </div>
    <div class="col-md-12 text-right display-none" id="btn_loading">
      <button type="button" class="btn btn_table animated" title="Please Wait While We Process Your Request"><i class="fa fa-spinner fa-spin"></i> Processing</button>
    </div>
  </div>
</div>
