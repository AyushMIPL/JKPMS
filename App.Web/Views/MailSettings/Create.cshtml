@model App.Data.Entities.MailSettings

@{
  ViewBag.Title = "Create";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
  <div class="card-header head_bg">
    <p>Add Mail Settings</p>
  </div>
  <div class="card-block">
    @using (Html.BeginForm())
    {
      @Html.AntiForgeryToken()

      <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">
          <div class="col-md-6 row">
            @Html.LabelFor(model => model.ProcessName, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.ProcessName, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.ProcessName, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.MailTo, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.MailTo, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.MailTo, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.CC, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.CC, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.CC, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.BCC, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.BCC, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.BCC, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.Subject, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.Subject, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.Subject, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.Contents, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.Contents, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.Contents, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.IsSendNotificationAlert, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              <div class="checkbox">
                @Html.EditorFor(model => model.IsSendNotificationAlert)
                @Html.ValidationMessageFor(model => model.IsSendNotificationAlert, "", new { @class = "text-danger" })
              </div>
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.ProcessWillStartAt, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.ProcessWillStartAt, new { htmlAttributes = new { @class = "form-control" } })
              @Html.ValidationMessageFor(model => model.ProcessWillStartAt, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-6 row">
            @Html.LabelFor(model => model.DelayTime, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              @Html.EditorFor(model => model.DelayTime, new { htmlAttributes = new { @class = "form-control decimal-text" } })
              @Html.ValidationMessageFor(model => model.DelayTime, "", new { @class = "text-danger" })
            </div>
          </div>

          @*<div class="col-md-6 row">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
              <div class="checkbox">
                @Html.EditorFor(model => model.IsActive)
                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
              </div>
            </div>
          </div>*@
          <div class="col-md-12 text-right">
            <button type="submit" title="Create" class="btn btn-primary"><i class="fa fa-save"></i> Create</button>
            <a class="btn btn-danger" title="Cancel" href="@Url.Action("Index", "MailSettings")"><i class="fa fa-remove"></i>&nbsp; Cancel</a>
          </div>
        </div>
      </div>
    }
  </div>
</div>
@*<div>
    @Html.ActionLink("Back to List", "Index")
  </div>*@
