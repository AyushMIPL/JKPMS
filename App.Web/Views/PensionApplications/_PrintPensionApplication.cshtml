@model App.Data.Entities.PensionApplications
@using App.Web.Helper
@{
  ViewBag.Title = "Details";
  Layout = null;
}
@Html.HiddenFor(m => m.BenefitTypes)

<!DOCTYPE html>
<html lang="en">
<head>

  <title>Html</title>
</head>
<body style="max-width:615px;max-height:960px;font-size:11px;">
  <div class="row">
    @*<div>
      <img src="~/Images/JKPSLogo.jpg" />
    </div>*@
    @*<div>
      <div style="text-align:center;"><img src="~/Images/JKPSLogo.jpg" /></div>
      <div style="text-align:center;font-weight:bold;text-decoration:underline;">PUBLIC SERVICE PENSION FUND</div>
      <div style="text-align:center;">APPLICATION FOR PENSIONS AND OTHER RETIRING ALLOWANCES</div>
      <div style="text-align:center;">(For Officers whose pension payable exceeds 2/3 of their pensionable emoluments)</div>
      <div style="text-align:center;">(to be typed/Written in 4-copies)</div>
    </div>*@
  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 10px; margin-top: 10px; color: #500050">
    <div style="display:inline-block;width:5%;">1.</div>
    <div style="display:inline-block;width:20%;">Name of Officer</div>
    <div style="width:72%;display:inline-block;border-bottom:1px solid black;float: right;"><b>@ViewBag.Name</b></div>
  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 10px; margin-top: 10px; color: #500050">
    <div style="display:inline-block;width:5%;">2.</div>
    <div style="display:inline-block;width:20%;">Post</div>
    <div style="width:72%;display:inline-block;border-bottom:1px solid black;float: right;"><b>@Model.Designation.Name</b></div>
  </div>

  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; color: #500050">
    <div style="display:inline-block;width:5%">3.</div><div style="display:inline-block;width:30%">Status of Post</div>
    <div style="width:62%;display:inline-block;float: right;">@Html.CheckBoxFor(model => model.PensionableStatus, new { @disabled = "disabled" })Pensionable</div>
  </div>

  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 50px; color: #500050">
    <div style="display:inline-block;width:5%">4.</div><div style="display:inline-block;width:30%">Type of benifit requested</div>
    <div style="width:62%;display:inline-block;float: right;"><input type="checkbox"> Pension</div>
    <div style="width:62%;display:inline-block;float: right;"><input type="checkbox"> Gratuity Reduced Pension</div>
    <div style="width:62%;display:inline-block;float: right;"><input type="checkbox"> Discounted gratuity Reduced Pension</div>
  </div>

  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; clear: both; color: #500050">
    <div style="display:inline-block;width:5%">5.</div><div style="display:inline-block;width:20%;">Leave Due</div>
    <div style="width:76%;display:inline-block;border-bottom:1px solid black;float: right;"><b>@Model.LeaveDue</b></div>
  </div>

  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; clear: both; color: #500050">
    <div style="display:inline-block;width:5%">6.</div>
    <div style="display:inline-block;width:28%;">(a)Date of Retirement/Resignation</div>
    <div style="width:22%;display:inline-block;border-bottom:1px solid black;"><b>@Html.FormatDate(Model.RetirementOrResignationDate)</b></div>
    <div style="display:inline-block;width:18%;">(b)Date of Birth</div>
    <div style="display:inline-block;border-bottom:1px solid black;float: right;width:25%;"><b>@Html.FormatDate(Model.DOB)</b></div>
  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; clear: both; color: #500050">
    <div style="display:inline-block;width:5%">7.</div>
    <div style="display:inline-block;width:28%;">(a) Date of first Appointment</div>
    <div style="width:15%;display:inline-block;border-bottom:1px solid black;"><b>@Html.FormatDate(Model.DateofAppointment1st)</b></div>
    <div style="display:inline-block;width:25%;">(b) Date of Last Appointment</div>
    <div style="display:inline-block;border-bottom:1px solid black;float: right;width:25%;"><b>@Html.FormatDate(Model.RetirementOrResignationDate)</b></div>

  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; color: #500050">
    <div style="display:inline-block;width:5%">8.</div><div style="display:inline-block;">Length Of Qualifying Service in Months(to Dec 31,2003)</div>
    <div style="width:50%;display:inline-block;border-bottom:1px solid black;float: right;"><b>@Model.LengthOfQualifyingServiceInMonthsTo31Dec2003</b></div>
  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; color: #500050">
    <div style="display:inline-block;width:5%">9.</div><div style="display:inline-block;">Length Of Qualifying Service in Months(from Jan 1,2004)</div>
    <div style="width:50%;display:inline-block;border-bottom:1px solid black;float: right;"><b>@Model.LengthOfQualifyingServiceInMonthsFrom1Jan2014</b></div>
  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; clear: both; color: #500050">
    <div style="display:inline-block;width:4%">10.</div>

    <div style="width:93%;display:inline-block;vertical-align:top;">If Length of Qualifying Service is longer or Shorter than Period between date of first appointment and date of retirement.State Why? <u><b>@Model.LongerShorterReason</b></u></div>
    @*<div style="width:95%;display:inline-block;border-bottom:1px solid black;float:right;"></div>*@
  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; clear: both; color: #500050">
    <div style="display:inline-block;width:5%;float:left;">11.</div>
    <div style="width:95%;display:inline-block;vertical-align:top;float:left;">(a)  Salary P.A/Salary P.A plus resposibility/inducement allowance at date of retirement,if in post longer than 3 Years <u><b>EC$ @Html.FormatSeparator(Model.RetirementAnnualSalary1)</b></u></div>
    @*<div style="display:inline-block;border-bottom:1px solid black;float:right;"></div>*@
  </div>
  <div style="word-wrap: break-word; margin: 0px auto; margin-bottom: 15px; clear: both; color: #500050">
    <div style="display:inline-block;width:5%"></div>

    <div style="display:inline-block;width:93%; vertical-align:top;">(b)  Average Salary P.A/Salary P.A plus resposibility/inducement allowance over past three (3) years at date of retirement,if in post less than three (3) Years <u><b>EC$ @Html.FormatSeparator(Model.RetirementAnnualSalary2)</b></u></div>
    @*<div style="display:inline-block;border-bottom:1px solid black;">EC$ @Model.RetirementAnnualSalary2</div>*@
  </div>
  @*<div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;clear:both">
    <div style="display:inline-block;width:5%;float:left;">&nbsp;</div>
    <div style="display:inline-block;width:15%;float:left;">Submitted By</div>
    <div style="width:30%;display:inline-block;border-bottom:1px solid black;">&nbsp;<b>@Model.ApplicationSubmittedBy</b></div>
    <div style="display:inline-block;width:10%;">Noted By</div>
    <div style="width:38%;display:inline-block;border-bottom:1px solid black;float:right;">&nbsp;<b>@ViewBag.NotedBy</b></div>
    <div style="display:inline-block;text-align:right;margin-top:0px;font-size:11px;width:49%;clear: both;color:#6D6D6D;">signature of Applying Officer</div>
    <div style="display:inline-block;text-align:right;margin-top:-7px;font-size:11px;width:49%;clear: both;color:#6D6D6D;">signature of Department Officer</div>
  </div>

  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%"></div>
    <div style="display:inline-block;width:30%;">Items 2 to 11 (b) verified</div>
    <div style="width:63%;display:inline-block;border-bottom:1px solid black;float: right;">&nbsp;<b>@ViewBag.Itemsverified</b></div>
    <div style="margin-top:-3px;font-size:11px;width:99%;clear: both;color:#6D6D6D;float:right;text-align:right;">signature of Human Resource Officer</div>

  </div>*@

  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%;">12.</div>
    <div style="display:inline-block;width:14%;">Full Pension</div>
    <div style="display:inline-block;margin-top:-8px;font-size:11px;width:32%;border-bottom:1px solid black;">Length of PEnsionable service(Months)</div>
    @*<div style="text-align:right;margin-top:1px;font-size:11px;width:20px;margin-left:175px">600</div>*@
    <div style="display:inline-block;width:5%;text-align:center;">X</div>
    <div style="display:inline-block;text-align:center;font-size:11px;width:21%;margin-top:5px;vertical-align: -webkit-baseline-middle;"><b>EC$</b><br /> Average Salary or Salary at the date of Retirement or Salary Plus responsibility/induced allowance</div>
    <div style="width:19%;display:inline-block;border-bottom:1px solid black;float: right;margin-top:25px;vertical-align: -webkit-baseline-middle;"><b>EC$ @Model.FullpensionAmount1</b></div>
    <div style="text-align:right;margin-top: -26px;font-size:11px;width: 37%;vertical-align: initial;">600</div>
  </div>
  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%;">13.</div>
    <div style="display:inline-block;width:14%;">Full Pension</div>
    <div style="display:inline-block;margin-top:-8px;font-size:11px;width:32%;border-bottom:1px solid black;">Length of PEnsionable service(Months)</div>
    <div style="display:inline-block;width:5%;text-align:center;">X</div>
    <div style="display:inline-block;text-align:center;font-size:11px;width:21%;margin-top:0px;vertical-align: -webkit-baseline-middle;"><b>EC$</b><br /> Average Salary or Salary at the date of Retirement or Salary Plus responsibility/induced allowance</div>
    <div style="width:19%;display:inline-block;border-bottom:1px solid black;float: right;margin-top:22px;vertical-align: -webkit-baseline-middle;"><b>EC$ @Model.FullpensionAmount2</b></div>
    <div style="text-align:right;margin-top: -26px;font-size:11px;width: 37%;vertical-align: initial;">960</div>
  </div>

  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%">14.</div>
    <div style="display:inline-block;width:93%;">Total Full Pension which exceeds maximum allowed(12 plus 13) <u><b>EC$ @Html.FormatSeparator(Model.TotalFullpension)</b></u></div>
    @*<div style="width:55%;display:inline-block;border-bottom:1px solid black;float: right;">EC$ @Model.TotalFullpension</div>*@
  </div>

  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%">15.</div>
    <div style="display:inline-block;width:93%;">Maximum Full Pension Allowed <u>EC$ @Model.MaxPension</u></div>
    @*<div style="width:75%;display:inline-block;border-bottom:1px solid black;float: right;">EC$ @Model.MaxPension</div>*@
  </div>
  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%">16.</div>
    <div style="display:inline-block;width:93%;">Gratuity Reduced Pension Gratuity payable(1/4 x Pension Payable x 12.5) <u><b>EC$ @Html.FormatSeparator(Convert.ToDecimal(Model.Gratuity))</b></u></div>
    @*<div style="width:48%;display:inline-block;border-bottom:1px solid black;float: right;">EC$ @Model.Gratuity</div>*@
  </div>
  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:25%">&nbsp;</div>
    <div style="display:inline-block;width:72%;">Reduced Pension P.A(3/4 x Pension Payable) P.A <u><b>EC$ @Html.FormatSeparator(Convert.ToDecimal(Model.ReducedPension))</b></u></div>
    @*<div style="width:64%;display:inline-block;border-bottom:1px solid black;float: right;">EC$ @Model.ReducedPension</div>*@
  </div>
  @*<div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%"></div>
    <div style="display:inline-block;width:55%;">Items 14,15 and 16 Certified for Payment</div>
    <div style="width:38%;display:inline-block;border-bottom:1px solid black;float: right;">&nbsp;<b>@ViewBag.ItemsPayment</b></div>
    <div style="text-align:right;margin-top:-3px;font-size:11px;width:99%;clear: both;color:#6D6D6D;">signature of Accountant,JKPS</div>

  </div>
  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="display:inline-block;width:5%"></div>
    <div style="display:inline-block;;width:15%">Audited By</div>
    <div style="width:76%;display:inline-block;border-bottom:1px solid black;float: right;">&nbsp;<b>@ViewBag.AuditedBy</b></div>
    <div style="text-align:right;margin-top:-3px;font-size:11px;width:98%;clear: both;color:#6D6D6D;">signature of Internal Auditor/Treasury</div>
  </div>
  <div style="word-wrap: break-word;margin:0px auto;margin-bottom: 15px;">
    <div style="width:100%;display:inline-block;float: right;text-align:justify;font-size:smaller;">Note. This Form must be signed by the applicant and Department Head, and then submitted to the Public Service Pension Fund office for Final Processing.After the application has been verified and certified,the original goes to the applicant, 1 copy to the departmental file, 1 copy to the Audit file and 1 copy to the Administrator , Public Service Pension Fund.</div>
  </div>*@
</body>
</html>


