<div class="panel-body" id="detailsDependant" style="display:none">
    <table class="table dataTable" id="DeathSurvivor">
        <thead>
            <tr>
                <th>Name</th>
                <th>RelationShip</th>
                <th>Age</th>
                <th>Pension Amount</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
@section Scripts{
    <script nonce="@ViewBag.StyleNonce">
        if ($("#DeathInjuryNormal").val() == "D") {
            $("#detailsDependant").show();
            deathbind();
        }

        $(document).ajaxStart(function () {
            $(".btndisable").prop('disabled', true);
        }).ajaxStop(function () {
            $(".btndisable").prop('disabled', false);
        });

        $('#PensionableStatus').prop('disabled', true)

        $('.form-control').prop('disabled', true);
        function Result(Rs) {
            var dstatus = $("#DeathInjuryNormal").val();
            var id = $("#Id").val();
            var notes = $("#Notes").val();
            if (notes != "") {
                $.ajax({
                    url: "@Url.Action("AcceptedAjax", "MasterPensioner")?Result=" + Rs + "&Id=" + parseInt(id) + "&Notes=" + notes + "&dstatus=" + dstatus,
                    type: "GET",
                }).done(function (result) {
                    if (result == 1) {
                        window.location.href = '/MasterPensioner/PensionApplicationApprovalIndex';
                    }
                    else {
                        toasterErrorMessage("Please Try Again...");
                    }
                })
            }
            else {
                toasterErrorMessage("Please Enter Notes");
            }
        }

        function deathbind() {
            var id = $("#PersonID").val();
            var pensionAmount = $("#TotalFullpension").val();
            if (id != "" && pensionAmount != "") {
                var oTable = $('#DeathSurvivor').dataTable({
                    "bJQueryUI": true,
                    "sPaginationType": "full_numbers",
                    "bServerSide": true,
                    "bDestroy": true,
                    "sAjaxSource": "@Url.Action("DeathDependantAjax", "PensionApplications")?Id=" + id + "&PensionAmount=" + pensionAmount,
                    "aoColumns": [

                { "sName": "Name" },
              { "sName": "RelationShip" },
              { "sName": "Age" },
              { "sName": "PensionAmount" }

                    ]
                })
            }
        }
    </script>
}
