          "aoColumns": [

      { "sName": "Name" },
    {
      "sName": "RelationShip",
      "bSearchable": false,
      "bSortable": false,
      "fnRender": function (oObj) {
        if (oObj.aData[1] != "C")
          return '<span > Spouse </span>';
        else
          return '<span >Child</span>';
      }
    },
    { "sName": "Age" },
    {
      "sName": "PensionAmount",
      "fnRender": function (oObj) {
        return '<span class="auto">' + oObj.aData[3] + ' </span>';
      }
    }

          ]
        })
      }
    }
  </script>
