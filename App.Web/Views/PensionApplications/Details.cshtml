@model App.Data.Entities.PensionApplications
@using App.Web.Helper
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Pension Application Form
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Details", "PensionApplications", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "form1" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            @Html.HiddenFor(m => Model.DeathInjuryNormal)
            @Html.HiddenFor(m => m.IsActive)
            @Html.Hidden("EditAllowed")
            <div class="row">
                <div class="col-sm-8">
                    <div class="form-group">
                        @Html.Label("EmployerType", "Employer Type", new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8 ">
                            @Html.DropDownList("EmployerType", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm disableCon" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployerID, "Employer *", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8 ">
                            @Html.DropDownList("EmployerID", null, "---Select---", htmlAttributes: new { @class = "form-control disableCon" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.PersonID, "Name of Officer *", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8 ">
                            @Html.DropDownList("PersonID", null, "---Select---", htmlAttributes: new { @class = "form-control disableCon" })
                        </div>

                    </div>
                    <div class="form-group Public">
                        @Html.Label("Death in Service", "Death in Service", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            <input type="checkbox" id="status" />
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.DesignationId, "Post *", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8 ">
                            @Html.DropDownList("DesignationId", null, "---Select---", htmlAttributes: new { @class = "form-control disableCon" })
                        </div>
                    </div>
                    <div class="form-group Public">
                        @Html.LabelFor(model => model.PensionableStatus, "Pensionable Status", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8 ">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.PensionableStatus)
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.BenefitTypes, "Benefit Type *", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8 ">
                            @Html.DropDownList("BenefitTypes", null, "---Select---", htmlAttributes: new { @class = "form-control disableCon" })

                        </div>
                    </div>

                    <div class="form-group Public">
                        @Html.LabelFor(model => model.LeaveDue, "Leave Due", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.LeaveDue, new { @class = "form-control input-sm" })
                            @Html.ValidationMessageFor(model => model.LeaveDue, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.RetirementOrResignationDate, "Date of Retirement/Resignation *", htmlAttributes: new { @class = "col-sm-4 control-label", id = "Retirement" })
                        <div class="col-sm-8">
                            <div class="input-group date" id="Retire">
                                @Html.EditorFor(model => model.RetirementOrResignationDate, new { })
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                            </div>

                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DOB, "Date of Birth", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @{string dob = String.Format("{0:MM/dd/yyyy}", Model.DOB);
                            @Html.TextBoxFor(model => model.DOB, new { @class = "form-control input-sm", @readonly = "readonly", @Value = dob })}
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.DateofAppointment1st, "Date of First Appointment", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @{string firstDate = String.Format("{0:MM/dd/yyyy}", Model.DateofAppointment1st);
                            @Html.TextBoxFor(model => model.DateofAppointment1st, new { @class = "form-control input-sm", @readonly = "readonly", @Value = firstDate })}

                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.DateofAppointmentLast, "Date of Last Appointment", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @{string AppDate = Model.DateofAppointmentLast.HasValue ? Model.DateofAppointmentLast.Value.ToString("MM/dd/yyyy") : "";
                            @Html.TextBoxFor(model => model.DateofAppointmentLast, new { @class = "form-control input-sm", @readonly = "readonly", @Value = AppDate })}

                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.LengthOfQualifyingServiceInMonthsTo31Dec2003, "Service Length(Upto Dec, 2003)", htmlAttributes: new { @class = "control-label", id = "serviceLength1" })
                            &nbsp;<i class="fa fa-question-circle fa-lg Public" data-toggle="tooltip" data-placement="bottom" title="Length of Qualifying Service in Month(to Dec 31, 2003)"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.LengthOfQualifyingServiceInMonthsTo31Dec2003, new { @class = "form-control input-sm", @readonly = "readonly" })

                        </div>
                        <div style="width:1%;float: right;margin-top: -25px;" class="Public"><a href="javascript:showDetails(0)" class="btn btn-primary btn-xs" title="Details"><i class="fa fa-list"></i></a></div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.LengthOfQualifyingServiceInMonthsFrom1Jan2014, "Service Length(From Jan, 2004)", htmlAttributes: new { @class = "control-label", id = "serviceLength2" })
                            &nbsp;<i class="fa fa-question-circle fa-lg Public" data-toggle="tooltip" data-placement="bottom" title="Length of Qualifying Service in Month(from Jan 1, 2004)"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.LengthOfQualifyingServiceInMonthsFrom1Jan2014, new { @class = "form-control input-sm", @readonly = "readonly" })

                        </div>
                        <div style="width:1%;float: right;margin-top: -25px;" class="Public"><a href="javascript:showDetails(1)" class="btn btn-primary btn-xs" title="Details"><i class="fa fa-list"></i></a></div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.LongerShorterReason, "Reason", htmlAttributes: new { @class = "control-label" })
                            &nbsp;<i class="fa fa-question-circle fa-lg Public" data-toggle="tooltip" data-placement="bottom" title="If Length of Qualifying Service is longer or shorter than peroid between date of first appointment and date of retirement, state Why"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextAreaFor(model => model.LongerShorterReason, 8, 8, new { @class = "form-control input-sm", placeholder = "Add Reasons" })

                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.RetirementAnnualSalary1, "Salary P.A", htmlAttributes: new { @class = "control-label" })
                            &nbsp;<i class="fa fa-question-circle fa-lg" data-toggle="tooltip" data-placement="bottom" title="Salary P.A./Salary P.A. plus responsibility/inducement allowance at date of retirement, if in post longer than 3 years"></i>
                        </div>
                        <div class="col-sm-8 TextRight">
                            @Html.TextBoxFor(model => model.RetirementAnnualSalary1, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.RetirementAnnualSalary2, "Salary P.A", htmlAttributes: new { @class = "control-label" })
                            &nbsp;<i class="fa fa-question-circle fa-lg" data-toggle="tooltip" data-placement="bottom" title="Average salary P.A over past three(3) years at date of retirement, if in post less than three (3) years"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.RetirementAnnualSalary2, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>
                    @*<div class="form-group">
                          @Html.LabelFor(model => model.ApplicationSubmittedBy, "Application Submitted By *", htmlAttributes: new { @class = "col-sm-4 control-label" })
                          <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.ApplicationSubmittedBy, new { @class = "form-control input-sm" })

                          </div>
                        </div>*@<div class="form-group">
                        <div class="col-sm-8">

                        </div>
                    </div>



                    <div class="form-group Public">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.FullpensionAmount1, "Pension(Upto Dec, 2003)", htmlAttributes: new { @class = "control-label" })
                            &nbsp;<i class="fa fa-question-circle fa-lg" data-toggle="tooltip" data-placement="bottom" title="Full Pension = (Length of pensionable service)(Month))/600)*(Salary)"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.FullpensionAmount1, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>

                    <div class="form-group Public">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.FullpensionAmount2, "Pension(From Jan, 2004)", htmlAttributes: new { @class = "control-label" })
                            &nbsp;<i class="fa fa-question-circle fa-lg" data-toggle="tooltip" data-placement="bottom" title="Full Pension = (Length of pensionable service)(Month))/960)*(Salary)"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.FullpensionAmount2, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>

                    <div class="form-group ">
                        <div class="col-sm-4 TextRight">
                            &nbsp;@Html.LabelFor(model => model.TotalFullpension, "Full Pension", htmlAttributes: new { @class = "control-label" })
                            <i class="fa fa-question-circle fa-lg Public" data-toggle="tooltip" data-placement="bottom" title="Total Full Pension which exceeds maximum allowed(12 plus 13)"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.TotalFullpension, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>

                    <div class="form-group Public">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.MaxPension, "Maximum Pension", htmlAttributes: new { @class = "control-label" })
                            &nbsp;<i class="fa fa-question-circle fa-lg" data-toggle="tooltip" data-placement="bottom" title="Maximum Full Pension Allowed"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.MaxPension, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>

                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.ReducedPension, "Reduced Pension", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.ReducedPension, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>
                    <div class="form-group Public">
                        @Html.LabelFor(model => model.Gratuity, "Gratuity", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.Gratuity, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>
                    <div class="form-group Police">
                        @Html.Label("FULL RETIREMENT", "Gratuity applicable on FULL RETIREMENT", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextBox("GratuityFullRetirement", "", new { @class = "form-control input-sm", @readonly = "readonly", placeholder = "Gratuity applicable on FULL RETIREMENT" })

                        </div>
                    </div>
                    <div class="form-group Police">
                        @Html.Label("EARLY RETIREMENT", "Gratuity applicable on EARLY RETIREMENT", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextBox("GratuityEarlyRetirement", "", new { @class = "form-control input-sm", @readonly = "readonly", placeholder = "Gratuity applicable on EARLY RETIREMENT" })

                        </div>
                    </div>
                    <div class="form-group Police">
                        @Html.Label("SHORT SERVICE", "Gratuity applicable on SHORT SERVICE", htmlAttributes: new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextBox("GratuityShortService", "", new { @class = "form-control input-sm", @readonly = "readonly", placeholder = "Gratuity applicable on SHORT SERVICE" })

                        </div>
                    </div>
                    <div class="form-group Public">
                        <div class="col-sm-4 TextRight">
                            @Html.LabelFor(model => model.GratuityReducedPension, "Discounted Gratuity", htmlAttributes: new { @class = "control-label" })
                            &nbsp;<i class="fa fa-question-circle fa-lg" data-toggle="tooltip" data-placement="bottom" title="Gratuity Reduced Pension Gratuity Payable(1/4 x Pension Payable at x 12.5)"></i>
                        </div>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.GratuityReducedPension, new { @class = "form-control input-sm auto", @readonly = "readonly" })

                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">
                            Note:
                            &nbsp;<i class="fa fa-question-circle fa-lg" data-toggle="tooltip" data-placement="bottom" title="Mandatory If Save And Approved at First Level"></i>
                        </label>
                        <div class="col-sm-8">
                            <textarea cols="78" columns="4" id="Notes" name="Notes" rows="4"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4"></label>
                        <div class="col-sm-8">

                            <button type="button" class="btn btn-success" id="btnSaveInfo"><i class="fa fa-save"></i> Update</button>
                            <a href="/PensionApplications/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
                            @*@Html.ActionLink("Back to List", "Index", "PensionApplications", null, new { @class = "btn btn-primary" })*@
                        </div>
                    </div>
                </div>

            </div>
        }



    </div>
</div>
<div class="modal fade in" id="formModal" aria-hidden="false" style="display: none;">
    <div class="modal-dialog" style="width:85%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" onclick="hidePension();" aria-hidden="true">×</button>

            </div>
            <div id="PartialDiv">

            </div><!-- /.modal-content -->

            <div class="modal-footer">
                <button class="btn btn-sm btn-success" data-dismiss="modal" aria-hidden="true" onclick="hidePension();">Close</button>

            </div>
        </div>
    </div>
</div>
<div class="panel-body" id="deathCase" style="display:none">
    <table class="table dataTable" id="DeathSurvivor">
        <thead>
            <tr>
                <th>Name</th>
                <th>RelationShip</th>
                <th>Age</th>
                <th>Pension Amount</th>
            </tr>

        </thead>
        <tbody></tbody>
    </table>
</div>
@section scripts{
    <script nonce="@ViewBag.StyleNonce">
        //$("#status").on('click', function (ev) {
        //  if (this.checked) {
        //    $("#Retirement").text("Date Of Death");
        //    $("#IsActive").val(true);
        //    $("#DeathInjuryNormal").val("D");
        //  }
        //  else {
        //    $("#deathCase").css("display", "none");
        //    $("#IsActive").val(false);
        //    $("#DeathInjuryNormal").val("N");
        //    $("#Retirement").text("Date of Retirement/Resignation *");
        //  }

        //})
        $(function () {
            $("#status").prop("disabled", true);
            if ($("#DeathInjuryNormal").val() == "D") {
                $("#Retirement").text("Date Of Death");
                $("#deathCase").css("display", "");
                $("#status").prop("checked", true);
                deathbind();
            }

            if ($("#EditAllowed").val() == "No") {
                $("#btnSaveInfo").prop("disabled", "disabled");
                toasterErrorMessage("Application cannot be edited as it has already been approved.");
            }

            if ($("#EmployerType").val() == 1) {
                hideControls();
                labelChangesForPolice();

            }
            else {
                showControl();
                labelChangesForPublic();
            }
            DisableContrls();
        })
        function DisableContrls() {
            $(".disableCon").each(function () {
                $(this).prop("disabled", "disabled");
            });
            return false;
        }
        $("#btnSaveInfo").click(function () {
            $(".disableCon").each(function () {
                $(this).prop("disabled", false);
            });
            $("#form1").submit();
        })

        function labelChangesForPublic() {
            $("#serviceLength1").text("Service Length(Upto Dec, 2003) ");
            $("#serviceLength2").text("Service Length(From Jan, 2004)");
        }
        function labelChangesForPolice() {
            $("#serviceLength1").text("Completed Years of Pensionable Service (up to 20 years)");
            $("#serviceLength2").text("Completed Six (6) Months period of Pensionable Service (from 20 ½ to 30 years)");
        }
        function hideControls() {
            $(".Public").each(function () {
                $(this).css('display', "none");
            })
            $(".Police").each(function () {
                $(this).css('display', "");
            })

        }
        function showControl() {
            $(".Public").each(function () {
                $(this).css('display', "");
            })
            $(".Police").each(function () {
                $(this).css('display', "none");
            })
        }

        function partialClear() {
            $("#LengthOfQualifyingServiceInMonthsFrom1Jan2014").val("");
            $("#LengthOfQualifyingServiceInMonthsTo31Dec2003").val("");
            $("#TotalFullpension").val("");
            $("#MaxPension").val("");
            $("#Gratuity").val("");
            $("#FullpensionAmount1").val("");
            $("#FullpensionAmount2").val("");
            $("#ApplicationSubmittedBy").val("");
            $("#GratuityReducedPension").val("");
            $("#ReducedPension").val("");
            //$("#RetirementOrResignationDate").val("");
            $("#GratuityFullRetirement").val("");
            $("#GratuityEarlyRetirement").val("");
            $("#GratuityShortService").val("");
            $("#LongerShorterReason").val("");
        }
        function hidePension() {
            $("#formModal").hide();
        }
        function dobind() {
            var id = $("#hdDocumentId").val();
            var eid = $("#EmployerID").val();
            var pid = $("#PersonID").val();
            var ret = $("#RetirementOrResignationDate").val();
            var fdate = $("#DateofAppointment1st").val();
            var oTable = $('#exampless').dataTable({
                "bJQueryUI": true,
                "sPaginationType": "full_numbers",
                "bServerSide": true,
                "bDestroy": true,
                "sAjaxSource": "@Url.Action("EditDetailSearchAjax", "PensionApplications")?EId=" + eid + "&PId=" + pid + "&ret=" + ret + "&fdate=" + fdate + "&id=" + id,
                "aoColumns": [

            { "sName": "JKPSID" },
            { "sName": "Month" },
            { "sName": "Year" },
            { "sName": "SystemSalary" },
            { "sName": "SystemContributorContribution" },
            { "sName": "SystemEmployerContribution" },
            { "sName": "Salary" },
            { "sName": "ContributorContribution" },
            { "sName": "EmployerContribution" }

                ]
            }).rowGrouping({
                bExpandableGrouping: false,
                iGroupingColumnIndex: 2,
                bHideGroupingColumn: true

            });
        }
        function showDetails(id) {
            $("#hdDocumentId").val(id);
            debugger
            if ($("#LengthOfQualifyingServiceInMonthsTo31Dec2003").val() != "" || $("#LengthOfQualifyingServiceInMonthsTo31Dec2003").val().length > 0) {
                $.get('@Url.Action("_serviceLengthContributionDetails", "PensionApplications")', function (data) {
                    $('#PartialDiv').html(data);
                    dobind();
                    $("#formModal").show();
                })

            }
        }


        $("#Retire").on('changeDate', function () {
            debugger
            partialClear();
            var retirementOrResignationDate = $("#RetirementOrResignationDate").val();
            if (retirementOrResignationDate != "") {
                var personID = $("#PersonID").val();
                if ($("#EmployerType").val() == 2) {
                    $.ajax({
                        url: "@Url.Action("CalculatePublicPensionDetailsAjax", "PensionApplications")?RetirementOrResignationDate=" + retirementOrResignationDate + "&PersonID=" + parseInt(personID),
                        type: 'Get',
                        dataType: 'json'
                    }).done(function (result) {
                        if (result == "discountedGratuity") {
                            toasterErrorMessage("Discount Factor not defined for that period");
                        }
                        else if (result.error != "" && result.error != null) {
                            toasterErrorMessage(result.error);
                        }
                        else {
                            $("#LengthOfQualifyingServiceInMonthsFrom1Jan2014").val(result.LengthOfQualifyingServiceInMonthsFrom1Jan2014);
                            $("#LengthOfQualifyingServiceInMonthsTo31Dec2003").val(result.LengthOfQualifyingServiceInMonthsTo31Dec2003);
                            $("#TotalFullpension").val(result.FullPension.toFixed(2));
                            $("#MaxPension").val(result.MaxPension.toFixed(2));
                            $("#Gratuity").val(result.Gratuity.toFixed(2));
                            $("#RetirementAnnualSalary2").val(0);
                            $("#RetirementAnnualSalary1").val(result.SalaryAmount.toFixed(2));
                            $("#FullpensionAmount1").val(result.FullPension1.toFixed(2));
                            $("#FullpensionAmount2").val(result.FullPension2.toFixed(2));
                            $("#GratuityReducedPension").val(result.DiscountedGratuity.toFixed(2));
                            $("#ReducedPension").val(result.ReducedPension.toFixed(2));


                        }
                    })
                }
                else {
                    var status = "False";
                    debugger
                    if ($("#DeathInjuryNormal").val() == "I") {
                        status = "True";
                    }
                    $.ajax({
                        url: "@Url.Action("CalculatePolicePensionDetailsAjax", "PensionApplications")?RetirementOrResignationDate=" + retirementOrResignationDate + "&PersonID=" + parseInt(personID) + "&status=" + status,
                        type: 'Get',
                        dataType: 'json'
                    }).done(function (result) {
                        if (result == "discountedGratuity") {
                            toasterErrorMessage("Discount Factor not defined for that period");
                        }
                        else if (result.error != "" && result.error != null) {
                            toasterErrorMessage(result.error);
                        }
                        else {
                            if (result.PensionType == "Injured") {
                                $("#TotalFullpension").val(result.FullPension.toFixed(2));
                                $("#Gratuity").val(result.Gratuity.toFixed(2));
                                $("#MaxPension").val(result.MaxPension.toFixed(2));
                                $("#RetirementAnnualSalary2").val(result.SalaryAmount2.toFixed(2));
                                $("#RetirementAnnualSalary1").val(result.SalaryAmount.toFixed(2));
                            }
                            else {
                                debugger
                                result.PensionType == "FullRetirement" ? $("#GratuityFullRetirement").val(result.Gratuity.toFixed(2)) : result.PensionType == "EarlyRetirement" ? $("#GratuityEarlyRetirement").val(result.Gratuity.toFixed(2)) : $("#GratuityShortService").val(result.Gratuity.toFixed(2));
                                $("#LengthOfQualifyingServiceInMonthsTo31Dec2003").val(result.LengthOfQualifyingServiceInMonthsTo31Dec2003);
                                $("#LengthOfQualifyingServiceInMonthsFrom1Jan2014").val(result.LengthOfQualifyingServiceInMonthsFrom1Jan2014);
                                $("#TotalFullpension").val(result.FullPension.toFixed(2));
                                $("#Gratuity").val(result.Gratuity.toFixed(2));
                                $("#MaxPension").val(result.MaxPension.toFixed(2));
                                $("#RetirementAnnualSalary2").val(result.SalaryAmount2.toFixed(2));
                                $("#RetirementAnnualSalary1").val(result.SalaryAmount.toFixed(2));
                                $("#ReducedPension").val(result.ReducedPension.toFixed(2));
                            }
                        }
                    })
                }
            }
            else {
                toasterErrorMessage("Select Resignation Date");
            }
        })

        function deathbind() {
            $("#deathCase").css("display", "");
            var id = $("#PersonID").val();
            var pensionAmount = $("#TotalFullpension").val();
            if (id != "" && pensionAmount != "") {
                var oTable = $('#DeathSurvivor').dataTable({
                    "bJQueryUI": true,
                    "sPaginationType": "full_numbers",
                    "bServerSide": true,
                    "bDestroy": true,
                    "sAjaxSource": "@Url.Action("DeathDependantAjax", "PensionApplications")?Id=" + id + "&PensionAmount=" + pensionAmount,
                    "aoColumns": [

                { "sName": "Name" },
              {
                  "sName": "RelationShip",
                  "bSearchable": false,
                  "bSortable": false,
                  "fnRender": function (oObj) {
                      if (oObj.aData[1] != "C")
                          return '<span > Spouse </span>';
                      else
                          return '<span >Child</span>';
                  }
              },
              { "sName": "Age" },
              {
                  "sName": "PensionAmount",
                  "fnRender": function (oObj) {
                      return '<span class="auto">' + oObj.aData[3] + ' </span>';
                  }
              }

                    ]
                })
            }
        }
    </script>
}


