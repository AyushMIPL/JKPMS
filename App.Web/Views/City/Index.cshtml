@model IEnumerable<App.Data.Entities.MasterCity>

@{
  ViewBag.Title = "Index";
}

<style>
  a.disabled {
    color: gray;
    pointer-events: none;
    opacity: .8;
  }

  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-cityindex">
      City

      @*<ul class="tool-bar">
        <li>
          <a href="/City/Create" data-toggle="tooltip"
             class="@(ViewBag.AddPermission == true ? "" : "disabled")"
             data-placement="bottom"
             title="Add details"
             data-original-title="Add Details">
            <i class="fa fa-plus"></i>
          </a>
        </li>

      </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>

          <th>District</th>
          <th>City</th>
          <th>Status</th>
          <th class="action-cityindex"></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {

  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });

      var CityTableId = [];

    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
        "sAjaxSource": "/City/AjaxHandler",

        "fnDrawCallback": function (setting) {
          debugger;

          CityTableId.forEach(function (item, index) {
            debugger
            if (document.getElementById("EditCityBtn_" + item) != null && document.getElementById("EditCityBtn_" + item) != undefined){
              document.getElementById("EditCityBtn_" + item).addEventListener("click", function () {
                EditCity(item);
              });
            }
            if (document.getElementById("DetailsCityBtn_" + item)!= null && document.getElementById("DetailsCityBtn_" + item) != undefined){
              document.getElementById("DetailsCityBtn_" + item).addEventListener("click", function () {
                DetailsCity(item);
              });
            }
            if (document.getElementById("DeleteCityBtn_" + item)!= null && document.getElementById("DeleteCityBtn_" + item) != undefined){
              document.getElementById("DeleteCityBtn_" + item).addEventListener("click", function () {
                del(item);
              });
            }


          });

        },


        "aoColumns": [

						{ "sName": "State" },
                        { "sName": "City" },
						{
						  "sName": "ActiveStatus",
						  "bSearchable": false,
						  "bSortable": false,
						  "fnRender": function (oObj) {
						    if (oObj.aData[2] == "False")
						      return '<span class="badge badge-danger">inactive</span>';
						    else
						      return '<span class="badge badge-success">active</span>';
						  }
						},
						{
						  "sName": "ID",
						  "bSearchable": false,
						  "bSortable": false,
              "fnRender": function (oObj) {
                var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
                var DeletePermission = ("@ViewBag.DeletePermission").toLowerCase();

                //  var strString = '<button onclick="EditCity(\'' + oObj.aData[3] + '\');" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : '') + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';
                //  strString += '&nbsp;<button onclick="DetailsCity(\'' + oObj.aData[3] + '\');" class="btn btn-xs btn-primary" title="Detail"><i class="fa fa-list"></i> Details</button>';
                //strString += '&nbsp;<button href="javascript:;" onclick="javascript:del(\'' + oObj.aData[3] + '\');" class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';

                var strString=''

                //var strString = '<button id="EditCityBtn_' + oObj.aData[3] + '"  class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : '') + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';
                strString += '&nbsp;<button id="DetailsCityBtn_' + oObj.aData[3] + '"  class="btn btn-xs btn-primary" title="Detail"><i class="fa fa-list"></i> Details</button>';
                //strString += '&nbsp;<button id="DeleteCityBtn_' + oObj.aData[3] + '" href="javascript:;"  class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete"><i class="fa fa-trash-o fa-lg"></i> Delete</button>';
                CityTableId.push(oObj.aData[3]);
						    return strString;
						  }
						}
        ]
      });
    }


        function EditCity(id) {
     window.location.href = "@Url.Action("Edit", "City")?Id=" + id ;
        }

        function DetailsCity(id) {
     window.location.href = "@Url.Action("Details", "City")?Id=" + id ;
        }




    function del(ctrlId) {
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
    }
    function onDeleteConfirm() {
      var id = $("#hdDocumentId").val();
      var name = "CityId";
      $.ajax({
        url: "@Url.Action("AjaxRemove", "City")?Id=" + id + "&name=" + name,
        type: "GET",
      })

		.done(function (result) {
      var actionRes = result;
      debugger
		  if (actionRes == "0") {
		    toasterErrorMessage("There is some error, please try again.");
		    return actionRes;
		  }
      else if (actionRes == "3") {
        toasterSuccessMessage("Record deleted successfully.");
        $('#confirmDelete').popup("hide");
        doBindData();

		  } else {
		    toasterErrorMessage("Already in Use.");
		    //$('#confirmDelete').popup("hide");
        /*toasterSuccessMessage("Status changed sucessfully.");*/
        $('#confirmDelete').popup("hide");
        doBindData();
		  }
		});
      }

      const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
      debugger
      Confirm_Delete_ClassBtn.forEach(button => {
        button.addEventListener('click', onDeleteConfirm);
      });
  </script>
}
