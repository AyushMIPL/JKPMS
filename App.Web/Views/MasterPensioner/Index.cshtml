        return;
      }
      else {
        $('#resumePaymentReason').removeClass('error');
          $('#error-message1').hide();
          $("#btn_Resume_loading").hide();
          $("#IdResumePayment").show();
      }

      var Id = $('#hiddenIdField').val();
      var paymentStatus = "N";
      $.ajax({
        type: "POST",
        url: "/MasterPensioner/ResumePaymentStatusAjax",
        data: {
          id: Id,
          resumePaymentReason: resumePaymentReason,
          resumepaymentStatus: paymentStatus,
        },
        success: function (result) {

            $("#btn_Resume_loading").hide();
            $("#IdResumePayment").show();
          if (result.Status == true) {

            toasterSuccessMessage(result.Message)
            location.reload();
          }
        },
        error: function (xhr, status, error) {

            console.error("Ajax request failed", error);
            $("#btn_Resume_loading").hide();
            $("#IdResumePayment").show();
        }
      });
      $('#PopUpHoldPayment').hide();
    }


