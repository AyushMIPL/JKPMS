@model IEnumerable<JKPS.COMMON.DVOMasterEmployee>
@using App.Web.Helper
@{
  ViewBag.Title = "Index";
  var Group = @Html.Raw(Json.Encode(ViewBag.Group));
}

<link href="~/Content/endless/LatestJS/jquery.dataTables.min.css" rel="stylesheet" />


<div class="panel panel-default">
  <div class="panel-body">
    @using (Html.BeginForm("Index", "MasterPensioner", FormMethod.Post, new { enctype = "multipart/form-data", onsubmit = "return Index();", id = "IdMasterPensioner" }))
    {
      <div class="row py-4">
        <div class="col-sm-4">
          <div class="form-group">
            <label>District</label>
            @Html.TextBox("RegionNames", "", new { @class = "form-control", @autocomplete = "off", @placeholder = " Regions" })
          </div>
        </div>
        <div class="col-sm-4 hidden">
          <div class="form-group ">
            <label>Tehsil</label>
            @Html.TextBox("Tehsil", "", new { @class = "form-control", @autocomplete = "off", @placeholder = "Enter Tehsil" })
          </div>
        </div>
        <div class="col-sm-4">

          <label>Account Status</label>
          <div class="form-group h_select">
            @Html.DropDownList("AccountStatus", new SelectList(new[]
            {
              new SelectListItem{Value="ALL",Text="ALL"},
              new SelectListItem{Value="ACTIVE",Text="Validated"},
              new SelectListItem{Value="INACTIVE ACCOUNT",Text="Not Validated "},
            }, "Value", "Text"), new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Account Status" })
          </div>
          @*<div class="form-group h_select">
              @Html.DropDownList("AccountStatus", null, "Select", new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Account Status" })
            </div>*@
        </div>
        @*<div class="row py-4">*@
        <div class="col-sm-4 hidden">

          <label>Gender</label>
          <div class="form-group h_select">
            @Html.DropDownList("Gender", new SelectList(new[]
            {
              new SelectListItem{Value="",Text="All",Selected=true},
              new SelectListItem{Value="M",Text="Male"},
              new SelectListItem{Value="F",Text="Female"},
              new SelectListItem{Value="T",Text="Transgender"},
            }, "Value", "Text"), new { @class = "form-control", @autocomplete = "off", @placeholder = "Select Gender" })
          </div>
        </div>

        <div class="col-sm-4">
          <div class="form-group h_select">
            <label>Account No.</label>
            <input type="text" id="bank_acct_no" class="form-control" placeholder="Search for Account No." />
            <i class="fa fa-search Searchicancenter" aria-hidden="true"></i>
          </div>
        </div>

        @*<div class="col-sm-4">
              <div class="form-group h-select">
                  <label>Account No.</label>
                  <input  type="text" id="ACCOUNT_NO" class="form-control" placeholder="Search for Account No."/>

              </div>

          </div>*@

        @*------Account Status----*@


        @*</div>*@



        <div class="col-sm-4">
          <div class="form-group h_select">
            <label>Reference No.</label>
            <input type="text" id="APPLICATION_REFERENCE_NO" class="form-control" placeholder="Search for Reference No." />
            <i class="fa fa-search Searchicancenter" aria-hidden="true"></i>
            @*@Html.DropDownList("APPLICATION_REFERENCE_NO", null, "Select Type", new { @class = "form-control select2-dropdown", @autocomplete = "off", @placeholder = "Reference No", @id = "APPLICATION_REFERENCE_NO" })*@
          </div>
        </div>

        <div class="col-sm-4">
          <div class="form-group h_select">
            <label>Scheme Type</label>
            @Html.DropDownList("BeneficiariesType", null, "Select Type", new { @class = "form-control", @autocomplete = "off", @placeholder = "Beneficiaries Type" })
          </div>
        </div>
        <div class="col-sm-2">
          <div class="form-group">
            <button type="button" class="btn btn-success px-5 height MPbtnProcessing " title="Please Wait While We Process Your Request" id="btn_Beneficiary_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
            <button class="btn btn-success height mr-2 px-5 MPbtnSearch" id="Btn" type="button">
              <i class="fa fa-search fa-lg"></i> Search
            </button>
          </div>
        </div>


      </div>
      @*
          <div class="row py-4">
           /reference And search button/

        </div>*@
    }
  </div>
</div>
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline Mpheadline">
      Beneficiary
      <button type="button" class="btn btn-success px-5 height display_none MpDownloadExcel" title="Please Wait While We Process Your Request" id="btn_downloadExcel_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
      <button class="btn btn-success MpDownloadExcel" id="IddownloadExcel">Download Excel</button>

    </h4>
  </div>
  <div class="loader display_none" id="loader"></div>
  <div class="panel-body">
    <div class="table-responsive MpTable">
      <table id="example" class="display nowrap" cellspacing="0" width="100%">
        @*<table class="table" id="example">*@
        <thead>
          <tr>
            <th>Application Reference No</th>
            <th>Name</th>
            <th>Gender</th>
            <th>Age</th>
            <th>Address</th>
            <th>Phone</th>
            <th>Mailid</th>
            <th>Account No</th>
            <th>IFSC Code</th>
            <th>Bank Name</th>
            <th>Last Verified</th>
            <th>Account Status</th>
            <th>Hold Payment</th>
            <th>Remarks/Reason</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
        </tbody>
      </table>
    </div>
  </div>

  <input type="hidden" id="hiddenIdField" value="" />


  <div class="custom-popup width-100 confirmClass Mpdisplaynone" id="PopUpHoldPayment">

    <div class="padding-md">
      <h4 class="m-top-none"> Are you sure want to De-Activate Payment?</h4>
      <label for="stopPaymentReason" class="required-field">Reason:</label>
      <textarea type="text" id="holdPaymentReason" class="form-control" placeholder="Enter reason"></textarea>
      <div id="error-message" class="MPerror-message"></div>
    </div>
    <div class="text-center">
      <button type="button" class="btn btn-success px-5 height MPbtnProcessing2" title="Please Wait While We Process Your Request" id="btn_HoldPayment_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
      <a class="btn btn-success m-right-sm @(ViewBag.EditPermission == true ? "" : "disabled")" id="IdHoldPayment">Yes</a>
      <a class="btn btn-danger logoutConfirm_close" id="oncancelHoldPayment_Btn">NO</a>
    </div>
  </div>

  <div class="custom-popup width-100 confirmClass Mpdisplaynone" id="PopUpResumePayment">
    <div class="padding-md">
      <h4 class="m-top-none"> Are you sure want to Activate Payment?</h4>
      <label for="stopPaymentReason" class="required-field">Reason:</label>
      <textarea type="text" id="resumePaymentReason" class="form-control" placeholder="Enter reason"></textarea>
      <div id="error-message1" class="MPerror-message"></div>
    </div>
    <div class="text-center">
      <button type="button" class="btn btn-success px-5 height Mpdisplaynone " title="Please Wait While We Process Your Request" id="btn_Resume_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
      <a class="btn btn-success   m-right-sm @(ViewBag.EditPermission == true ? "" : "disabled")" id="IdResumePayment"> Yes</a>
      <a class="btn btn-danger logoutConfirm_close" id="oncancelResumePayment_Btn">No</a>
    </div>
  </div>

  <div class="custom-popup width-100 confirmClass Mpdisplaynone" id="PopUpStopPayment ">
    <div class="padding-md">
      <h4 class="m-top-none"> Are you sure want to Stop Payment?</h4>
      <label for="stopPaymentReason" class="required-field">Reason:</label>
      <textarea type="text" id="stopPaymentReason" class="form-control" placeholder="Enter reason"></textarea>
      <div id="error-message2" class="MPerror-message"></div>
    </div>
    <div class="text-center">
      <a class="btn btn-success m-right-sm @(ViewBag.EditPermission == true ? "" : "disabled")" id="OnclickStopPayment_Btn">Yes</a>
      <a class="btn btn-danger" id="oncancelStopPayment_Btn">Cancel</a>
    </div>
  </div>

