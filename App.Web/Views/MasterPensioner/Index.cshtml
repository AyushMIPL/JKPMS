      function downloadExcel(evt) {


          try {
              $(evt.target).find("i.fa-spinner").show();
              $('#btn_downloadExcel_loading').show();
              $('#IddownloadExcel').hide();

              // Create XMLHttpRequest object
                var xhr = new XMLHttpRequest();

                // Configure it: POST-request for the URL
                xhr.open('POST', '@Url.Action("BeneficiaryAjaxHandler", "MasterPensioner")', true);
                xhr.responseType = 'arraybuffer'; // Expect binary data

                // Set up event handlers
              xhr.onload = function () {

                  if (xhr.status === 200) {

                        // Success: Convert arraybuffer to blob and initiate download
                        var blob = new Blob([xhr.response], { type: 'application/octet-stream' });
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                    a.download = 'Beneficiary.xlsx'; // Default filename

                        // Check Content-Disposition header for filename if available
                        var disposition = xhr.getResponseHeader('Content-Disposition');
                        if (disposition) {
                            var matches = /filename="([^"]*)"/.exec(disposition);
                            if (matches != null && matches[1]) {
                                a.download = matches[1];
                            }
                        }

                        // Append the anchor to the document body and trigger the download
                        document.body.appendChild(a);
                        a.click();

                        // Clean up
                        window.URL.revokeObjectURL(url);
                      document.body.removeChild(a);

                      $('#btn_downloadExcel_loading').hide();
                      $('#IddownloadExcel').show();
                    } else {
                        // Handle HTTP errors
                      console.error('Error downloading file:', xhr.statusText);
                      $('#btn_downloadExcel_loading').hide();
                      $('#IddownloadExcel').show();
                    }
                };

              xhr.onerror = function () {

                    // Handle network errors
                  console.error('Network error.');
                  $('#btn_downloadExcel_loading').hide();
                  $('#IddownloadExcel').show();
                };

                // Prepare form data and send
                var formData = new FormData();
                formData.append('Tehsil', $('#Tehsil').val());
                formData.append('BeneficiariesType', $('#BeneficiariesType').val());
                formData.append('Gender', $('#Gender').val());
                formData.append('RegionNames', $('#RegionNames').val());
              formData.append('AccountStatus', $('select#AccountStatus option:selected').val());
                formData.append('bank_acct_no', $('#bank_acct_no').val());
                formData.append('APPLICATION_REFERENCE_NO', $('#APPLICATION_REFERENCE_NO').val());
                formData.append('isDownload', true);

                // Send the request with form data
                xhr.send(formData);



                 } catch (e) {
                 }
    }
