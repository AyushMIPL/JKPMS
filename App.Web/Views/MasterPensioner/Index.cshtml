          function dobind() {

            document.getElementById("loader").style.display = "block";
            $('#example').dataTable({
              "bJQueryUI": true,
              "sPaginationType": "full_numbers",
              "bServerSide": true,
              "bDestroy": true,
              //"bProcessing": true,
               //"sAjaxSource": "/MasterPensioner/BeneficiaryAjaxHandler?Tehsil=" + $("#Tehsil").val() + "&BeneficiariesType=" + $("#BeneficiariesType").val() + "&Gender=" + $("#Gender").val() + "&RegionNames=" + $("#RegionNames").val() + "&AccountStatus=" + $('select#AccountStatus option:selected').val() + "&bank_acct_no=" + $("#bank_acct_no").val() + "&APPLICATION_REFERENCE_NO=" + $("#APPLICATION_REFERENCE_NO").val(),
                ajax: {
                    url: "/MasterPensioner/BeneficiaryAjaxHandler",
                    type: "POST", // ✅ POST reduces WAF flagging vs. long query strings
                    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
                    data: function (d) {
                        d.sEcho = d.draw;
                        d.iDisplayStart = d.start;
                        d.iDisplayLength = d.length;
                        d.sSearch = d.search.value;
                        d.iSortingCols = (d.order && d.order.length > 0) ? d.order[0].column : 0;
                        d.sColumns = (d.columns || []).map(c => c.data).join(',');
                        // ✅ Always send short, clean key/value pairs – avoid commas and special chars
                        d.Tehsil = $("#Tehsil").val() || "";
                        d.BeneficiariesType = $("#BeneficiariesType").val() || "";
                        d.Gender = $("#Gender").val() || "";

                        // Replace commas (,) which trigger WAFs – use pipe (|) or IDs instead
                        d.RegionNames = ($("#RegionNames").val() || "");

                        d.AccountStatus = $('select#AccountStatus').val() || "";
                        d.bank_acct_no = $("#bank_acct_no").val() || "";
                        d.APPLICATION_REFERENCE_NO = $("#APPLICATION_REFERENCE_NO").val() || "";

                        return d;
                    },
                    headers: {
                        "X-Requested-With": "XMLHttpRequest" // ✅ helps WAF recognize legit AJAX
                        // If you have antiforgery: add it here
                        // "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    error: function (xhr, textStatus, error) {
                        console.error("AJAX Error:", textStatus, error, xhr.responseText);
                    }
                },
              "fnDrawCallback": function (setting) {
                document.getElementById("loader").style.display = "none";
                document.querySelectorAll('.clearLocatMenuStorage_class').forEach(element => {
                  element.addEventListener('click', clearLocatMenuStorage);
                });
               OpenMessagePopupArr.forEach(function (item, index) {

                  var items = item.split('~')[0];
                  var heading = items.split('_')[0];
                  var message = items.split('_')[1];
                  var element = document.getElementById(item);
                  if (element) {
                    element.addEventListener("click", function () {
                      OpenMessagePopup(heading, message);
                    });
                  }
                });
                OpenMessagePopupApplicationNoArr.forEach(function (item) {
                  var parts = item.split('_');
                  var heading = parts[0];
                  var applicationReferenceNo = parts[1];
                  var name = parts[2];
                  var scheme = parts[3];
                  var bankAccountNo = parts[4];
                  var ifscCode = parts[5];
                  var accountStatus = parts[6];
                  var cbsName = parts[7];
                  var holdPayment = parts[8];
                  var element2 = document.getElementById(item);
                  if (element2) {
                    element2.addEventListener("click", function () {
                      OpenMessagePopupApplicationNo(heading, applicationReferenceNo, name, scheme, bankAccountNo, ifscCode, accountStatus, cbsName, holdPayment);
                    });
                  }
                });
                showHoldPaymentPopupArr.forEach(function (item, index) {

                  var id = item.split('~')[0]
                  var status = item.split('~')[1]
                  if (status === "Y") {
                    if (document.getElementById(item) != null && document.getElementById(item) != undefined) {
                      document.getElementById(item).addEventListener("click", function () {
                        showResumePaymentPopup(id)
                      });
                    }
                 }
                  else {
                    if (document.getElementById(item) != null && document.getElementById(item) != undefined) {
                      document.getElementById(item).addEventListener("click", function () {
                        showHoldPaymentPopup(id);
                      });
                    }
                  }
                });
