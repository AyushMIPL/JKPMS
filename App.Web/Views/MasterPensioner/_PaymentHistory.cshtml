@model IEnumerable<JKPS.COMMON.DVOMasterEmployeeIncomes>

@{
  Layout = "~/Views/Shared/_LayoutPensioner.cshtml";
}

<link href="~/Content/endless/LatestJS/jquery.dataTables.min.css" rel="stylesheet" />
<link href="~/Content/endless/LatestJS/buttons.dataTables.min.css" rel="stylesheet" />

<style>
  .dataTables_wrapper .dt-buttons {
    float: none;
    text-align: right;
  }

  /*.my-sky-blu {
    background-color: #95c8d7;
  }*/
</style>
@section profilePensioner
{@Html.Hidden("PensionerID")
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <div class="row">
      <div class="col-sm-12">
        <div class="form-group">
          <div class="col-sm-6">
            <h4 class="headline" style="margin:0px;padding:0px;border:none;">
              Payment History:@string.Format("{0} ({1})", ViewBag.Name, ViewBag.ApplicationReferenceNo)
            </h4>

          </div>
          <div class="col-sm-6">
            <h4 class="headline" style="margin:0px;padding:0px;border:none;">
              Scheme Type:@string.Format("({0})", ViewBag.TypeCode)
            </h4>
          </div>
          <button type="button" class="btn btn-success px-5 height" style="display: none; float:right" title="Please Wait While We Process Your Request" id="btn_downloadExcelHistroy_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
          <button class="btn btn-success" id="IddownloadExcelHistory" style="float: right; text-align: right;" onclick="downloadExcel(event)">Download Excel</button>
        </div>
      </div>
    </div>
  </div>

  <div class="panel-body">
    @*<table id="reportData" class="display nowrap" cellspacing="0" width="100%">*@
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>
          <th>Account No</th>
          <th>Bank Name</th>
          <th>IFSC Code</th>
          <th>Paid On</th>
          <th>Amount</th>
          <th>Status</th>
          <th>Reason</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

@*This is for the payment status Edit Model*@

<div class="custom-popup confirmClass" id="PopUpPaymentStatus" style="display: none; width: 900px !important;">
  <div class="padding-md">

    <!-- Update Payment Section -->
    <h3 class="m-top-none py-3 text-white" style="background: #95c8d7">Update Payment History Details.</h3>
    <!-- Header Section -->
    <div class="row">
      <div class="col-sm-6">
        <label for="APPLICATION_REFERENCE_NO">Application Reference No:</label>
        <div class="form-group">
          <input type="text" id="APPLICATION_REFERENCE_NO" class="form-control" placeholder="Enter Your Application Reference No." disabled />
        </div>
      </div>
      <div class="col-sm-6">
        <label for="Name">Name:</label>
        <div class="form-group">
          <input type="text" id="Name" class="form-control" placeholder="Enter Your Name" disabled />
        </div>
      </div>
    </div>


    <!-- Payment Status -->
    <div class="row">
      <div class="col-sm-6">
        <label for="paymentStatus">Payment Status:</label>
        <div class="form-group">
          <select class="form-control" id="paymentStatus1" style="border-radius:20px;">
            <option value="0">--select--</option>
            <option value="Fail">Fail</option>
            <option value="Ok">Ok</option>
          </select>
          <div id="error-paymentStatus1" class="error-message" style="color:red;"></div>

        </div>
      </div>
      <div class="col-sm-6">
        <label for="Date">Date:</label>
        <div class="form-group">
          <input type="text" id="TransactionDate" class="form-control" placeholder="Search for TransactionDate No." />
        </div>
      </div>
    </div>

    <!-- Date -->
    <!-- Remark -->
    <div class="row">
      <div class="col-sm-12">
        <label for="RemarksId">Remark:</label>
        <div class="form-group">
          <textarea type="text" id="RemarksId" class="form-control" placeholder="Enter Your Remark"></textarea>
          <div id="error-RemarksId" style="color: red;"></div>
        </div>
      </div>
    </div>

    <!-- Buttons (Update and Cancel) -->
    <div class="text-center">
      <button type="button" class="btn btn-success px-5 height" style="display: none; float:right" title="Please Wait While We Process Your Request" id="btn_PaymentStatus_loading">
        <i class="fa fa-spinner fa-spin"></i> Processing
      </button>
      <a class="btn btn-success m-right-sm " id="IdPaymentStatus" onclick="onclickPaymentStatus()">Update</a>
      <a class="btn btn-danger" onclick="oncancelPayment()">Cancel</a>

      @*@(ViewBag.EditPermission == true ? "" : "disabled")"*@
    </div>
  </div>
</div>

<input type="text" id="PaymentStatusEmplcode" hidden />
<input type="text" id="PaymentStatusAccountNo" hidden />


}



