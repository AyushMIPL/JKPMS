  <script nonce="@ViewBag.StyleNonce">


    $(function () {
      var pensionerID = $("#PensionerID").val();
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
          "sAjaxSource": "/MasterPensioner/_PaymentHistoryHandlerAjax/?PensionerID=" + pensionerID,
        "aoColumns": [

          { "sName": "Account No" },
          {
            "sName": "Bank Name",
            "fnRender": function (oObj) {
              //debugger

              return '<span class="auto">' + oObj.aData[1] + '</span>';

            }
          },
          {
            "sName": "IFSC Code",
            "fnRender": function (oObj) {
              return '<span class="auto">' + oObj.aData[2] + '</span>';
            }
          },
          {
            "sName": "Paid On",
            "fnRender": function (oObj) {
              return '<span class="auto">' + oObj.aData[3] + '</span>';
            }
          },
          {
            "sName": "Amount",
            "fnRender": function (oObj) {
              return '<span class="auto">' + oObj.aData[4] + '</span>';
            }
          },
          {
            "sName": "Status",
            "fnRender": function (oObj) {
              return '<span class="auto">' + oObj.aData[5] + '</span>';
            }
          },
          {
            "sName": "Reason",
            "fnRender": function (oObj) {
              return '<span class="auto">' + oObj.aData[6] + '</span>';
            }
          },

          {
            "sname": "EmplCode",
            "bsearchable": false,
            "bsortable": false,
            "fnRender": function (oObj) {
              var emplCode = oObj.aData[7];
              var payDocNo = oObj.aData[13];
              debugger;
              return '<div>' +
                '<button class="btn btn-secondary dropdown-toggle" style="color: honeydew;background:#95c7e5;"  type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" onclick="showPaymentStatusPopup(\'' + emplCode + '\', \'' + payDocNo + '\')">' +
                'Edit' +
                '</button>' +
                '</div>';
            }
          }


        ]@*,
        dom:  'Bflrtip',
        buttons: [
          {
          //  extend: 'excelHtml5',
          //  title: 'Excel',
          //  text: 'Export to excel'
          //},

             text: 'Download Excel',
             autoFilter: true,
             action: function (e, dt, node, config) {
                 try {
                     $.ajax({
                         type: "POST",
                       data: { param: dt.ajax.params(), PensionerID: $("#PensionerID").val(),isDownload: true },
                       url: '@Url.Action("_PaymentHistoryAjaxHandler", "MasterPensioner")',
                         cache: false,
                         success: function (result) {
                             if (result != null) {
                                 var bytes = new Uint8Array(result.FileContents);
                                 var blob = new Blob([bytes], { type: '@System.Net.Mime.MediaTypeNames.Application.Octet' });
                                 if (window.navigator.msSaveOrOpenBlob) {
                                     // IE11
                                     window.navigator.msSaveOrOpenBlob(blob, result.FileDownloadName);
                                 } else {
                                     // Google chome, Firefox, ....
                                     var link = document.createElement('a');
                                     link.href = window.URL.createObjectURL(blob);
                                     link.download = result.FileDownloadName;
                                     link.click();
                                 }
                             }
                             else {

                             }
                         },
                         error: function (xhr, status, error) {
                         }
                     });

                 } catch (e) {
                 }
             }
          },




        ]*@

      });

    })

    $(document).ajaxStop(function () {
      $(".auto").autoNumeric({ aSep: ',', aDec: '.' });
    });

      function downloadExcel(evt) {
        debugger;
          $(evt.target).find("i.fa-spinner").show();
          $('#btn_downloadExcelHistroy_loading').show();
          $('#IddownloadExcelHistory').hide();
             $.ajax({
                 type: "POST",
               data: { PensionerID: $("#PensionerID").val(),isDownload: true },
               url: '@Url.Action("_PaymentHistoryHandlerAjax", "MasterPensioner")',
                 cache: false,
                 success: function (result) {
                     $('#IddownloadExcelHistory').show();
                     $('#btn_downloadExcelHistroy_loading').hide();
                     if (result != null) {
                         var bytes = new Uint8Array(result.FileContents);
                         var blob = new Blob([bytes], { type: '@System.Net.Mime.MediaTypeNames.Application.Octet' });
                         if (window.navigator.msSaveOrOpenBlob) {
                             // IE11
                             window.navigator.msSaveOrOpenBlob(blob, result.FileDownloadName);
                         } else {
                             // Google chome, Firefox, ....
                             var link = document.createElement('a');
                             link.href = window.URL.createObjectURL(blob);
                             link.download = result.FileDownloadName;
                             link.click();
                             $(evt.target).find("i.fa-spinner").hide();
                         }
                     }
                     else {

                     }
                 },
                 error: function (xhr, status, error) {
                 }
             });



    }

    ////Showing Payment Model
    function showPaymentStatusPopup(detailsLink,payDocNo) {
      debugger
        $.ajax({
          url: "/MasterPensioner/GetPaymentdetailsAjax?EmplCode=" + detailsLink + "&PayDocNo=" + payDocNo,
          method: "GET",
          success: function (data) {
            debugger
            if (data && data.length > 0) {
              var firstRecord = data[0];
              $('#PaymentStatusAccountNo').val(accountNo);
              $("#PaymentStatusEmplcode").val(detailsLink);
              $("#APPLICATION_REFERENCE_NO").val(firstRecord.ApplicationReferenceNo);
              $("#Name").val(firstRecord.FullName);
              $("#PopUpPaymentStatus").popup('show');
            } else {
              console.error("No data returned from the server.");
            }
          },
          error: function (xhr, textStatus, errorThrown) {
            debugger
            console.log("AJAX Request Failed", textStatus, errorThrown);
          }
      });
    }

    function oncancelPayment() {
      debugger
      $('#error-message').hide();
      $('#PopUpPaymentStatus').popup("hide");;
    }


    function onclickPaymentStatus()
    {
      debugger
      var emplcode = $("#PaymentStatusEmplcode").val();
      var Remark = $("#RemarksId").val();
      var TransactionDate = $("#TransactionDate").val();
      var paymentStatus = $("#paymentStatus").val();
      var TransactionreferenceNo = $("#APPLICATION_REFERENCE_NO").val();
      var accountno = $('#PaymentStatusAccountNo').val();
      if (!Remark) {
        debugger
        $('#error-RemarksId').text('Remark is required.');
        return;
      }
      if (paymentStatus==0) {
        debugger
        $('#error-paymentStatus1').text('Payment Status is required.');
        return;
      }
      $.ajax({
        type: "POST",
        url: "/MasterPensioner/UpdatePaymentStatusAjax",
        data: {
          emplcodes: emplcode,
          Remarks: Remark,
          TransactionDates: TransactionDate,
          paymentStatuses: paymentStatus,
          TransactionReferenceNos: TransactionreferenceNo,
          accountNos: accountno

        },
        success: function (result) {
          debugger
          if (result.Status == true)
          {
            toasterSuccessMessage(result.Message);
          }
            location.reload();
        },
        error: function (xhr, status, error) {
          debugger
          console.error("Ajax request failed", error);
          $('#btn_HoldPayment_loading').hide();
          $('#IdHoldPayment').show();
        }
      });
      $('#PopUpHoldPayment').hide();
    }

    $("#TransactionDate").datepicker({
      dateFormat: 'dd-mm-yy',
      changeMonth: true,
      changeYear: true,
    });

  </script>
