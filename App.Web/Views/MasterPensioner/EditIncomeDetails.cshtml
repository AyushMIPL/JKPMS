      $('#SaveDetails').on('click', function (e) {
        var ReasonForChange = $('#ReasonForChange').val();
        var inc_rate = $("#inc_rate").val();
        if (inc_rate === null || inc_rate.trim() === '') {
          e.preventDefault();
          $("#inc_rateArr").text("Rate is Required..");
        }
        else {
          $("#inc_rateArr").text("");
        }
        if (ReasonForChange === null || ReasonForChange.trim() === '') {
          e.preventDefault();
          $("#remarksErr").text("Remarks is Required..");
        }
        else {
          $("#remarksErr").text("");
        }
      });

    $(function () {
      $(".auto").autoNumeric({ aSep: ',', aDec: '.' });
    })

    $("#SaveDetails").click(function () {
      $('.auto').each(function (i) {
        var self = $(this);
        var v = self.autoNumeric('get');
        self.autoNumeric('destroy');
        self.val(v);
      });
    })


    $("#IncomeCode").on('change', function () {
      if ($("#IncomeCode").val() != null) {
        var iCode = $("#IncomeCode").val();
        var value = $("#Empl_Code").val();
        $.ajax({
          url: "@Url.Action("IncomeDropDownAjax", "MasterPensioner")?Value=" + value + "&incomeCode" + iCode,
          type: "Get"
        }).done(function (result) {
          debugger
          if (result == "Error") {
            toasterErrorMessage("This income Code Already Exist For this Pensioner");

          }
          else {
            $("#inc_rate").val(result);
          }
        })
      }
      else {
        $("#inc_rate").val("");
      }
    })

    ////////


    function ClosePopup() {
      location.reload();
      $("#exampleModal").popup("hide");
