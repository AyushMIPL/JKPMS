@model App.Data.Entities.MasterEmployeeIncomes
@{
  ViewBag.Title = "EditIncomeDetails";
  Layout = "~/Views/Shared/_LayoutPensioner.cshtml";
  var roleid = ViewBag.roleidlist;
  var ReasonForChange = @Html.Raw(Model.ReasonForChange);
  var ReasonForChangeString = ReasonForChange.ToString().Trim();
}
@{
  bool showRegion = false;
  if (!string.IsNullOrEmpty(ReasonForChangeString))
  {
    showRegion = true;
  }
}



@section profilePensioner
{
  <div class="panel panel-default">
    <div class="panel-heading clearfix">
      <h4 class="headline Dash_contributorSummary">
        Edit Details:@string.Format("{0} ({1})", ViewBag.Name, ViewBag.ApplicationReferenceNo)

        @*<ul class="tool-bar">

          </ul>*@
      </h4>
    </div>
    <div class="panel-body">
      @using (Html.BeginForm("EditIncomeDetails", "MasterPensioner", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "IdEditIncomeDetails" }))
      {
        @Html.Hidden("PensionerID")
        @Html.HiddenFor(model => model.EmpIncomeID, new { @Value = ViewBag.Id })
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("", new { @class = "text-danger" })

        @Html.HiddenFor(model => model.EmployeeID)
        @Html.HiddenFor(model => model.line_no)
        @Html.HiddenFor(model => model.inc_number)
        @Html.HiddenFor(model => model.inc_hours)
        @Html.HiddenFor(model => model.acct_no)
        @Html.HiddenFor(model => model.department)
        @Html.HiddenFor(model => model.inc_qtd1)
        @Html.HiddenFor(model => model.inc_qtd2)
        @Html.HiddenFor(model => model.inc_qtd3)
        @Html.HiddenFor(model => model.inc_qtd4)
        @Html.HiddenFor(model => model.inc_ytd)
        @Html.HiddenFor(model => model.lo_inc_amt)
        @Html.HiddenFor(model => model.inc_code)



        <div class="row">
          <div class="col-sm-6">
            <div class="form-group hidden">
              @Html.LabelFor(model => model.Empl_Code, "Pensioner ID", new { @class = "col-sm-4 control-label Color-Red-asterisk" })
              <div class="col-sm-8 ">
                @Html.TextBoxFor(m => m.Empl_Code, new { @class = "form-control input-sm disable-textbox", @Value = ViewBag.PensionerID, @readonly = "readonly", placeholder = "Pensioner ID" })
              </div>
            </div>

            <div class="form-group hidden">
              @Html.LabelFor(model => model.inc_code, "Application Reference No *", new { @class = "col-sm-4 control Color-Red-asterisk" })
              <div class="col-sm-8">
                @Html.TextBoxFor(m => m.Empl_Code, new { @class = "form-control input-sm disable-textbox", @Value = ViewBag.ApplicationReferenceNo, @readonly = "readonly", placeholder = "Application Reference No" })
              </div>
            </div>

            <div class="form-group">
              @Html.LabelFor(model => model.inc_code, "Monthly Pension *", new { @class = "col-sm-4 control Color-Red-asterisk" })
              <div class="col-sm-8 disabled">
                @*@Html.DropDownList("inc_code", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })*@
                @*@Html.DropDownList("inc_code", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm disable-textbox  ", @readonly = "readonly" })*@
                @Html.DropDownListFor(model => model.inc_code, null, "---Select---", new { @class = "form-control input-sm", @disabled = "disabled" })
                @*@Html.HiddenFor(model => model.inc_code)*@
              </div>
            </div>



            <div class="form-group">
              @Html.LabelFor(model => model.inc_rate, "Rate *", new { @class = "col-sm-4 control Color-Red-asterisk" })
              @*<div class="col-sm-8">
                  @Html.TextBoxFor(m => m.inc_rate, new { @class = "form-control input-sm allownumericwithdecimal auto disable-textbox", placeholder = "Rate" })
                </div>*@

              <div class="col-sm-8">
                @foreach (var item in ViewBag.permitionlist)
                {
                  if (item.FieldName.Trim() == "inc_rate")
                  {
                    @Html.TextBoxFor(m => m.inc_rate, new { @class = "form-control input-sm allownumericwithdecimal auto disable-textbox" + (item.AllowEdit == true ? "" : "readonlyy"), placeholder = "Rate" })
                  }
                }
                <p id="inc_rateArr" class="red"></p>
              </div>



            </div>
            @*<div class="form-group">
                @Html.LabelFor(model => model.inc_number, new { @class = "col-sm-4 control-label" })
                <div class="col-sm-8">
                  @Html.TextBoxFor(m => m.inc_number, new { @class = "form-control input-sm", placeholder = "Number" })
                </div>
              </div>*@
            <div class="form-group hidden">
              @Html.LabelFor(model => model.hi_inc_amt, "Amount *", new { @class = "col-sm-4 control Color-Red-asterisk" })
              <div class="col-sm-8">
                @Html.TextBoxFor(m => m.hi_inc_amt, new { @class = "form-control input-sm allownumericwithdecimal auto disable-textbox", placeholder = "Amount" })
              </div>
            </div>
            @*Reason for Remarks*@
            <div class="form-group ">
              @Html.LabelFor(model => model.ReasonForChange, "Remark *", new { @class = "col-sm-4 control Color-Red-asterisk " })
              <div class="col-sm-8">
                <div id="ReasonForChangeDiv" class="row hidden">
                  <label>@ReasonForChange</label>
                </div>
              </div>
              @Html.LabelFor(model => model.ReasonForChange, " ", new { @class = "col-sm-4 control  Color-Red-asterisk" })
              <div class="col-sm-8 Editmargin-top">
                @Html.TextAreaFor(m => m.ReasonForChange, new { @class = "form-control input-sm disable-textbox spaceNotAllowed MPSReasRN", placeholder = "Enter your Remark" })
                <p id="remarksErr" class="red"></p>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-4 control-label"></label>
              <div class="col-sm-8">
                <button type="button" class="btn btn-success px-5 height display_none" title="Please Wait While We Process Your Request" id="btn_IncomeBank_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                @*<button type="submit" class="btn btn-success" id="SaveDetails"><i class="fa fa-save"> </i> Update</button>*@

                <button type="submit" id="SaveDetails" class="btn btn-success @(ViewBag.AdminOrSupperAminPerMition == true ? "" : "disabled") @(ViewBag.AddPermission == true ? "" : "disabled") @(ViewBag.EditPermission == true ? "" : "disabled")"><i class="fa fa-save"> </i> Update</button>

                <a href="/MasterPensioner/IncomeIndex/@ViewBag.CId" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
                @*<input type="submit" class="btn btn-success" id="SaveDetails" value="Save" />
                  @Html.ActionLink("Cancel", "IncomeIndex", "MasterPensioner", new { id = @ViewBag.CId }, new { @class = "btn btn-primary" })*@
              </div>
            </div>
          </div>
        </div>

      }
    </div>
  </div>



  @*<div class="panel panel-default">
      <div class="panel-heading clearfix">
        <div class="row">
          <div class="col-sm-12">
            <div class="form-group">
              <div class="col-sm-6">
                <h4 class="headline" style="margin:0px;padding:0px;border:none;">
                  Audit Log - Income Details:
                </h4>
