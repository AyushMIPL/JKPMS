              "fnDrawCallback": function (setting) {
                document.getElementById("loader").style.display = "none";
                document.querySelectorAll('.clearLocatMenuStorage_class').forEach(element => {
                  element.addEventListener('click', clearLocatMenuStorage);
                });
               OpenMessagePopupArr.forEach(function (item, index) {

                  var items = item.split('~')[0];
                  var heading = items.split('_')[0];
                  var message = items.split('_')[1];
                  var element = document.getElementById(item);
                  if (element) {
