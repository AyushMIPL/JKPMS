    $("#SearchType").on("change", function () {
      var selectedValue = $(this).val();
      if (selectedValue == "0") {
        $("#AccountNoDivd").addClass("hidden");
        $("#ReferenceNoDivId").addClass("hidden");
      }
      else if (selectedValue=="1") {
        $("#ReferenceNoDivId").addClass("hidden");
        $("#AccountNoDivd").removeClass("hidden");
      }
      else if (selectedValue=="2") {
        $("#ReferenceNoDivId").removeClass("hidden");
        $("#AccountNoDivd").addClass("hidden");
      }
    });


      function GetReferenceNo() {
        $("#APPLICATION_REFERENCE_NO").autocomplete({
          source: function (request, response) {
            $.ajax({
              url: '/MasterPensioner/GetReferenceNoAjax/?ReferenceNo=' + request.term,
              method: "GET",
              data: { term: request.term },
              success: function (data) {
                debugger
                if (data.length === 0) {
                  toastr.error("Please input a valid Reference No.");
                } else {
                  response($.map(data, function (item) {

                    return { label: item.Text, value: item.Value };
                  }));
                }
              }
            });
          },
        });
      }


    function GetAccountNo() {
      $("#bank_acct_no").autocomplete({
          source: function (request, response) {
            $.ajax({
              url: '/MasterPensioner/GetAccountNoAjax/?accountno=' + request.term,
              method: "GET",
              data: { term: request.term },
              success: function (data) {
                debugger
                if (data.length === 0) {
                  toastr.error("Please input a valid Account No.");
                } else {
                  response($.map(data, function (item) {
                    return { label: item.Text, value: item.Value };
                  }));
                }
              }
            });
          },
        });
      }


          let i = 0;
          var OpenMessagePopupArr = [];
          var OpenMessagePopupApplicationNoArr = [];
          var showHoldPaymentPopupArr = [];
