  <script src="~/Content/endless/LatestJS/jquery.dataTables.min.js"></script>


  <script nonce="@ViewBag.StyleNonce">

        document.getElementById("Btn").addEventListener("click", dobind);
        document.getElementById("IddownloadExcel").addEventListener("click", downloadExcel);        
    

    jQuery(document).ready(function ($) {
      comboTree = $('#RegionNames').comboTree({
        source: @Group,
        isMultiple: true,
        cascadeSelect: true,
