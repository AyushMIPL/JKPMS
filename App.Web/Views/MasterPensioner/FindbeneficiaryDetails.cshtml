                    var id = `Details_${row[0]}_${row[1]} ${row[13]}_${row[11]}_${row[7]}_${row[8]}_${row[15]}_${row[20]}_${row[17]}`;
                    OpenMessagePopupApplicationNoArr.push(id);
                    return ('<span href="#" class="MPCursor" id="' + id + '" >' + data + '...</span>');
                  }
                },

                {
                  "sname": "FirstName",
                  "bsearchable": false,
                  "bsortable": false,
                  "render": function (data, type, row) {
                    return `${row[1]+" "+row[13]}`;
                  }
                },
                { "sname": "Gender" },
                { "sname": "AgeInYears" }, {
                  "sname": "Address1",
                  "bsearchable": false,
                  "bsortable": false,
                  "render": function (data, type, row) {
                    if (row[4].length > 10) {
                      // Get the first 10 characters
                      i = i + 1;
                      var firstTenCharacters = row[4].substring(0, 10);
                      var id = "Address" + "_" + row[4] + "~" + i;
                      OpenMessagePopupArr.push(id);
                      return ('<span href="#" class="MPCursor" id="' + id + '" >' + firstTenCharacters + '...</span>');
                    } else {
                      return (row[16]);
