      function OpenMessagePopup(heading, message) {
        ;
          $("#MHeader").html(heading + '<button  class="MPSClose close" type="button" class="close" title="Close" aria-label="Close" id="ClosePopupWindow"><span aria-hidden="true">&times;</span>');
        $("#MessageText").html(message);
          $("#PopUpShowLargeMessage").popup('show');
          document.getElementById("ClosePopupWindow").addEventListener("click", ClosePopupWindow);

      }
      function ClosePopupWindow() {
        $("#PopUpShowLargeMessage").popup("hide");
        $("#PopUpMessage").popup('hide');
      }

      function clearLocatMenuStorage() {
        localStorage.setItem('activeIndex', "0");
      }

      function downloadExcel(evt) {
          var searchtype = $("#SearchType").val();
          if (searchtype === "0") {
            toastr.error("Please select a valid search type");
            return;
          }
        var isAccountDivVisible = !$("#AccountNoDivd").hasClass("hidden");
        var isReferenceDivVisible = !$("#ReferenceNoDivId").hasClass("hidden");
        if (isAccountDivVisible) {
          var bankAcctNo = $("#bank_acct_no").val();
          if (bankAcctNo.trim() === "") {
            toastr.error("Please input a valid Account No.");
            return;
          }
        }

        if (isReferenceDivVisible) {
          var applicationReferenceNo = $("#APPLICATION_REFERENCE_NO").val();
          if (applicationReferenceNo.trim() === "") {
            toastr.error("Please input a valid Reference No.");
            return;
          }
        }

          try {
              $(evt.target).find("i.fa-spinner").show();
              $('#btn_downloadExcel_loading').show();
              $('#IddownloadExcel').hide();

              // Create XMLHttpRequest object
                var xhr = new XMLHttpRequest();

                // Configure it: POST-request for the URL
                xhr.open('POST', '@Url.Action("BeneficiaryAjaxHandler", "MasterPensioner")', true);
                xhr.responseType = 'arraybuffer'; // Expect binary data

                // Set up event handlers
              xhr.onload = function () {

                  if (xhr.status === 200) {

                        // Success: Convert arraybuffer to blob and initiate download
                        var blob = new Blob([xhr.response], { type: 'application/octet-stream' });
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                    a.download = 'Beneficiary.xlsx'; // Default filename

                        // Check Content-Disposition header for filename if available
                        var disposition = xhr.getResponseHeader('Content-Disposition');
                        if (disposition) {
                            var matches = /filename="([^"]*)"/.exec(disposition);
                            if (matches != null && matches[1]) {
                                a.download = matches[1];
                            }
                        }

                        // Append the anchor to the document body and trigger the download
                        document.body.appendChild(a);
                        a.click();

                        // Clean up
                        window.URL.revokeObjectURL(url);
                      document.body.removeChild(a);

                      $('#btn_downloadExcel_loading').hide();
                      $('#IddownloadExcel').show();
                    } else {
                        // Handle HTTP errors
                      console.error('Error downloading file:', xhr.statusText);
                      $('#btn_downloadExcel_loading').hide();
                      $('#IddownloadExcel').show();
                    }
                };

              xhr.onerror = function () {

                    // Handle network errors
                  console.error('Network error.');
                  $('#btn_downloadExcel_loading').hide();
                  $('#IddownloadExcel').show();
                };

                // Prepare form data and send
                var formData = new FormData();
                formData.append('Tehsil', "");
                formData.append('BeneficiariesType', "");
                formData.append('Gender',"");
                formData.append('RegionNames', $('#RegionNames').val());
                formData.append('AccountStatus',"");
                formData.append('bank_acct_no', $('#bank_acct_no').val());
                formData.append('APPLICATION_REFERENCE_NO', $('#APPLICATION_REFERENCE_NO').val());
                formData.append('isDownload', true);

                // Send the request with form data
                xhr.send(formData);



                 } catch (e) {
                 }
    }
    
      function AddMasterEmployeeExcelDatabase() {
      if ($("#formattedName").val() == "" || $("#formattedName").val() == null || $("#formattedName").val() == undefined || $("#formattedName").val() == "undefined") {
        toasterWarningMessage("First upload the file then save.");
        return false;
      }
      // Create FormData object
      var fileData = new FormData();
      // Adding one more key to FormData object
      fileData.append('formattedName', $("#formattedName").val());
      $.ajax({
        type: "POST",
        url: "@Url.Action("AddMasterEmployeeExcelDatabase", "MasterPensioner")",
        contentType: false, // Not to set any content header
        processData: false, // Not to process data
        data: fileData,
        success: function (data) {
          if (data == "1") {
            toasterSuccessMessage("Save Successfully.");
            location.reload();
          } else {
            toastr.error("Opps! Something went wrong. Please try again.");

          }
        }
      });
    }

   

  </script>
}
