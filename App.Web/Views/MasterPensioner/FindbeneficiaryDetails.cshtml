                  var applicationReferenceNo = parts[1];
                  var name = parts[2];
                  var scheme = parts[3];
                  var bankAccountNo = parts[4];
                  var ifscCode = parts[5];
                  var accountStatus = parts[6];
                  var cbsName = parts[7];
                  var holdPayment = parts[8];
                  var element2 = document.getElementById(item);
                  if (element2) {
                    element2.addEventListener("click", function () {
                      OpenMessagePopupApplicationNo(heading, applicationReferenceNo, name, scheme, bankAccountNo, ifscCode, accountStatus, cbsName, holdPayment);
                    });
                  }
                });               
                debugger
