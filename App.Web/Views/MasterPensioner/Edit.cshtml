          OpenMessagePopupArr.forEach(function (item, index) {
            debugger
            var items = item.split("~")[0];
            var itemArray = items.split('_');
            var oldNew = "Old Remark";
            if (itemArray[1] == 2) {
              oldNew = "New Remark";
            }
            document.getElementById(item).addEventListener("click", function () {
              OpenMessagePopup(oldNew, itemArray[2]);
            });

          });

        },
        "aoColumns": [
            { "sName": "empl_code" },
            { "sName": "update_date" },
            { "sName": "field_name" },
            {
                "sname": "old_value",
                "bsearchable": false,
                "bsortable": false,
                "fnRender": function (oObj) {
                    debugger;
                    if (oObj.aData[3].length > 10) {
                        // Get the first 10 characters
                      var firstTenCharacters = oObj.aData[3].substring(2, 10);
                      i = i + 1;
                      var id = "OpenMessagePopup_1_" + oObj.aData[3]+"~"+i;
                      OpenMessagePopupArr.push(id);
                      return ('<a href="#" class="MPCursor1" id="' + id +'" >' + firstTenCharacters + '...</a>');
                    } else {
                        return (oObj.aData[3]);
                    }
                }
          },

          {
            "sname": "new_value",
            "bsearchable": false,
            "bsortable": false,
            "fnRender": function (oObj) {
              if (oObj.aData[4].length > 10) {
                // Get the first 10 characters
                i = i + 1;
                var firstTenCharacters = oObj.aData[4].substring(2, 10);
                var id = "OpenMessagePopup_2_" + oObj.aData[4]+"~"+i;
                OpenMessagePopupArr.push(id);
                return ('<a href="#" class="MPCursor1" id="' + id + '" >' + firstTenCharacters + '...</a>');
              } else {
                return (oObj.aData[4]);
              }
            }
          },
        ]
      });
      }
