      $('form').submit(function () {
          $('#Beneficiary_EditId').hide();
          $('#Beneficiary_loaderId').show();
          var form = $("#BeneficiaryId");
          if (!form.valid()) {
              $('#Beneficiary_EditId').show();
              $('#Beneficiary_loaderId').hide();
