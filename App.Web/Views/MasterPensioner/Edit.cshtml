  <script nonce="@ViewBag.StyleNonce">

    

  $("#PermanentHalqaPanchayatMunicipalityName").autocomplete({
      source: function (request, response) {
        $.ajax({
          url: '/MasterPensioner/GetPermanentMunicipalityAjax/?term=' + request.term,
          method: "GET",
          data: { term: request.term },
          success: function (data) {
            debugger
            if (data.length === 0) {
              toasterErrorMessage("Permanent Halqa Panchayat Municipality Name is not valid");
              $("#PermanentHalqaPanchayatMunicipalityName").focus().val(""); // Keep the input active
            } else {
              response($.map(data, function (item) {
                return { label: item.Value/*, id: item.Key*/ };
              }));
            }
          }
        });
      },
    });

    $("#PresentHalqaPanchayatMunicipalityName").autocomplete({
      source: function (request, response) {
        debugger; // Open dev tools to check if this is hit
        $.ajax({
          url: '/MasterPensioner/GetPresentMunicipalityAjax?term=' + request.term, // Adjust URL as needed
          type: "GET",
          success: function (data) {
            debugger;
            if (!data || data.length === 0) {
              toasterErrorMessage("Present Halqa Panchayat Municipality Name is not valid");
              $("#PresentHalqaPanchayatMunicipalityName").focus().val(""); // Keep the input active
              return false;
            }
            response($.map(data, function (item) {
              return { label: item.Value };
            }));
          },
          error: function (xhr, status, error) {
            console.error("Error fetching data:", error);
            toasterErrorMessage("Failed to fetch data. Please try again later.");
          }
        });
      }
    });
