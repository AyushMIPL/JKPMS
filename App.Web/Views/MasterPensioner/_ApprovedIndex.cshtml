
@{
  Layout = null;
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h5 class="headline" style="margin:0px;padding:0px;border:none;">
      Approved Applications Details

    </h5>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tblApproved">
      <thead>
        <tr>
          <th>Applicant Name</th>
          <th>Reason</th>
          <th>Employer Name</th>
          <th>Applied Date</th>
          <th>Approval Date</th>
          <th>Request Last Approved By</th>
          <th>Status</th>
          <th></th>
          <th style="display:none"></th>
        </tr>

      </thead>
      <tbody>
      </tbody>
    </table>
  </div>
</div>
