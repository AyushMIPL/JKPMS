        function OpenMessagePopup(heading, message) {
          $("#MHeader").html(heading + '<button  type="button" class="close MPSClose" title="Close" aria-label="Close MPSClose" id="ClosePopupWindow"><span aria-hidden="true">&times;</span>');
            $("#MessageText").html(message);
            $("#PopUpShowLargeMessage").popup('show');
          document.getElementById("ClosePopupWindow").addEventListener("click", ClosePopupWindow);
        }
        function ClosePopupWindow() {
            $("#PopUpShowLargeMessage").popup("hide");
        }

