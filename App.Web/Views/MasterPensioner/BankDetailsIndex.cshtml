                                var status = oObj.aData[4];
                                var statusClass = 'unknown';
                                var statusIcon = '<i class="fa fa-question-circle"></i>';
                                var statusTooltip = 'Unknown Status';
                                if (status === "ACTIVE") {
                                    statusClass = 'badge badge-success';
                                    statusIcon = '<i class="fa fa-check-circle text-success" title="Active"></i>';
                                    statusTooltip = 'Active';
                                } else {
                                    statusClass = 'badge badge-danger';
                                    statusIcon = '<i class="fa fa-times-circle text-success" title="Not Active"></i>';
                                    statusTooltip = 'Not Active';
                                }
                                return '<span class="' + statusClass + '" title="' + statusTooltip + '">' + statusIcon + ' ' + statusTooltip + '</span>';
                            }
