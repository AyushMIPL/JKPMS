    function oncancelHoldPayment() {
      $('#holdPaymentReason').removeClass('error');
      $('#error-message').hide();
      $('#PopUpHoldPayment').popup("hide");;
    }

    function OnclickHoldPayment() {
        $('#btn_HoldPayment_loading').show();
        $('#IdHoldPayment').hide();
      var holdPaymentReason = $('#holdPaymentReason').val();
      if (!holdPaymentReason.trim()) {
        $('#holdPaymentReason').addClass('error');
          $('#error-message').text('Please enter a reason').show();
          $('#btn_HoldPayment_loading').hide();
          $('#IdHoldPayment').show();
        return;
      }
      else {
        $('#holdPaymentReason').removeClass('error');
          $('#error-message').hide();
          $('#btn_HoldPayment_loading').hide();
          $('#IdHoldPayment').show();
      }

      var Id = $('#hiddenIdField').val();
      var paymentStatus = "Y";
      $.ajax({
        type: "POST",
        url: "/MasterPensioner/HoldPaymentStatusAjax",
        data: {
          id: Id,
          HoldPaymentReason: holdPaymentReason,
          holdpaymentStatus: paymentStatus,
        },
        success: function (result) {
            $('#btn_HoldPayment_loading').hide();
            $('#IdHoldPayment').show();
          if (result.Status == true) {
            toasterSuccessMessage(result.Message)
            location.reload();
          }
        },
        error: function (xhr, status, error) {
            console.error("Ajax request failed", error);
            $('#btn_HoldPayment_loading').hide();
            $('#IdHoldPayment').show();
        }
      });
      $('#PopUpHoldPayment').hide();
    }










