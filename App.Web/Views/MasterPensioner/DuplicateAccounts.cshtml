      function AddMasterEmployeeExcelDatabase() {
      if ($("#formattedName").val() == "" || $("#formattedName").val() == null || $("#formattedName").val() == undefined || $("#formattedName").val() == "undefined") {
        toasterWarningMessage("First upload the file then save.");
        return false;
      }
      // Create FormData object
      var fileData = new FormData();
      // Adding one more key to FormData object
      fileData.append('formattedName', $("#formattedName").val());
      $.ajax({
        type: "POST",
        url: "@Url.Action("AddMasterEmployeeExcelDatabase", "MasterPensioner")",
        contentType: false, // Not to set any content header
        processData: false, // Not to process data
        data: fileData,
        success: function (data) {
          if (data == "1") {
            toasterSuccessMessage("Save Successfully.");
            location.reload();
          } else {
            toastr.error("Opps! Something went wrong. Please try again.");

          }
        }
      });
    }



    function MasterEmployeeExcelCancelUpload() {
      window.location.reload();
    }
    function MasterEmployeeExcelUpload() {
      var IsFile = $("#file").val();
      if (IsFile != null && IsFile != "" && IsFile != undefined) {
        var fileUpload = $("#file").get(0);
        var files = fileUpload.files;
        // Create FormData object
        var fileData = new FormData();
        // Looping over all files and add it to FormData object
        for (var i = 0; i < files.length; i++) {
          fileData.append(files[i].name, files[i]);
        }
        $.ajax({
          type: "POST",
          url: "@Url.Action("MasterEmployeeExcelUpload", "MasterPensioner")",
          contentType: false, // Not to set any content header
          processData: false, // Not to process data
          data: fileData,
          success: function (data) {
            if (data != "") {
              $("#formattedName").val(data);
              $("#MasterEmployeeExcelUpload").toggle();
              $("#MasterEmployeeExcelSave").toggle();
              $("#MasterEmployeeExcelCancel").toggle();
              toasterSuccessMessage("Upload Successfully.");
            } else {
              toastr.error("Opps! Somthing went wrong. Please try again.");
            }
          }
        });
      }
    }
    function MasterEmployeeExcelDownload() {
      try {
        var ApplicantIFSCCode = $("#ApplicantIFSCCode").val();
        if (ApplicantIFSCCode == "" || ApplicantIFSCCode == undefined || ApplicantIFSCCode == "undefined") {
           toasterErrorMessage("Select IFSC code before download.");
        } else {

          var xhr = new XMLHttpRequest();
          xhr.open('GET', '/MasterPensioner/MasterEmployeeExcelDownloadAjax?ApplicantIFSCCode=' + ApplicantIFSCCode, true);
          xhr.responseType = 'blob';
          xhr.onload = function () {
            if (xhr.status === 200) {
              var blob = xhr.response;
              var url = window.URL.createObjectURL(blob);
              var a = document.createElement('a');
              a.href = url;
              var name = xhr.getResponseHeader('Content-Disposition').split(" ")[1];
              if (name.indexOf("filename") > -1) {
                name = name.split("=")[1];
              }
                a.download = name;
                a.addClass = Sc_display;
              document.body.appendChild(a);
              a.click();
              window.URL.revokeObjectURL(url);
            } else {
              console.error('Request failed with status:', xhr.status);
            }
          };
          xhr.onerror = function () {
            console.error('Request error');
          };
          xhr.send();
        }
      } catch(e) {

      }
    }

