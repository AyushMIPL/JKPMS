  <input type="hidden" id="hiddenIdField" value="" />


  <div class="custom-popup width-100 confirmClass Sc_display" id="PopUpHoldPayment">

    <div class="padding-md">
      <h4 class="m-top-none"> Are you sure want to De-Activate Payment?</h4>
      <label for="stopPaymentReason">Reason:</label>
      <textarea type="text" id="holdPaymentReason" class="form-control" placeholder="Enter reason"></textarea>
      <div id="error-message" class="errormessage"></div>
    </div>
    <div class="text-center">
      <button type="button" class="btn btn-success px-5 height canceldup" title="Please Wait While We Process Your Request" id="btn_HoldPayment_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
      <a class="btn btn-success m-right-sm @(ViewBag.EditPermission == true ? "" : "disabled")" id="IdHoldPayment" onclick="OnclickHoldPayment()">Yes</a>
      <a class="btn btn-danger" onclick="oncancelHoldPayment()">Cancel</a>
    </div>
  </div>

  <div class="custom-popup width-100 confirmClass Sc_display" id="PopUpResumePayment">
    <div class="padding-md">
      <h4 class="m-top-none"> Are you sure want to Activate Payment?</h4>
      <label for="stopPaymentReason">Reason:</label>
      <textarea type="text" id="resumePaymentReason" class="form-control" placeholder="Enter reason"></textarea>
      <div id="error-message1" class="errormessage"></div>
    </div>
    <div class="text-center">
      <button type="button" class="btn btn-success px-5 height Sc_display" title="Please Wait While We Process Your Request" id="btn_Resume_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
      <a class="btn btn-success   m-right-sm @(ViewBag.EditPermission == true ? "" : "disabled")" id="IdResumePayment" onclick="OnclickResumePayment()"> Yes</a>
      <a class="btn btn-danger" onclick="oncancelResumePayment()">Cancel</a>
    </div>
  </div>

  <div class="custom-popup width-100 confirmClass Sc_display" id="PopUpStopPayment">
    <div class="padding-md">
      <h4 class="m-top-none"> Are you sure want to Stop Payment?</h4>
      <label for="stopPaymentReason">Reason:</label>
      <textarea type="text" id="stopPaymentReason" class="form-control" placeholder="Enter reason"></textarea>
      <div id="error-message2" class="errormessage"></div>
    </div>
    <div class="text-center">
      <a class="btn btn-success m-right-sm @(ViewBag.EditPermission == true ? "" : "disabled")" onclick="OnclickStopPayment()">Yes</a>
      <a class="btn btn-danger" onclick="oncancelStopPayment()">Cancel</a>
    </div>
  </div>

  <div class="custom-popup confirmClass duppopup p-0" data-keyboard="false" data-backdrop="static" id="PopUpShowLargeMessage">
