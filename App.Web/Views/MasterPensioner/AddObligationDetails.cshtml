@model App.Data.Entities.MasterEmployeeObligations

@{
  ViewBag.Title = "AddObligationDetails";
  Layout = "~/Views/Shared/_LayoutPensioner.cshtml";
}
@section profilePensioner
{
  <div class="panel panel-default">
    <div class="panel-heading clearfix">
      <h4 class="headline" style="margin:0px;padding:0px;border:none;">
        Add Details:@string.Format("{0} ({1})", ViewBag.Name, ViewBag.PensionerID)
        
        @*<ul class="tool-bar">
          
        </ul>*@
      </h4>
    </div>
    <div class="panel-body">
      @using (Html.BeginForm("AddObligationDetails", "MasterPensioner", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
      {
        @Html.Hidden("PensionerID")
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="row">
          <div class="col-sm-5">
            @*<div class="form-group">
              @Html.LabelFor(model => model.PensionerID, new { @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.TextBoxFor(m => m.PensionerID, new { @class = "form-control input-sm", placeholder = "Pensioner ID" })
              </div>
            </div>*@
            <div class="form-group">
              @Html.LabelFor(model => model.ObligationCode, new { @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.DropDownList("ObligationCode", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })

              </div>
            </div>
            <div class="form-group">
              @Html.LabelFor(model => model.ObligationRate, new { @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.TextBoxFor(m => m.ObligationRate, new { @class = "form-control input-sm", placeholder = "Obligation Rate" })
              </div>
            </div>
            <div class="form-group">
              @Html.LabelFor(model => model.ObligationLimit, new { @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.TextBoxFor(m => m.ObligationLimit, new { @class = "form-control input-sm", placeholder = "Obligation Limit" })
              </div>
            </div>
            <div class="form-group">
              @Html.LabelFor(model => model.PayLimit, new { @class = "col-sm-4 control-label" })
              <div class="col-sm-8">
                @Html.TextBoxFor(m => m.PayLimit, new { @class = "form-control input-sm", placeholder = "Pensioner ID" })
              </div>
            </div>


            <div class="form-group">
              <label class="col-sm-4 control-label"></label>
              <div class="col-sm-8">
                <button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Save</button>
                @Html.ActionLink("Cancel", "Obligation", "MasterPensioner", new { @ViewBag.Id }, new { @class = "btn btn-primary" })
              </div>
            </div>
          </div>
        </div>

      }
    </div>

  </div>
}
@section scripts{
  <script nonce="@ViewBag.StyleNonce">
    $("#ObligationCode").on('change', function () {
      if ($("#ObligationCode").val() != null) {
        var value = $("#ObligationCode").val();
        $.ajax({
          url: "@Url.Action("obligationDropDownBind", "MasterPensioner")?Value=" + value,
          type: "Get"
        }).done(function (result) {
          debugger
          $("#ObligationRate").val(result.dflt_rate);
          $("#ObligationLimit").val(result.dflt_limit);
          $("#PayLimit").val(result.dflt_pay_limit);
        })
      }
      else {
        $("#ObligationRate").val("");
        $("#ObligationLimit").val("");
        $("#PayLimit").val("");
      }
    })
  </script>
}
