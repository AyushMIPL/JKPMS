@model App.Data.Entities.MasterSuffix

@{
  ViewBag.Title = "Edit";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Update Details
      
      @*<ul class="tool-bar">
        
      </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "Suffix", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      @Html.HiddenFor(model => model.Id)
      <div class="row">
        <div class="col-sm-4">
     
            @Html.LabelFor(model => model.Name, new { @class = "control-label mb-2" })
         
              @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Enter Name Here" })
         
          </div>
          @*<div class="form-group">
            <label for="IsActive" class="col-sm-4 control-label">Status:</label>
            <div class="col-sm-8">
              <div class="checkbox">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
              </div>
            </div>
          </div>*@
          @*<hr>*@
         
            <div class="col-sm-4">
              <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
              <button type="submit" class="btn btn-success height px-5"><i class="fa fa-save"> </i> Update</button>
              <a href="/Suffix/Index" class="btn btn-primary height border-radius line-height"><i class="fa fa-reply"> </i> Back to List</a>
            </div>
          </div>
     
        <div class="col-sm-2">

          <span class="field-validation-error text-danger" id="fileValidate"></span>

        </div>
    
    }
  </div>
</div>
