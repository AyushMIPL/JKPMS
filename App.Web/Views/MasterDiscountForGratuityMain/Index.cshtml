@section scripts{
  <style>
    .select2-container {
      width: 100% !important;
    }
  </style>

  <script nonce="@ViewBag.StyleNonce">

    $(function () {
      doBindData();
    });
    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
        "sAjaxSource": "/MasterDiscountForGratuityMain/AjaxHandler",
        "aoColumns": [

              { "sName": "DateFrom - DateTo" },
              { "sName": "EmployerTypeID" },
              { "sName": "DiscountFactorPercent" },
              { "sName": "MaxYearsToNormalRetirement" },
              {
                "sName": "ID",
                "bSearchable": false,
                "bSortable": false,
                "fnRender": function (oObj) {
                  var strString = '<a href="/MasterDiscountForGratuityMain/Edit/' + oObj.aData[4] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';
                  strString += '&nbsp;<a href="javascript:;"  onclick="javascript:detail(' + oObj.aData[4] + ');" class="btn btn-xs btn-primary" title="Details"><i class="fa fa-list"></i> Details</a>';
                  strString += '&nbsp;<a href="javascript:;"  onclick="javascript:del(' + oObj.aData[4] + ');" class="btn btn-xs btn-danger"> <i class="fa fa-trash-o fa-lg"></i> Delete</a>';
                  return strString;
                }
              }
        ]
      });
    }

