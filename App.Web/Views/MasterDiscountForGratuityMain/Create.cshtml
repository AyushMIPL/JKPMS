@model App.Data.Entities.MasterDiscountForGratuityMain

@{
  ViewBag.Title = "Create";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Add Discount Rate
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Create", "MasterDiscountForGratuityMain", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="row">
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.EmployerTypeID, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              @Html.DropDownList("EmployerTypeID", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-4 control-label">Max Year &nbsp;<i class="fa fa-question-circle fa-lg Public" data-toggle="tooltip" data-placement="bottom" title="Max Year to normal retirement"></i></label>

            <div class="col-sm-8">
              @Html.TextBoxFor(m => m.MaxYearsToNormalRetirement, new { @class = "form-control input-sm exceptNumber", placeholder = "Max Years To Normal Retirement" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.DiscountFactorPercent, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              @Html.TextBoxFor(m => m.DiscountFactorPercent, new { @class = "form-control input-sm allownumericwithdecimal", placeholder = "Discount Factor" })
            </div>
          </div>
        </div>
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.DateFrom, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              <div class="input-group date" id="StartDate">
                @Html.EditorFor(m => m.DateFrom, new { @class = "form-control", placeholder = "Date From" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.DateTo, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              <div class="input-group date" id="EndDate">
                @Html.EditorFor(m => m.DateTo, new { @class = "form-control", placeholder = "Date To" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>
          </div>
          @*<div class="form-group">
              <label for="IsActive" class="col-sm-4 control-label">Status:</label>
              <div class="col-sm-8">
                <div class="checkbox">
                  @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
                </div>
              </div>
            </div>*@
          @*<hr>*@
          <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
              <button type="button" class="btn btn-primary" id="calculateDiscount" onclick="calculate();"><i class="fa fa-calculator"></i> Calculate</button>
              @*<input type="button" class="btn btn-success" value="Calculate" id="calculateDiscount" onclick="calculate();" />*@
              <button type="submit" class="btn btn-success" id="updateInfo" style="display:none" ><i class="fa fa-save"></i> Save</button>
              <a href="/MasterDiscountForGratuityMain/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
              
            </div>
          </div>
        </div>
        <div class="col-sm-2">

          <span class="field-validation-error text-danger" id="fileValidate"></span>

        </div>
      </div>
    }
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl" style="display:none;">
      <thead>
        <tr>
          <th>DateFrom - DateTo</th>
          <th>Public/Police</th>
          <th>Years to<br />Normal Retirement</th>
          <th>Discount Factor (%)</th>
          <th>Formulae</th>
          <th>Discount Factor</th>

        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section scripts{
  <script nonce="@ViewBag.StyleNonce">
    $("#EndDate").change(function (ev) {
      debugger
      var Sdate = $("#DateFrom").val();
      if (Sdate == '') {
        toasterErrorMessage("Please ensure that the End Date is greater than or equal to the Start Date.");
        $("#DateTo").val("")
        return false;
      }
    });
    $("#StartDate").on("change", function (ev) {
      var Sdate = new Date($("#DateFrom").val());
      if (Sdate != '') {
        $('#EndDate').datepicker('setStartDate', Sdate);
      }
    })

    function doBind() {
      var discountfactor = $("#DiscountFactorPercent").val();
      var maxYear = $("#MaxYearsToNormalRetirement").val();

      $.ajax({
        type: 'Get',
        url: '/MasterDiscountForGratuityMain/AjaxDiscountedTable?discountfactor=' + discountfactor + "&maxYear=" + maxYear,
        dataType: 'json'
      }).done(function (result) {
        $("#tbl tbody").empty();
        debugger
        var discountFactor = $("#DiscountFactorPercent").val();
        var empType = $("#EmployerTypeID option:selected").text();
        var date = $("#DateFrom").val() + ($("#DateTo").val() == "" ? "" : (" - " + $("#DateTo").val()));
        $.each(result, function (i, item) {
          var formulae = "1 / (" + (1 + (parseInt(discountFactor) / 100)) + " ^ " + item.YearsToNormalRetirement + ")";
          $("#tbl tbody").append("<tr><td>" + date + "</td><td><span class='badge badge-danger'>" + empType + "</span></td><td>" + item.YearsToNormalRetirement + "</td><td>" + parseFloat(discountFactor).toFixed(2) + "</td><td>" + formulae + "</td><td>" + parseFloat(item.DiscountFactor).toFixed(9) + "</td></tr>");

        });

      })
    }
    function calculate() {
      if ($("#MaxYearsToNormalRetirement").val() == "" || $("#DiscountFactorPercent").val() == "" || $("#DateFrom").val() == "") {
        toasterErrorMessage("Please ensure that Employer type , Max Year,Discount Factor and datefrom field are filled.");
      }
      else {
        $("#calculateDiscount").css('display', "none");
        $("#updateInfo").css('display', "");
        $("#tbl").css('display', "");
        doBind();
      }
    }

    $("#EmployerTypeID").change(function (ev) {
      debugger
      if ($("#EmployerTypeID").val() != "") {
        var Id = $("#EmployerTypeID").val();
        $.ajax({
          type: 'Get',
          url: '/MasterDiscountForGratuityMain/AjaxEmployerType?id=' + Id,
          dataType: 'json'
        }).done(function (result) {
          $("#MaxYearsToNormalRetirement").val(result);
        })
      }
      else {
        $("#MaxYearsToNormalRetirement").val("");
      }
    });

  </script>
}
