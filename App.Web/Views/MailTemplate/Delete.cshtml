@model App.Data.Entities.MailTemplate

@{
    ViewBag.Title = "Delete Email Template";
}

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline">
            Delete Email Template
            <ul class="tool-bar">
                <li>
                    <a href="@Url.Action("Index")" class="btn btn-default btn-xs"><i class="fa fa-arrow-left"></i> Back to List</a>
                </li>
            </ul>
        </h4>
    </div>
    <div class="panel-body">
        <div class="alert alert-danger">
            <h4><i class="fa fa-warning"></i> Are you sure you want to delete this?</h4>
            <p>This will permanently remove the template <b>@Model.TemplateName</b> from the database and it cannot be recovered.</p>
        </div>

        <dl class="dl-horizontal">
            <dt>@Html.DisplayNameFor(model => model.TemplateName)</dt>
            <dd>@Html.DisplayFor(model => model.TemplateName)</dd>

            <dt>@Html.DisplayNameFor(model => model.ProcessKey)</dt>
            <dd>@Html.DisplayFor(model => model.ProcessKey)</dd>

            <dt>@Html.DisplayNameFor(model => model.Subject)</dt>
            <dd>@Html.DisplayFor(model => model.Subject)</dd>

            <dt>@Html.DisplayNameFor(model => model.IsActive)</dt>
            <dd>
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">Active</span>
                }
                else
                {
                    <span class="badge badge-danger">Inactive</span>
                }
            </dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color mt-4">
                <button type="submit" class="btn btn-danger"><i class="fa fa-trash-o"></i> Confirm Delete</button>
                <a href="@Url.Action("Index")" class="btn btn-default">Cancel</a>
            </div>
        }
    </div>
</div>
