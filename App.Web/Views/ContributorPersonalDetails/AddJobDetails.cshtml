                                @Html.ValidationMessageFor(model => model.JobTitleID, "", new { @class = "text-danger" })
                              </div>
                            </div>*@

                        <div class="form-group">
                            @Html.LabelFor(model => model.GradeId, "Grade", htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.DropDownList("GradeId", null, "---Select---", htmlAttributes: new { @class = "form-control" })
                                @*@Html.ValidationMessageFor(model => model.GradeId, "", new { @class = "text-danger" })*@
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.HireDate, "Hire Date *", new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-6">
                                <div class="input-group date" id="Hire">
                                    @Html.EditorFor(m => m.HireDate, new { @class = "form-control", placeholder = "Hire Date" })

                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
