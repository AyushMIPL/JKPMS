                        <div class="form-group">
                            @Html.LabelFor(model => model.DesignationId, "Job Title *", htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.DropDownList("DesignationId", null, "---Select---", htmlAttributes: new { @class = "form-control" })

