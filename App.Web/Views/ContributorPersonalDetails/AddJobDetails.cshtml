                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Expected Retirement Date:</label>
                            @*@Html.LabelFor(model => model.Contributor.ExpectedRetirementDate, new { @class = "col-sm-2 control-label" })*@
                            <div class="col-sm-6">
                                <input type="text" id="ExpectedRetirementDate" name="ExpectedRetirementDate" readonly="readonly" , required data-val="true" data-val-required="Select Expected Retirement Date" class="form-control">
                                @*@Html.TextBoxFor(m => m.Contributor.ExpectedRetirementDate, new { id = "ExpectedRetirementDate", @class = "form-control", placeholder = "Expected RetirementDate", @readonly = "readonly" })*@
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.JoiningDate, "Joining Date *", new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-6">
                                <div class="input-group date" id="join" onclick="loadDate();">
                                    @Html.EditorFor(m => m.JoiningDate, new { @class = "form-control", placeholder = "Joining Date" })


                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ContributionStartDate, "Contribution Start Date", new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-6">
                                <div class="input-group date" id="conStart" >
                                    @Html.EditorFor(m => m.ContributionStartDate, new { @class = "form-control", placeholder = "Contribution Start Date" })
                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        @*<div class="form-group">
                              <label class="col-sm-2 control-label">First Appointment Date:</label>
                              @Html.LabelFor(model => model.Contributor.FirstAppointmentDate, "1st Appointment Date", new { @class = "col-sm-2 control-label" })
                              <div class="col-sm-6">
                                <div class="input-group date" id="First">
                                  @Html.EditorFor(model => model.Contributor.FirstAppointmentDate, new { id = "FirstAppointmentDate", @placeholder = "First Appointment Date" })
                                  <input type="text" id="FirstAppointmentDate" name="FirstAppointmentDate" , required data-val="true" data-val-required="Select First Appointment Date" class="form-control"><span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                  </span>
                                </div>
                              </div>
                            </div>*@

                        <div class="form-group">
                            <label class="col-sm-2 control-label">Last Appointment Date:</label>
                            <div class="col-sm-6">
                                <div class="input-group date" id="LastDate">
                                    @*@Html.EditorFor(model => model.Contributor.LastAppointmentDate, new { id = "LastAppointmentDate", @placeholder = "Last Appointment Date"})*@
                                    <input type="text" id="LastAppointmentDate" name="LastAppointmentDate" class="form-control">
                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
