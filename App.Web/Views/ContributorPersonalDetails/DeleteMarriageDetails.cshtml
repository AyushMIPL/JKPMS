    @using (Html.BeginForm("DeleteMarriageDetails", "ContributorPersonalDetails", new { ID = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      <div class="row">
        <div class="panel-body">
          <div class="col-sm-12">
            @Html.AntiForgeryToken()
            <div class="form-group">
              <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Delete" class="btn btn-sm btn-success" />
                <button type="submit" class="btn btn-success btn-sm" id="btnCancelInfo" onclick="javascript: return RefreshView();">Cancel</button>
              </div>
            </div>

          </div>
        </div>
