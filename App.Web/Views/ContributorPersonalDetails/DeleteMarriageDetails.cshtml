@section Scripts {

<script type="text/javascript">
  function RefreshView() {
    /*window.location.reload();*/
    //alert(window.location.hostname);
    window.location.href = "/ContributorPersonalDetails/MarriageDetails/"+@ViewBag.PersonId;    
