  $(document).ready(function () {
    var dt = $('#tblList').DataTable({
      "processing": true,
      "serverSide": true,
      "sAjaxSource": "@Url.Action("ContributorAjaxHandler", "ContributorPersonalDetails")",
      "columns": [
          {
            "class": "details-control",
            "orderable": false,
            "data": null,
            "defaultContent": ""
          },
          { "sName": "PersonId" },
            { "sName": "PersonName" },
            { "sName": "SystemSalary" },
            { "sName": "Salary" },
            { "sName": "SystemContributorContribution" },
            { "sName": "ContributorContribution" },
            { "sName": "SystemEmployerContribution" },
            { "sName": "EmployerContribution" }
      ],
      "order": [[1, 'asc']]
    });

    // Array to track the ids of the details displayed rows
    var detailRows = [];

    $('#tblList tbody').on('click', 'tr td.details-control', function () {
      var tr = $(this).closest('tr');
      var row = dt.row(tr);
      var idx = $.inArray(tr.attr('id'), detailRows);

      if (row.child.isShown()) {
        tr.removeClass('details');
        row.child.hide();

        // Remove from the 'open' array
        detailRows.splice(idx, 1);
      }
      else {
        tr.addClass('details');
        row.child(format(row.data())).show();

        // Add to the 'open' array
        if (idx === -1) {
          detailRows.push(tr.attr('id'));
        }
      }
    });

    // On each draw, loop over the `detailRows` array and show any child rows
    dt.on('draw', function () {
      $.each(detailRows, function (i, id) {
        $('#' + Id + ' td.details-control').trigger('click');
      });
    });
  });*@


