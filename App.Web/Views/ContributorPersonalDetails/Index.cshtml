@model List<App.Data.Entities.MasterContributor>
@using App.Web.Helper
@{
  ViewBag.Title = "Index";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
  .employer {
    float: right;
    margin-right: 35%;
  }    
  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>

<div class="panel panel-default">
    <div class="panel-body">
        <div class="row py-4">

            <div class="col-sm-3">
                @Html.DropDownList("EmployerName", null, "---All---", htmlAttributes: new { @class = "form-control input-sm" })
            </div>
            <div class="col-sm-3">
                @Html.DropDownList("JobStatusID", null, "---All---", htmlAttributes: new { @class = "form-control input-sm" })
            </div>
        
            <div class="col-sm-3">
                <button type="button" class="btn btn-success height px-5" onclick="detailSearch()"><i class="fa fa-search"></i> Search</button>
            </div>


        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">

        <h4 class="headline headline-contributonindex" >
            Contributors Personal Details

            <ul class="tool-bar inline">
                 
                <li style="margin-right:5px;"><a href="/ContributorPersonalDetails/AddPersonalDetails" data-toggle="tooltip" data-placement="bottom" title="Add details" data-original-title="Add Details"><i class="fa fa-plus"></i></a></li>

            </ul>
        </h4>

    </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>
          <th class="contributionphto">Photo</th>
          <th>JKPS ID</th>
          <th>Person ID</th>
          <th>Name</th>
          <th>Employer Name</th>
          <th>S.S.#</th>
          <th>Gender</th>
          <th>D.O.B.</th>
          <th>Postal Address</th>
          <th>PF Rate</th>
          <th>Effective Date</th>
          <th>Status</th>
          <th></th>
        </tr>

      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

@section Scripts {
  <link href="~/Content/endless/css/newdatatablemodified.css" rel="stylesheet" />
  
  <script nonce="@ViewBag.StyleNonce">


    $(function () {

      debugger
      doBindData();
    });
    function doBindData() {
      var Id = $("#EmployerName").val();
      var JobStatusId = $("#JobStatusID").val();
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        //"bProcessing": true,
        "sAjaxSource": "/ContributorPersonalDetails/ContributorPersonalDetailsAjaxHandler/?Id=" + Id + "&JobStatusId=" + JobStatusId,
        "aoColumns": [
          {
            "sName": "Photo",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {
              if (oObj.aData[0] != null)
                return '<div class="pstyle"><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" /></div>';
              else
                return '<div class="pstyle"><img src="../Images/noimage.jpg" /></div>';

            }
          },
          { "sName": "PersonID" },
            { "sName": "OldPersonID" },
            { "sName": "Name" },
            { "sName": "EmployerName" },
            { "sName": "SocialSecurityNo" },
            {
              "sName": "Gender",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                if (oObj.aData[6] != "M")
                  return '<span > Female </span>';
                else
                  return '<span >Male</span>';
              }
            },
            { "sName": "DateOfBirth" },
            { "sName": "PostalAddress" },
        //{ "sName": "Phone" },
        //{ "sName": "PhoneOffice" },
        {
          "sName": "Pf Rate",
          "bSearchable": false,
          "bSortable": false,
          "fnRender": function (oObj) {
            var strString = "";
            strString += oObj.aData[11];
            if (oObj.aData[12] == "True")
              strString += '<span class="fa fa-times text-danger fa-lg" title="PF Rate has been expired" style="margin-left:10px;"></span>';
            else
              strString += '<span class="fa fa-check-circle text-success fa-lg" title="Active" style="margin-left:10px;"></span>';
            return strString;
          }
        },
            {
              "sName": "Effective Date",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = "";
                strString += oObj.aData[13] + " - " + oObj.aData[14];
                //if(oObj.aData[12]=="True")
                //  strString+='<span class="fa fa-times text-danger fa-lg" title="Expired"></span>';
                //else
                //  strString+='<span class="fa fa-check-circle text-success fa-lg" title="Active"></span>';
                return strString;
              }
            },
        {
          "sName": "Status",
          "bSearchable": false,
          "bSortable": false,
          "fnRender": function (oObj) {
            if (oObj.aData[15] == "1")
              return '<span class="badge badge-success">Active Contributor</span>';
            else if (oObj.aData[15] == "3")
              return '<span class="badge badge-danger">Pensioner</span>';
            else if (oObj.aData[15] == "4")
              return '<span class="badge badge-danger">Resignee </span>';
            if (oObj.aData[15] == "Active Contributor")
              return '<span class="badge badge-success">' + oObj.aData[15] + '</span>';
            else if (oObj.aData[15] == "In-Active")
              return '<select style="width:100% !important" id="' + oObj.aData[16] + '"  onchange="inActiveToActive(' + oObj.aData[16] + ')" class="form-control input-sm" ><option value="1">Active</option><option value="0" selected="selected">In-Active</select>';
            else
              return oObj.aData[15] == "2" ? '<select style="width:100% !important" onchange="changeStatus(' + oObj.aData[16] + ')" id="' + oObj.aData[16] + '" class="form-control input-sm"><option value="1">Active Contributor</option><option value="2" selected="selected">Death In Service</option><option value="4">Resignee</option><option value="5">Supernumerary</option><option value="6">Treasury Unknowns</option><option value="7">Unknown</option></select>' : oObj.aData[15] == "5" ? '<select style="width:100% !important" onchange="changeStatus(' + oObj.aData[16] + ')" id="' + oObj.aData[16] + '" class="form-control input-sm"><option value="1">Active Contributor</option><option value="2" >Death In Service</option><option value="4">Resignee</option><option value="5" selected="selected">Supernumerary</option><option value="6">Treasury Unknowns</option><option value="7">Unknown</option></select>' : oObj.aData[15] == "6" ? '<select style="width:100% !important" onchange="changeStatus(' + oObj.aData[16] + ')" id="' + oObj.aData[16] + '" class="form-control input-sm"><option value="1">Active Contributor</option><option value="2" >Death In Service</option><option value="4">Resignee</option><option value="5">Supernumerary</option><option value="6" selected="selected">Treasury Unknowns</option><option value="7">Unknown</option></select>' : '<select style="width:100% !important" onchange="changeStatus(' + oObj.aData[16] + ')" id="' + oObj.aData[16] + '" class="form-control input-sm"><option value="1">Active Contributor</option><option value="2">Death In Service</option><option value="4">Resignee</option><option value="5">Supernumerary</option><option value="6">Treasury Unknowns</option><option value="7" selected="selected">Unknown</option></select>';

          }
        },
            {
              "sName": "ID",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = '<a href="/ContributorPersonalDetails/Edit/' + oObj.aData[16] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';
                return strString;
              }
            }
        ]
      }).rowGrouping({
        bExpandableGrouping: false,
        iGroupingColumnIndex: 4,
        bHideGroupingColumn: true

      })
      //.columnFilter({
      //  sPlaceHolder: "head:before",
      //  aoColumns: [null,
      //		    	 		null,
      //                            			null,
      //                                  null,
      //		    	 		null,
      //                            			null,
      //                                  null,
      //		    	 		null,
      //                            			null,
      //                                  null,
      //                                  { type: "select", values: ['Active Contributor', 'Death In Service', 'Pensioner', 'Resignee', 'Supernumerary'] },
      //  ]

      //});
    }


    function changeStatus(Id) {
      debugger
      //var id = Id;
      var jobstatus = $('#' + Id).val();
      if (jobstatus != "") {
        $("#hdDocumentId").val(Id);
        $("#hdActiveOrDelete").val(jobstatus);
        $("#hdIsVerified").val("status");
        $("#statusRecord").text("Do You want to change Job Status of this Contributor?");
        $('#confirmCancel').popup("show");
      }
    }
    const onConfirmSelect_ClassBtn = document.querySelectorAll('.onConfirmSelect_Class');
    onConfirmSelect_ClassBtn.forEach(button => {
      button.addEventListener('click', onConfirmSelect);
    });

    function onConfirmSelect() {
      debugger
      $('#confirmCancel').popup("hide");
      if ($("#hdIsVerified").val() == "status") {
        var id = $("#hdDocumentId").val();
        var jobstatus = $("#hdActiveOrDelete").val();
        $.ajax({
          url: "@Url.Action("changeStatusAjax", "ContributorPersonalDetails")?Id=" + id + "&jobstatus=" + jobstatus,
          type: "GET",
        }).done(function (result) {
          if (result == 1) {
            toasterSuccessMessage("Status changed sucessfully.");
          }
          else {
            toasterErrorMessage("There is some error, please try again.");
          }
        })
      }
      else {
        var id = $("#hdDocumentId").val();
        var status = $("#hdActiveOrDelete").val();
        $.ajax({
          url: "@Url.Action("inActiveToActiveAjax", "ContributorPersonalDetails")?Id=" + id + "&status=" + status,
          type: "GET",
        }).done(function (result) {
          if (result == 1) {
            toasterSuccessMessage("Status changed sucessfully.");
          }
          else {
            toasterErrorMessage("There is some error, please try again.");
          }
        })
      }
      doBindData();
    }
    const onCancel_ClassBtn = document.querySelectorAll('.onCancel_class');
    onCancel_ClassBtn.forEach(button => {
      button.addEventListener('click', onCancel);
    });
    function onCancel() {
      $('#confirmCancel').popup("hide");
    }
    function inActiveToActive(Id) {
      debugger
      var jobstatus = $('#' + Id).val();
      if (jobstatus != "") {
        $("#hdDocumentId").val(Id);
        $("#hdActiveOrDelete").val(jobstatus);
        $("#hdIsVerified").val("InActive");
        if (jobstatus == "1") {
          $("#statusRecord").text("Do you want to Activate this Contributor ? ");
        }
        else {
            $("#statusRecord").text("Do you want to In-Active this Contributor ?  ");
        }
        $('#confirmCancel').popup("show");
      }
    }

    @*function del(ctrlId) {
        $("#hdDocumentId").val(ctrlId);
        $('#confirmDelete').popup("show");
      }
      function onDeleteConfirm() {
        var id = $("#hdDocumentId").val();
        $.ajax({
          url: "@Url.Action("Remove", "ContributorPersonalDetails")?Id=" + id + "",
          type: "GET",
        })
      .done(function (result) {
        var actionRes = result;
        if (actionRes == "0") {
          toasterErrorMessage("There is some error, please try again.");
          return actionRes;
        }
        else {
          toasterSuccessMessage("Status changed sucessfully.");
          $('#confirmDelete').popup("hide");
          doBindData();
        }
      });
      }*@



    $(document).ajaxStop(function () {
      $('select').select2({
        placeholder: "---Select---",
        allowClear: true
      });
    });

    $("#EmployerName").on('change', function () {
      var Id = $("#EmployerName").val();
      if (Id != "") {
        doBindData();
      }
    })
    $("#JobStatusID").on('change', function () {
      var JobStatusId = $("#JobStatusID").val();
      if (JobStatusId != "") {
        doBindData();
      }
    })

  </script>
}
