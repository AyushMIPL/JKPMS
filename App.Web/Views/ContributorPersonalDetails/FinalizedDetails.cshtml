  <div class="panel-body">
    @using (Html.BeginForm("FinalizedDetails", "ContributorPersonalDetails", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
      @Html.ValidationSummary("", new { @class = "text-danger" })

      <!--<div class="form-group">
        <div class="pull-right">
          <button type="button" id="finalButton" class="btn btn-success btn-xs" onclick="finalize()" disabled>Finalize</button>
