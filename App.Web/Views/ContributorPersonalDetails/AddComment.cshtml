@model App.Data.Entities.ContributorComments

@{
  ViewBag.Title = "CommentList";
  Layout = "~/Views/Shared/_LayoutProfile.cshtml";
}
@section profileContainer
{
  @Html.Hidden("PersonID")
  @Html.Hidden("CId")
  @Html.Hidden("ActiveContributor")
  <div class="panel panel-default">
    <div class="panel-heading clearfix">
      <h4 class="headline" style="margin:0px;padding:0px;border:none;">
        Comments:: @string.Format("{0} ({1})", ViewBag.Name, ViewBag.PersonID)

        <ul class="tool-bar">
          <li><a href="javascript:comment();" data-toggle="tooltip" data-placement="bottom" title="Add Comment" data-original-title="Add Comment"><i class="fa fa-plus"></i></a></li>

        </ul>
      </h4>
    </div>

    <div class="row" id="divcomment">
      <div class="col-sm-14">
        <div class="form-group">
          <div class="col-sm-12">
            @Html.TextAreaFor(model => model.Comments, 8, 8, new { @class = "form-control input-sm", placeholder = "Add Comments" })
          </div>
        </div>
        <div class="form-group">
          <label class="col-sm-4 control-label"></label>
          <div class="col-sm-8">
            <button type="button" class="btn btn-success" onclick="AddComment()"><i class="fa fa-save"> </i> Add Comment</button>
            <button type="button" class="btn btn-primary" onclick="dobind()"><i class="fa fa-reply"> </i> Back to List</button>
          </div>
        </div>
      </div>
    </div>


    <div class="panel-body">
      <table class="table dataTable" id="tbl">
        <thead>
          <tr>
            <th>Comments</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

}
@section Scripts {

  <script src="~/Content/endless/js/jquery.dataTables.min.js"></script>
  <script nonce="@ViewBag.StyleNonce">
    function comment() {
      $("#divcomment").show();
    }

    $(function () {
      if ($("#ActiveContributor").val() == "No") {
        $(".tool-bar").hide();
      }
      dobind()
    });
    function dobind() {
      var personID = $("#PersonID").val();
      $("#Comments").val("");
      $("#divcomment").hide();
      debugger;
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/ContributorPersonalDetails/CommentAjaxHandler/?PersonID=" + personID,
        "aoColumns": [

						{ "sName": "Comments" },
						{ "sName": "Date" }
        ]
      });
    }

    function AddComment() {
      var contributorID = $("#PersonID").val();
      var comments = $("#Comments").val();
      if (comments == "") {
        toasterErrorMessage("Please Enter Comment First..")
      }
      else {
        $.ajax({
          url: "@Url.Action("AddComments", "ContributorPersonalDetails")?PersonID=" + contributorID + "&Comments=" + comments,
          type: "Get"
        }).done(function (result) {
          if (result > 0) {
            toasterSuccessMessage("Comment Added Sucessfully.");
          }
        })
        dobind();
      }
    }
  </script>
}



