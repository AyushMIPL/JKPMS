            var NewEntry = $("#NewEntry").val();
            if (NewEntry != null && NewEntry != "") {
              if (newdata != 0) {
                debugger;
                $('#confirmCancel').popup("show");
              } else {
                $('#newDatasaveconfirm').popup("show");
              }
            }
          } else {
            onConfirmSelect();
          }
        },
