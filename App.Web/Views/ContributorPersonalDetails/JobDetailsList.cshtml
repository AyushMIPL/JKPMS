@section Scripts {
  <script nonce="@ViewBag.StyleNonce">



    function AddMarriageDetails() {
      event.preventDefault();
    }
    function RefreshView() {
      window.location.reload();
      return false;
    }

    function doDeleteDocument(docId, activeOrDelete) {
      debugger;
      event.preventDefault();
      $("#hdDocumentId").val(docId);
      $("#hdActiveOrDelete").val(activeOrDelete);
      if (activeOrDelete == 1)
        $('#confirmActive').popup("show");
      else
        $('#confirmDelete').popup("show");
    }
    function onDeleteConfirm() {
      var docId = $("#hdDocumentId").val();
      var isActive = $("#hdActiveOrDelete").val();
      if (isActive == "1")
        $('#confirmActive').popup("hide");
      else
        $('#confirmDelete').popup("hide");

      //Delete or Active document
      $.ajax({
        url: "@Url.Action("DeleteDocument", "UserProfile")?Id=" + docId + "&IsActive=" + isActive + "",
        type: "GET",
        async: true,
      })
			.done(function (result) {
			  var actionRes = result;
			  if (actionRes == "0") {
			    toasterErrorMessage("There is some error, please try again.");
			    return actionRes;
			  }
			  else {
			    toasterSuccessMessage("Status changed sucessfully.");
			    window.location.reload();
			    return actionRes;
			  }
			});

    }

    function doUpdateVerify(id, ctrl) {
      debugger;
      event.preventDefault();
      var isverify = "0";
      if ($('#' + ctrl.id + '').is(":checked")) {
        isverify = "1";
      }
      $("#hdDocumentId").val(id);
      $("#hdIsVerified").val(isverify);
      $('#confirmVerify').popup("show");

    }
    function onVerifyConfirm() {
      var docId = $("#hdDocumentId").val();
      var isverify = $("#hdIsVerified").val();
      $('#confirmVerify').popup("hide");
      $.ajax({
        url: "@Url.Action("UpdateVerify", "UserProfile")?Id=" + docId + "&IsVerify=" + isverify + "",
        type: "GET",
        async: false,
      })
		.done(function (result) {
