@model IEnumerable<App.Data.Entities.MasterContributorJobDetails>
@{
  ViewBag.Title = "Job Details";
  Layout = "~/Views/Shared/_LayoutProfile.cshtml";
}
@section profileContainer
{@Html.Hidden("PersonId")
  <div class="panel panel-default">
    <div class="panel-heading clearfix">
      <h4 class="headline" style="margin:0px;padding:0px;border:none;">
        Job Details : @string.Format("{0} ({1})", ViewBag.Name, ViewBag.PersonId)
        
        <ul class="tool-bar">
          <li><a href="/ContributorPersonalDetails/AddJobDetails/@ViewBag.PersonId" data-toggle="tooltip" data-placement="bottom" title="Add Job Details" data-original-title="Add Job Details"><i class="fa fa-plus"></i></a></li>
          
        </ul>
      </h4>
    </div>
    <div class="panel-body">
      <table class="table dataTable" id="tbl">
        <thead>
          <tr>
            <th>Employer Name</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Employment Type</th>
            <th>Hire Date</th>
            <th>Present Salary</th>
            <th>Status</th>
            <th style="width:110px"></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
}
@section Scripts {
<script src="~/Content/endless/js/jquery.dataTables.min.js"></script>
  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });
    function doBindData() {
      var personId = $("#PersonId").val();
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/ContributorPersonalDetails/JobAjaxHandler/?PersonId=" + personId,
        "aoColumns": [

          { "sName": "EmployerName" },
          { "sName": "Department" },
          { "sName": "Designation" },
          { "sName": "EmploymentType" },
          { "sName": "HireDate" },
          { "sName": "PresentSalary" },
          { "sName": "ActiveStatus",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                if (oObj.aData[6] == "False")
                  return '<span class="badge badge-danger">inactive</span>';
                else
                  return '<span class="badge badge-success">active</span>';
              }
            },
            {
              "sName": "ID",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = '<a href="/ContributorPersonalDetails/EditJobDetails/' + oObj.aData[7] + '\" class="btn btn-success btn-xs">Edit</a>';
                strString += '&nbsp;<a href="/ContributorPersonalDetails/DeleteJobDetails/' + oObj.aData[7] + '\" class="btn btn-primary btn-xs">Delete</a>';

                return strString;
              }
            }
        ]
      });
    }
  </script>
}



