@model App.Data.Entities.MasterDependantDetails

@{
    ViewBag.Title = "Add";
    Layout = "~/Views/Shared/_LayoutProfile.cshtml";
}

@section profileContainer
{
    <div class="panel panel-default">
        <div class="panel-heading">
            <h4 class="headline" style="margin:0px;padding:0px;border:none;">
                Add Dependant Details  : @string.Format("{0} ({1})", ViewBag.Name, ViewBag.PersonId)

            </h4>
        </div>
        @using (Html.BeginForm("AddDependantDetails", "ContributorPersonalDetails", new { ID = (Model == null ? string.Empty : Model.Id.ToString()) }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
            @Html.Hidden("RequestFrom")
            <div class="row">
                <div class="panel-body">
                    <div class="col-sm-12">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary("", new { @class = "text-danger" })
                        @Html.Hidden("id")
                        @Html.Hidden("DependantTerminationAge")
                        <div class="form-group">
                            @Html.LabelFor(model => model.PersonID, htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.TextBoxFor(m => m.PersonID, new { @class = "form-control", placeholder = "JKPS ID", @Value = ViewBag.PersonID, @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.PersonID, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                                @*@Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })*@
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.MidName, htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.MidName, new { htmlAttributes = new { @class = "form-control" } })
                                @*@Html.ValidationMessageFor(model => model.MidName, "", new { @class = "text-danger" })*@
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                                @*@Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })*@
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Gender, htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.Gender, new { htmlAttributes = new { @class = "form-control" } })
                                @*@Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })*@
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.DateOfBirth, new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-6">
                                <div class="input-group date" id="Date">
                                    @Html.EditorFor(model => model.DateOfBirth, new { @placeholder = "DateOfBirth" })
                                    <span class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.RelationshipID, "Relationship *", htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.DropDownList("RelationshipID", null, "---Select---", htmlAttributes: new { @class = "form-control" })
                                @*@Html.ValidationMessageFor(model => model.RelationshipID, "", new { @class = "text-danger" })*@
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.TerminationDate, htmlAttributes: new { @class = "control-label col-lg-2" })
                            <div class="col-md-6">
                                @Html.TextBoxFor(m => m.TerminationDate, new { @class = "form-control", placeholder = "Termination Date", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="IsActive" class="col-sm-2 control-label">Status:</label>
                            <div class="col-sm-6">
                                <div class="checkbox">
                                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm", @checked = "checked" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Save</button>
                                <a id="backtolist" href="/ContributorPersonalDetails/DependantDetailsIndex/@ViewBag.CId" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/Scripts/Master.js"></script>
    <script type="text/javascript">
        $(function () {
            if ($("#RequestFrom").val() == "True") {
                debugger
                $("#backtolist").attr('href', '/ContributorPersonalDetails/errorsInContributorDetails');
            }
        })
        $('.input-group.date').datepicker({
            format: 'mm/dd/yyyy',
            autoclose: true,
            todayHighlight: true
        });
        var dep = $("#DependantTerminationAge").val();
        var date = new Date();
        var dob = (date.getMonth() + 1) + "/" + (date.getDate() + 1) + "/" + (date.getFullYear() - dep);
        $('#Date').datepicker({
            startDate: dob,
            endDate: date,
            startView: 1,
            format: "mm/dd/yyyy",
            autoclose: true
        });


        $(document).on('change', '#DateOfBirth', function () {
            var dep = $("#DependantTerminationAge").val();
            var date = new Date($("#DateOfBirth").val());
            if (!isNaN(date.getTime())) {
                var d = (date.getMonth() + 1) + "/" + date.getDate() + "/" + (date.getFullYear() + parseInt(dep));
                $("#TerminationDate").val(d);
            } else {
                toasterErrorMessage("Invalid Date");
            }
        })
        @*$(document).on('change','#DateOfBirth',function () {
      var date = new Date($("#DateOfBirth").val());
      var personID=$("#PersonID").val();
      if(!isNaN(date.getTime())){
        $.ajax({
          url: "@Url.Action("DependantTerminationDateIndex", "ContributorPersonalDetails")?PersonId=" + personID,
          type: 'Get',
        dataType: 'json'
      }).done(function (result) {
        var age=result.TerminationAtAge;
        var c = date.getMonth() == 0 ? 12 : date.getMonth();
        var d=c + "/" + date.getDate() + "/" + (date.getFullYear()+age);
        $("#TerminationDate").val(d);
      });



    } else {
        toasterErrorMessage("Invalid Date");
    }
    });*@
        
    </script>
}
