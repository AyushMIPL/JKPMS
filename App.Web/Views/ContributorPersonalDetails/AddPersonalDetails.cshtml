@section Scripts {
  <script src="~/Scripts/FileUpload.js"></script>
  <script src="~/Scripts/ContributorDetails.js"></script>
  <script nonce="@ViewBag.StyleNonce">
    $('.input-group.date').datepicker({
      format: 'mm/dd/yyyy',
      autoclose: true,
      todayHighlight: true      
    });
    $(function () {
      $.ajax({
        url: "@Url.Action("PersonIDAjax", "ContributorPersonalDetails")",
        type: 'Get',
        dataType: 'json'
      }).done(function (result) {
        $("#PersonID").val(result);
      });
      country();
    })

    
    


    

    $("#Email").on('blur', function () {
      var PersonID = $("#PersonID").val();
      var OldPersonID = $("#OldPersonID").val();
      var email = $("#Email").val();
      if (email != "") {
        $.ajax({
          type: 'Get',
          url: '/ContributorPersonalDetails/EmailAjax?Email=' + email + "&personID=" + PersonID + "&oldPersonID=" + OldPersonID,
          dataType: 'json'
        }).done(function (result) {
          if (result != "0") {
            toasterErrorMessage("This Email Id already exist");
            $("#Email").val("");
          }
        });
      }
    })

    $("#CountryID").change(function () {
      country();
    })

  </script>
