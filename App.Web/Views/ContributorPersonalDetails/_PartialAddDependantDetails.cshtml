@model App.Data.Entities.MasterDependantDetails
@{
  //Layout = null;
}

@{
  AjaxOptions options = new AjaxOptions();
  options.HttpMethod = "POST";
  options.InsertionMode = InsertionMode.Replace;
  options.UpdateTargetId = "divContainer";
}


@using (Ajax.BeginForm("_PartialAddDependantDetails", options))
{
  <div class="panel panel-default">
    <div class="form-horizontal">
      <h4>Contributor Dependant Details</h4>
      <hr />
      @Html.AntiForgeryToken()
      @Html.ValidationSummary(true, "", new { @class = "text-danger" })
      <div class="form-group">
        @Html.LabelFor(model => model.PersonID, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.TextBoxFor(m => m.PersonID, new { @class = "form-control", placeholder = "JKPS ID", @Value = ViewBag.PersonID, @readonly = "readonly" })
          @Html.ValidationMessageFor(model => model.PersonID, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.FirstName, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.MidName, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.MidName, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.MidName, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.Gender, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.Gender, new { @class = "form-control" })
          @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.DateOfBirth, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.DateOfBirth, new { htmlAttributes = new { @class = "form-control", @format = "MM/dd/yyyy" } })
          @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.RelationshipID, "Relationship", htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.DropDownList("RelationshipID", null, htmlAttributes: new { @class = "form-control" })
          @Html.ValidationMessageFor(model => model.RelationshipID, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.TerminationDate, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.TerminationDate, "DateOfBirth", new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.TerminationDate, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          <div class="checkbox">
            @Html.EditorFor(model => model.IsActive, new { @class = "form-control input-sm", @checked = "checked" })
            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="panel-footer clearfix">
    <div class="pull-left">
      <button class="btn btn-success btn-sm" id="prevStep1">Previous</button>
      @*<button type="submit" class="btn btn-sm btn-success">+ Add More</button>*@
      <button type="submit" class="btn btn-sm btn-success" id="nextStep1">Next</button>
    </div>
  </div>

}

