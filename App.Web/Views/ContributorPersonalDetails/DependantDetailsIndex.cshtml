@model IEnumerable<App.Data.Entities.MasterDependantDetails>
@{
  ViewBag.Title = "Dependant Details";
  Layout = "~/Views/Shared/_LayoutProfile.cshtml";
}
@section profileContainer
{
  @Html.Hidden("PersonId")
  @Html.Hidden("id")
@Html.Hidden("ActiveContributor")
  <div class="panel panel-default">
    <div class="panel-heading clearfix">
      <h4 class="headline" style="margin:0px;padding:0px;border:none;">
        Dependant Details: @string.Format("{0} ({1})", ViewBag.Name, ViewBag.PersonId)
        
        <ul class="tool-bar">
          <li><a href="/ContributorPersonalDetails/AddDependantDetails/@ViewBag.CId" data-toggle="tooltip" data-placement="bottom" title="Add Dependant Details" data-original-title="Add Dependant Details"><i class="fa fa-plus"></i></a></li>
          
        </ul>
      </h4>
    </div>
    <div class="panel-body">
      <table class="table dataTable" id="tbl">
        <thead>
          <tr>
            <th>Relationship</th>
            @*<th>JKPS ID</th>*@
            <th>First Name</th>
            <th>Mid Name</th>
            <th>Last Name</th>
            <th>Gender</th>
            <th>Date Of Birth</th>
            <th>Termination Date</th>
            <th>Status</th>
            <th style="width:110px"></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
}
@section Scripts {

  <script src="~/Content/endless/js/jquery.dataTables.min.js"></script>
  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      if ($("#ActiveContributor").val() == "No") {
        $(".tool-bar").hide();
      }
      doBindData();
    });
    function doBindData() {
      var personId = $("#PersonId").val();
      var oTable = $('#tbl').DataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/ContributorPersonalDetails/DepandantAjaxHandler/?PersonId=" + personId,
        "aoColumns": [

						{ "sName": "Relationship" },
            //{ "sName": "PersonId" },
            { "sName": "FirstName" },
            { "sName": "MidName" },
            { "sName": "LastName" },
            {
              "sName": "Gender",
              "fnRender": function (oObj) {
                if (oObj.aData[4] == "M")
                  return "Male";
                else
                  return "Female";
              }
            },
            { "sName": "DateOfBirth" },
            { "sName": "Termination Date" },
            {
              "sName": "ActiveStatus",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                if (oObj.aData[7] == "False")
                  return '<span class="badge badge-danger">inactive</span>';
                else
                  return '<span class="badge badge-success">active</span>';
              }
            },
            {
              "sName": "ID",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = '<a href="/ContributorPersonalDetails/EditDependantDetails/' + oObj.aData[8] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';

                //strString += '&nbsp;<a href="/ContributorPersonalDetails/DeleteDependantDetails/' + oObj.aData[8] + '\" class="btn btn-primary btn-xs">Delete</a>';

                return strString;
              }
            }
        ]
      });
    }
  </script>
}



