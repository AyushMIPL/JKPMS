      var date = new Date($("#DateOfBirth").val());
      var personID=$("#PersonID").val();
      if(!isNaN(date.getTime())){
        $.ajax({
          url: "@Url.Action("DependantTerminationDateIndex", "ContributorPersonalDetails")?PersonId=" + personID,
          type: 'Get',
          dataType: 'json'
        }).done(function (result) {
          var age=result.TerminationAtAge;
          var c = date.getMonth() == 0 ? 12 : date.getMonth();
          var d=c + "/" + date.getDate() + "/" + (date.getFullYear()+age);
          $("#TerminationDate").val(d);
        });



      } else {
        toasterErrorMessage("Invalid Date");
      }
