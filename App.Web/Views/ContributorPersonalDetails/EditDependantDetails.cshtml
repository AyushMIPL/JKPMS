        $(function () {
            if ($("#RequestFrom").val() == "True") {
                debugger
                $("#backtolist").attr('href', '/ContributorPersonalDetails/errorsInContributorDetails');
            }
            if ($("#ActiveContributor").val() == "No") {
                $(".form-control").each(function () {
                    $(this).prop("disabled", "disabled");
                });
                $(".checkbox").each(function () {
                    $(this).prop("disabled", "disabled");
                });
                $(".btn-success").prop("disabled", "disabled");
            }
        })


    </script>
}

