            </div>
            <div class="form-group">
              @Html.LabelFor(model => model.FirstName, "First Name *", new { @class = "col-sm-3 control-label" })
              <div class="col-sm-9">
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control input-sm", placeholder = "First Name" })
              </div>
            </div>
            <div class="form-group">
              @Html.LabelFor(model => model.MidName, new { @class = "col-sm-3 control-label" })
              <div class="col-sm-9">
                @Html.TextBoxFor(m => m.MidName, new { @class = "form-control input-sm", placeholder = "Mid Name" })
              </div>
