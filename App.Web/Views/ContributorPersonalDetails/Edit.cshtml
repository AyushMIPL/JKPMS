            </div>
            <div class="form-group">
              @Html.LabelFor(model => model.Email, new { @class = "col-sm-3 control-label" })
              <div class="col-sm-9">
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control input-sm", placeholder = "Email", onblur = "checkEmail()" })
              </div>
            </div>
            @*<div class="form-group">
                @Html.LabelFor(model => model.SalaryAmount, new { @class = "col-sm-3 control-label" })
                <div class="col-sm-9">
                  @Html.TextBoxFor(m => m.SalaryAmount, new { @class = "form-control input-sm", placeholder = "Salary Amount" })
                  @Html.ValidationMessageFor(model => model.SalaryAmount, "", new { @class = "text-danger" })
                </div>
              </div>*@
            <div class="form-group">
