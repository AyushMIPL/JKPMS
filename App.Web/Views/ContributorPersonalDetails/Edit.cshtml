              </div>
            </div>


            @if (Model.ShowTable)
            {
              <div class="form-group">
                @*<label class="col-lg-1 control-label"></label>*@
                <div class="col-sm-12">
                  <ul class="list-group collapse in" id="EmployerSummary">
                    <li class="list-group-item clearfix">
                      <table class="contributiontable-edit">
                        <tr>
                          <th class="contributionpf-edit" style="width:30%;">Pf For</th>
                          <th class="contributionrate-edit" style="width:10%;">PF Rate</th>
                          <th class="contributiondate-edit" style="width:30%;">Effective Date</th>
                          <th class="contributioncreateon-edit" style="width:15%;">Created On</th>
                          <th class="contributionmodified-edit" style="width:15%;">Modified On</th>
                        </tr>
                      </table>
                    </li>
                    @foreach (var List in ViewBag.ChangedPfRateList)
                    {
                      <li class="list-group-item clearfix">
                        <table style="width:100%;margin:5px;">
                          <tr>
                            <th style="width:30%;">
                              @if (List.IsApplied)
                              {
                                <i class="fa fa-check-circle text-success fa-lg" style="margin-right:5px;" title="Applied"></i>
                              }
                              @if (List.IsExpired)
                              {
                                <i class="fa fa-times-circle text-danger fa-lg" style="margin-right:5px;" title="PF Rate has been expired"></i>
                              }
                            @List.PfRateName
                            </th>
                            <th style="width:10%;">@List.PFRate</th>
                            <th style="width:30%;">@List.StringEffiectiveDate - @List.StringEffectiveEndDate</th>
                            <th style="width:15%;">@List.StringCreatedOn</th>
                            <th style="width:15%;">
                              @List.StringModifiedOn
                            </th>
                          </tr>
                        </table>
                      </li>
                    }

                  </ul>
                </div>
              </div>
            }

            @*<div class="form-group">
                @Html.Label("EmployerContribution", "Employer's Contribution", new { id = "EmployerContribution", @class = "col-sm-3 control-label" })
                <div class="col-sm-9">
                  @Html.TextBox("EmployerContributionAmount", "0.00", new { id = "EmployerContributionAmount", name = "EmployerContribution", @class = "form-control input-sm", @readonly = "readonly" })
                </div>
              </div>
              <div class="form-group">
                @Html.Label("ContributorContribution", "Contributor's Contribution", new { id = "ContributorContribution", @class = "col-sm-3 control-label" })
                <div class="col-sm-9">
                  @Html.TextBox("ContributorContributionAmount", "0.00", new { id = "ContributorContributionAmount", name = "ContributorContributionAmount", @class = "form-control input-sm", @readonly = "readonly" })
                </div>
              </div>*@
            @*<div class="form-group">
                @Html.LabelFor(model => model.JobStatusID, "Job Status", new { @class = "col-sm-3 control-label" })
                <div class="col-sm-9">
                  @Html.DropDownList("JobStatusID", null, "Select Job Status", htmlAttributes: new { @class = "form-control" })
                </div>
              </div>*@
            <div class="form-group">
              @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-lg-3" })
              <div class="col-sm-9">
                <div class="checkbox">
                  @Html.EditorFor(model => model.IsActive)
                  @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger", @checked = "checked" })
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-lg-3"></label>
              <div class="col-sm-9">
                <button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Save</button>
                <a id="backtolist" href="/ContributorPersonalDetails/Index" class="btn btn-primary"> <i class="fa fa-reply"> </i> Back to List</a>
                @*<button type="submit" class="btn btn-success btn-sm" id="btnCancelInfo" onclick="javascript: return RefreshView();">Cancel</button>*@
              </div>
            </div>

          </div>
        </div>
        <div class="col-sm-2">

          <div style="border-radius: 13px;padding: 5px;" class="media">
            @if (Model.ProfilePath != null)
            {
              var path = SiteHelper.GetProfileImagePath + Model.ProfilePath;
              <a href="#" class="thumbnail pull-left" onclick="javascript: return ShowUpload('NewfileUploadProfile')">
                <img id="imgProfileNew" class="editable img-responsive" alt="Alex's Avatar" src='@path' style="cursor:pointer;" title="Upload Image" />
              </a>
            }
            else
            {
              <a href="#" class="thumbnail pull-left" onclick="javascript: return ShowUpload('NewfileUploadProfile')">
                <img id="imgProfileNew" class="editable img-responsive" alt="Alex's Avatar" src="~/Images/noimage.jpg" style="cursor:pointer;" title="Upload Image" />
              </a>
            }

          </div>
          <input type="file" id="NewfileUploadProfile" style="padding-left: 0px; display: none;" name="NewfileUploadProfile" onchange="ShowImagePreview(this, 'imgProfileNew',1024)" accept="image/*" />
        </div>

      </div>
      @*</div>*@

    }
  </div>

}

@section Scripts {
  <script src="~/Scripts/Master.js"></script>
  <script src="~/Scripts/FileUpload.js"></script>
  <script src="~/Scripts/ContributorDetails.js"></script>
  <script nonce="@ViewBag.StyleNonce">


    $("#Email").on('blur', function () {
      var PersonID = $("#PersonID").val();
      var OldPersonID = $("#OldPersonID").val();
      var email = $("#Email").val();
      if (email != "") {
        $.ajax({
          type: 'Get',
          url: '/ContributorPersonalDetails/EmailAjax?Email=' + email + "&personID=" + PersonID + "&oldPersonID=" + OldPersonID,
          dataType: 'json'
        }).done(function (result) {
          if (result != "0") {
            toasterErrorMessage("This Email Id already exist");
            $("#Email").val("");
          }
        });
      }
    })

    $(function () {
      if ($("#RequestFrom").val() == "True") {
        debugger
        $("#backtolist").attr('href', '/ContributorPersonalDetails/errorsInContributorDetails');
      }
      EmployerChange();
      if ($("#ActiveContributor").val() == "No") {
        $(".form-control").each(function () {
          $(this).prop("disabled", "disabled");
        });
        $(".checkbox").each(function () {
          $(this).prop("disabled", "disabled");
        });
        $(".btn-success").prop("disabled", "disabled");
      }
    })
  </script>

}
