@model App.Data.Entities.MarriageDetails
@{
  //Layout = null;
}

@{
  AjaxOptions options = new AjaxOptions();
  options.HttpMethod = "POST";
  options.InsertionMode = InsertionMode.Replace;
  options.UpdateTargetId = "divContainer";
}

@using (Ajax.BeginForm("_PartialAddMarriageDetails", options))
{
  <div class="panel panel-default">
    <div class="form-horizontal">
      <h4>Contributor Marriage Details</h4>
      <hr />
      @Html.AntiForgeryToken()

      @Html.ValidationSummary(true, "", new { @class = "text-danger" })
      <div class="form-group">
        @Html.LabelFor(model => model.PersonId, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.TextBoxFor(m => m.PersonId, new { @class = "form-control", placeholder = "JKPS ID", @Value = ViewBag.PersonID, @readonly = "readonly" })
          @Html.ValidationMessageFor(model => model.PersonId, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.SpouseFirstName, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.SpouseFirstName, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.SpouseFirstName, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.MidName, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.MidName, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.MidName, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.LastName, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.CountryID, "Country", htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.DropDownList("CountryID", null, htmlAttributes: new { @class = "form-control" })
          @Html.ValidationMessageFor(model => model.CountryID, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.DateOfBirth, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.DateOfBirth, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.Phone, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.PhoneOffice, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.PhoneOffice, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.PhoneOffice, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.Mobile, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.Mobile, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.Mobile, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.MarriageBeginDate, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.MarriageBeginDate,  new { htmlAttributes = new {@name="MarriageBeginDate", @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.MarriageBeginDate, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.MarriageEndDate, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.EditorFor(model => model.MarriageEndDate,  new { htmlAttributes = new {@name="MarriageEndDate", @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.MarriageEndDate, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.MaritalStatusId, "Marital Status", htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          @Html.DropDownList("MaritalStatusId", null, htmlAttributes: new { @class = "form-control" })
          @Html.ValidationMessageFor(model => model.MaritalStatusId, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="form-group">
        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-lg-2" })
        <div class="col-md-10">
          <div class="checkbox">
            @Html.EditorFor(model => model.IsActive, new { @class = "form-control input-sm", @checked = "checked" })
            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="panel-footer clearfix">
    <div class="pull-left">
      <button class="btn btn-success btn-sm" id="prevStep1">Previous</button>
      @*<button type="submit" class="btn btn-sm btn-success">+ Add More</button>*@
      <button type="submit" class="btn btn-sm btn-success" id="nextStep1">Next</button>
    </div>
  </div>
  
  <div id="MerriageDetailsList"> </div>
}



