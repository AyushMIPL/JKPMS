      function validateDateRange() {
        debugger
        var fromDateInput = $("#From").val();
        var toDateInput = $("#to").val();

        if (fromDateInput > toDateInput) {
          toasterErrorMessage("From Date should be less than or equal to To Date");
          $("#From").val(lastValidFromDate);
          $("#to").val(lastValidToDate);
