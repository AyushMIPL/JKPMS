        function continueWithPassword() {
            var status = $("#hdActiveOrDelete").val();
            var id = $("#hdDocumentId").val();
            var p = $("#exampleInputPassword1").val();
            debugger
            if (p != "") {
                $.ajax({
                    url: "@Url.Action("checkPasswordAjax", "ContributorPersonalDetails")?p=" + p,
                    type: "GET",
                })
              .done(function (result) {
                  debugger
                  if (result == 1) {
                      if (status == "Edit") {
                          window.location.href = "/ContributorPersonalDetails/EditContributorFinalizedDetails/?id=" + id;
                      }
                      else {
                          var grp = [];
                          var notes = $("#NotesBehindDelete").val();
                          if (status == "Delete") {
                              grp.push(id);
                          }
                          else {
                              $(".childcheckbox").each(function () {
                                  if (this.checked) {
                                      grp.push($(this).val());
                                  }
                              })
                          }

                          $.ajax({
                              url: "@Url.Action("deleteAllContributionAjax", "ContributorPersonalDetails")?Value=" + grp + "&Notes=" + notes,
                              type: "GET",
                          })
                        .done(function (result) {
                            var actionRes = result;
                            if (actionRes == "0") {
                                toasterErrorMessage("There is some error, please try again.");
                                hidemodal();
                                return actionRes;
                            }
                            else {
                                toasterSuccessMessage("Record deleted successfully.");
                                hidemodal();
                                dobind();
                            }
                        });
                      }
                  }
                  else {
                      $("#exampleInputPassword1").val("");
                      $("#Passworderror").text('Please Check Your Password');

                  }
              })
            }
            else {
                $("#Passworderror").text('Please Enter Password Before Continue.');
            }
    }

