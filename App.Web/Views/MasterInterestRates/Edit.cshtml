@model App.Data.Entities.MasterInterestRate

@{
  ViewBag.Title = "Edit";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Update Details
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "MasterInterestRates", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      @Html.HiddenFor(model => model.Id)
      <div class="row">
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.EmployerTypeID, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              @Html.DropDownList("EmployerTypeID", null, "---Select---", htmlAttributes: new { @class = "form-control" })
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.InterestRate, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              @Html.TextBoxFor(m => m.InterestRate, new { @class = "form-control input-sm allownumericwithdecimal", placeholder = "Interest Rate" })
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
              <button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Update</button>
              <a href="/MasterInterestRates/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>

            </div>
          </div>
        </div>
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.DateFrom, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              <div class="input-group date" id="StartDate">
                @Html.EditorFor(m => m.DateFrom, new { @class = "form-control", placeholder = "Date From" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>
          </div>
          <div class="form-group">
            @Html.LabelFor(model => model.DateTo, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              <div class="input-group date" id="EndDate">
                @Html.EditorFor(m => m.DateTo, new { @class = "form-control", placeholder = "Date To" })
                <span class="input-group-addon">
                  <i class="fa fa-calendar"></i>
                </span>
              </div>
            </div>
          </div>
          @*<div class="form-group">
              <label for="IsActive" class="col-sm-4 control-label">Status:</label>
              <div class="col-sm-8">
                <div class="checkbox">
                  @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
                </div>
              </div>
            </div>*@
          @*<hr>*@
          @*<div class="form-group">
              <label class="col-sm-4 control-label"></label>
              <div class="col-sm-8">
                <button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Update</button>
                @Html.ActionLink("Back to List", "Index", "MasterInterestRates", null, new { @class = "btn btn-primary" })
              </div>
            </div>*@
        </div>
        <div class="col-sm-2">

          <span class="field-validation-error text-danger" id="fileValidate"></span>

        </div>
      </div>
    }
  </div>
</div>
@section scripts{
  <script nonce="@ViewBag.StyleNonce">
    $("#EndDate").change(function (ev) {
      debugger
      var Sdate = $("#DateFrom").val();
      if (Sdate == '') {
        toasterErrorMessage("Please ensure that the End Date is greater than or equal to the Start Date.");
        $("#DateTo").val("")
        return false;
      }
    });
    $("#StartDate").on("change", function (ev) {
      var Sdate = new Date($("#DateFrom").val());
      if (Sdate != '') {
        $('#EndDate').datepicker('setStartDate', Sdate);
      }
    })
  </script>
}
