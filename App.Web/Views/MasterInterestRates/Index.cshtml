@model App.Data.Entities.MasterInterestRate
@{
    ViewBag.Title = "Index";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Interest Rates
            <ul class="tool-bar">
                <li><a href="javascript:Module();" data-toggle="tooltip" data-placement="bottom" title="Add Module" data-original-title="Add Module"><i class="fa fa-plus"></i></a></li>
            </ul>
        </h4>
    </div>
    <div class="panel-body" id="AddModule" style="display:none">
        @using (Html.BeginForm("Create", "MasterInterestRates", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="row">
            <div class="col-sm-3">

                @Html.LabelFor(model => model.EmployerTypeID, new { @class = "control-label mb-2" })
                @Html.DropDownList("EmployerTypeID", null, "---Select---", htmlAttributes: new { @class = "form-control" })

            </div>

            <div class="col-sm-3">
                @Html.LabelFor(model => model.InterestRate, new { @class = "control-label mb-2" })
                @Html.TextBoxFor(m => m.InterestRate, new { @class = "form-control input-sm allownumericwithdecimal", placeholder = "Interest Rate" })
            </div>




            <div class="col-sm-3">
                @Html.LabelFor(model => model.DateFrom, new { @class = "control-label mb-2" })
                <div class="input-group date" id="StartDate">
                    @Html.TextBoxFor(m => m.DateFrom, new { @class = "form-control", placeholder = "Date From" })
                    <span class="input-group-addon">
                        <i class="fa fa-calendar"></i>
                    </span>
                </div>
            </div>


            <div class="col-sm-3 mb-4">
                @Html.LabelFor(model => model.DateTo, new { @class = "control-label mb-2" })
                <div class="input-group date" id="EndDate">
                    @Html.TextBoxFor(m => m.DateTo, new { @class = "form-control", placeholder = "Date To" })
                    <span class="input-group-addon">
                        <i class="fa fa-calendar"></i>
                    </span>
                </div>
            </div>
            <div class="col-sm-12 text-right">
                <button type="submit" class="btn btn-success px-5 height"><i class="fa fa-save"> </i> Create</button>
                <button type="button" onclick="hidemodule()" class="btn btn-primary height border-radius line-height"><i class="fa fa-reply"> </i> Back to List</button>
            </div>
        </div>
                @*<div class="form-group">
                  <label for="IsActive" class="col-sm-4 control-label">Status:</label>
                  <div class="col-sm-8">
                    <div class="checkbox">
                      @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
                    </div>
                  </div>
                </div>*@
                @*<hr>*@

        

          
            <div class="col-sm-2">

                <span class="field-validation-error text-danger" id="fileValidate"></span>

            </div>
       

        }
    </div>

</div>

<div class="panel panel-default">
    <div class="panel-body">
        <table class="table dataTable" id="tbl">
            <thead>
                <tr>
                    <th>Date From - Date To</th>
                    <th>Public/Police</th>
                    <th>Interest Rate</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
@section scripts{
    <style>
        .select2-container {
            width: 100% !important;
        }
    </style>

    <script nonce="@ViewBag.StyleNonce">

    $(function () {
      doBindData();
    });
    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
        "sAjaxSource": "/MasterInterestRates/AjaxHandler",
        "aoColumns": [

    					{ "sName": "dateFrom-dateTo" },
              { "sName": "Public/Police" },
              { "sName": "Interest Rate" },
              {
                "sName": "ID",
                "bSearchable": false,
                "bSortable": false,
                "fnRender": function (oObj) {
                  var strString = '<a href="/MasterInterestRates/Edit/' + oObj.aData[3] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';
                  strString += '&nbsp;<a href="javascript:;"  onclick="javascript:del(' + oObj.aData[3] + ');" class="btn btn-xs btn-danger"> <i class="fa fa-trash-o fa-lg"></i> Delete</a>';
                  return strString;
                }
              }
        ]
      });
    }

    function Module() {
        $("#AddModule").show();
        $("#DateFrom").val("");
        $("#InterestRate").val("");
        $("#DateTo").val("");
    }
    function hidemodule() {
      $("#AddModule").hide();
      $("#DateFrom").val("");
      $("#InterestRate").val("");
      $("#DateTo").val("");
    }



    $("#EndDate").change(function (ev) {
      debugger
      var Sdate = $("#DateFrom").val();
      if (Sdate == '') {
        toasterErrorMessage("Please ensure that the End Date is greater than or equal to the Start Date.");
        $("#DateTo").val("")
        return false;
      }
    });
    $("#StartDate").on("change", function (ev) {
      var Sdate = new Date($("#DateFrom").val());
      if (Sdate != '') {
        $('#EndDate').datepicker('setStartDate', Sdate);
      }
    })
    function del(ctrlId) {
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
      }
      const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
      debugger
      Confirm_Delete_ClassBtn.forEach(button => {
        button.addEventListener('click', onDeleteConfirm);
      });
    function onDeleteConfirm() {
      var id = $("#hdDocumentId").val();
      var name = "InterestRateId";
      $.ajax({
        url: "@Url.Action("Remove", "MasterInterestRates")?Id=" + id + "&name=" + name,
        type: "GET",
      })
    .done(function (result) {
      var actionRes = result;
      if (actionRes == "0") {
        toasterErrorMessage("There is some error, please try again.");
        return actionRes;
      }
      else if (actionRes == "1") {
        toasterSuccessMessage("Status changed sucessfully.");
        $('#confirmDelete').popup("hide");
        doBindData();
      } else {
        toasterErrorMessage("Already in Use.");
        $('#confirmDelete').popup("hide");
      }
    });
    }
    </script>
}
