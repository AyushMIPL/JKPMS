@model App.Data.Entities.MasterSource
@{
  ViewBag.Title = "Create";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Add Details
      @*<ul class="tool-bar">
          
        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Create", "MasterSource", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="row">
     
           
          <div class="col-sm-4">
              @Html.LabelFor(model => model.Name, new { @class = "control-label mb-2" })
              @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Enter Suffix" })


          </div>
         
            
          <div class="col-sm-2">
              <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
              <label for="IsActive" class="col-sm-4 control-label">Status:</label>
              <div class="checkbox">
                  @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
              </div>
          </div>
        


 
          <div class="col-sm-4">
              <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
              <button type="submit" class="btn btn-success px-5 height"><i class="fa fa-save"> </i> Create</button>
              @Html.ActionLink("Back to List", "Index", "MasterSource", null, new { @class = "btn btn-primary height border-radius line-heighty" })
          </div>
          </div>
    
  

    }
  </div>
</div>
@section scripts{

  <script src="~/Scripts/Master.js"></script>
}