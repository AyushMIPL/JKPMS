    function AddDeduction() {
      $("#simpleModal1").show();
    }
    function hidemodal() {
      $("#simpleModal1").hide();
    }
    function AddDeductionDetails() {
      var count = $("#tbl > tbody > tr").length;
      var ded_Code = $("#Ded_Code").val();
      var deduction_Rate = $("#Deduction_Rate").val();
      var amount = $("#Amount").val();
      if (ded_Code != "" && deduction_Rate != "" && amount != "") {
        $("#tbl").append('<tr><td ><select class="form-control input-sm disable" name="[' + count + '].ded_code" ><option value="AC">Advance Caribbean</option><option value="ADB">Anguilla Development Board</option><option value="ADF">JKPS Administration Fee</option><option value="AIS">Alliance Insurance Services</option><option value="AMC">Anguilla Mortgage Company</option><option value="ATU">Anguilla teachers Union</option><option value="FLI">Fairplay Life Insurance </option><option value="FMI">FairPlay Medical Insurance</option><option value="GOA">Government of Anguilla</option><option value="MASA">Medical Air Services Association</option><option value="NCI">National caribbean Insurance </option><option value="NEL">Nagico EC Life</option><option value="NMI">Nagico Medical Insurance</option><option value="BA">SAGICOR</option></select></td><td >  <input type="text" class="form-control input-sm disable" name="[' + count + '].ded_rate" value="' + deduction_Rate + '"/></td><td >  <input type="text" class="form-control input-sm disable" name="[' + count + '].amount" value="' + amount + '"/></td><td><button type="button"  id="btnSave' + count + '" onclick="javascript: return DoSave(' + count + ');" class="btn btn-xs btn-success SaveRow" title="Save"><i class="fa fa-save fa-lg"></i></button>&nbsp;<button type="button" id="btnEdit' + count + '" onclick="javascript: return doedit(' + count + ');" class="btn btn-xs btn-primary" title="Edit"><i class="fa fa-pencil fa-lg"></i></button>&nbsp;<button type="button" class="btn btn-xs btn-danger deleterow" onclick="deleterow(' + count + ');" <i class="fa fa-trash-o fa-lg"></i></button></td></tr>');
        $('[name="[' + count + '].ded_code"]').val(ded_Code);
        $('select').select2({
          placeholder: "---Select---",
          allowClear: true
        });
        DisableContrls();
        hidemodal();
        clearPopupValues();
        toasterSuccessMessage("Details Added Successfully.");
      }
      else {
        toasterErrorMessage("Fill All Details to Add Deduction.");
      }

    }

    function clearPopupValues() {
      $("#Ded_Code").select2("val", "");
      $("#Deduction_Rate").val('');
      $("#Amount").val('');
    }

    function deleterow(x) {
      $(".deleterow").on('click', function () {
        $(this).closest('tr').hide();
        $('[name="[' + x + '].description_MasterIncCodes"]').val("deleted");
      })
    }

  </script>
