@model List<App.Data.Entities.MasterEmpBankDetails>

@{
  Layout = "~/Views/Shared/_LayoutUpdatePayroll.cshtml";
}
@section profileUpdatePayroll
{
  @Html.Hidden("PensionerID")

  <div class="panel panel-default">
    <div class="panel-heading clearfix">
      <h4 class="headline" style="margin:0px;padding:0px;border:none;">
        Direct Deposit Details:@string.Format("{0} ({1})", ViewBag.Name, ViewBag.PensionerID)
        @*<ul class="tool-bar">
          <li>
          <li><a href="javascript:AddBank();" data-toggle="tooltip" data-placement="bottom" title="Add Direct Deposit" data-original-title="Add Direct Deposit"><i class="fa fa-plus"></i></a></li>

        </ul>*@
      </h4>
    </div>
    <div class="panel-body">
      @using (Html.BeginForm("DirectDepositIndex", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
      {@Html.Hidden("CId")
        <table class="table dataTable" id="tbl">
          <thead>
            <tr>
              <th>Bank Code</th>
              <th>Account Type<br /> (C - Current<br />S - Savings)</th>
              <th>Account NO</th>
              <th>Type<br />(P- Percentage <br /> A - Amount <br /> R - Remainder )</th>
              <th>Amount<br />(Amount/%)</th>
              @*<th></th>*@
            </tr>
          </thead>
          <tbody>
            @if (Model != null)
            {
              for (int i = 0; i < Model.ToArray().Count(); i++)
              {
                @Html.HiddenFor(m => Model[i].line_no)
                <tr>
                  <td>@Html.DropDownListFor(m => Model[i].bank_code, new SelectList(ViewBag.bank_code, "Value", "Text", Model[i].bank_code), htmlAttributes: new { @class = "form-control input-sm" })</td>
                  <td>@Html.DropDownListFor(m => Model[i].typeofacct, new SelectList(ViewBag.typeofacct, "Value", "Text", Model[i].typeofacct), htmlAttributes: new { @class = "form-control input-sm" })</td>
                  <td>@Html.TextBoxFor(m => Model[i].bank_acct_no, new { @class = "form-control input-sm allownumericwithdecimal" })</td>
                  <td>@Html.DropDownListFor(m => Model[i].type, new SelectList(ViewBag.type, "Value", "Text", Model[i].type), htmlAttributes: new { @class = "form-control input-sm" })</td>
                  <td>@Html.TextBoxFor(m => Model[i].amount, new { @class = "form-control input-sm allownumericwithdecimal" })</td>
                  @*<td><button type="button" class="btn btn-xs btn-danger deleterow" onclick="deleteRow(this);" <i class="fa fa-trash-o fa-lg"></i></button></td>*@
                </tr>
              }
            }
          </tbody>
        </table>
        <div class="form-group">
          <label class="col-sm-4 control-label"></label>
          <div class="col-sm-8">
            <input type="submit" class="btn btn-success" value="Submit" />
            @Html.ActionLink("Cancel", "DirectDepositIndex", "PensionProcess", new { id = @ViewBag.PensionerID }, new { @class = "btn btn-primary" })
          </div>
        </div>
      }
    </div>
  </div>
  @*<div class="modal fade in" id="simpleModal1" aria-hidden="false" style="display: none;">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <button type="button" class="close" onclick="hidemodal();" aria-hidden="true">×</button>
          </div>
          <div class="panel-body">
            <div class="row">
              <div class="col-sm-11">
                <div class="form-group">
                  <label class="col-sm-3 control-label">Bank Code</label>
                  <div class="col-sm-8">
                    @Html.DropDownList("bank_code", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label">Account Type</label>
                  <div class="col-sm-8">
                    @Html.DropDownList("typeofacct", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label">Account NO</label>
                  <div class="col-sm-8">
                    @Html.TextBox("AccountNO", "", new { @class = "form-control input-sm", placeholder = "AccountNO" })

                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label">Type</label>
                  <div class="col-sm-8">
                    @Html.DropDownList("type", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label">Amount</label>
                  <div class="col-sm-8">
                    @Html.TextBox("Amount", "", new { @class = "form-control input-sm", placeholder = "Amount" })

                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-3 control-label"></label>
                  <div class="col-sm-8">
                    <input type="button" class="btn btn-success" value="Add Details" onclick="AddBankDetails();" />
                    <input type="button" class="btn btn-primary" value="Cancel" onclick="hidemodal();" />

                  </div>
                </div>
              </div>
            </div>
          </div>

        </div><!-- /.modal-content -->
      </div><!-- /.modal-dialog -->
    </div>
    <style>
      .select2-container {
        width: 100% !important;
      }
    </style>*@

}
