        $(document).ready(function () {
            debugger;
      if ('@ViewBag.RptLoad' == 'RptPrintExceptionReportWages.rpt' || '@ViewBag.RptLoad' == 'RptPrintExceptionReport.rpt') {
          //$("#PrintExceptionReportId").show();
