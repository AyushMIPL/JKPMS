@model App.Data.ViewModels.GeneratePensionProcessModel
@{
  ViewBag.Title = "PrintPayslip";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="panel panel-default">

  <div class="panel-body pt-1 pb-4">
    @using (Html.BeginForm("PrintPayslip", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="">
        <div class="row">
          <div class="col-sm-4">

            @Html.LabelFor(model => model.PayDate, "Pay Date *", new { @class = "control-label mb-2" })
            <div class="input-group date">
              @Html.EditorFor(model => model.PayDate, new { @class = "form-control input-sm" })
              <span class="input-group-addon">
                <i class="fa fa-calendar"></i>
              </span>

            </div>
          </div>


          <div class="col-sm-4">
            @Html.LabelFor(model => model.PayrollCashAccount, new { @class = "control-label mb-2" })
            @Html.DropDownListFor(model => model.PayrollCashAccount, ViewBag.accounttype as SelectList, new { @class = "form-control input-sm" })
          </div>


          <div class="col-sm-4">

            @Html.LabelFor(model => model.EmployeeType, "Scheme Name *", new { @class = "control-label mb-2" })
            @Html.DropDownListFor(model => model.EmployeeType, ViewBag.EmployeeType as SelectList, new { @class = "form-control input-sm" })

          </div>


          <div class="col-sm-4">
            @Html.LabelFor(model => model.Department, "Department *", new { id = "lblDepartment", @class = "control-label mb-2" })
            @Html.DropDownListFor(model => model.Department, ViewBag.department as SelectList, new { @class = "form-control input-sm" })
          </div>
          <div class="col-sm-4">
            <div class="control-label mb-2 mt-3" for="StartingChequeNo"> &nbsp;</div>
            <button type="submit" id="Btn" class="btn btn-success height px-5"><i class="fa fa-print"></i> Print Pension</button>
            @*<input type="submit" id="Btn" class="btn btn-success" value="Print Pension" />*@

          </div>
        </div>
       
        </div>

      
    }
  </div>
</div>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Payroll Process - Print Pension
      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <div class="row py-3">
        <div class="col-sm-12 hidden" id="DivRptIframe">
            <iframe id="RptIframe" width="100%" height="500" frameborder="0"></iframe>
        </div>
      <div class="col-sm-12 hidden" id="DivRecordFound">
        <div class="alert alert-warning">
          <h4 class="mb-0"> There is no Record Found</h4>
        </div>

        @*<div class="alert alert-info">
              <h4 class="mb-0"> There is no Record Found</h4>
          </div>*@
        @*<iframe id="reportData" style="border: 0px;height:700px;width:100%;"></iframe>*@
      </div>
    </div>
  </div>

</div>
@section scripts{
  <script nonce="@ViewBag.StyleNonce">
    // By Sujeet No action name "CheckProcessAdded" method found int the solution. So comment the code on class ".btn-success" click function
    //$('.btn-success').click(function () {
    //  $.ajax({
    //    url: '/PensionProcess/CheckProcessAdded',
    //    type: 'Get',
    //    dataType: 'json'
    //  }).done(function (result) {
    //    if (result.length <= 0) {
    //      toasterErrorMessage("No Active Batch for Payroll Process,Please Create a New Batch & Refresh"); return false;
    //    }
    //  });
    //});

    $(document).ready(function () {
        if ('@ViewBag.RptLoad' == 'rptPaySlipsA4.rpt') {
            $("#DivRptIframe").removeClass("hidden");
            document.getElementById('RptIframe').src = "/ReportForms/ContributionByEmployer.aspx";
        }
        else {
            $("#DivRecordFound").removeClass("hidden");
        }
    });


  </script>
}
