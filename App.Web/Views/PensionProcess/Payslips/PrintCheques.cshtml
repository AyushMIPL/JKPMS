@model App.Data.ViewModels.GeneratePensionProcessModel
@{
  ViewBag.Title = "PrintCheques";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="panel panel-default">

  <div class="panel-body">
    @using (Html.BeginForm("PrintCheques", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="">
        <div class="row">
          <div class="col-sm-4">

            @Html.LabelFor(model => model.DirectDepositsCheques, new { @class = "control-label mb-2" })
            @Html.TextBoxFor(model => model.DirectDepositsCheques, new { @class = "form-control input-sm" })

          </div>
          <div class="col-sm-4">

            @Html.LabelFor(model => model.EmployeeType, new { @class = "control-label mb-2" })
            @Html.DropDownListFor(model => model.EmployeeType, ViewBag.EmployeeType as SelectList, new { @class = "form-control input-sm" })

          </div>

          <div class="col-sm-4">
           
                @Html.LabelFor(model => model.PayrollCashAccount, new { @class = "control-label mb-2" })
                @Html.DropDownListFor(model => model.PayrollCashAccount, ViewBag.OSCheckingAccount as SelectList, new { @class = "form-control input-sm" })
             
          </div>
        </div>
        <div class="row mt-4">
      
          <div class="col-sm-12 text-right">
           
           
                <button type="submit" id="Btn" class="btn btn-success height px-5" ><i class="fa fa-print"></i> Print Cheques List</button>
              
         
          </div>
        </div>
      </div>
      <div>
        @*<iframe id="RptIframe" width="100%" height="500" frameborder="0"></iframe>*@
      </div>
    }
  </div>
</div>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;" id="PrintChequesId">
      Payroll Process - Print Cheques
      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <div class="row py-3">
        <div class="col-sm-12 hidden" id="DivRptIframe">
            <iframe id="RptIframe" width="100%" height="500" frameborder="0"></iframe>
        </div>
      <div class="col-sm-12 hidden" id="DivRecordFound">
        <div class="alert alert-warning">
          <h4 class="mb-0"> There is no Record Found</h4>
        </div>

        @*<div class="alert alert-info">
              <h4 class="mb-0"> There is no Record Found</h4>
          </div>*@
        @*<iframe id="reportData" style="border: 0px;height:700px;width:100%;"></iframe>*@
      </div>
    </div>
  </div>

</div>
@section scripts{
  <script nonce="@ViewBag.StyleNonce">
    $("#PrintChequesId").hide();
    // By Sujeet No action name "CheckProcessAdded" method found int the solution. So comment the code on class ".btn-success" click function
  //$('.btn-success').click(function () {
  //  $.ajax({
  //    url: '/PensionProcess/CheckProcessAdded',
  //    type: 'Get',
  //    dataType: 'json'
  //  }).done(function (result) {
  //    if (result.length <= 0) {
  //      toasterErrorMessage("No Active Batch for Payroll Process,Please Create a New Batch & Refresh"); return false;
  //    }
  //  });
  //});

  $(document).ready(function () {
      if ('@ViewBag.RptLoad' == 'RptPrintPayrollChecksNew.rpt') {
          $("#PrintChequesId").show();
          $("#DivRptIframe").removeClass("hidden");
          document.getElementById('RptIframe').src = "/ReportForms/ContributionByEmployer.aspx";
      }
      else {
          $("#DivRecordFound").removeClass("hidden");
      }
  });


  </script>
}
