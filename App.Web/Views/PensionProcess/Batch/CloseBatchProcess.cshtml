@model App.Data.ViewModels.PensionProcessViewModel
@using App.Web.Helper
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default">

    <div class="panel-body">
        @*@using (Html.BeginForm("", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
            {*@
        @Html.HiddenFor(model => model.pybatchid, new { @Value = Model.pybatchid })
        @Html.AntiForgeryToken()
        @Html.ValidationSummary("", new { @class = "text-danger" })
        <div class="row border">
            <div class="row">
                <div class="col-sm-8">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Title, "Payroll Process", new { @class = "col-sm-3 control-label" })
                        <div class="col-sm-7">

                            <button type="submit" id="Btn" class="btn btn-success @(ViewBag.AddPermission == true ? "" : "disabled") @(ViewBag.EditPermission == true ? "" : "disabled")"><i class="fa fa-times fa-lg"></i> Close Batch Process</button>
                            @*<a href="#" id="Btn" class="btn btn-success"><i class="fa fa-times fa-lg"></i> Close Batch Process</a>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div id="processDetail" class="row border">
            <div class=" px-4">
                <ul class="list-group">
                    <li class="list-group-item clearfix">
                        <div class="pull-left m-left-sm">
                            @if (Model.pybatchid > 0)
                            {
                                <span><b class="batchid">Batch Id:- </b></span>@Html.DisplayFor(model => model.pybatchid, new { @class = "control-label" })<br>
                            }
                            else
                            {
                                <span><b class="batchid">Batch Id:- </b></span><br>
                            }
                            @*<span><b style="font-weight:bolder">Batch Id:- </b></span>@Html.DisplayFor(model => model.pybatchid, new { @class = "control-label" })<br>*@
                            @*@Html.TextBox("txtpybatchid", Model.pybatchid, new { id = "txtpybatchid", name = "txtpybatchid", @class = "form-control input-sm" })*@
                        </div>
                        <div class="pull-right">
                            <span><b class="batchid">Process Started On:-</b></span>@Html.FormatDate(Model.processstartedon)<br>
                        </div>
                    </li>

                    <li class="list-group-item clearfix">
                        <div class="pull-left m-left-sm">
                            <span><b class="batchid">Start By:-</b></span>@Html.DisplayFor(model => model.insertbyName, new { @class = "control-label" })
                        </div>
                    </li>
                    <li class="list-group-item clearfix">
                        <div class="pull-left m-left-sm">
                            <span><b class="batchid">Status:- </b></span>
                            @if (Model != null)
                            {
                                @Html.FormatProcess(Model.status)<br>
                            }
                        </div>
                    </li>

                </ul>

            </div>

        </div>
