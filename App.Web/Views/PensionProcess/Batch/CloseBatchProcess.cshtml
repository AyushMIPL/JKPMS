    </div>
</div>


<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline payroll">
            Payroll Process - Close Batch Process
            @*<ul class="tool-bar">

                </ul>*@
        </h4>
    </div>
    <div class="panel-body">
        <table id="tbl" class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Process</th>
                    <th>Start On</th>
                    <th>End On</th>
                    <th>Searched</th>
                    <th>Processed</th>
                    <th>Error</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <table id="tblDGVCheck" class="table">
            <thead>
                <tr>
                    <th>Doc No.</th>
                    <th>Cheque No.</th>
                    <th>Pay Date</th>
                    <th>Employee</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

</div>








<div class="custom-popup width-100 Sc_display" id="Ok_To_Postd_Data">
    <div class="padding-md">
        <h4 class="m-top-none" id="statusRecord">Are you sure want to close active batch of pension process? </h4>
    </div>
    <div class="text-center">
        <a type="button" class="btn btn-success px-5 height Sc_display" title="Please Wait While We Process Your Request" id="btn_close_loading"><i class="fa fa-spinner fa-spin"></i> Processing</a>
        <a class="btn btn-success m-right-sm" id="CloseBatchId">Confirm</a>
        <a class="btn btn-danger logoutConfirm_close" id="closeclick">Cancel</a>
    </div>
</div>


<div class="custom-popup width-100 Sc_display" id="Ok_To_Post_P_not_Found">
    <div class="padding-md">
        <h4 class="m-top-none" id="statusRecord">You are unable to close active batch of pension process.</h4>
    </div>
    <div class="text-center">
        <div class="d-flex">
            <a></a><a></a>
            <a></a><a></a>
            <a class="btn btn-danger m-right-sm" id="closeclick">Cancel</a>
        </div>
    </div>
</div>








@section scripts{
    <script nonce="@ViewBag.StyleNonce">

    $(function () {
      if ($("#pybatchid").val() != 0) {
        $('input[type="text"]').each(function () {
          $(this).attr("disabled", true);
        });
        var pybatchid = $("#pybatchid").val();
        //$("#Btn").val("Batch:" + pybatchid + " is Active for Pension Process")
        $.ajax({
           

          url: "@Url.Action("DisplayAjax", "PensionProcess")?Pybatchid=" + pybatchid,
          type: "GET",
        }).done(function (result) {
          var trHTML = '';
          $('#tbl> tbody > tr').empty();
          $.each(result, function (index, item) {
            debugger
            trHTML += '<tr><td>' + item.pybatchid + '</td><td>' + item.processname + '</td><td>' + item.processstartedon + '</td><td>' + item.processendedon + '</td><td>' + item.recordssearched + '</td><td>' + item.recordsprocessed + '</td><td>' + item.errormessage + '</td></tr>';
          })
          $('#tbl').append(trHTML);
          debugger;
        });

        $.ajax({
          url: "@Url.Action("DGVCheckAjax", "PensionProcess")?Pybatchid=" + pybatchid,
          type: "GET",
        }).done(function (result) {
          var trHTML = '';
          $('#tblDGVCheck> tbody > tr').empty();
          $.each(result, function (index, item) {
            debugger
            trHTML += '<tr><td>' + item.DocNo + '</td><td>' + item.CheckNo + '</td><td>' + item.PayDate + '</td><td>' + item.Employee + '</td><td>' + item.Amount + '</td></tr>';
          })
          $('#tblDGVCheck').append(trHTML);
          debugger;
        });

      }
      else {
        $('#Btn').attr('disabled', 'disabled');
        $("#Btn").removeClass("btn btn-success").addClass("btn btn-primary")
      }
    })



    $(document).ready(function () {
      debugger
      $('#CloseBatchId').click(function () {
        debugger
        $('#spinner').show();
          var obj = { pybatchid: $('#pybatchid').val() };
          $('#btn_close_loading').show();
          $('#CloseBatchId').hide();
    $.ajax({
      type: "POST",
      url: '@Url.Action("CloseBatchProcessAjax", "PensionProcess")',
      dataType: "json",
      data: JSON.stringify(obj),
      contentType: "application/json; charset=utf-8",
    }).done(function (result) {
        $('#CloseBatchId').show();
        $('#btn_close_loading').hide();

      debugger
      $('#spinner').hide();
      $('#Ok_To_Postd_Data').popup("hide");
      if (result.message) {
        debugger
        toastr.success(result.message);
        location.reload();
      }
      // Handle the result of your action here
    });
  });
});




