                </div>
              </li>
              <li class="list-group-item clearfix">
                <div class="pull-left m-left-sm">
                  <span>Status:-</span>@Html.DisplayFor(model => model.status, new { @class = "control-label" })<br>
                </div>
              </li>

            </ul>
          </div>
        </div>*@

    }
  </div>
</div>


<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headlineMonthlyPensionSummary">
      Payroll Process - Cancel Individual Payroll
      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <table id="tbl" class="table display-block">
      <thead>
        <tr>
          <th>ID</th>
          <th>Process</th>
          <th>Start On</th>
          <th>End On</th>
          <th>Searched</th>
          <th>Processed</th>
          <th>Error</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>

    <table id="tblDGVCheck" class="table display-none">
      <thead>
        <tr>
          <th>Doc No.</th>
          <th>Cheque No.</th>
          <th>Pay Date</th>
          <th>Employee</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
