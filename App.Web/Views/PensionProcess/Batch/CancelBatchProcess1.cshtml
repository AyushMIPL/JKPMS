<div class="panel panel-default">

  <div class="panel-body">
    @using (Html.BeginForm("CancelBatchProcess1", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "IdCancelBatchProcess", onsubmit = "return GenerateBatchProcess1();" }))
    {
      @Html.HiddenFor(model => model.pybatchid, new { @Value = Model.pybatchid })
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="row border">
        <div class="row">
          <div class="col-sm-12">
            <label>District</label>
            @Html.TextBoxFor(x => x.RegionNames, "", new { @class = "form-control", @autocomplete = "off", @placeholder = "Regions" })
          </div>
          <div class="col-sm-4">
            @Html.LabelFor(model => model.Title, "Scheme Type", new { @class = "control" })
            @*@Html.DropDownListFor(model => model.EmployeeCode, null, htmlAttributes: new { @class = "form-control" })*@
            @Html.DropDownListFor(model => model.EmployerId, ViewBag.EmployeeType as SelectList, new { @class = "form-control input-sm" })

          </div>
          <div class="col-sm-4 select_drop">

            @Html.LabelFor(model => model.Title, "Beneficiary Name", new { @class = "control" })
            @*@Html.DropDownListFor(model => model.EmployeeCode, null, htmlAttributes: new { @class = "form-control" })*@
            @*@Html.DropDownListFor(model => model.EmployeeCode, ViewBag.EmployeeCode as SelectList, new { @class = "form-control input-sm" })*@
            <input type="hidden" name="EmployeeCode" id="EmployeeCode_id" /> 
            @Html.TextBoxFor(x => x.EmployeeCode, "", new { @class = "form-control", @autocomplete = "off", @placeholder = "Search Beneficiary Name" })

          </div>
          <div class="col-sm-4  mt-5">
            <button type="button" class="btn btn-success px-5 height display-none" title="Please Wait While We Process Your Request" id="btn_CancelBatchProcess_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
            <button type="submit" id="Btn" class="btn btn-success cancel-payroll-btn @(ViewBag.AddPermission == true ? "" : "disabled") @(ViewBag.EditPermission == true ? "" : "disabled")"><i class="fa fa-times fa-lg"></i> Cancel Payroll</button>
            @*<input type="submit" id="Btn" class="btn btn-success" value="Cancel Payroll" />*@

          </div>
        </div>
        @*<div class="row">
              <div class="col-sm-4">
                  <div class="form-group">
                      @Html.LabelFor(model => model.Title, "Payroll Process", new { @class = "col-sm-4 control-label" })
                      <div class="col-sm-7">
                          <input type="submit" id="Btn" class="btn btn-success" value="Cancel Batch Process" />
                      </div>
                  </div>
              </div>
          </div>*@
      </div>
      <br />
      <div id="processDetail" class="row border">
        <div class="px-4">
          <ul class="list-group">
            <li class="list-group-item clearfix">
              <div class="pull-left m-left-sm">
                @if (Model.pybatchid > 0)
                {
                  <span><b class="font-weight-bolder">Batch Id:- </b></span>@Html.DisplayFor(model => model.pybatchid, new { @class = "control-label" })<br>
                }
                else
                {
                  <span><b class="font-weight-bolder">Batch Id:- </b></span>
                }
              </div>
              <div class="pull-right">
                <span><b class="font-weight-bolder">Process Started On:-</b></span>@Html.FormatDate(Model.processstartedon)<br>
              </div>
            </li>

            <li class="list-group-item clearfix">
              <div class="pull-left m-left-sm">
                <span><b class="font-weight-bolder">Start By:-</b></span>@Html.DisplayFor(model => model.insertbyName, new { @class = "control-label" })
              </div>
            </li>
            <li class="list-group-item clearfix">
              <div class="pull-left m-left-sm">
                <span><b class="font-weight-bolder">Status:- </b></span>
                @if (Model != null)
                {
                  @Html.FormatProcess(Model.status)<br>
                }
              </div>
            </li>

          </ul>

        </div>

      </div>
      @*<div id="processDetail" class="row border">
          <div class="panel panel-default">
            <ul class="list-group">
              <li class="list-group-item clearfix">
                <div class="pull-left m-left-sm">
                  <span>Batch Id:-</span>@Html.DisplayFor(model => model.pybatchid, new { @class = "control-label" })<br>
                </div>
                <div class="pull-right">
                  <span>Process Started On:-</span>@Html.DisplayFor(model => model.processstartedon, new { @class = "control-label" })<br>
                </div>
              </li>

              <li class="list-group-item clearfix">
                <div class="pull-left m-left-sm">
