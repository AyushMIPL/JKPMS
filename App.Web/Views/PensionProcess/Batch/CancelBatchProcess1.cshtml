  $("#EmployeeCode").autocomplete({
    source: function (request, response) {
      debugger;
      var type = $("#EmployerId option:selected").val();
      if (!type) {
        toasterErrorMessage("Please select the Scheme Type first");
        return
      }
       // $("#spinner2").show();
        $.ajax({
          url: `@Url.Action("GetseletedTypeAjax", "ContributorPersonalDetails")?term=${request.term}&seletedType=${type}`,
            type: "GET",
            success: function (data) {
              // $("#spinner2").hide();
              debugger
              if (data.length == 0) {
                toasterErrorMessage("Beneficiary name is not valid");
                return false
              }
              const dataArray = Object.values(data);
              response($.map(dataArray, function (item) {
                return { label: item.Value, id: item.Key };
              }));
            },
            error: function (xhr, status, error) {
                $("#spinner2").hide();
                console.error("Error fetching data:", error);
            }
        });
    },
     select: function (event, ui) {       
       //console.log("Selected item:", ui.item);
      $("#EmployeeCode_id").val(ui.item.id);
       $("#EmployeeCode").val(ui.item.label);
      return false;
    }

});

