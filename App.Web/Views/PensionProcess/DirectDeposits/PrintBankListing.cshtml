    function DispersementExcelDownload(evnt, District) {
      debugger

            var ButtonHtml = $("#Download_" + District).html();
            if (!$("#Download_" + District).html().includes('<i class="fa fa-spinner fa-spin" aria-hidden="true">')) {
                $("#Download_" + District).html('<i class="fa fa-spinner fa-spin" aria-hidden="true"></i> ' + ButtonHtml);
            }

                var pybatchid1 = @pybatchid;
                var pybatchid_value;
                if (pybatchid1 === null) {
                  pybatchid_value = 0;
                }
                else {
                  pybatchid_value = @pybatchid;
                    }
      var Region_value = District;

      var Disabledid = "Download_" + District;
      $("#" + Disabledid).attr("disabled", true);

            var xhr = new XMLHttpRequest();
             xhr.open('POST', '@Url.Action("DownLoadBankDisbursementFileAjax", "PensionProcess")', true);
            xhr.responseType = 'arraybuffer';
            xhr.onload = function () {
                ;
                if (xhr.status === 200) {
                    if (xhr.response.byteLength > 0) {
                        let fileName = "downloaded_file";
                        const contentDisposition = xhr.getResponseHeader("Content-Disposition");
                        if (contentDisposition && contentDisposition.indexOf("filename=") !== -1) {
                            fileName = contentDisposition.split("filename=")[1].replace(/"/g, "");
                        }
                        // Success: Convert arraybuffer to blob and initiate download
                        var blob = new Blob([xhr.response], { type: 'application/octet-stream' });
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = fileName; // Default filename

                        // Check Content-Disposition header for filename if available
                        var disposition = xhr.getResponseHeader('Content-Disposition');
                        if (disposition) {
                            var matches = /filename="([^"]*)"/.exec(disposition);
                            if (matches != null && matches[1]) {
                                a.download = matches[1];
                            }
                        }

                        // Append the anchor to the document body and trigger the download
                        document.body.appendChild(a);
                        a.click();

                        // Clean up
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                    }
                    else {
                        toasterErrorMessage("File not found.");
                    }
                    if ($("#Download_" + District).html().includes('<i class="fa fa-spinner fa-spin" aria-hidden="true">')) {
                        $("#Download_" + District).html(ButtonHtml);
                    }
                } else {
                    toasterErrorMessage('Request failed with status:', xhr.status);
                    if ($("#Download_" + District).html().includes('<i class="fa fa-spinner fa-spin" aria-hidden="true">')) {
                        $("#Download_" + District).html(ButtonHtml);
                    }
                }
            };

            xhr.onerror = function () {
                toasterErrorMessage('Request error');
                if ($("#Download_" + District).html().includes('<i class="fa fa-spinner fa-spin" aria-hidden="true">')) {
                    $("#Download_" + District).html(ButtonHtml);
                }
            };

            // Prepare form data and send
            var formData = new FormData();
            formData.append('batch_value', pybatchid_value);
            formData.append('distict_value', Region_value);

            xhr.send(formData);

        }

