@model App.Data.ViewModels.GeneratePensionProcessModel
@{
    ViewBag.Title = "DirectDepositEntries";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var Group = @Html.Raw(Json.Encode(ViewBag.Group));
}
<div class="panel panel-default">

    <div class="panel-body pt-1">
        @using (Html.BeginForm("DirectDepositEntries", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", onsubmit = "return generateDepositEntries();" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })


            <div class="row">
                <div class="col-sm-12">
                    <label>District</label>
                    @Html.TextBox("RegionNames", "", new { @class = "form-control", @autocomplete = "off", @placeholder = " Regions" })
                </div>
                <div class="col-sm-4" hidden>

                    @Html.LabelFor(model => model.EmployeeType, new { @class = " control-label mb-2" })
                    @*@Html.DropDownListFor(model => model.EmployeeType, null, new { @class = "form-control input-sm" })*@
                    @Html.DropDownList("EmpType", ViewBag.EmployeeType as SelectList, new { @class = "form-control input-sm" })

                </div>
                <div class="col-sm-4">
                    <div class="mt-4" for="EmployeeType"> &nbsp;</div>
                    <input type="submit" id="Btn" class="btn btn-success px-5 height" value="Create Direct Deposit Entries" />
                    <i id="spinner" class="fa fa-spinner fa-spin" style="display:none;"></i>
                </div>
            </div>
            @*<div>
                  <iframe id="RptIframe" width="100%" height="500" frameborder="0"></iframe>
                </div>*@
        }
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Payroll Process - Direct Deposit Entries
        </h4>
    </div>
    <div class="panel-body">
        <div class="row py-3">
            <div class="col-sm-12 hidden" id="DivRptIframe">
                <iframe id="RptIframe" width="100%" height="500" frameborder="0"></iframe>
            </div>
            <div class="col-sm-12 hidden" id="DivRecordFound">
                <div class="alert alert-warning">
                    <h4 class="mb-0"> There is no Record Found</h4>
                </div>

                @*<div class="alert alert-info">
                        <h4 class="mb-0"> There is no Record Found</h4>
                    </div>*@
                @*<iframe id="reportData" style="border: 0px;height:700px;width:100%;"></iframe>*@
            </div>
        </div>
    </div>

</div>
@section scripts{
    <script nonce="@ViewBag.StyleNonce">
    // By Sujeet No action name "CheckProcessAdded" method found int the solution. So comment the code on class ".btn-success" click function
  //$('.btn-success').click(function () {
  //  $.ajax({
  //    url: '/PensionProcess/CheckProcessAdded',
  //    type: 'Get',
  //    dataType: 'json'
  //  }).done(function (result) {
  //    if (result.length <= 0) {
  //      toasterErrorMessage("No Active Batch for Payroll Process,Please Create a New Batch & Refresh"); return false;
  //    }
  //  });
  //});

  $(document).ready(function () {
      if ('@ViewBag.RptLoad' == 'RptDirectDepositEntries.rpt') {
          $("#DivRptIframe").removeClass("hidden");
          document.getElementById('RptIframe').src = "/ReportForms/ContributionByEmployer.aspx";
      }
      else {
          $("#DivRecordFound").removeClass("hidden");
      }
  });
     jQuery(document).ready(function ($) {
      comboTree = $('#RegionNames').comboTree({
        source: @Group,
        isMultiple: true,
        cascadeSelect: true,
        collapse: false
      });
     });

    function generateDepositEntries() {
      debugger
      $('#spinner').show();

      $('#Btn').prop('disabled', true);
      return true;
    }

    </script>
}
