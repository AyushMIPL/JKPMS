@model App.Data.ViewModels.PensionFileUploadViewModel
@{
    ViewBag.Title = "Upload Pension File";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style nonce="@ViewBag.StyleNonce">
    /* ===== Tabs Container ===== */
    .nav-tabs {
        border-bottom: 2px solid #27ae60;
        margin-bottom: 0;
    }

        /* ===== Tab Links ===== */
        .nav-tabs > li > a {
            border: none !important;
            color: #666;
            padding: 12px 25px;
            font-weight: 600;
            border-radius: 5px 5px 0 0;
            margin-right: 5px;
            background-color: transparent !important;
            border-bottom: 2px solid transparent !important;
            transition: all 0.25s ease-in-out;
        }

            .nav-tabs > li > a:hover {
                background-color: rgba(0, 0, 0, 0.05) !important;
                color: #333;
            }

        /* ===== Active Tab ===== */
        .nav-tabs > li.active > a,
        .nav-tabs > li.active > a:hover,
        .nav-tabs > li.active > a:focus {
            background-color: #eafaf1 !important;
            color: #27ae60 !important;
            border: 2px solid #27ae60 !important;
            border-bottom: none !important;
            position: relative;
            z-index: 2;
        }

    /* ===== Tab Content ===== */
    .tab-content {
        background-color: #fff;
        padding: 30px;
        border: 2px solid #e7e7e7;
        border-top: none;
        border-radius: 0 0 8px 8px;
    }

    /* ===== Panel Body ===== */
    .panel-body-upload {
        background-color: #fcfcfc;
        padding: 20px;
    }

    /* ===== Labels ===== */
    .control-label {
        font-weight: 600;
        color: #555;
    }

    /* ===== Table Alignment ===== */
    #tblUploadHistory th,
    #tblUploadHistory td {
        text-align: left !important;
        vertical-align: middle;
    }

    /* ===== Select2 Width Fix for Upload Forms ===== */
    .upload-form .select2-container {
        width: 100% !important;
    }
</style>

<div class="panel panel-default">
    <div class="panel-heading">
        <h4 class="headline">Upload already generated pension files</h4>
    </div>
    <div class="panel-body panel-body-upload pb-5">
        <!-- Requirement 1: Improved tab structure -->
        @*<ul class="nav nav-tabs" id="uploadTabs" role="tablist">
            <li class="active">
                <a href="#disbursementTab" data-toggle="tab" role="tab" data-type="Disbursement">
                    <i class="fa fa-money"></i> Upload Disbursement File
                </a>
            </li>
            <li>
                <a href="#validationTab" data-toggle="tab" role="tab" data-type="Validation">
                    <i class="fa fa-check-circle"></i> Upload Account Validation File
                </a>
            </li>
        </ul>*@
        <ul class="nav nav-tabs">
            <li class="active">
                <a href="#disbursementTab"  data-type="Disbursement">
                    Upload Disbursement File
                </a>
            </li>
            <li>
                <a href="#validationTab"  data-type="Validation">
                    Upload Account Validation File
                </a>
            </li>
        </ul>

        <!-- Tab Panes -->
        <div class="tab-content">
            <div class="tab-pane active" id="disbursementTab">
                @using (Html.BeginForm("UploadPensionFileAjax", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", id = "disbursementForm", @class = "form-horizontal upload-form" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UploadType" value="Disbursement" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.UploadedFile, new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    <input type="file" name="UploadedFile" class="form-control" accept=".csv,.xlsx" />
                                    @Html.ValidationMessageFor(m => m.UploadedFile, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">District *</label>
                                <div class="col-sm-8">
                                    <!-- Role-based District Selection: Pre-selected and Disabled for District Role users, Selectable for others -->
                                    @if (ViewBag.IsDistrictUser == true)
                                    {
                                        @Html.DropDownListFor(m => m.Region, (IEnumerable<SelectListItem>)ViewBag.Regions, new { @class = "form-control district-select", disabled = "disabled", id = "Region" })
                                        <input type="hidden" name="Region" value="@ViewBag.UserDistrictName" />
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(m => m.Region, (IEnumerable<SelectListItem>)ViewBag.Regions, "Select Region", new { @class = "form-control district-select", required = "required", id = "Region" })
                                    }
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Year *</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(m => m.UploadYear, (IEnumerable<SelectListItem>)ViewBag.Years, "Select Year", new { @class = "form-control", required = "required" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Month *</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(m => m.UploadMonth, (IEnumerable<SelectListItem>)ViewBag.Months, "Select Month", new { @class = "form-control", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Remarks, new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", rows = "5", placeholder = "Additional remarks mapping to file" })
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="tab-pane" id="validationTab">
                @using (Html.BeginForm("UploadPensionFileAjax", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", id = "validationForm", @class = "form-horizontal upload-form" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UploadType" value="Validation" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Validation File *</label>
                                <div class="col-sm-8">
                                    <input type="file" name="UploadedFile" class="form-control" accept=".csv,.xlsx" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">District *</label>
                                <div class="col-sm-8">
                                    <!-- Role-based District Selection: Pre-selected and Disabled for District Role users, Selectable for others -->
                                    @if (ViewBag.IsDistrictUser == true)
                                    {
                                        @Html.DropDownListFor(m => m.Region, (IEnumerable<SelectListItem>)ViewBag.Regions, new { @class = "form-control district-select", disabled = "disabled", id = "ValidationRegion" })
                                        <input type="hidden" name="Region" value="@ViewBag.UserDistrictName" />
                                    }
                                    else
                                    {
                                        @Html.DropDownListFor(m => m.Region, (IEnumerable<SelectListItem>)ViewBag.Regions, "Select Region", new { @class = "form-control district-select", required = "required", id = "ValidationRegion" })
                                    }
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(m => m.Remarks, new { @class = "col-sm-4 control-label" })
                                <div class="col-sm-8">
                                    @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", rows = "3", placeholder = "Additional remarks for validation file" })
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="row m-top-sm mt-3">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="button" id="btnUpload" class="btn btn-success px-5 shadow-sm">
                        <i class="fa fa-cloud-upload"></i> <span id="btnText">Upload & Send to Bank</span>
                        <i id="uploadSpinner" class="fa fa-spinner fa-spin" style="display:none;"></i>
                    </button>
                    <button type="button" id="btnDownloadFormat" class="btn btn-info px-4 shadow-sm ml-2" style="margin-left: 10px;">
                        <i class="fa fa-download"></i> Download Format
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-default m-top-md shadow-sm">
    <div class="panel-heading">
        <h4 class="headline">Upload History</h4>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table id="tblUploadHistory" class="table table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th>File Name</th>
                        <th>District</th>
                        <th>Period</th>
                        <th>Upload Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script nonce="@ViewBag.StyleNonce">
        var currentUploadType = "Disbursement";
        var historyTable;

        $(document).ready(function () {

            $('.nav-tabs li a').on('click', function (e) {
                e.preventDefault();

                var target = $(this).attr('href');
                currentUploadType = $(this).data('type');

                //  Remove active from all tabs
                $('.nav-tabs li').removeClass('active');
                $('.nav-tabs li a').removeClass('active');

                //  Add active to clicked tab
                $(this).parent().addClass('active');
                $(this).addClass('active');

                // Hide all tab panes
                $('.tab-pane').removeClass('active').hide();

                //  Show selected tab
                $(target).addClass('active').show();

                //  Handle table changes
                toggleColumns();
                historyTable.fnDraw();
            });

            // Initialize History Table
            historyTable = $('#tblUploadHistory').dataTable({
                "bServerSide": true,
                "sAjaxSource": "/PensionProcess/BeneficiaryUploadHistoryAjaxHandler",
                "fnServerParams": function (aoData) {
                    aoData.push({ "name": "uploadType", "value": currentUploadType });
                },
                "bProcessing": true,
                "sPaginationType": "full_numbers",
                "bDestroy": true,
                "aoColumns": [
                    {
                        "sName": "FileName",
                        "mRender": function (data, type, row) {
                            //console.log($.fn.dataTable.version);
                            var id = row[5]; // or row.Id if using object
                            return '<a href="/PensionProcess/DownloadUploadedPensionFile?id=' + id + '" target="_blank" title="Click to download" class="text-primary font-weight-bold"><i class="fa fa-download"></i> ' + data + '</a>';
                        }
                    },
                    { "sName": "Region" },
                    { "sName": "Period" },
                    { "sName": "UploadedOn" },
                    { 
                        "sName": "Status",
                        "render": function (data, type, row) {
                            var badgeClass = "badge-default";
                            if (data === "Sent") badgeClass = "label label-success";
                            else if (data === "Failed") badgeClass = "label label-danger";
                            else badgeClass = "label label-warning";
                            return '<span class="' + badgeClass + '">' + data + '</span>';
                        }
                    }
                ]
            });

            //setTimeout(function () {
            //    toggleColumns();
            //}, 100);


            // Requirement 2: Fixed Tab Refresh using standard Bootstrap events
            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                currentUploadType = $(e.target).data('type');

                toggleColumns();                  
                historyTable.fnDraw(); 
            });
        });

        $(document).on('click', '#btnUpload', function () {
            var activeFormId = currentUploadType === "Disbursement" ? "#disbursementForm" : "#validationForm";
            var form = $(activeFormId)[0];
            handleFormSubmission(form);
        });

        $(document).on('click', '#btnDownloadFormat', function () {
            window.location.href = '@Url.Action("DownloadFormatFile", "PensionProcess")?type=' + currentUploadType;
        });

        function toggleColumns() {

            var oTable = $('#tblUploadHistory').dataTable();

            if (currentUploadType === "Disbursement") {
                oTable.fnSetColumnVis(1, true);  // Show District
                oTable.fnSetColumnVis(2, true);  // Show Period
            } else {
                // Show District column in Account Validation File DataTable
                oTable.fnSetColumnVis(1, true);  // Show District
                oTable.fnSetColumnVis(2, false); // Hide Period
            }
        }

        function resetForm(form) {

            // Reset native form
            form.reset();

            // Clear file input (important)
            $(form).find('input[type="file"]').val('');

            // Reset dropdowns properly (MVC fix) - preserve disabled ones so they remain pre-selected for district role users
            $(form).find('select:not([disabled])').each(function () {
                $(this).val('').prop('selectedIndex', 0);
                $(this).find('option').prop('selected', false);
                $(this).find('option:first').prop('selected', true);
                $(this).trigger('change'); // important if any UI plugin
            });

            // Clear textarea
            $(form).find('textarea').val('');

            // Clear validation messages
            $(form).find('.text-danger').html('');
        }

        function handleFormSubmission(form) {
            var fileInput = $(form).find('input[type="file"]');
            if (!fileInput.val()) {
                alert('Please select a file to upload.');
                return;
            }

            if (currentUploadType === "Disbursement") {
                if (!$('#Region').val()) { alert('Please select a District.'); return; }
                if (!$('#UploadYear').val()) { alert('Please select a Year.'); return; }
                if (!$('#UploadMonth').val()) { alert('Please select a Month.'); return; }
            } else if (currentUploadType === "Validation") {
                if (!$('#ValidationRegion').val()) { alert('Please select a District.'); return; }
            }

            $('#uploadSpinner').show();
            $('#btnUpload').prop('disabled', true);

            var formData = new FormData(form);

            $.ajax({
                url: form.action,
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    $('#uploadSpinner').hide();
                    $('#btnUpload').prop('disabled', false);
                    
                    if (response.success) {
                        toasterSuccessMessage(response.message);
                        resetForm(form);
                        historyTable.fnDraw();
                    } else {
                        toasterErrorMessage(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    $('#uploadSpinner').hide();
                    $('#btnUpload').prop('disabled', false);
                    toasterErrorMessage("Upload failed. Status: " + status + ", Error: " + error);
                    console.error(xhr.responseText);
                }
            });
        }

        function retryUpload(id) {
            if (!confirm('Are you sure you want to retry processing this file?')) return;

            $.ajax({
                url: '/PensionProcess/RetryUploadPensionFileAjax',
                type: 'POST',
                data: { id: id },
                success: function (response) {
                    if (response.success) {
                        toasterSuccessMessage(response.message);
                        historyTable.fnDraw();
                    } else {
                        toasterErrorMessage(response.message);
                    }
                },
                error: function () {
                    toasterErrorMessage("An error occurred during retry.");
                }
            });
        }
    </script>
}