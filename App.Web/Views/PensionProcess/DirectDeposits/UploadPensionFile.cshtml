@model App.Data.ViewModels.PensionFileUploadViewModel
@{
    ViewBag.Title = "Upload Pension File";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default">
    <div class="panel-heading">
        <h4 class="headline">Upload already generated pension files</h4>
    </div>
    <div class="panel-body pt-2 pb-5">
        @using (Html.BeginForm("UploadPensionFileAjax", "PensionProcess", FormMethod.Post, new { enctype = "multipart/form-data", id = "uploadForm", @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.UploadedFile, new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            <input type="file" name="UploadedFile" id="UploadedFile" class="form-control" accept=".csv,.xlsx" />
                            @Html.ValidationMessageFor(m => m.UploadedFile, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.BankReferenceNo, new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.BankReferenceNo, new { @class = "form-control", placeholder = "Enter Bank Reference No" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(m => m.Remarks, new { @class = "col-sm-4 control-label" })
                        <div class="col-sm-8">
                            @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control", rows = "3", placeholder = "Additional remarks mapping to file" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row m-top-sm">
                <div class="col-sm-offset-2 col-sm-10">
                    <button type="button" id="btnUpload" class="btn btn-success px-5">
                        <i class="fa fa-cloud-upload"></i> Upload & Send to Bank
                        <i id="uploadSpinner" class="fa fa-spinner fa-spin" style="display:none;"></i>
                    </button>
                    <button type="reset" id="btnReset" class="btn btn-default">Reset</button>
                </div>
            </div>
        }
    </div>
</div>

<div class="panel panel-default m-top-md">
    <div class="panel-heading">
        <h4 class="headline">Upload History</h4>
    </div>
    <div class="panel-body">
        <div class="table-responsive">
            <table id="tblUploadHistory" class="table table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th>File Name</th>
                        <th>Uploaded By</th>
                        <th>Upload Date</th>
                        <th>Status</th>
                        <th>Ref No</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script nonce="@ViewBag.StyleNonce">
        $(document).ready(function () {
            var oTable = $('#tblUploadHistory').dataTable({
                "bServerSide": true,
                "sAjaxSource": "/PensionProcess/BeneficiaryUploadHistoryAjaxHandler",
                "bProcessing": true,
                "sPaginationType": "full_numbers",
                "bDestroy": true,
                "aoColumns": [
                    { "sName": "FileName" },
                    { "sName": "UploadedBy" },
                    { "sName": "UploadedOn" },
                    { 
                        "sName": "Status",
                        "render": function (data, type, row) {
                            var badgeClass = "badge-default";
                            if (data === "Sent") badgeClass = "label label-success";
                            else if (data === "Failed") badgeClass = "label label-danger";
                            else badgeClass = "label label-warning";
                            return '<span class="' + badgeClass + '">' + data + '</span>';
                        }
                    },
                    { "sName": "BankReferenceNo" },
                    {
                        "sName": "Actions",
                        "bSearchable": false,
                        "bSortable": false,
                        "render": function (data, type, row) {
                            var id = row[5];
                            var status = row[3];
                            var buttons = `<a href="/PensionProcess/DownloadUploadedPensionFile/${id}" class="btn btn-info btn-xs" title="Download Original File"><i class="fa fa-download"></i> Download</a>`;
                            
                            if (status === "Failed") {
                                buttons += '<button type="button" onclick="retryUpload(' + id + ')" class="btn btn-warning btn-xs" title="Retry Send"><i class="fa fa-refresh"></i> Retry</button>';
                            }
                            return buttons;
                        }
                    }
                ]
            });

            //$('#uploadForm').submit(function (e) {
            //    e.preventDefault();
            //    e.stopImmediatePropagation();
            //    handleFormSubmission(this);
            //    return false;
            //});
        });

        $(document).on('click', '#btnUpload', function () {
            handleFormSubmission($('#uploadForm')[0]);
        });

        function handleFormSubmission(form) {
            if (!$('#UploadedFile').val()) {
                alert('Please select a file.');
                return;
            }

            $('#uploadSpinner').show();
            $('#btnUpload').prop('disabled', true);

            var formData = new FormData(form);

            $.ajax({
                url: form.action,
                type: 'POST',
                data: formData,
                //cache: false,
                contentType: false,
                processData: false,
                success: function (response) {
                    $('#uploadSpinner').hide();
                    $('#btnUpload').prop('disabled', false);
                    
                    if (response.success) {
                        toasterSuccessMessage(response.message);
                        $('#uploadForm')[0].reset();
                        $('#tblUploadHistory').dataTable().fnDraw();
                    } else {
                        toasterErrorMessage(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    $('#uploadSpinner').hide();
                    $('#btnUpload').prop('disabled', false);
                    toasterErrorMessage("Upload failed. Status: " + status + ", Error: " + error);
                    console.error(xhr.responseText);
                }
            });
        }

        function retryUpload(id) {
            if (!confirm('Are you sure you want to retry sending this file to the bank?')) return;

            $.ajax({
                url: '/PensionProcess/RetryUploadPensionFileAjax',
                type: 'POST',
                data: { id: id },
                success: function (response) {
                    if (response.success) {
                        toasterSuccessMessage(response.message);
                        $('#tblUploadHistory').dataTable().fnDraw();
                    } else {
                        toasterErrorMessage(response.message);
                    }
                },
                error: function () {
                    toasterErrorMessage("An error occurred during retry.");
                }
            });
        }
    </script>
}
