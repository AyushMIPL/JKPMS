            // Check if a file is selected and validate the file extension
            if (file && !file.name.endsWith('.csv')) {
                fileInput.val(''); // Clear the file input
                fileInput.next('label').attr('data-title', 'Select file');
                fileInput.next('label').find('span').attr('data-title', 'No file selected...');
            } else if (file) {
                // Update label to show selected file name if valid
                fileInput.next('label').find('span').attr('data-title', file.name);
            }
        });

