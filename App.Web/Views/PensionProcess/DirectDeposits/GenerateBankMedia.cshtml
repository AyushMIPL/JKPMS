      function AddBankMediaExcelDatabase(evt) {
          $(evt.target).find("i.fa-spinner").show();
        if ($("#formattedName").val() == "" || $("#formattedName").val() == null || $("#formattedName").val() == undefined || $("#formattedName").val() == "undefined") {
            toasterWarningMessage("First upload the file then save.");
            $(evt.target).find("i.fa-spinner").hide();
          return false;
        }
        // Create FormData object
        var fileData = new FormData();
        // Adding one more key to FormData object
        fileData.append('formattedName', $("#formattedName").val());
        $.ajax({
          type: "POST",
          url: "@Url.Action("AddBankMediaIntoDatabaseAjax", "PensionProcess")",
          contentType: false, // Not to set any content header
          processData: false, // Not to process data
          data: fileData,
          success: function (data) {
            if (data == "1") {
              toasterSuccessMessage("Save Successfully.");
              location.reload();
            } else {
                toasterErrorMessage("Opps! Somthing went wrong. Please try again.");
                $(evt.target).find("i.fa-spinner").hide();
            }
          }
        });
      }
      function BankMediaExcelCancelUpload() {
      window.location.reload();
    }
      function BankMediaExcelUpload(evt) {
      try {
          var IsFile = $("#file").val();
          $(evt.target).find("i.fa-spinner").show();
        if (IsFile != null && IsFile != "" && IsFile != undefined) {
          var fileUpload = $("#file").get(0);
          var files = fileUpload.files;
          // Create FormData object
          var fileData = new FormData();
          // Looping over all files and add it to FormData object
          for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
          }
          $.ajax({
            type: "POST",
            url: '@Url.Action("BankMediaExcelUploadAjax", "PensionProcess")',
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            //contentType: "application/json; charset=utf-8",
            //dataType: "json",
            data: fileData,
            success: function (data) {
              if (data != "") {
                $("#formattedName").val(data);
                $("#BankMediaExcelUpload").toggle();
                $("#BankMediaExcelSave").toggle();
                $("#BankMediaExcelCancel").toggle();
                  toasterSuccessMessage("Upload Successfully.");
                  $(evt.target).find("i.fa-spinner").hide();
              } else {
                  toasterErrorMessage("Opps! Somthing went wrong. Please try again.");
                  $(evt.target).find("i.fa-spinner").hide();
              }
            },
            error: function (a, b, c) {
              debugger;
            }
          });
         }
      }
      catch (e) {
        debugger;
      }
    }
