
<style>
  a.disabled {
    color: gray;
    pointer-events: none;
    opacity: .8;
  }
  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style> 

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-masterincomeindex" >
      @*Income Codes*@
      Monthly Pension

      <ul class="tool-bar">
        <li>
          <a href="/MasterIncomeCode/Create" class="@(ViewBag.AddPermission == true ? "" : "disabled")"
             data-placement="bottom"
             title="Add details"
             data-original-title="Add Details">
            <i class="fa fa-plus"></i>
          </a>
        </li>

      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>

          <th>Code</th>
          <th>Description</th>
          <th>Type</th>
          <th class="button-masterincome-action"></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {

    <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });

      var MasterIncomeTableId = [];

    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "sAjaxSource": "/MasterIncomeCode/AjaxHandler",

        "fnDrawCallback": function (setting) {
          debugger;
          MasterIncomeTableId.forEach(function (item, index) {
            debugger
            if (document.getElementById("EditMasterIncomeCodeBtn_" +item) != null && document.getElementById("EditMasterIncomeCodeBtn_" + item) != undefined) {              
                document.getElementById("EditMasterIncomeCodeBtn_" + item).addEventListener("click", function () {
                  EditMasterIncomeCode(item);
                });
              }
              if (document.getElementById("DetailsMasterIncomeCodeeBtn_" +item) != null && document.getElementById("DetailsMasterIncomeCodeeBtn_" + item) != undefined) {
                document.getElementById("DetailsMasterIncomeCodeeBtn_" + item).addEventListener("click", function () {
                  DetailsMasterIncomeCodee(item);
                });
              }

          });

        },

        "aoColumns": [

						{ "sName": "Code" },
            { "sName": "Description" },
            { "sName": "Type" },
						{
						  "sName": "ID",
						  "bSearchable": false,
						  "bSortable": false,
              "fnRender": function (oObj) {
                var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
                  //var strString = '<button onclick="EditMasterIncomeCode(\'' + oObj.aData[3] + '\');" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

                  //strString += '&nbsp;<button onclick="DetailsMasterIncomeCodee(\'' + oObj.aData[3] + '\');" class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';


                var strString = '<button id="EditMasterIncomeCodeBtn_' + oObj.aData[3] + '"  class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

                strString += '&nbsp;<button id="DetailsMasterIncomeCodeeBtn_' + oObj.aData[3] + '"  class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';
                MasterIncomeTableId.push(oObj.aData[3]);
						    return strString;
						  }
						}
        ]
      });
      }


      /// **** Code By Himanshu Rajput *****

        function EditMasterIncomeCode(id) {
     window.location.href = "@Url.Action("Edit", "MasterIncomeCode")?Id=" + id ;
}

        function DetailsMasterIncomeCodee(id) {
     window.location.href = "@Url.Action("Details", "MasterIncomeCode")?Id=" + id ;
}

    </script>
}
