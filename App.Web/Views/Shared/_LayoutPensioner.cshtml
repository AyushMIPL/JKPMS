<div class="row">
  <div class="col-sm-2 bg-primary custom-grid menu-grid">
    <button type="button" class="navbar-toggle" id="inboxMenuToggle">
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>
    <div class="menu-header">
      Menu
    </div>
    <ul class="inbox-menu" id="inboxMenu">
      <li class="active">
        <a href="/MasterPensioner/Edit?Id=@ViewBag.CId"><i class="fa fa-user-times fa-lg"></i> <span class="m-left-xs" title="Beneficiary Details">Beneficiary Details</span></a>
      </li>
      <li>
        <a href="/MasterPensioner/IncomeIndex?Id=@ViewBag.CId">
          @*@ViewBag.CId*@
          <i class="fa fa-inr fa-lg"></i>
          <span class="m-left-xs" title="Income">Monthly Pension</span>
        </a>
      </li>

      <li>
        <a href="/MasterPensioner/BankDetailsIndex?Id=@ViewBag.CId">
          <i class="fa fa-university fa-lg"></i>
          <span class="m-left-xs" title="Bank Detail">Bank Detail</span>
        </a>
      </li>

      @******Code by Himanshu Rajpu ******@

      <li>
        @*<a href="/MasterPensioner/_PaymentHistory?Id=@IdUrl">*@
        <a href="/MasterPensioner/PaymentHistoryAjax?Id=@ViewBag.CId">
          <i class="fa fa-history fa-lg"></i>
          <span class="m-left-xs" title="Payment History">Payment History</span>
        </a>
      </li>


    </ul>
  </div>
  <div class="col-sm-10">
    @RenderSection("profilePensioner", required: false)
  </div>
</div>

@section scripts{


  <script nonce="@ViewBag.StyleNonce">
    $(document).ready(function () {
      var activeIndex = localStorage.getItem('activeIndex');
      if (activeIndex !== null) {
        $('#inboxMenu li').removeClass('active');
        $('#inboxMenu li').eq(activeIndex).addClass('active');
      }
      $('#inboxMenu li').click(function(){
        $('#inboxMenu li').removeClass('active');
      $(this).addClass('active');
      var currentIndex = $('#inboxMenu li').index(this);
      localStorage.setItem('activeIndex', currentIndex.toString());
      });
    });
  </script>

  @*<style>
    .menu-grid .inbox-menu > li > a {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>*@

  @RenderSection("Scripts", false);
}