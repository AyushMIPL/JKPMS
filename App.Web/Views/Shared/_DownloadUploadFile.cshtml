    function MasterEmployeeSFTPUpload(evt) {
        $('#btn_SFTP_loading').show();
        $('#MasterEmployeeSFTPUpload').hide();

        $.ajax({
            type: "GET",
            url: '@Url.Action("UpdateValidationResponseAjax", "PensionProcess")',
            success: function (response) {
                if (response === "Validation Response Uploaded") {
                    toasterSuccessMessage("Validation Response from SFTP Processed Successfully.");
                    location.reload();
                } else if (response.error) {
                    toasterErrorMessage("Error: " + response.error);
                    $('#btn_SFTP_loading').hide();
                    $('#MasterEmployeeSFTPUpload').show();
                } else {
                    toasterErrorMessage("Oops! Something went wrong.");
                    $('#btn_SFTP_loading').hide();
                    $('#MasterEmployeeSFTPUpload').show();
                }
            },
            error: function () {
                toasterErrorMessage("Failed to process validation response from SFTP.");
                $('#btn_SFTP_loading').hide();
                $('#MasterEmployeeSFTPUpload').show();
            }
        });
    }

