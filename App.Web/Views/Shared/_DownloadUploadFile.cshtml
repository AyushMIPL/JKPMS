    function AddMasterEmployeeExcelDatabase(evt) {
        $('#btn_Saved_loading').show();
        $('#MasterEmployeeExcelSave').hide();
        //$(evt.target).find("i.fa-spinner").show();
      var fileName = $("#formattedName").val();
      if (fileName == "" || fileName == null || fileName == undefined || fileName == "undefined") {
          toasterWarningMessage("First upload the file then save.");
          $('#MasterEmployeeExcelSave').hide();
          //$(evt.target).find("i.fa-spinner").hide();
        return false;
      }
      // Create FormData object
      var fileData = new FormData();
      // Adding one more key to FormData object
      fileData.append('formattedName', fileName);
      $.ajax({
        type: "POST",
        url: "@Url.Action("AddMasterEmployeeExcelDatabaseAjax", "MasterPensioner")",
        contentType: false, // Not to set any content header
        processData: false, // Not to process data
        data: fileData,
        success: function (data) {
            if (data == "1") {
                $('#MasterEmployeeExcelSave').show();
                $('#btn_Saved_loading').hide();
            toasterSuccessMessage("Save Successfully.");
            location.reload();
          } else {
            toastr.error("Opps! Something went wrong. Please try again.");
                $('#btn_Saved_loading').hide();
            }
            $('#btn_Saved_loading').hide();
            //$(evt.target).find("i.fa-spinner").hide();
        }
      });
    }

