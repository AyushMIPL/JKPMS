      function MasterEmployeeExcelDownload(evt) {
        try {
          $('#btn_loading_Bank').show();
          $('#btnDownload').hide();

          var bankname = $("#BanksName").val();
          if (!bankname) {
            toasterErrorMessage("Select Bank Name before download.");
            $('#btn_loading_Bank').hide();
            $('#btnDownload').show();
            return;
          }

          bankname = bankname.map(function (element) {
            return element.replace('&', 'ANDSYMBOL');
          });

          $.ajax({
            url: '/MasterPensioner/MasterEmployeeExcelDownloadAjax',
            type: 'GET',
            data: { BankName: bankname.join(',') },
            success: function (response) {
              $('#btn_loading_Bank').hide();
              $('#btnDownload').show();

              if (response.Error) {
                console.error("Error:", response.Error);
                return;
              }

              if (Array.isArray(response)) {
                response.forEach((file, index) => {
                  setTimeout(() => downloadFile(file), index * 1000);
                });
              }
            },
            error: function () {
              $('#btn_loading_Bank').hide();
              $('#btnDownload').show();
              console.error("Failed to fetch files.");
            }
          });
        } catch (e) {
          console.error("Error:", e);
          $('#btn_loading_Bank').hide();
          $('#btnDownload').show();
        }
      }

      function downloadFile(file) {
        const link = document.createElement('a');
        const blob = new Blob([Uint8Array.from(atob(file.FileContent), c => c.charCodeAt(0))], { type: file.ContentType });
        const url = window.URL.createObjectURL(blob);

        link.href = url;
        link.download = file.FileName;
        link.click();
        setTimeout(() => window.URL.revokeObjectURL(url), 100);
      }



    //forward to fstp server
    function MasterForwardToFSTP(evt) {
      debugger
        try {
            //$(evt.target).find("i.fa-spinner").show();
            $('#btn_MasterForwardToFSTP_loading').show();
            $('#IdMasterForwardToFSTP').hide();
        var ApplicantIFSCCode = "JKB";// $("#ApplicantIFSCCode").val();
        if (ApplicantIFSCCode == "" || ApplicantIFSCCode == undefined || ApplicantIFSCCode == "undefined") {
            toasterErrorMessage("Select IFSC code before download.");
            $('#IdMasterForwardToFSTP').hide();
            //$(evt.target).find("i.fa-spinner").hide();
        } else {

          var bankname = "JKB,THE JAMMU AND KASHMIR BANK LTD.";
          var url = '/MasterPensioner/MasterJKBankEmployeeExcelDownloadAjax?BankName=' + bankname;
          var xhr = new XMLHttpRequest();
          xhr.open('GET', url, true);
          xhr.responseType = 'blob';
          xhr.onload = function () {
            console.log("success");
              //$(evt.target).find("i.fa-spinner").hide();
              $('#IdMasterForwardToFSTP').show();
            $('#btn_MasterForwardToFSTP_loading').hide();
            debugger
            if (xhr.status === 200) {
              toasterSuccessMessage("File forward to sftp server successfully.");
            }
            else {
              console.error('Request failed with status:', xhr.status);
              toasterErrorMessage("Failed forward to sftp server file.");
            }
            if (xhr.status === 200) {
              var blob = xhr.response;
              var url = window.URL.createObjectURL(blob);
              var a = document.createElement('a');
              a.href = url;
              var name = xhr.getResponseHeader('Content-Disposition').split(" ")[1];
              if (name.indexOf("filename") > -1) {
                name = name.split("=")[1];
              }
              a.download = name;
              a.style.display = 'none';
              document.body.appendChild(a);
              a.click();
              window.URL.revokeObjectURL(url);
            } else {
              console.error('Request failed with status:', xhr.status);
            }
          };
          xhr.onerror = function () {
              console.error('Request error');
              $('#btn_MasterForwardToFSTP_loading').hide();
            //$(evt.target).find("i.fa-spinner").hide();
          };
            xhr.send();
            //$(evt.target).find("i.fa-spinner").hide();
        }
      } catch (e) {

      }
