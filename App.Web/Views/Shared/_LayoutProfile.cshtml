@{
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
  <div class="col-sm-2 bg-primary custom-grid menu-grid">
    <button type="button" class="navbar-toggle" id="inboxMenuToggle">
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>
    <div class="menu-header">
      Menu
    </div>
    <ul class="inbox-menu" id="inboxMenu">
      <li class="active">

        <a href="@Url.Action("Edit", "ContributorPersonalDetails", new { id = @ViewBag.CId })"><i class="fa fa-inbox fa-lg"></i> <span class="m-left-xs" title="PersonalDetails">Personal Details</span></a>

      </li>
      <li>
        <a href="@Url.Action("MarriageDetailsIndex", "ContributorPersonalDetails", new { id = @ViewBag.CId })">
          <i class="fa fa-star fa-lg"></i>
          <span class="m-left-xs" title="Marriage Details">Marriage Details</span>
        </a>
      </li>
      <li>
        <a href="@Url.Action("DependantDetailsIndex", "ContributorPersonalDetails", new { id = @ViewBag.CId })">
          <i class="fa fa-bookmark fa-lg"></i>
          <span class="m-left-xs" title="Dependant Details">Dependant Details</span>
        </a>
      </li>
      <li>
        <a href="@Url.Action("AddJobDetails", "ContributorPersonalDetails", new { id = @ViewBag.CId })">
          <i class="fa fa-bookmark fa-lg"></i>
          <span class="m-left-xs" title="Job Details">Job Details</span>
        </a>
      </li>
      <li>
        <a href="@Url.Action("AddComment", "ContributorPersonalDetails", new { id = @ViewBag.CId })">
          <i class="fa fa-bookmark fa-lg"></i>
          <span class="m-left-xs" title="Comments">Comments</span>
        </a>
      </li>
      <li>
        <a href="@Url.Action("SalaryHistoryIndex", "ContributorPersonalDetails", new { id = @ViewBag.CId })">
          <i class="fa fa-bookmark fa-lg"></i>
          <span class="m-left-xs" title="Salary History">Salary History</span>
        </a>
      </li>
    </ul>
  </div>
  <div class="col-sm-10">
    @RenderSection("profileContainer", required: false)
  </div>
</div>

@section scripts{
  <style>
    .menu-grid .inbox-menu>li>a {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>
  @RenderSection("Scripts", false);
}
