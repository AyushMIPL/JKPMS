@model string

@{
  bool isMale=false;
  if (Model != null)
  {
    isMale = (Model ?? "M") == "M";
  }
  else
  {
    isMale = true;
  }
}
 


<div class=" row radio">
  <div class="col-md-3">@Html.RadioButton("", 'M', @isMale) Male</div>
  <div class="col-md-2">@Html.RadioButton("", 'F', !@isMale) Female</div>
</div>
