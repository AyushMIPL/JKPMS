      const downloadExcel_ClassBtn = document.querySelectorAll('.DownloadExcelclass');
      downloadExcel_ClassBtn.forEach(button => {
        button.addEventListener('click', downloadExcel);
      });

      function downloadExcel(evt) {
        ;
          $(evt.target).find("i.fa-spinner").show();
          $('#btn_downloadExcelHistroy_loading').show();
          $('#IddownloadExcelHistory').hide();
             $.ajax({
                 type: "POST",
               data: { PensionerID: $("#PensionerID").val(),isDownload: true },
               url: '@Url.Action("_PaymentHistoryHandlerAjax", "MasterPensioner")',
                 cache: false,
                 success: function (result) {
                     $('#IddownloadExcelHistory').show();
                     $('#btn_downloadExcelHistroy_loading').hide();
                     if (result != null) {
                         var bytes = new Uint8Array(result.FileContents);
                         var blob = new Blob([bytes], { type: '@System.Net.Mime.MediaTypeNames.Application.Octet' });
                         if (window.navigator.msSaveOrOpenBlob) {
                             // IE11
                             window.navigator.msSaveOrOpenBlob(blob, result.FileDownloadName);
                         } else {
                             // Google chome, Firefox, ....
                             var link = document.createElement('a');
                             link.href = window.URL.createObjectURL(blob);
                             link.download = result.FileDownloadName;
                             link.click();
                             $(evt.target).find("i.fa-spinner").hide();
                         }
                     }
                     else {

                     }
                 },
                 error: function (xhr, status, error) {
                 }
             });
    }

    ////Showing Payment Model
    function showPaymentStatusPopup(detailsLink, payDocNo) {

      $.ajax({
        url: "/MasterPensioner/GetPaymentdetailsAjax?EmplCode=" + detailsLink + "&PayDocNo=" + payDocNo,
        method: "GET",
        success: function (data) {
          if (data && data.length > 0) {
            var firstRecord = data[0];
            //$('#PaymentStatusAccountNo').val(accountNo);
            $("#PaymentStatusEmplcode").val(detailsLink);
            $("#APPLICATION_REFERENCE_NO").val(firstRecord.ApplicationReferenceNo);
            $("#Name").val(firstRecord.FullName);

            // Extract the numeric part of the timestamp string
            if (firstRecord.TransactionDate != "") {
              var timestamp = parseInt(firstRecord.TransactionDate.match(/\d+/)[0], 10);
              var currentDate = new Date(timestamp);
              var formattedDate = $.datepicker.formatDate('yy-mm-dd', currentDate);
              $('#TransactionDate').val(formattedDate);
            }
            //$("#TransactionDate").val(firstRecord.TransactionDate);

            $("#TransactionNo").val(firstRecord.TransactionRefrenceNo);
            /* $("#TransactionNo").val(firstRecord.TransactionNo);*/
            $("#RemarksId").val(firstRecord.Remarks);
            $("#paymentStatus").val(firstRecord.Status)
            $("#PayDocNo").val(firstRecord.PayDocNo)
            $("#PopUpPaymentStatus").popup('show');
          } else {
            console.error("No data returned from the server.");
          }
        },
        error: function (xhr, textStatus, errorThrown) {

          console.log("AJAX Request Failed", textStatus, errorThrown);
        }
      });
    }

   const logoutConfirm_close_ClassBtn = document.querySelectorAll('.logoutConfirm_close');
      logoutConfirm_close_ClassBtn.forEach(button => {
