    function oncancelPayment() {

      $('#error-message').hide();
      $('#PopUpPaymentStatus').popup("hide");;
    }
      document.getElementById("IdPaymentStatus").addEventListener("click", function () {
        onclickPaymentStatus();
      });

    function onclickPaymentStatus()
    {
      var emplcode = $("#PaymentStatusEmplcode").val();
      var Remark = $("#RemarksId").val();
      var TransactionDate = $("#TransactionDate").val();
      var paymentStatus = $("#paymentStatus").val();
      var ApplicationReferenceNo = $("#APPLICATION_REFERENCE_NO").val();
      var accountno = $('#PaymentStatusAccountNo').val();
      var TransactionNo = $("#TransactionNo").val();
      if (!Remark) {
        $('#error-RemarksId').text('Remark is required.');
        return;
      }
      if (paymentStatus==0) {
        $('#error-paymentStatus').text('Payment Status is required.');
        return;
      }
      if (paymentStatus == 'Ok') {
        if (TransactionNo == "") {
          $('#error-TransactionNo').text('Transaction no is required.');
          return;
        }
      }
      if (TransactionDate == '') {
        $('#error-TransactionDate').text('Date is required.');
        return;
      }
      $.ajax({
        type: "POST",
        url: "/MasterPensioner/UpdatePaymentStatusAjax",
        data: {
          emplcodes: emplcode,
          Remarks: Remark,
          TransactionDates: TransactionDate,
          paymentStatuses: paymentStatus,
          ApplicationReferenceNo: ApplicationReferenceNo,
          accountNos: accountno,
          TransactionNos: TransactionNo,
          PayDocNo: $("#PayDocNo").val()
        },
        success: function (result) {
          if (result.Status == true)
          {
            toasterSuccessMessage(result.Message);
          }
            location.reload();
        },
        error: function (xhr, status, error) {

          console.error("Ajax request failed", error);
          $('#btn_HoldPayment_loading').hide();
          $('#IdHoldPayment').show();
        }
      });
      $('#PopUpHoldPayment').hide();
    }

