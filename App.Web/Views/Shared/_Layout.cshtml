function attachFileUploadValidation(config) {
    const {
        uploadButtonId,
        fileInputId
    } = config;

    document.getElementById(uploadButtonId)?.addEventListener("click", function (e) {
        const fileInput = document.getElementById(fileInputId);
    
        if (!fileInput || !fileInput.files.length) {
            toasterErrorMessage("Please select a file before uploading.");
            e.preventDefault();
            return;
        }
    
        const file = fileInput.files[0];
        const fileName = file.name;
    
        const forbiddenCharsRegex = /[<>|{}()\\\/;\[\]*%$'"`=:+!^~#@@&]/g;
        const wafPatternStrings = ["--", "++", "<", ">", "|", "{", "}", "(", ")", "/", "\\"];
    
        const matchedSpecials = fileName.match(forbiddenCharsRegex);
        const containsWafPatterns = wafPatternStrings.some(pat => fileName.includes(pat));
    
        if (matchedSpecials || containsWafPatterns) {
            const extension = fileName.substring(fileName.lastIndexOf('.'));
            const baseName = fileName.substring(0, fileName.lastIndexOf('.'));
            const suggestedName = baseName.replace(forbiddenCharsRegex, "_").replace(/--|\+\+/g, "_") + extension;    
            toasterErrorMessage(`
                Invalid file name: <strong>${fileName}</strong><br><br>
                Characters like <code>&lt;, &gt;, |, {}, (), --, ++</code> etc. are not allowed.<br>
                Please rename your file to something like:<br>${suggestedName}<br>
            `);
            fileInput.value = '';
            e.preventDefault();
            return;
        }
    });
}
