@using Microsoft.AspNet.Identity;
@using App.Data;
@using App.Web.Helper;
@{
  ConnectionStringProvider ConnectionStringProvider = new ConnectionStringProvider();
  AppDbContext db = new AppDbContext(ConnectionStringProvider.GetConnectionString());
  int Id = Convert.ToInt32(User.Identity.GetUserId());
  string IdUrl = UrlEncryption.EncryptURL(Convert.ToString(Id));
  string userType = UrlEncryption.EncryptURL("1");
  var userDetails = db.Users.Where(x => x.Id == Id).FirstOrDefault();
  //var useremailId = db.Users.Where(x => x.Id == Id).Select(x => x.Email).FirstOrDefault();
  ViewBag.profilePath = db.UserProfiles.Where(x => x.UserId == Id).Select(x => x.ProfilePath).FirstOrDefault();

  var myList = Session["List"] as List<App.Data.ViewModels.SessionViewModel>;
  if (myList != null && myList.Any())
  {

    var firstRegion = myList.First().Region;


    ViewBag.FirstRegion = firstRegion;
  }

  int FinancialYear = DateTime.Now.Year;
  if (Session["FinancialYear"] != null)
  {
    FinancialYear = Convert.ToInt32(Session["FinancialYear"]);
  }
  string FinancialYearString = FinancialYear + "_" + (FinancialYear + 1);
}
@{
  var nonce = ViewBag.StyleNonce;
  var sessionNonce = Session["StyleNonce"];
  if (nonce == null)
  {
    nonce = sessionNonce;
  }
}


