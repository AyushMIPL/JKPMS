          @{
            var Controller = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString();
            var Action = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString();
            int refundlastApprovedLevel = 0;
            int pensionlastApprovedLevel = 0;
            //int user = App.Data.Entities.AppUserManager.GetUserId();
            List<App.Data.Entities.RefundApplications> model;
            List<App.Data.Entities.RefundApplications> tempRefund = new List<App.Data.Entities.RefundApplications>();
            var levels = (from level in db.ApprovalProcessLevel join users in db.ApprovalProcessAssignedUser on level.ApprovalProcessLevelId equals users.ApprovalProcessLevelId where level.ModuleId == 10 select users).ToList();
            if (levels.Where(x => x.ApprovalUser == Id).Any())
            {
              model = db.RefundApplications.ToList();
              int MaxLevel = levels.LastOrDefault().ApprovalProcessId;
              int MinLevel = levels.FirstOrDefault().ApprovalProcessId;
              foreach (var item in model)
              {
                string approved = "A";
                refundlastApprovedLevel = (from a in db.ApplicationApprovalStatus where a.ApplicationId == item.Id && a.ApprovalProcessId <= MaxLevel && a.ApprovalProcessId >= MinLevel orderby a.ApprovalProcessId descending select a == null ? 0 : a.ApprovalProcessId).FirstOrDefault();
                if (refundlastApprovedLevel != 0)
                {
                  approved = (from a in db.ApplicationApprovalStatus where a.ApplicationId == item.Id && a.ApprovalProcessId == refundlastApprovedLevel orderby a.ApprovalProcessId descending select a.ApprovalStatus).FirstOrDefault();
                }
                if (refundlastApprovedLevel != MaxLevel)
                {
                  item.Name = refundlastApprovedLevel == 4 ? "33%" : refundlastApprovedLevel == 5 ? "66%" : refundlastApprovedLevel + "%";
                  var pstatus = levels.Where(x => x.ApprovalProcessId > refundlastApprovedLevel).Select(x => new { x.ApprovalUser, x.ApprovalProcessId }).FirstOrDefault();
                  if (Id == pstatus.ApprovalUser && approved != "R" && pstatus.ApprovalProcessId <= MaxLevel)
                  {
                    tempRefund.Add(item);
                  }
                }
              }
            }
            //int user = AppUserManager.GetUserId();
            List<App.Data.Entities.PensionApplications> models;
            List<App.Data.Entities.PensionApplications> tempPension = new List<App.Data.Entities.PensionApplications>();
            var pensionlevels = (from level in db.ApprovalProcessLevel join users in db.ApprovalProcessAssignedUser on level.ApprovalProcessLevelId equals users.ApprovalProcessLevelId where level.ModuleId == 16 select users).ToList();
            if (pensionlevels.Where(x => x.ApprovalUser == Id).Any())
            {
              models = db.PensionApplications.ToList();
              int MaxLevel = pensionlevels.LastOrDefault().ApprovalProcessId;
              int MinLevel = pensionlevels.FirstOrDefault().ApprovalProcessId;
              foreach (var item in models)
              {
                string approved = "A";
                pensionlastApprovedLevel = (from a in db.ApplicationApprovalStatus where a.ApplicationId == item.Id && a.ApprovalProcessId <= MaxLevel && a.ApprovalProcessId >= MinLevel orderby a.ApprovalProcessId descending select a == null ? 0 : a.ApprovalProcessId).FirstOrDefault();
                if (pensionlastApprovedLevel != 0)
                {
                  approved = (from a in db.ApplicationApprovalStatus where a.ApplicationId == item.Id && a.ApprovalProcessId == pensionlastApprovedLevel orderby a.ApprovalProcessId descending select a.ApprovalStatus).FirstOrDefault();
                }
                if (pensionlastApprovedLevel != MaxLevel)
                {
                  item.ApprovalLevel = pensionlastApprovedLevel == 1 ? "33%" : pensionlastApprovedLevel == 2 ? "66%" : pensionlastApprovedLevel + "%";
                  var pstatus = pensionlevels.Where(x => x.ApprovalProcessId > pensionlastApprovedLevel).Select(x => new { x.ApprovalUser, x.ApprovalProcessId }).FirstOrDefault();
                  if (Id == pstatus.ApprovalUser && approved != "R" && pstatus.ApprovalProcessId <= MaxLevel)
                  {
                    tempPension.Add(item);
                  }
                }
              }
            }
            if (tempRefund.Count > 0)
            {
              <a href="#" class="dropdown-toggle" data-toggle="dropdown" title="Refund Application for Approval">
                <i class="fa fa-tasks fa-lg"></i>
                <span class="notification-label bounceIn animation-delay5">@tempRefund.Count</span>
              </a>
              <ul class="dropdown-menu task dropdown-2" id="refundNotification">
                @foreach (var item in tempRefund)
                {
                  <li>
                    <a href="/PaymentAndRefund/RefundApplicationApprovalDetails/@item.Id">
                      <div class="clearfix">
                        <span class="pull-left">@item.Contributor.FirstName @item.Contributor.MidName @item.Contributor.LastName</span>
                        <small class="pull-right text-muted">@item.Employer.EmployerName</small>
                      </div>
                      <div class="progress">
                        <div class="progress-bar progress-bar1-Layout" style="width:@item.Name"></div>
                      </div>
                    </a>
                  </li>
                }
                <li><a href="/PaymentAndRefund/RefundApplicationApprovalIndex">View all notifications</a></li>
              </ul>
            }
            else
            {
              <a href="#" class="dropdown-toggle hidden" data-toggle="dropdown" title="Refund Application for Approval">
                <i class="fa fa-tasks fa-lg"></i>
                <span class="notification-label bounceIn animation-delay5">0</span>
              </a>
              <ul class="dropdown-menu task dropdown-2" id="refundNotification">
                <li><a href="#">No Refund Application for Approval</a></li>
              </ul>
            }
          }
        </li>
