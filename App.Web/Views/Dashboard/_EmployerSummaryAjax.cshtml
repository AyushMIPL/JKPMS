@model List<App.Data.ViewModels.EmployerSummaryViewModel>
@using App.Web.Helper
@{
  Layout = null;
}
<div class="panel panel-default" id="employerSummaryStatistics">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      <button type="button" class="btn btn-info" onclick="showEmployerGraph();" style="float: right; display: none;" data-dismiss="modal" aria-hidden="true">Graph</button>
      Beneficiaries Summary

    </h4>
  </div>

  <ul class="list-group collapse in" id="EmployerSummary" @*style="background-color:lightgray"*@>
    <li class="list-group-item clearfix">
      <table style="width:100%;margin:5px;">
        <tr>
          <th style="width:50%;">Scheme</th>
          <th style="width:25%;">Beneficiary</th>
          <th style="width:25%">Details</th>
        </tr>
      </table>
    </li>
    @foreach (var item in Model)
    {
      <li class="list-group-item clearfix">
        <table style="width:100%;margin:5px;">
          <tr>
            <td style="width:50%;">@item.EmployerName</td>
            <td style="width:25%;">@item.Count</td>
            <td style="width:25%;"><a href='/MasterPensioner/Index?BeneficiariesType=@item.EmployerId' class=" btn btn-xs btn-primary" title="Detail"><i class="fa fa-list"></i></a></td>

          </tr>
        </table>
      </li>
    }

  </ul>

</div>

<div class="panel panel-default" id="employerGraph" style="display:none">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      <button type="button" class="btn btn-info" onclick="showEmployerStatistics();" style="float: right; display: none;">Statistics</button>
      Employers Summary

    </h4>
  </div>
  <canvas id="employerSummary" style="height:500px;width:500px;"></canvas>  

</div>



