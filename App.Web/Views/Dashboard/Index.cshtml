@model App.Data.ViewModels.WidgetsViewModel
@{
  ViewBag.Title = "Admin Dashboard";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row display_none">
  <div class="col-sm-6 col-md-3">
    <div class="panel-stat3 bg-danger panel_dashord">
      <h2 class="m-top-none" id="userCount">@ViewBag.NewContributor</h2>
      <h5>Newly Contributors</h5>
      <i class="fa fa-arrow-circle-o-up fa-lg"></i><span class="m-left-xs">Added in Current month</span>
      <div class="stat-icon">
        <i class="fa fa-user fa-3x"></i>
      </div>
      <div class="loading-overlay">
        <i class="loading-icon fa fa-refresh fa-spin fa-lg"></i>
      </div>
    </div>
  </div><!-- /.col -->
  <div class="col-sm-6 col-md-3">
    <a href="#Contributor">
      <div class="panel-stat3 bg-success">
        @*<h2 class="m-top-none" id="visitorCount">@ViewBag.Contributor</h2>*@
        <h5>Contributor's Service</h5>
        <i class="fa fa-arrow-circle-o-up fa-lg"></i><span class="m-left-xs">Being Mature in next 3 months</span>
        <div class="stat-icon">
          <i class="fa fa-briefcase fa-3x"></i>
        </div>
        <div class="loading-overlay">
          <i class="loading-icon fa fa-refresh fa-spin fa-lg"></i>
        </div>
      </div>
    </a>
  </div><!-- /.col -->
  <div class="col-sm-6 col-md-3">
    <a href="#Dependant">
      <div class="panel-stat3 bg-info">
        @*<h2 class="m-top-none"><span id="serverloadCount">@ViewBag.Dependant</span></h2>*@
        <h5>Dependants</h5>
        <i class="fa fa-arrow-circle-o-up fa-lg"></i><span class="m-left-xs">Terminating in next 3 months</span>
        <div class="stat-icon">
          <i class="fa fa-sitemap fa-3x"></i>
        </div>
        <div class="loading-overlay">
          <i class="loading-icon fa fa-refresh fa-spin fa-lg"></i>
        </div>
      </div>
    </a>
  </div><!-- /.col -->
  <div class="col-sm-6 col-md-3">
    <a href="#Survivor">
      <div class="panel-stat3 bg-warning">
        @*<h2 class="m-top-none" id="orderCount">@ViewBag.Survivor</h2>*@
        <h5>Survivor Pensioner</h5>
