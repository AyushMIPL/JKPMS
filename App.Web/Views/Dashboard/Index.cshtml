  <link href="~/Content/endless/LatestJS/buttons.dataTables.min.css" rel="stylesheet" />

  <script src="~/Content/endless/LatestJS/jquery.dataTables.min.js"></script>
  <script src="~/Content/endless/LatestJS/dataTables.buttons.min.js"></script>
  <script src="~/Content/endless/LatestJS/jszip.min.js"></script>
  <script src="~/Content/endless/LatestJS/pdfmake.min.js"></script>
  <script src="~/Content/endless/LatestJS/vfs_fonts.js"></script>
  <script src="~/Content/endless/LatestJS/buttons.html5.min.js"></script>

  <script nonce="@ViewBag.StyleNonce">
    BindBeneficiaryDetails();

      const PMTransander_ClassBtn = document.querySelectorAll('.PMTransander_Class');
    PMTransander_ClassBtn.forEach(button => {
        button.addEventListener('click', PMTransander);
      });

    const data_bs_dismiss_ClassBtn = document.querySelectorAll('.data_bs_dismiss');
    data_bs_dismiss_ClassBtn.forEach(button => {
      button.addEventListener('click', ClosePopup);
    });

    function PMTransander() {
      toasterErrorMessage("Beneficiary Records is not available");
      return false;
    }


    $(function () {
      survivor();
      Contributor();
      Dependant();
      BindFinancialYear();
      ContributionSummary();

    });
    function ReBindDashboardPaymentSummary() {
      ContributionSummary();
    }
    function ShowGrandTotalFooterValue(data) {
      var totalValueOfSuccess = 0;
      var totalValueOfFailed = 0;
      var totalValueOfStatusNotUpdated = 0;
      var totalValueOfBeneficiaries = 0;
      var totalValueOfMonthAmount = 0;
      var totalValueOfYearAmount = 0;
      var PayMonthInYear = "";
      var LastPayMonthInYear = "";

      data.aaData.forEach(function (item) {
        totalValueOfSuccess = totalValueOfSuccess + parseFloat(item[2]);
        totalValueOfFailed = totalValueOfFailed + parseFloat(item[3]);
        totalValueOfStatusNotUpdated = totalValueOfStatusNotUpdated + parseFloat(item[4]);
        totalValueOfBeneficiaries = totalValueOfBeneficiaries + parseFloat(item[5]);
        totalValueOfMonthAmount = totalValueOfMonthAmount + parseFloat(item[6]);
          totalValueOfYearAmount = totalValueOfYearAmount + parseFloat(item[7]);
          if (PayMonthInYear == "") {
              PayMonthInYear = item[8];
          }
          if (LastPayMonthInYear == "") {
              LastPayMonthInYear = item[9]
          }
      });
      totalValueOfMonthAmount = totalValueOfMonthAmount.toFixed(2);
      totalValueOfYearAmount = totalValueOfYearAmount.toFixed(2);

      $("#totalValueOfSuccess").text(totalValueOfSuccess);
      $("#totalValueOfFailed").text(totalValueOfFailed);
      $("#totalValueOfStatusNotUpdated").text(totalValueOfStatusNotUpdated);
      $("#totalValueOfBeneficiaries").text(totalValueOfBeneficiaries);
      $("#totalValueOfMonthAmount").text(totalValueOfMonthAmount);
      $("#totalValueOfYearAmount").text(totalValueOfYearAmount);

      var words = PayMonthInYear.split(',');

      // Insert line breaks after every 4 words
      var formattedText = words.map(function (word, index) {
        return (index % 3 === 2) ? word + '<br>' : word;
      }).join(', ');

      $("#PayMonthInYear").html(formattedText);
      $("#LastPayMonthInYear").html(LastPayMonthInYear);

    }

    var ContributionSummaryAjaxHandler = [];

    function ContributionSummary() {
      if (document.getElementById("loader") != null) {
        document.getElementById("loader").style.display = "block";
      }
      //var financialYear = $("#FinancialYearDropdown").val().split('_')[0];
      debugger
      var financialYear = 0;
      $("#tblPaymentCounts").dataTable({
        "bJQueryUI": true,
        "paging": false,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
        "sAjaxSource": "/Dashboard/ContributionSummaryAjaxHandler?financialYear=" + financialYear,
        "fnDrawCallback": function (settings) {
          debugger
          document.getElementById("loader").style.display = "none";
          ShowGrandTotalFooterValue(settings.json);
          // remove duplicates
          ContributionSummaryAjaxHandler = ContributionSummaryAjaxHandler.filter((value, index) => ContributionSummaryAjaxHandler.indexOf(value) === index);
          ContributionSummaryAjaxHandler.forEach(function (item, index) {
            debugger
            var splittedArray = item.split('_');
            document.getElementById(item).addEventListener("click", function () {
              GetPaymentList('', splittedArray[1], splittedArray[2], splittedArray[3]);
            });
          });
          //do whatever

          debugger
          GroupDataTable(this.api(), 0, 8);
        },
        "columnDefs": [
          {
            "targets": [0], // Index of the column to hide
            "visible": false // Set visibility to false
          }
        ],
        "aoColumns": [
          { "sName": "EmployerId" },
          { "sName": "EmployerName" },
          {
            "sName": "TotalContributorContribution",
            "bSearchable": false,
            "bSortable": false,
            "render": function (oObj, el, aData) {
              var Region = aData[0];
              var District = aData[1];
              var DataCount = aData[2];
              if (oObj != "0") {
                debugger
                var id = "paymentList_ok_" + District + "_" + Region;
                ContributionSummaryAjaxHandler.push(id);
                return '<span class="badge badge-success cursor_pointernotimportent" id="' + id + '">' + DataCount + '</span>';
              }
              /* return '<span href="" class="badge badge-success" style="cursor: pointer;" id="paymentList_(this,\'ok\',\'' + District + '\',\'' + Region + '\')">' + DataCount + '</span>';*/
              else {
                return '<span class="badge badge-success">' + DataCount + '</span>';
              }
            }
          },
          {
            "sName": "TotalMonthAmount",
            "bSearchable": false,
            "bSortable": false,
            "render": function (oObj, el, aData) {
              var Region = aData[0];
              var District = aData[1];
              var DataCount = aData[3];
              if (oObj != "0") {
                var id = "paymentList_fail_" + District + "_" + Region;
                ContributionSummaryAjaxHandler.push(id);
                return '<span class="badge badge-danger cursor_pointernotimportent" id="' + id + '">' + DataCount + '</span>';
                /* return '<span href="" class="badge badge-danger" style="cursor: pointer;" onclick="GetPaymentList(this,\'fail\',\'' + District + '\',\'' + Region + '\')">' + DataCount + '</span>';*/
              }
              else {
                return '<span class="badge badge-danger">' + DataCount + '</span>';
              }
            }
          },
          {
            "sName": "NotUpdated",
            "bSearchable": false,
            "bSortable": false,
            "render": function (oObj, el, aData) {
              var Region = aData[0];
              var District = aData[1];
              var DataCount = aData[4];
              if (oObj != "0") {
                var id = "paymentList_statusnotupdated_" + District + "_" + Region;
                ContributionSummaryAjaxHandler.push(id);
                return '<span class="badge badge-primary cursor_pointernotimportent"  id="' + id + '">' + DataCount + '</span>';
              }
              else {
                return '<span class="badge badge-primary">' + DataCount + '</span>';
              }
            }
          },
          {
            "sName": "NotUpdated",
            "bSearchable": false,
            "bSortable": false,
            "render": function (oObj, el, aData) {
              var total = aData[5];
              return '<span class="tableTdTextCenter">' + total + '</span>';
            }
          },
          { "sName": "status" },
          { "sName": "TotalEmployerContribution" },
        ]
      });
      //.rowGrouping({
      //  bExpandableGrouping: true,
      //  iGroupingColumnIndex: 0,
      //  bHideGroupingColumn: true
      //});
    }
    function GetPaymentList(element, Status, District, Region) {
      debugger
      $(element).find("i.fa-spinner").show();
      $('#PaymentExampleTbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "iDisplayLength": 10,
        "bDestroy": true,
        //"bProcessing": true,
        "sAjaxSource": "/Dashboard/PaymentDetailsAjaxHandler?Status=" + Status + "&District=" + District,
        "aoColumns": [
          { "sname": "ApplicationReferenceNo" },
          { "sname": "FirstName" },
          { "sname": "Gender" },
          { "sname": "AgeInYears" },
          { "sname": "Address1" },
          { "sname": "Phone" },
