    function OnchangeBindBeneficiaryDetails() {
      //$("#mydivth").hide();
      //$("#mydivtd").hide();
      if (document.getElementById("loader") != null) {
        document.getElementById("loader").style.display = "block";
      }
      var Beneficiary = $("#BeneficiaryDetails").val();
      $.ajax({
        type: "POST",
        data: { BeneficiaryData: Beneficiary },
        url: "/Dashboard/BeneficiaryDetails_summAjaxHandler",
        dataType: "json",
        success: function (data) {
          debugger;
          document.getElementById("loader").style.display = "none";
          console.log(data);
          var tableContainer = $('#tblJAMMUCounts');
          tableContainer.empty();

          var tableHtml = '<table class="tbl"><thead class="thr">';

          // Print headers
          tableHtml += '<tr>';
          for (let i = 0; i < data.length; i++) {
            tableHtml += '<th colspan="3">' + data[i].District + '</th>';
          }
          tableHtml += '</tr>';
          tableHtml += '</thead>';

          tableHtml += '<tbody class="tbr">';
          tableHtml += '<tr>';
          let j = 0;

          for (let i = 0; i < data.length; i++) {
            var empStatusList = data[i].EmpStatusList;
            for (let j = 0; j < empStatusList.length; j++) {
              tableHtml += '<td>' + empStatusList[j].gender1 + '</td>';
            }
            if (empStatusList.length == 1) {
              if (empStatusList[j].gender1 != "F") {
                tableHtml += '<td>F</td>';
              }
              if (empStatusList[j].gender1 != "M") {
                tableHtml += '<td>M</td>';
              }
              if (empStatusList[j].gender1 != "T") {
                tableHtml += '<td>T</td>';
              }
            }
            if (empStatusList.length == 2 && empStatusList[j].gender1 != "T") {
              tableHtml += '<td>T</td>';
            }
          }
          tableHtml += '</tr>';

          tableHtml += '<tr>';
          for (let i = 0; i < data.length; i++) {
            var empStatusList = data[i].EmpStatusList;
            for (let j = 0; j < empStatusList.length; j++) {

              tableHtml += '<td>' + empStatusList[j].count1 + '</td>';
            }
            if (empStatusList.length == 1) {
              if (empStatusList[j].gender1 != "F") {
                tableHtml += '<td>0</td>';
              }
              if (empStatusList[j].gender1 != "M") {
                tableHtml += '<td>0</td>';
              }
              if (empStatusList[j].gender1 != "T") {
                tableHtml += '<td>0</td>';
              }
            }

            if (empStatusList.length == 2) {
              tableHtml += '<td>0</td>';
            }
          }

          tableHtml += '</tr>';

          // Close table structure
          tableHtml += '</tbody></table>';

          // Append table to container element
          tableContainer.append(tableHtml);

          if (data.length == 0) {
            // If no data is found, display an error message
            var errorMessage = $('<p class="error-message">No data available in table</p>').css({
              'text-align': 'center'
            });
            tableContainer.append(errorMessage);
            return;
          }
        }
      });
    }



