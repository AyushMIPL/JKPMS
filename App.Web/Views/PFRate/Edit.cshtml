@model App.Data.Entities.MasterPFRate

@{
  ViewBag.Title = "Edit";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Update Details

      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "PFRate", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "form1" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      @Html.HiddenFor(model => model.Id)
      <div class="row">
        <div class="col-sm-4">

         
            @Html.LabelFor(model => model.PfType, new { @class = "control-label mb-2" })
         
              @Html.DropDownList("PfType", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm" })
            </div>
          

           
        <div class="col-sm-4">
          @Html.LabelFor(model => model.Name, new { @class = "control-label mb-2" })
          @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "PF for" })
        </div>
      
            
        <div class="col-sm-4">
          @Html.LabelFor(model => model.PFRate, new { @class = "control-label mb-2" })
          @Html.TextBoxFor(m => m.PFRate, new { @class = "form-control input-sm allownumericwithdecimal", placeholder = "PF Rate (%)" })
        </div>
        
        
            
        <div class="col-sm-4">
          @Html.LabelFor(model => model.EffectiveDate, new { @class = "control-label mb-2" })
          <div class="input-group date">
            @Html.EditorFor(model => model.EffectiveDate, new { @placeholder = "Effective Start Date" })
            <span class="input-group-addon">
              <i class="fa fa-calendar"></i>
            </span>
          </div>
        </div>
       
       
           
        <div class="col-sm-4">
          @Html.LabelFor(model => model.EffectiveEndDate, new { @class = "control-label mb-2" })
          <div class="input-group date">
            @Html.EditorFor(model => model.EffectiveEndDate, new { @placeholder = "Effective End Date" })
            <span class="input-group-addon">
              <i class="fa fa-calendar"></i>
            </span>
          </div>
        </div>
        
          @*<div class="form-group">
              <label for="IsActive" class="control-label mb-2">Status:</label>
              <div class="col-sm-8">
                <div class="checkbox">
                  @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm" })
                </div>
              </div>
            </div>*@
          @*<hr>*@
         
           
      <div class="col-sm-4">
        <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
        <button type="submit" id="btn_Update" onclick="DisableThis()" class="btn btn-success height px-5"><i class="fa fa-save"> </i> Update</button>
        <a href="/PFRate/Index" id="btn_cancel" class="btn btn-primary border-radius height line-height"><i class="fa fa-reply"> </i> Back to List</a>
      </div>
          </div>
     
        <div class="col-sm-2">

          <span class="field-validation-error text-danger" id="fileValidate"></span>

        </div>
  
    }
  </div>
</div>
<div class="panel panel-default" id="Employer_Div">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Manage Employers PF History
      @*<ul class="tool-bar">
          <li><a href="/Employers/Create" data-toggle="tooltip" data-placement="bottom" title="Add details" data-original-title="Add Details"><i class="fa fa-plus"></i></a></li>
        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <div class="row" style="margin-bottom:10px;">

      <div class="form-group">
        <div class="col-md-12">
          @Html.LabelFor(model => model.PfRateId, "PF Rate *", new { @class = "col-sm-1 control-label" })
          <div class="col-sm-6">
            @Html.DropDownList("PfRateId", null, "---Select ---", htmlAttributes: new { @class = "form-control" })
          </div>
          <div class="col-sm-1">
            <input type="text" id="PFRateEmp" class="form-control input-sm" readonly="" />
          </div>
          <div class="col-sm-2">
            <a class="btn btn-success" onclick="UpateEmployerPfDetails()">Apply</a>
          </div>
        </div>

      </div>
    </div>
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>
          <th>ID</th>
          <th>Employer Name</th>
          <th>Employer Address</th>
          @*<th>City</th>*@
          <th>PO.Box No.</th>
          <th>Contact Person</th>
          <th>Mobile</th>
          <th>PF Rate</th>
          <th>PF Rate Effective Date</th>
          <th>
            <input type="checkbox" id="AllCheck" class="AllCheck" style="margin-top:-16px;margin-left:-3px;">
          </th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
<div class="panel panel-default" id="Contributor_Div">
  <div class="panel-heading clearfix">
    <h4>Manage Contributor PF History</h4>
