          <div class="col-sm-2">
            @Html.DropDownList("EmployerName", null, "---All---", htmlAttributes: new { @class = "form-control" })
          </div>
          <div class="col-sm-2">
            @Html.DropDownList("JobStatusID", null, "---All---", htmlAttributes: new { @class = "form-control" })
          </div>
          @*@Html.LabelFor(model => model.PfRateIdContributor, "PF Rate *", new { @class = "col-sm-1 control-label" })*@
          <div class="col-sm-6">
            @Html.DropDownList("PfRateIdContributor", null, "---Select---", htmlAttributes: new { @class = "form-control" })
          </div>
          <div class="col-sm-1">
            <input type="text" id="PFRateContributor" class="form-control input-sm" readonly="" />
          </div>
