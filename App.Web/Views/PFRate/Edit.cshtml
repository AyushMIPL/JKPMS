@section Scripts {
  <link href="~/Content/endless/css/newdatatablemodified.css" rel="stylesheet" />
  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      debugger
      $("#Employer_Div").hide();
      $("#Contributor_Div").hide();
      if ('@Model.PfType' == 'E') {
        $("#Employer_Div").show();
        doBindData();
      }
      else {
        $("#Contributor_Div").show();
        doBindDataContributor();
      }

    });
    function DisableThis() {
      $("#btn_Update").html('<i class="fa fa-spinner fa-spin"></i> Update');
      $("#btn_Update").prop('disabled', true);
      $("#btn_cancel").removeAttr('href');
      $('#form1').submit();
    }
    $("#PfRateId").change(function () {
      debugger
      UniqueIds = [];
      $('.AllCheck').prop("checked", false);
      var pfRateID = $("#PfRateId").val();
      if (pfRateID != "") {
        var id = parseInt(pfRateID);
        $.ajax({
          url: '/Employers/PFAjax?Id=' + id,
          type: 'Get',
          dataType: 'json'
        }).done(function (result) {
          $("#PFRateEmp").val(result + ".00");
        });
      }
      else {
        toasterErrorMessage("Please Select PF Rate.");
        $("#PFRate").val("");
      }
      doBindData(pfRateID);
    });
    function doBindData(id) {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        //"bProcessing": true,
        "sAjaxSource": "/PFRate/BindEmployerAjaxHandler?PfRateId=" + id,
        "aoColumns": [
          { "sName": "ID" },
            { "sName": "EmployerName" },
            { "sName": "EmployerAddress" },
            //{ "sName": "City" },
            { "sName": "POBoxNo" },
            { "sName": "ContactPerson" },
            { "sName": "Mobile" },
            //{ "sName": "PFRate" },
            {
              "sName": "Pf Rate",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = "";
                strString += oObj.aData[6];
                if (oObj.aData[12] == "True")
                  strString += '<span class="fa fa-times text-danger fa-lg" title="PF Rate has been expired" style="margin-left:10px;"></span>';
                else
                  strString += '<span class="fa fa-check-circle text-success fa-lg" title="Active" style="margin-left:10px;"></span>';
                return strString;
              }
            },
            {
              "sName": "Effective Date",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = "";
                strString += oObj.aData[10] + " - " + oObj.aData[11];
                //if(oObj.aData[12]=="True")
                //  strString+='<span class="fa fa-times text-danger fa-lg" title="Expired"></span>';
                //else
                //  strString+='<span class="fa fa-check-circle text-success fa-lg" title="Active"></span>';
                return strString;
              }
            },
        {
          "sName": "CheckBox",
          "bSearchable": false,
          "bSortable": false,
          "fnRender": function (oObj) {
            if (oObj.aData[9] == "True")
              var strString = '<input type="checkbox" class="SingleCheck" checked value="' + oObj.aData[0] + '" disabled>';
            else
              var strString = '<input type="checkbox" class="SingleCheck" value="' + oObj.aData[0] + '">';
            return strString;
          }
        }
        ]
      });
    }
    var UniqueIds = [];
    $(document).on("click", '.SingleCheck', function () {
      debugger
      if (this.checked) {
        UniqueIds.push(this.value);
        //$('#confirmUpdate').popup("show");
      }
      else {
        UniqueIds.splice($.inArray(this.value, UniqueIds), 1);
      }
    })
    function UpateEmployerPfDetails() {
      var PfRateId = $("#PfRateId").val();
      var PfRateText = $('#PfRateId option:selected').text();
      if (PfRateId == "" || PfRateId == null || PfRateId == undefined) {
        toasterErrorMessage("Please Select Pf Rate.");
      }
      else if (UniqueIds.length == 0) {
        toasterErrorMessage("Please Select Atleast One Employer.");
      }
      else {
        $("#EmployerConfirmMessage").text("Do You Really Want To Update " + PfRateText + " For The Selected Employers");
        $('#confirmUpdate').popup("show");
      }
    }
    function onUpdateConfirm() {
      var PfRateId = $("#PfRateId").val();
      $.ajax({
        url: "@Url.Action("ManageEmployerPfHistoryAjax", "PFRate")?UniqueIdsString=" + UniqueIds + "&PfRateId=" + PfRateId,
        type: "GET",
      })
      .done(function (result) {
        debugger
        if (result == 1) {
          toasterSuccessMessage("Employer Pf Rate History Updated Successfully.");
          UniqueIds = [];
          $('.AllCheck').prop("checked", false);
          $('#tbl').dataTable().fnDraw();
        }
        else if (result == 0) {
          toasterErrorMessage("Please Select Atleast One Employer.");
        }
        else {
          toasterErrorMessage("Something Wrong.");
        }
        $('#confirmUpdate').popup("hide");
      });
    }
    function CancelClick() {
      //UniqueIds = [];
      $('#confirmUpdate').popup("hide");
    }

    $('.AllCheck').click(function () {
      debugger
      if ($(this).is(':checked')) {
        //$('#confirmUpdateAll').popup("show");
        $('.SingleCheck').prop("checked", true);
        $('.SingleCheck').each(function (index, obj) {
          if (this.checked === true && this.disabled == false) {
            UniqueIds.push(this.value);
          }
        });
      }
      else {
        $('.SingleCheck').each(function (index, obj) {
          if (this.checked === true && this.disabled == false) {
            $(this).prop("checked", false);
          }
        });
        //$('.SingleCheck').prop("checked", false);
        UniqueIds = [];
      }
    });
    @*function onUpdateConfirmAll() {

      $.ajax({
        url: "@Url.Action("ManageAllEmployerPfHistoryAjax", "PFRate")?PfRateId=" + @Model.Id,
        type: "GET",
      })
    .done(function (result) {
      debugger
      if (result == 1) {
        toasterSuccessMessage("Employer Pf Rate History Updated Successfully.");
        $('#tbl').dataTable().fnDraw();
      }
      else {
        toasterErrorMessage("Something Wrong.");
      }
      $('#confirmUpdateAll').popup("hide");
    });
    }
    function CancelClickAll(){
      debugger
      $('#confirmUpdateAll').popup("hide");
      $(".AllCheck").attr('checked', false);
    }*@


    $("#PfRateIdContributor").change(function () {
      debugger
      UniqueIds = [];
      $('.AllCheckContributor').prop("checked", false);
      var pfRateID = $("#PfRateIdContributor").val();
      if (pfRateID != "") {
        var id = parseInt(pfRateID);
        $.ajax({
          url: '/Employers/PFAjax?Id=' + id,
          type: 'Get',
          dataType: 'json'
        }).done(function (result) {
          $("#PFRateContributor").val(result + ".00");
        });
      }
      else {
        toasterErrorMessage("Please Select PF Rate.");
        $("#PFRateContributor").val("");
      }
      doBindDataContributor(pfRateID);
    });

    function doBindDataContributor(id) {
      var Id = $("#EmployerName").val();
      var JobStatusId = $("#JobStatusID").val();
      var oTable = $('#tblContributor').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        //"bProcessing": true,
        "sAjaxSource": "/PFRate/BindContributorAjaxHandler/?Id=" + Id + "&JobStatusId=" + JobStatusId + "&PfRateId=" + id,
        "aoColumns": [
          {
            "sName": "Photo",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {
              if (oObj.aData[0] != null)
                return '<div class="pstyle"><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" /></div>';
              else
                return '<div class="pstyle"><img src="../Images/noimage.jpg" /></div>';

            }
          },
          { "sName": "PersonID" },
            { "sName": "OldPersonID" },
            { "sName": "Name" },
            { "sName": "EmployerName" },
            { "sName": "SocialSecurityNo" },
            {
              "sName": "Gender",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                if (oObj.aData[6] != "M")
                  return '<span > Female </span>';
                else
                  return '<span >Male</span>';
              }
            },
            { "sName": "DateOfBirth" },
            { "sName": "PostalAddress" },
        { "sName": "Phone" },
        //{ "sName": "PhoneOffice" },
        //{
        //  "sName": "ActiveStatus",
        //  "bSearchable": false,
        //  "bSortable": false,
        //  "fnRender": function (oObj) {
        //    if (oObj.aData[11] == "False")
        //      return '<span class="badge badge-danger">Not Applied</span>';
        //    else
        //      return '<span class="badge badge-success">Applied</span>';
        //  }
        //},
        {
          "sName": "Pf Rate",
          "bSearchable": false,
          "bSortable": false,
          "fnRender": function (oObj) {
            var strString = "";
            strString += oObj.aData[14];
            if (oObj.aData[17] == "True")
              strString += '<span class="fa fa-times text-danger fa-lg" title="PF Rate has been expired" style="margin-left:10px;"></span>';
            else
              strString += '<span class="fa fa-check-circle text-success fa-lg" title="Active" style="margin-left:10px;"></span>';
            return strString;
          }
        },
            {
              "sName": "Effective Date",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                var strString = "";
                strString += oObj.aData[15] + " - " + oObj.aData[16];
                //if(oObj.aData[12]=="True")
                //  strString+='<span class="fa fa-times text-danger fa-lg" title="Expired"></span>';
                //else
                //  strString+='<span class="fa fa-check-circle text-success fa-lg" title="Active"></span>';
                return strString;
              }
            },
            {
              "sName": "CheckBox",
              "bSearchable": false,
              "bSortable": false,
              "fnRender": function (oObj) {
                if (oObj.aData[13] == "True")
                  var strString = '<input type="checkbox" id="CheckId' + oObj.aData[1] + '" class="SingleCheckContributor" checked value="' + oObj.aData[1] + '" disabled>';
                else
                  var strString = '<input type="checkbox" id="CheckId' + oObj.aData[1] + '" class="SingleCheckContributor" value="' + oObj.aData[1] + '">';
                return strString;
              }
            }
        ],
        "fnDrawCallback": function (oSettings) {
          if ($('input.AllCheckContributor').is(':checked')) {
                $(".SingleCheckContributor").prop("checked", true);
              }
        }
      }).rowGrouping({
        bExpandableGrouping: false,
        iGroupingColumnIndex: 4,
        bHideGroupingColumn: true

      })
    }
    $("#EmployerName").on('change', function () {
      UniqueIds = [];
      $('.AllCheckContributor').prop("checked", false);
      var PfRateId = $("#PfRateIdContributor").val();
      var Id = $("#EmployerName").val();
      if (Id != "") {
        doBindDataContributor(PfRateId);
      }
    })
    $("#JobStatusID").on('change', function () {
      UniqueIds = [];
      $('.AllCheckContributor').prop("checked", false);
      var PfRateId = $("#PfRateIdContributor").val();
      var JobStatusId = $("#JobStatusID").val();
      if (JobStatusId != "") {
        doBindDataContributor(PfRateId);
      }
    })
    $(document).on("click", '.SingleCheckContributor', function () {
      debugger
      if (this.checked) {
        UniqueIds.push(this.value);
        //$('#confirmUpdateContributor').popup("show");
      }
      else {
        UniqueIds.splice($.inArray(this.value, UniqueIds), 1);
      }

      //debugger
      //if (this.checked) {
      //  UniqueIds.push(this.value);
      //  $('#confirmUpdateContributor').popup("show");
      //}
    })
    function UpateContributorPfDetails() {
      var PfRateId = $("#PfRateIdContributor").val();
      var PfRateText = $('#PfRateIdContributor option:selected').text();
      if ($('input.AllCheckContributor').is(':checked')) {
        if (PfRateId == "" || PfRateId == null || PfRateId == undefined) {
          toasterErrorMessage("Please Select Pf Rate.");
        }
        else {
          $("#ContributorConfirmMessage").text("Do You Really Want To Update " + PfRateText + " For The Selected Contributors?");
          $('#confirmUpdateContributor').popup("show");
        }
      }
      else {
        if (PfRateId == "" || PfRateId == null || PfRateId == undefined) {
          toasterErrorMessage("Please Select Pf Rate.");
        }
        else if (UniqueIds.length == 0) {
          toasterErrorMessage("Please Select Atleast One Contributor.");
        }
        else {
          $("#ContributorConfirmMessage").text("Do You Really Want To Update " + PfRateText + " For The Selected Contributors?");
          $('#confirmUpdateContributor').popup("show");
        }
      }
    }
    function onUpdateConfirmContributor() {
      var PfRateId = $("#PfRateIdContributor").val();
      var Id = $("#EmployerName").val();
      var JobStatusId = $("#JobStatusID").val();
      var url = "";
      if ($('input.AllCheckContributor').is(':checked')) {
        url = "@Url.Action("ManageAllContributorPfHistoryAjax", "PFRate")?PfRateId=" + PfRateId + "&Id=" + Id + "&JobStatusID=" + JobStatusId;
      }
      else {
        url = "@Url.Action("ManageContributorPfHistoryAjax", "PFRate")?PersonIdsString=" + UniqueIds + "&PfRateId=" + PfRateId;
      }

      $.ajax({
        url: url,
        type: "GET",
      })
    .done(function (result) {
      debugger
      if (result == 1) {
        toasterSuccessMessage("Contributor Pf Rate History Updated Successfully.");
        UniqueIds = [];
        $('.AllCheckContributor').prop("checked", false);
        $('#tblContributor').dataTable().fnDraw();
      }
      else if (result == 0) {
        toasterErrorMessage("Please Select Atleast One Contributor.");
      }
      else {
        toasterErrorMessage("Something Wrong.");
      }
      $('#confirmUpdateContributor').popup("hide");
    });
    }
    function CancelClickContributor() {
      //UniqueIds = [];
      $('#confirmUpdateContributor').popup("hide");
    }

    $('.AllCheckContributor').click(function () {
      debugger
      if ($(this).is(':checked')) {
        //$('#confirmUpdateAll').popup("show");
        $('.SingleCheckContributor').prop("checked", true);
        $('.SingleCheckContributor').each(function (index, obj) {
          if (this.checked === true && this.disabled == false) {
            UniqueIds.push(this.value);
          }
        });
      }
