@model IEnumerable<App.Data.Entities.MasterBanks>
@{
  ViewBag.Title = "Index";
}

<style>
  a.disabled {
    color: gray;
    pointer-events: none;
    opacity: .8;
  }

  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-masterbankindex">
      Master Bank

      <ul class="tool-bar">
        <li>
          <a href="/MasterBank/Create" class="@(ViewBag.AddPermission == true ? "" : "disabled")"
             data-placement="bottom"
             title="Add details"
             data-original-title="Add Details">
            <i class="fa fa-plus"></i>
          </a>
        </li>

      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tbl">
      <thead>
        <tr>
          <th>Bank Code</th>
          <th>Bank Name</th>
          <th>Sftp Media</th>
          @*<th>Media Format</th>
            <th>Status</th>*@
          <th></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {

  <script nonce="@ViewBag.StyleNonce">
    $(function () {
      doBindData();
    });

      var MasterBankTableId = [];
    function doBindData() {
      var oTable = $('#tbl').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
        "sAjaxSource": "/MasterBank/AjaxHandler",

        "fnDrawCallback": function (setting) {
          debugger;

          MasterBankTableId.forEach(function (item, index) {
            debugger
            if (document.getElementById("EditMasterBankBtn_" + item) != null && document.getElementById("EditMasterBankBtn_" + item) != undefined) {
              document.getElementById("EditMasterBankBtn_" + item).addEventListener("click", function () {
                EditMasterBank(item);
              });
            }
            if (document.getElementById("DetailsMasterBankBtn_" +item) != null && document.getElementById("DetailsMasterBankBtn_" + item) != undefined) {
              document.getElementById("DetailsMasterBankBtn_" + item).addEventListener("click", function () {
                DetailsMasterBank(item);
              });
            }

          });

        },


        "aoColumns": [
            { "sName": "bank_code" },
						{ "sName": "bank_desc" },
            { "sName": "mag_media" },
            //{ "sName": "MediaFormat" },
						//{
						//  //"sName": "ActiveStatus",
						//  "bSearchable": false,
						//  "bSortable": false,
						//  "fnRender": function (oObj) {
						//    //if (oObj.aData[4] == "False")
						//    //  return '<span class="badge badge-danger">inactive</span>';
						//    //else
						//    //  return '<span class="badge badge-success">active</span>';
						//  }
						//},
						{
						  "sName": "Bank_Code_ID",
						  "bSearchable": false,
						  "bSortable": false,
              "fnRender": function (oObj) {
                @*var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
                  var strString = '<button onclick="EditMasterBank(\'' + oObj.aData[3] + '\');" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

                  strString += '&nbsp;<button onclick="DetailsMasterBank(\'' + oObj.aData[3] + '\');" class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';*@






                 var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
                var strString = '<button id="EditMasterBankBtn_' + oObj.aData[3] + '"  class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

                strString += '&nbsp;<button id="DetailsMasterBankBtn_' + oObj.aData[3] + '"  class="btn btn-xs btn-primary " title="Detail"><i class="fa fa-list"></i> Details</button>';

                MasterBankTableId.push(oObj.aData[3]);
                return strString;
						  }
						}
        ]
      });
    }

     /// **** Code By Himanshu Rajput *****

        function EditMasterBank(id) {
     window.location.href = "@Url.Action("Edit", "MasterBank")?Id=" + id ;
}

        function DetailsMasterBank(id) {
     window.location.href = "@Url.Action("Details", "MasterBank")?Id=" + id ;
}


    function del(ctrlId) {
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
    }
    const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
    debugger
    Confirm_Delete_ClassBtn.forEach(button => {
      button.addEventListener('click', onDeleteConfirm);
    });
    function onDeleteConfirm() {
      var id = $("#hdDocumentId").val();
      $.ajax({
        url: "@Url.Action("Remove", "MasterBank")?Id=" + id + "",
        type: "GET",
      })
		.done(function (result) {
		  var actionRes = result;
		  if (actionRes == "0") {
		    toasterErrorMessage("There is some error, please try again.");
		    return actionRes;
		  }
		  else {
        toasterSuccessMessage("Record deleted successfully.");
		    $('#confirmDelete').popup("hide");
		    doBindData();
		  }
		});
    }
  </script>
}
