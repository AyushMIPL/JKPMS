@model App.Data.Entities.MasterBanks
@{
  ViewBag.Title = "Edit";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-masterbankedit">
      Update Details

      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Edit", "MasterBank", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form",id= "EditMasterBank_Id" }))
    {
      @Html.AntiForgeryToken()
      @*@Html.ValidationSummary("", new { @class = "text-danger" })*@
      @Html.HiddenFor(model => model.Bank_Code_ID)
      <div class="row">
        <div class="col-sm-4">
          <label control-label">
            @Html.DisplayNameFor(model => model.bank_code)
            <span class="text-danger">*</span>
          </label>
          @*@Html.LabelFor(model => model.bank_code, "Bank Code", htmlAttributes: new { @class = "control-label mb-2" })*@
          @Html.EditorFor(model => model.bank_code, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.bank_code, "", new { @class = "text-danger" })
        </div>




        <div class="col-md-4">
          <label control-label">
            @Html.DisplayNameFor(model => model.bank_desc)
            <span class="text-danger">*</span>
          </label>
          @*@Html.LabelFor(model => model.bank_desc, "Bank Name", htmlAttributes: new { @class = "control-label mb-2" })*@
          @Html.EditorFor(model => model.bank_desc, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.bank_desc, "", new { @class = "text-danger" })
        </div>




        <div class="col-md-4">
          <label control-label">
            @Html.DisplayNameFor(model => model.mag_media)
            <span class="text-danger">*</span>
          </label>
          @*@Html.LabelFor(model => model.mag_media, htmlAttributes: new { @class = "control-label mb-2" })*@
          @Html.EditorFor(model => model.mag_media, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.mag_media, "", new { @class = "text-danger" })
        </div>



        <div class="col-md-4">
          <label control-label">
            @Html.DisplayNameFor(model => model.co_bank_acct_no)
            <span class="text-danger">*</span>
          </label>
          @*@Html.LabelFor(model => model.co_bank_acct_no, "Bank Account Number", htmlAttributes: new { @class = "control-label mb-2" })*@
          @Html.EditorFor(model => model.co_bank_acct_no, new { htmlAttributes = new { @class = "form-control" } })
          @Html.ValidationMessageFor(model => model.co_bank_acct_no, "", new { @class = "text-danger" })
        </div>


        @*<div class="form-group">
            @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
              <div class="checkbox">
                @Html.EditorFor(model => model.IsActive)
                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
              </div>
            </div>
          </div>*@
        @*<hr>*@


        <div class="col-sm-4">
          <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
          <button type="submit" class="btn btn-success px-5 height" id="EditmasetrBank_submit"><i class="fa fa-save"> </i> Update</button>
          <a href="/MasterBank/Index" class="btn btn-primary height border-radius line-height"><i class="fa fa-reply"> </i> Back to List</a>

        </div>

      </div>
      <div class="col-sm-3">

        <span class="field-validation-error text-danger" id="fileValidate"></span>

      </div>

    }
  </div>
</div>

@section scripts{

  <script src="~/Scripts/Master.js"></script>
  @Scripts.Render("~/bundles/jqueryval")
  <script nonce="@ViewBag.StyleNonce">

    document.getElementById("EditmasetrBank_submit").addEventListener("click", EditMasterSubmit);
    async function EditMasterSubmit() {
      var form = $("#EditmasetrBank_submit");
      if (!form.valid()) {
        return false;
      }
    }
  </script>
}