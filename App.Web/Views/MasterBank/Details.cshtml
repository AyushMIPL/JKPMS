@model App.Data.Entities.MasterBanks

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline headline-masterbankdetails" >
      Bank Details
      @*<ul class="tool-bar">
        
      </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <div class="row">
      <div class="col-sm-4">
        <dl class="dl-horizontal">
          <dt>
            @Html.DisplayNameFor(model => model.bank_code)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.bank_code)
          </dd>

          <dt>
            @Html.DisplayNameFor(model => model.bank_desc)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.bank_desc)
          </dd>

          <dt>
            @Html.DisplayNameFor(model => model.co_bank_acct_no)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.co_bank_acct_no)
          </dd>

          <dt>
            @Html.DisplayNameFor(model => model.mag_media)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.mag_media)
          </dd>

          @*<dt>
            @Html.DisplayNameFor(model => model.IsActive)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.IsActive)
          </dd>*@

        </dl>
      </div>

    </div>
  </div>
  <div class="panel-footer">
    <a href="/MasterBank/Edit/@ViewBag.EncryptedId" class="btn btn-info  @(ViewBag.EditPermission == true ? "" : "disabled")"><i class="fa fa-pencil"> </i> Edit</a>
    <a href="/MasterBank/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
    
  </div>
</div>