@model App.Data.Entities.MasterGrade

@{
    ViewBag.Title = "Create";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      Add Details
      @*<ul class="tool-bar">
        
      </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("Create", "Grade", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="row">
        <div class="col-sm-5">
          <div class="form-group">
            @Html.LabelFor(model => model.Name, new { @class = "col-sm-4 control-label" })
            <div class="col-sm-8">
              @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-sm", placeholder = "Grade" })

            </div>
          </div>
          @*<div class="form-group">
            <label for="IsActive" class="col-sm-4 control-label">Status:</label>
            <div class="col-sm-8">
              <div class="checkbox">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-control input-sm"})
              </div>
            </div>
          </div>*@

          <div class="form-group">
            <label class="col-sm-4 control-label"></label>
            <div class="col-sm-8">
              <button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Create</button>
              <a href="/Grade/Index" class="btn btn-primary"><i class="fa fa-reply"> </i> Back to List</a>
            </div>
          </div>
        </div>
      </div>

    }
  </div>
</div>
@section scripts{
  
<script src="~/Scripts/Master.js"></script>
}