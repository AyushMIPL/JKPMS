@{
    ViewBag.Title = "Index";
}

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Report Text

            <ul class="tool-bar">
                <li><a href="/ReportText/Create" data-toggle="tooltip" data-placement="bottom" title="Add details" data-original-title="Add Details"><i class="fa fa-plus"></i></a></li>

            </ul>
        </h4>
    </div>
    <div class="panel-body">
        <table class="table dataTable" id="tbl">
            <thead>
                <tr>

                    <th>Module</th>
                    <th>Field</th>
                    <th>Signature</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>
@section Scripts {
    <link href="~/Content/endless/css/newdatatablemodified.css" rel="stylesheet" />
    <script nonce="@ViewBag.StyleNonce">
        $(function () {
            doBindData();
        });
        function doBindData() {
            var oTable = $('#tbl').dataTable({
                "bJQueryUI": true,
                "sPaginationType": "full_numbers",
                "bServerSide": true,
                "bDestroy": true,
                "sAjaxSource": "/ReportText/AjaxHandler",
                "aoColumns": [

                                { "sName": "Module" },
                                { "sName": "Field" },
                                { "sName": "Signature" },
                                {
                                    "sName": "ID",
                                    "bSearchable": false,
                                    "bSortable": false,
                                    "fnRender": function (oObj) {
                                        var strString = '<a href="/ReportText/Edit/' + oObj.aData[3] + '\" class="btn btn-info btn-xs" title="Edit"><i class="fa fa-pencil"></i> Edit</a>';
                                        return strString;
                                    }
                                }
                ]
            }).rowGrouping({
                bExpandableGrouping: false,
                iGroupingColumnIndex: 0,
                bHideGroupingColumn: true

            });
        }

    </script>
}
