@model App.Data.Entities.ReportText

@{
    ViewBag.Title = "Create";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline" style="margin:0px;padding:0px;border:none;">
            Add Details
            @*<ul class="tool-bar">

                </ul>*@
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Create", "ReportText", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            <div class="row">
                 
                      
                <div class="col-sm-3">
                    @Html.LabelFor(model => model.ModuleId, new { @class = "control-label mb-2" })
                    @Html.DropDownList("ModuleId", null, "---Select---", new { @class = "form-control" })
                </div>
                  
                     
                        <div class="col-sm-3">
                            @Html.LabelFor(model => model.Field, new { @class = "control-label mb-2" })
                            @Html.TextBoxFor(m => m.Field, new { @class = "form-control input-sm", placeholder = "Field" })
                        </div>
                 
                       
                        <div class="col-sm-3">
                            @Html.LabelFor(model => model.Signature, new { @class = "control-label mb-2" })
                            @Html.TextBoxFor(m => m.Signature, new { @class = "form-control input-sm", placeholder = "Signature" })

                        </div>
                  
             
                        <div class="col-sm-3">
                            <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
                            <button type="submit" class="btn btn-success px-5 height"><i class="fa fa-save"> </i> Create</button>
                            <a href="/ReportText/Index" class="btn btn-primary height border-radius line-height"><i class="fa fa-reply"> </i> Back to List</a>
                        </div>
                 
                </div>
         

        }
    </div>
</div>