@model List<App.Data.ViewModels.RoleModuleViewModel>
@using App.Web.Helper;
@{
  var Groups = Model.FirstOrDefault().Group;
  ViewBag.Title = "RoleModule";
}
<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline rolemanagementuse">
      Role Management
      @*<ul class="tool-bar">
          <li><a href="/Account/AddModule" data-toggle="tooltip" data-placement="bottom" title="Add Module" data-original-title="Add Module"><i class="fa fa-plus"></i></a></li>
        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    @using (Html.BeginForm("RoleModule", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "IdRoleModule" }))
    {
      @Html.AntiForgeryToken()
      @Html.ValidationSummary("", new { @class = "text-danger" })
      <div class="row">
        <div class="col-sm-10">
          <div class="form-group">
            <div class="col-sm-5">
              @Html.DropDownList("RoleID", null, "---Select Role---", htmlAttributes: new
              {
                @class = "form-control"@*, onchange = "javascript:sendParam();"*@})
            </div>
            <button type="button" class="btn btn-success px-5 height roleprocess" title="Please Wait While We Process Your Request" id="btn_RoleModule_loading">
              <i class="fa fa-spinner fa-spin"></i> Processing
            </button>
            <button type="submit" id="IdRoleEdit" class="btn btn-success height px-5"><i class="fa fa-save"> </i> Save </button>
          </div>
        </div>
      </div>
      <div>
        <table class="table">
          <thead>
            <tr><th>Module</th><th>View</th><th>Add</th><th>Edit</th><th>Delete</th><th></th></tr>
          </thead>
          <tbody>
            @if (Model != null)
            {
              foreach (var result in Model.Where(x => x.ParentId == 0))
              {
                int c = result.ModuleID;
                int i = Model.FindIndex(x => x.ModuleID == c);
                @Html.HiddenFor(m => Model[i].ModuleID)
                @Html.HiddenFor(m => Model[i].RoleID)
                @Html.HiddenFor(m => Model[i].ParentId)
                @Html.HiddenFor(m => Model[i].ModuleName)
                <tr class="rolepre">
                  <td>@Model[i].ModuleName</td>
                  <td>@Html.CheckBoxFor(m => Model[i].ViewPermission, new { @onclick = "checkView('" + Model[i].ModuleID + "','View' )" })</td>
                  <td>@Html.CheckBoxFor(m => Model[i].AddPermssion, new { @onclick = "checkView('" + Model[i].ModuleID + "','Add')" })</td>
                  <td>@Html.CheckBoxFor(m => Model[i].EditPermission, new { @onclick = "checkView('" + Model[i].ModuleID + "','Edit')" })</td>
                  <td>@Html.CheckBoxFor(m => Model[i].DeletePermission, new { @onclick = "checkView('" + Model[i].ModuleID + "','Delete')" })</td>
                </tr>
                var item = Model.Where(x => x.ParentId == Model[i].ModuleID).ToList();
                if (item.Any())
                {
                  for (int j = 0; j < item.Count; j++)
                  {
                    int p = item[j].ModuleID;
                    int q = Model.FindIndex(x => x.ModuleID == p);
                    @Html.HiddenFor(m => Model[q].ModuleID)
                    @Html.HiddenFor(m => Model[q].RoleID)
                    @Html.HiddenFor(m => Model[q].ParentId)
                    @Html.HiddenFor(m => Model[q].ModuleName)
                    <tr>
                      <td>@Model[q].ModuleName</td>
                      <td>@Html.CheckBoxFor(m => Model[q].ViewPermission, new { @id = Model[q].ParentId + "V" })</td>
                      <td>@Html.CheckBoxFor(m => Model[q].AddPermssion, new { @id = Model[q].ParentId + "A" })</td>
                      <td>@Html.CheckBoxFor(m => Model[q].EditPermission, new { @id = Model[q].ParentId + "E" })</td>
                      <td>@Html.CheckBoxFor(m => Model[q].DeletePermission, new { @id = Model[q].ParentId + "D" })</td>
                    </tr>
                  }
                }
              }
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
@section scripts{
  @Scripts.Render("~/bundles/jqueryval")
  <script nonce="@ViewBag.StyleNonce">

      $("#RoleID").on("change", function () {
        sendParam();
      });


      function sendParam() {
        debugger;
      var roleid = $("#RoleID").val();
      if (roleid == "" || roleid == "1") {
          toasterErrorMessage("Please Select a Role.");
        return false;
      } else {
        window.location = "/Account/RoleModule/" + roleid;
      }
      /*window.location = "/Account/RoleModule/" + $("#RoleID").val();*/
    }
    function checkView(id, status) {
      debugger
      if (status == "View") {
        if ($('input[type="checkbox"][name="[' + (id - 1) + '].ViewPermission"]').prop('checked')) {
          $('input:checkbox[id="' + id + 'V"]').each(function () {
            $(this).prop("checked", true);
          })
        }
        else {
          $('input:checkbox[id="' + id + 'V"]').each(function () {
            $(this).prop("checked", false);
          })
        }
      }
      if (status == "Add") {
        if ($('input[type="checkbox"][name="[' + (id - 1) + '].AddPermssion"]').prop('checked')) {
          $('input:checkbox[id="' + id + 'A"]').each(function () {
            $(this).prop("checked", true);
          })
        }
        else {
          $('input:checkbox[id="' + id + 'A"]').each(function () {
            $(this).prop("checked", false);
          })
        }
      }
      if (status == "Edit") {
        if ($('input[type="checkbox"][name="[' + (id - 1) + '].EditPermission"]').prop('checked')) {
          $('input:checkbox[id="' + id + 'E"]').each(function () {
            $(this).prop("checked", true);
          })
        }
        else {
          $('input:checkbox[id="' + id + 'E"]').each(function () {
            $(this).prop("checked", false);
          })
        }
      }
      if (status == "Delete") {
        if ($('input[type="checkbox"][name="[' + (id - 1) + '].DeletePermission"]').prop('checked')) {
          $('input:checkbox[id="' + id + 'D"]').each(function () {
            $(this).prop("checked", true);
          })
        }
        else {
          $('input:checkbox[id="' + id + 'D"]').each(function () {
            $(this).prop("checked", false);
          })
        }
      }
    }
    function AssignRole() {
      $("#divLoading").show();
      var data = new Array();
      $('input[type=checkbox]:checked').each(function () {
        data.push($(this).attr("name"));
      });
      role = $("#RoleID").val();
      debugger
      $.ajax({
        url: "@Url.Action("AddPermission", "Account")?Data=" + data + "&RoleId=" + role,
        type: "Get"
      }).done(function () {
        $("#divLoading").fadeOut();
        toasterSuccessMessage("Permission Assigned Sucessfully.");
      })
      }

      $(document).ready(function () {
        @*$('form').submit(function () {
        debugger
          $('#IdRoleEdit').hide();
          $('#btn_RoleModule_loading').show();
          var form = $("#IdRoleModule");
          if (!form.valid()) {
              $('#IdRoleEdit').show();
              $('#btn_RoleModule_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdRoleEdit').show();
            $('#btn_RoleModule_loading').hide();
        }
          $('#btn_RoleModule_loading').hide();*@
      });

      document.getElementById("IdRoleEdit").addEventListener("click", GenerateRoleModule);

    function GenerateRoleModule()
    {
      debugger
      var roleid = $("#RoleID").val();
      if (roleid == "" || roleid == "1") {
        var form = $("#IdRoleModule");
          toasterErrorMessage("Please Select a Role.");
          if (!form.valid()) {
            $('#IdRoleEdit').show();
            $('#btn_RoleModule_loading').hide();
           // return false;
          }
        return;
      }
      else {
        $('form').submit(function (e) {
            debugger
            e.preventDefault();
          $('#IdRoleEdit').hide();
          $('#btn_RoleModule_loading').show();
          var form = $("#IdRoleModule");
            if (!form.valid()) {
                $('#IdRoleEdit').show();
                $('#btn_RoleModule_loading').hide();
                return false;
            }
            else {
                debugger
                const array = $("#IdRoleModule").serializeArray();

                const result = array.reduce((acc, obj) => {
                    const [index, key] = obj.name.split('].');
                    const idx = parseInt(index.replace('[', ''));
                    const actualKey = key;

                    if (!acc[idx]) {
                        acc[idx] = {};
                    }
                    if (acc[idx][actualKey] == undefined) {
                        acc[idx][actualKey] = obj.value;
                    }

                    return acc;
                }, []);

                $.ajax({
                    url: '@Url.Action("RoleModule","Account")',
                    contentType: 'application/json; charset=utf-8',
                    type: 'POST',
                    data: JSON.stringify(result),
                    success: function (data) {
                        debugger
                        location.reload();
                    },
                    error: function (e) {
                        location.reload();
                    }
});
            }
        });
            debugger
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
          $('#IdRoleEdit').show();
          $('#btn_RoleModule_loading').hide();
        }
        $('#btn_RoleModule_loading').hide();
        $('#spinner').show();

        $('#Btn').prop('disabled', true);
      }
      return true;
    }
  </script>
}
