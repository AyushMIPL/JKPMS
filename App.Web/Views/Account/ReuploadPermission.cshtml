    function getMonthNameFromDate(dateString) {
      debugger;
      var months = [
        "January", "February", "March",
        "April", "May", "June",
        "July", "August", "September",
        "October", "November", "December"
      ];

      // Split the date string into day, month, and year components
      var dateComponents = dateString.split('/');

      // Rearrange the components to form a standard format "MM/DD/YYYY"
      var rearrangedDateString = dateComponents[1] + '/' + dateComponents[0] + '/' + dateComponents[2];

      // Create a Date object using the rearranged date string
      var date = new Date(rearrangedDateString);

      //var date = new Date(dateString);
      var monthIndex = date.getMonth();

      return months[monthIndex];
    }
    function getMonthName(monthNumber) {
      var monthNames = [
        "January", "February", "March",
        "April", "May", "June",
        "July", "August", "September",
        "October", "November", "December"
      ];

      // Check if the provided monthNumber is valid
      if (monthNumber >= 1 && monthNumber <= 12) {
        return monthNames[monthNumber - 1];
      } else {
        return "Invalid Month Number";
      }
    }

    function extractDateFromDateStr(dateStr) {

      // Assuming dateStr is in the format "YYYY-MM-DD"
      const dateParts = dateStr.split(' ');
      const extractedDate = `${dateParts[0]}`;
      return extractedDate;
    }

        // new code   SFTP file send
      function DirectGenerateBankMedia(button, District) {
        debugger
        $('#SFTPfileSend').popup("show");
        $("#District_value").val( District);

      }
      const onCancel_ClassBtn = document.querySelectorAll('.onCancel_class');
      onCancel_ClassBtn.forEach(button => {
        button.addEventListener('click', onCancel);
