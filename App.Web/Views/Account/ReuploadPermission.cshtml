      function SFTPfiledata() {
       debugger;
        var District = $("#District_value").val();
        $('#btn_Confirm_loading').show();
        $('#BtnFinelize').hide();
      var pybatchid1 = @pybatchid;
      var pybatchid_value;
      if (pybatchid1 === null) {
        pybatchid_value = 0;
      }
      else {
        pybatchid_value = @pybatchid;
          }
          var Region_value = District;

      $.ajax({
      type: "POST",
        url: "@Url.Action("SFTPfileSendAjax", "Account")",
        data: { batch_value: pybatchid_value, distict_value: Region_value },
        success: function (response) {
          $('#BtnFinelize').show();
          $('#btn_Confirm_loading').hide();
          $('#SFTPfileSend').popup("hide");
          debugger;
          if (response == "File has been successfully saved.") {
            toasterSuccessMessage("File has been successfully saved.");
          }
          else {
            toasterErrorMessage(response);
          }
          /*button.setAttribute('disabled', 'disabled');*/
        },
        error: function (xhr, status, error) {
