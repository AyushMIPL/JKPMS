  @section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryval")
    <script nonce="@ViewBag.StyleNonce">
      debugger

      $("#Role").on("change", function () {
        getWidgetsDetails();
      });

      document.getElementById("Total_Registered_id").addEventListener("click", function () {
        changeStatus("1")
      })

      document.getElementById("Total_Approved").addEventListener("click", function () {
        debugger;
        changeStatus("2")
      })
      document.getElementById("Total_Unapproved").addEventListener("click", function () {
        debugger;
        changeStatus("3")
      })
      document.getElementById("Beneficiary_Paid").addEventListener("click", function () {
         changeStatus("4")
      })
      document.getElementById("RegisteredBeneficiary_DistrictWise").addEventListener("click", function () {
          changeStatus("5")
      })
      document.getElementById("Beneficiaries_PaymentSummary").addEventListener("click", function () {
        changeStatus("6")
      })
      function getWidgetsDetails() {
        Roleid = document.getElementById("Role").value;
        window.location.href = `/Account/Widgets?Role_id=${Roleid}`;
      } 
      function changeStatus(id) {
        var Roleid = document.getElementById("Role").value;
        if (!Roleid || Roleid <= 0) {
          toasterErrorMessage("Please select a valid Role!");
          return; 
        }
        if (id > 0) {
          $.post('/Account/ChangeStatus',
            $.param({ id: id, Roleid: Roleid }, true),
            function (data) {
              debugger              
              if (data.success === true) {
                if (data.isDisplay === true) {
                  toasterSuccessMessage("Activated successfully");
                }
                else {
                  toasterSuccessMessage("Deactivated successfully");
                }
                getWidgetsDetails();
              }
              else {
                toasterErrorMessage(data.message);
              }
            }
          ).fail(function () {
            toasterErrorMessage("An error occurred while changing the status.");
          });
        } else {
          toasterErrorMessage("Invalid ID provided!");
        }
      }

    </script>
  }









