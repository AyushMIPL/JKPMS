@model App.Data.ViewModels.ChangePasswordViewModel
@{
    ViewBag.Title = "ResetUserPassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .validation-summary-errors ul li {
        display: none !important;
    }
</style>
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline changepassuser">
            Reset Password
            @*<ul class="tool-bar">

                </ul>*@
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("ChangeUserPassword", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id = "ChangeUserPassword" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            @*<div class="row">
                    <div class="col-sm-4 mb-4">


                        @Html.LabelFor(model => model.OldPassword, new { @class = "control-label mb-2" })
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control input-sm", placeholder = "Old Password" })
                    </div>



                    <div class="col-sm-4 mb-4">
                        @Html.LabelFor(model => model.NewPassword, new { @class = "control-label mb-2" })
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control input-sm", placeholder = "New Password" })

                    </div>



                    <div class="col-sm-4 mb-4">
                        @Html.LabelFor(model => model.ConfirmPassword, new { @class = "control-label mb-2" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control input-sm", placeholder = "Confirm Password" })

                    </div>


                </div>*@

            <div class="row" id="changepasswordID">
                <div class="col-sm-4 mb-4">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OldPassword, new { @class = "control-label mb-2 my-span-icon" })
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control input-sm", placeholder = "Old Password" })
                    </div>
                </div>
            </div>

            <div class="row" id="changepasswordID">
                <div class="col-sm-4 mb-4">
                    <div class="form-group">
                        @Html.LabelFor(model => model.NewPassword, new { @class = "control-label mb-2 my-span-icon span" })
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control input-sm", placeholder = "New Password" })
                    </div>
                </div>
            </div>

            <div class="row" id="changepasswordID">
                <div class="col-sm-4 mb-4">
                    <div class="form-group">
                        @Html.LabelFor(model => model.ConfirmPassword, new { @class = "control-label mb-2 my-span-icon span" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control input-sm", placeholder = "Confirm Password" })
                    </div>
                </div>
            </div>


            <div class="row form-group">
                <div class="col-sm-12 text-right">
                    <button type="button" class="btn btn-success px-5 height resetprocessing" title="Please Wait While We Process Your Request" id="btn_changeuserPass_loading">
                        <i class="fa fa-spinner fa-spin"></i> Processing
                    </button>
                    <button type="submit" id="IdChangePaswd" class="btn btn-success height px-5 @(ViewBag.AddPermission == true ? "" : "disabled") @(ViewBag.EditPermission == true ? "" : "disabled")"><i class="fa fa-save"> </i> Update</button>

                    @*<button type="submit" class="btn btn-success"><i class="fa fa-save"> </i> Update</button>*@
                    @if (ViewBag.ProfilePage != null)
                    {
                        <a href="/Admin/Profile/@ViewBag.ProfilePage" class="btn btn-primary border-radius"><i class="fa fa-reply"> </i> Back</a>
                        @*<a href='/Admin/Profile/@ViewBag.ProfilePage' class="btn btn-primary" title="Cancel">Cancel</a>*@
                        @*@Html.ActionLink("Cancel", "Profile", "Admin", null, new { @class = "btn btn-primary", id = ViewBag.ProfilePage })*@
                    }
                    else
                    {
                        <a href="/Dashboard/Index" class="btn btn-primary height px-5 border-radius resetprocessing1"><i class="fa fa-reply"> </i> Back</a>
                        @*@Html.ActionLink("Cancel", "Index", "Dashboard", null, new { @class = "btn btn-primary" })*@
                    }
                </div>
            </div>
        }
    </div>
</div>
@section scripts{

    <script src="~/Scripts/Master.js"></script>

    <!------******* Code By Himanshu RAjput *******-->

    <script nonce="@ViewBag.StyleNonce">
        $(document).ready(function () {
      $('form').submit(function () {
          $('#IdChangePaswd').hide();
          $('#btn_changeuserPass_loading').show();
          var form = $("#ChangeUserPassword");
          if (!form.valid()) {
              $('#IdChangePaswd').show();
              $('#btn_changeuserPass_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdChangePaswd').show();
            $('#btn_changeuserPass_loading').hide();
        }
            $('#btn_changeuserPass_loading').hide();
    });

        //$("#IdChangePaswd").on('click', function () {
        //    $("i.fa-spinner").show();
        //    setTimeout(function () {
        //        $("i.fa-spinner").hide();
        //    }, 1000);
        //});

    </script>

}