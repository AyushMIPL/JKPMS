@model App.Data.Entities.SecModule

@{
    ViewBag.Title = "Edit";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline editmodules">
            Update Details
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("EditModule", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form" ,id= "IdEditModule" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Id)

            <div class="row">


                <div class="col-sm-4 mb-4">
                    @Html.LabelFor(model => model.ModuleName, new { @class = "control mb-2" })
                   <span class="red">*</span>
                    @Html.TextBoxFor(m => m.ModuleName, new { @class = "form-control input-sm", placeholder = "Module Name", required = "required" })

                </div>


                <div class="col-sm-4 mb-4">
                  @Html.LabelFor(model => model.ControllerName, new { @class = "control mb-2" })
                  <span class="red">*</span>
                  @Html.DropDownList("ControllerName", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm", required = "required" })
                </div>



                <div class="col-sm-4 mb-4">
                  @Html.LabelFor(model => model.ActionName, new { @class = "control mb-2" })
                  <span class="red">*</span>
                  @Html.DropDownList("ActionName", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm", required = "required" })
                </div>


                <div class="col-sm-4 mb-4">
                  @Html.LabelFor(model => model.ParentId, "Select Parent Module", new { @class = "control mb-2" })
                  <span class="red">*</span>
                  @Html.DropDownList("ParentId", null, "---Select---", htmlAttributes: new { @class = "form-control input-sm", required = "required" })
                </div>


                <div class="col-sm-4 combobox mb-4">
                  @Html.LabelFor(model => model.ModuleClass, "Select Icon Class", new { @class = "control mb-2" })
                  <span class="red">*</span>
                  @Html.TextBoxFor(m => m.ModuleClass, new { @class = "form-control input-sm txtbox", placeholder = "Module Class", required = "required" })
                  <ul id="tempList" class="dropdown tmpDDOption editmodulesdropdown"></ul>
                </div>

                <div class="col-sm-4">
                    <div class="control-label mb-2 mt-3" for="Name"> &nbsp; </div>
                    <button type="button" class="btn btn-success px-5 height processmodules" title="Please Wait While We Process Your Request" id="btn_moduleEdit_loading">
                        <i class="fa fa-spinner fa-spin"></i> Processing
                    </button>
                    <button type="submit" id="IdUpdatedModule" class="btn btn-success px-5 height"><i class="fa fa-save"> </i> Update</button>
                    <a href="/Account/AddModule" class="btn btn-primary height border-radius line-height"><i class="fa fa-reply"> </i> Back to List</a>
                </div>
            </div>



        }
    </div>
</div>

@section scripts{
    <script nonce="@ViewBag.StyleNonce">
        $(function () {
            loadDropDown();
        })
        $("#ControllerName").on('change', function () {
            if ($("#ControllerName").val() != "") {
                debugger
                var controllerName = $("#ControllerName").val();
                $.ajax({
                    url: "FindAction/Account/?ControllerName=" + controllerName,
                    type: "Get",
                }).done(function (result) {
                    $("#ActionName").empty();
                    $('#ActionName').append($('<option/>').attr("value", "").text("---Select---"));
                    $.each(result, function (i, actionName) {
                        debugger
                        $('#ActionName').append($('<option/>').attr("value", actionName).text(actionName));
                    });
                })
            }
        })

        $('.combobox').on('click', '.txtbox', function () {
            if ($("#tempList").is(":visible"))
                $("#tempList").hide();
            else
                $("#tempList").show();
        });

        $('.tmpDDOption').on('click', 'li', function () {
            var $selectedLi = $(this),
                $options = $selectedLi.parent(),
                $combobox = $options.siblings('.combobox'),
                $txtbox = $combobox.children('.txtbox');
            $("#ModuleClass").val($selectedLi.text().trim());
            $options.hide();
        });


        function loadDropDown() {
            $.ajax({
                url: '/Account/ModuleClassAjax',
                type: "GET",
            })
                .done(function (result) {
                    debugger
                    var items = [];
                    $.each(result, function (i, names) {
                        items.push('<li><span class="' + names + '"></span>   ' + names + ' </li>');
                    });
                    $('#tempList').append(items.join(''));
                })
        }

    </script>
    <script nonce="@ViewBag.StyleNonce">
        $(document).ready(function () {
      $('form').submit(function () {
          $('#IdUpdatedModule').hide();
          $('#btn_moduleEdit_loading').show();
        var form = $("#IdEditModule");
        debugger;
          if (!form.valid()) {
              $('#IdUpdatedModule').show();
              $('#btn_moduleEdit_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdUpdatedModule').show();
            $('#btn_moduleEdit_loading').hide();
        }
            $('#btn_moduleEdit_loading').hide();
    });


        //$("#IdUpdated12").on('click', function () {
        //    debugger
        //    $("i.fa-spinner").show();
        //});
    </script>
}


