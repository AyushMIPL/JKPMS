@model App.Data.ViewModels.UserRegisterViewModel

@{
  ViewBag.Title = "User Profiles";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
  #changePasswordModalPopupLabel {
    font-size: large;
  }

  .is-invalid {
    border-color: red;
  }

  label.error {
    color: red;
    font-size: 12px;
    margin-top: 5px;
  }
</style>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline resetpuse">
      Reset Password
      @*<ul class="tool-bar">

        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <table class="table dataTable" id="tblCategory">
      <thead>
        <tr>

          <th class="Photouserreset">Photo</th>
          <th>Employee Name</th>
          <th>User Name</th>
          <th>Aadhar Number</th>
          <th>D.O.B</th>
          <th>Email</th>
          <th>Hire Date</th>
          <th>Status</th>
          <th class="extrathreset">Reset/Change Password</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

</div>


<!-- Modal -->
<div class="modal fade mt-5" id="changePasswordModalPopup" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered mt-5" role="document">
    <div class="modal-content mt-5">
      <div class="modal-body mt-5">
        <form id="changePasswordModalPopup_Form">
          <input type="hidden" name="changePasswordUserId_Hdn" id="changePasswordUserId_Hdn" />
          <div class="col-md-12 mt-5">
            <label id="changePasswordModalPopupLabel">Are you sure, you want to change user Password?</label><hr />
          </div>
          @*<div class="col-md-12 mb-4">
            <div class="form-group">
              <label class="control-label mb-2 my-span-icon" for="OldPassword">Current password <span style="color:red">*</span></label>
              <input class="form-control input-sm" id="OldPassword" name="OldPassword" placeholder="Old Password" type="password">
            </div>
          </div>*@

          <div class="col-md-12 mb-4 mt-5">
            <div class="form-group">
              <label class="control-label mb-2 my-span-icon span" for="NewPassword">New password <span style="color:red">*</span></label>
              <input class="form-control input-sm" id="NewPassword" name="NewPassword" placeholder="New Password" type="password">
            </div>
          </div>

          <div class="col-md-12 mb-4 mt-5">
            <div class="form-group">
              <label class="control-label mb-2 my-span-icon span" for="ConfirmPassword">Confirm new password <span style="color:red">*</span></label>
              <input class="form-control input-sm" id="ConfirmPassword" name="ConfirmPassword" placeholder="Confirm Password" type="password">
            </div>
          </div>

          <div class="text-right">
            <a class="btn btn-danger changePasswordModalPopup_close">Close</a>
            <button type="submit" class="btn btn-success m-right-sm" id="changePasswordModalPopup_btn">Continue</button>

          </div>
        </form>
      </div>
    </div>
  </div>
</div>


@section Scripts {

  <script nonce="@ViewBag.StyleNonce">

    $(document).ready(function () {
      debugger

      $('#changePasswordModalPopup_Form').submit(function (event) {
        debugger
        event.preventDefault(); // Prevent the default form submission

        // validation
        //var OldPassword = $("#OldPassword").val();
        var NewPassword = $("#NewPassword").val();
        var ConfirmPassword = $("#ConfirmPassword").val();

        //if (OldPassword != "" || OldPassword != null || OldPassword != undefined) {
        //  OldPassword = OldPassword.trim();
        //}
        if (NewPassword != "" || NewPassword != null || NewPassword != undefined) {
          NewPassword = NewPassword.trim();
        }
        if (ConfirmPassword != "" || ConfirmPassword != null || ConfirmPassword != undefined) {
          ConfirmPassword = ConfirmPassword.trim();
        }

        // old password validation
        //if (OldPassword == "" || OldPassword == null || OldPassword == undefined) {
        //  toasterErrorMessage("Please enter Current password");
        //  $("#OldPassword").focus();
        //  return false;
        //}

        // new password valiation
        if (NewPassword == "" || NewPassword == null || NewPassword == undefined) {
          toasterErrorMessage("Please enter New password");
          $("#NewPassword").focus();
          return false;
        }
        else {
          // new password validation
          const passwordPattern = /^.*(?=.{6,})(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[@@#$%^&+=]).*$/;
          if (!passwordPattern.test(NewPassword)) {
            toasterErrorMessage("Password must be at least 6 characters long and include a number, a lowercase letter, an uppercase letter, and a special character");
            return false;
          }
        }

        // old password and new password should not be same
        //if (OldPassword == NewPassword) {
        //  toasterErrorMessage("Current password and New password should not be same");
        //  return false;
        //}

        // confirm new password validation
        if (ConfirmPassword == "" || ConfirmPassword == null || ConfirmPassword == undefined) {
          toasterErrorMessage("Please enter Confirm new password");
          $("#ConfirmPassword").focus();
          return false;
        }
        else {
            // new password and confurm password should be same
            if (NewPassword != ConfirmPassword) {
              toasterErrorMessage("New password and confirm new password should be same");
              return false;
            }
        }

        // Get form data
        const formData = $(this).serialize(); // Serialize form data into a query string

        debugger
        // Optionally, you can submit the form data via AJAX or handle it as needed
        $.ajax({
          url: '/Account/ChangeUserPasswordAjax', // Replace with your server endpoint
          method: 'POST',
          data: formData,
          success: function (response) {
            debugger
            if (response.status == true) {
              toasterSuccessMessage(response.message);
              $('#changePasswordModalPopup').popup('hide');
              //location.href = "/Login";
            }
            else {
              toasterErrorMessage(response.message);
            }
          },
          error: function (error) {
            debugger
            toasterErrorMessage("An error occured.");
          }
        });
      });
    });

        $(function () {
            var UserProfileTableIds = [];
      var oTable = $('#tblCategory').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
          "sAjaxSource": "/Account/AjaxHandler",

          "fnDrawCallback": function (setting) {
              debugger;

              UserProfileTableIds.forEach(function (item, index) {
                debugger
                if (document.getElementById("ResetBtn_" + item) != null && document.getElementById("ResetBtn_" + item) !== undefined) {
                  document.getElementById("ResetBtn_" + item).addEventListener("click", function () {
                    ResEditUserPassword(item);
                  });
                }

                // change password

                if (document.getElementById("ChangePasswordBtn_" + item) != null && document.getElementById("ChangePasswordBtn_" + item) !== undefined) {
                  document.getElementById("ChangePasswordBtn_" + item).addEventListener("click", function () {
                    ChangeUserPassword(item);
                  });
                }

              });

          },
        "aoColumns": [

          {
            "sName": "Photo",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {
              if (oObj.aData[0] != null)
                  return '<div class="rgbreset" ><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" /></div>';
              else
                  return '<div class="rgbreset"><img src="../Images/noimage.jpg" /></div>';

            }
          },
          { "sName": "Employee Name" },
          { "sName": "User Name" },
          { "sName": "SocialSecurityNumber" },
          { "sName": "DOB" },
          { "sName": "EmailId" },
          { "sName": "HireDate" },
          {
            "sName": "ActiveStatus",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {
              if (oObj.aData[7] == "False")
                return '<span class="badge badge-danger">inactive</span>';
              else
                return '<span class="badge badge-success">active</span>';
            }
          },
          {
            "sName": "ID",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {
              var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
              var strString = ""
              strString += '<button title="Reset Password" id="ResetBtn_' + oObj.aData[8] + '" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '"><i class="fa fa-undo"></i></button> ';
              strString += '<button title="Change Password" id="ChangePasswordBtn_' + oObj.aData[8] + '" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '"><i class="fa fa-key"></i></button>';
                UserProfileTableIds.push(oObj.aData[8]);
              return strString;
            }
          }
        ]
      });
    })

    /// **** Code By Himanshu Rajput *****

        function ResEditUserPassword(id) {
     window.location.href = "@Url.Action("ResEditUserPassword", "Account")?Id=" + id ;
    }

    function ChangeUserPassword(id) {
      debugger

      $("#OldPassword").val("");
      $("#NewPassword").val("");
      $("#ConfirmPassword").val("");

      $("#changePasswordUserId_Hdn").val(id);
      $('#changePasswordModalPopup').popup('show');
}

  </script>
}