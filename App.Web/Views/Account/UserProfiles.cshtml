@model App.Data.ViewModels.UserRegisterViewModel
@{
  ViewBag.Title = "User Profiles";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
  table.dataTable thead th, table.dataTable tfoot th, table.dataTable tbody td {
    text-align: left !important;
  }
</style>

<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline userprofile">
      User Profiles
      <ul class="tool-bar">
        <li><a href="/Account/AddUser" data-toggle="tooltip" class="@(ViewBag.AddPermission == true ? "" : "disabled")" data-placement="bottom" title="Add details" data-original-title="Add Details"><i class="fa fa-plus"></i></a></li>
      </ul>
    </h4>
  </div>
  <div class="panel-body">
    <div class="table-responsive height">
      <table class="table dataTable usertable" id="tblCategory">
        <thead>
          <tr>
            <th class="photouser">Photo</th>
            <th>Employee Name</th>
            <th>User Name</th>
            <th>Aadhar No.</th>
            <th>D.O.B</th>
            <th>Email</th>
            <th>Hire Date</th>
            <th>Status</th>
            <th class="extrathuser"></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>
@section Scripts {
  @Scripts.Render("~/bundles/jqueryval")
  <script nonce="@ViewBag.StyleNonce">
    $(function () {
        doBindData();


    });

        var UserProfileTableIds = [];

    function doBindData() {
        debugger;


      var oTable = $('#tblCategory').dataTable({
        "bJQueryUI": true,
        "sPaginationType": "full_numbers",
        "bServerSide": true,
        "bDestroy": true,
        "bAutoWidth": false,
          "sAjaxSource": "/Account/AjaxHandler",

          "fnDrawCallback": function (setting) {
              debugger;

              UserProfileTableIds.forEach(function (item, index) {
                debugger
                if (document.getElementById("EditAccountBtn_" + item) != null && document.getElementById("EditAccountBtn_" + item) != undefined) {
                  document.getElementById("EditAccountBtn_" + item).addEventListener("click", function () {
                    EditAccount(item);
                  });
                }
                if (document.getElementById("DetailsAccountBtn_" + item) != null && document.getElementById("DetailsAccountBtn_" + item) != undefined) {
                  document.getElementById("DetailsAccountBtn_" + item).addEventListener("click", function () {
                    DetailsAccount(item);
                  });
                }
                if (document.getElementById("DeleteAccountBtn_" + item) != null && document.getElementById("DeleteAccountBtn_" + item) != undefined) {
                  document.getElementById("DeleteAccountBtn_" + item).addEventListener("click", function () {
                    del(item);
                  });
                }

              });

          },
        "aoColumns": [
          {
            "sName": "Photo",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {

              if (oObj.aData[0] != null)
                return '<div class="  pstyle" ><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" /></div>';
              else
                return '<div class="  pstyle"><img src="../Images/noimage.jpg" /></div>';

            }
            //  if (oObj.aData[0] != null)
            //    /*return '<div class="thumbnail pstyle"><a href="../UserFiles/ProfileImages/' + oObj.aData[0] + '" target="_blank"><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" /></a></div>';*/
            //  return '<div class="pstyle" ><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" /></div>';
            //   // return '<div class="thumbnail pstyle"><a href="../UserFiles/ProfileImages/' + oObj.aData[0] + '" target="_blank"><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" /></a></div>';
            //   /*  return ' <div class="thumbnail" onmouseover="showImage(this)" onmouseout="hideImage()"><img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '"  alt="Thumbnail Image"> <div class="enlarged-image" id="enlargedImage"> <img src="../UserFiles/ProfileImages/' + oObj.aData[0] + '" alt="Enlarged Image"> </div></div>'*/
            //  else
            //  /*  return ' <div class="thumbnail" onmouseover="showImage(this)" onmouseout="hideImage()"><img src="../Images/noimage.jpg"  alt="Thumbnail Image"> <div class="enlarged-image" id="enlargedImage"> <img src="../Images/noimage.jpg" alt="Enlarged Image"> </div></div>'*/
            //    /*return '<div class="thumbnail pstyle"><img src="../Images/noimage.jpg" /></div>';*/
            //   return '<div class="pstyle"><img src="../Images/noimage.jpg" /></div>';
            //}
          },
          { "sName": "EmployeeName" },
          { "sName": "UserName" },
          { "sName": "SocialSecurityNumber" },
          { "sName": "DOB" },
          { "sName": "EmailId" },
          { "sName": "HireDate" },
          {
            "sName": "ActiveStatus",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {
              debugger;
              if (oObj.aData[7] == "False")
                return '<span class="badge badge-danger">inactive</span>';
              else
                return '<span class="badge badge-success">active</span>';
            }
            },


          {
            "sName": "ID",
            "bSearchable": false,
            "bSortable": false,
            "fnRender": function (oObj) {
              var EditPermission = ("@ViewBag.EditPermission").toLowerCase();
              var DetailsPermission = ("@ViewBag.ViewPermission ").toLowerCase();
              var DeletePermission = ("@ViewBag.DeletePermission").toLowerCase();
            //    var strString = '<button onclick="EditAccount(\'' + oObj.aData[8] + '\');" class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

            //    strString += '&nbsp;<button onclick="DetailsAccount(\'' + oObj.aData[8] + '\');" class="btn btn-xs btn-primary ' + (DetailsPermission == "false" ? "disabled" : "") + '" title="Detail"><i class="fa fa-list"></i> Details</button>';

            ///*  strString += '&nbsp; <href="javascript:;" onclick="javascript:del(\'' + oObj.aData[0] + '\');" class= "btn btn-xs btn-danger" title = "Delete" ><i class="fa fa-trash-o fa-lg"></i> Delete</a>';*/
                //    strString += '&nbsp;<button href="javascript:;" onclick="javascript:del(\'' + oObj.aData[8] + '\');" class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete" ><i class="fa fa-trash-o fa-lg"></i> Delete</button>';


                var strString = '<button id="EditAccountBtn_' + oObj.aData[8] + '"   class="btn btn-info btn-xs ' + (EditPermission == "false" ? "disabled" : "") + '" title="Edit"><i class="fa fa-pencil"></i> Edit</button>';

                strString += '&nbsp;<button id="DetailsAccountBtn_' + oObj.aData[8] + '"   class="btn btn-xs btn-primary ' + (DetailsPermission == "false" ? "disabled" : "") + '" title="Detail"><i class="fa fa-list"></i> Details</button>';


                strString += '&nbsp;<button id="DeleteAccountBtn_' + oObj.aData[8] + '" href="javascript:;" class="btn btn-xs btn-danger ' + (DeletePermission == "false" ? "disabled" : "") + '" title="Delete" ><i class="fa fa-trash-o fa-lg"></i> Delete</button>';



                UserProfileTableIds.push(oObj.aData[8]);
                return strString;
            }
          }
        ]
      });
    }


	  /// **** Code By Himanshu Rajput *****

        function EditAccount(id) {
     window.location.href = "@Url.Action("UserEdit", "Account")?Id=" + id ;
}

        function DetailsAccount(id) {
     window.location.href = "@Url.Action("UserDetails", "Account")?Id=" + id ;
}


    function del(ctrlId) {
      debugger
      $("#hdDocumentId").val(ctrlId);
      $('#confirmDelete').popup("show");
    }
    function onDeleteConfirm() {
      debugger
      var id = $("#hdDocumentId").val();
      var name = "UserId";
      $.ajax({
        url: "@Url.Action("AjaxRemove", "Account")?Id=" + id + "&name=" + name,
        type: "GET",
      })
    .done(function (result) {
      var actionRes = result;
      if (actionRes == "0") {
        toasterErrorMessage("There is some error, please try again.");
        return actionRes;
      }
      else if (actionRes == "3") {
        toasterSuccessMessage("Status changed sucessfully.");
        $('#confirmDelete').popup("hide");
        doBindData();
      }
      else {
        toasterErrorMessage("Already in Use.");
        $('#confirmDelete').popup("hide");
      }
    });
      }
      const Confirm_Delete_ClassBtn = document.querySelectorAll('.Confirm_Delete_Class');
      debugger
      Confirm_Delete_ClassBtn.forEach(button => {
        button.addEventListener('click', onDeleteConfirm);
      });
  </script>
}