  <script nonce="@ViewBag.StyleNonce">

    $(document).ready(function () {
      // Attach onchange event handlers
      $('#HireDate').on('change', function () {
        validateDates();
      });

      function validateDates() {
        debugger
        var dob = $('#DOB').val();
        var hireDate = $('#HireDate').val();

        // Convert string dates to Date objects
        var dobDate = new Date(dob);
        var hireDateDate = new Date(hireDate);

        // Perform comparison
        debugger;
        if (dobDate > hireDateDate) {
          toasterErrorMessage("Hire Date must be greater than Date of Birth.");
          $('#HireDate').val('');
          // You can also reset the date or perform other actions here
        }
      }
    });
  </script>
} 