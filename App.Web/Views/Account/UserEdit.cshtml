    //    if (inputValue !== numericValue) {
    //      // Display validation message if non-numeric characters are present
    //      $('#validationMessage').text('Please enter only numeric characters.');
    //    } else {
    //      $('#validationMessage').text('');
    //    }

    //    // Update the input field with the numeric value
    //    $(this).val(numericValue);
    //  });
    //});
  </script>

  <!-------***** Code By Himanshu ****---------->

  <script nonce="@ViewBag.StyleNonce">

      $(document).ready(function () {
        $('form').submit(function () {
          $("#orignalAdhar").val(originalValue);
          $('#IdUpdatedUser').hide();
          $('#btn_User_loading').show();
          var form = $("#IdUserEdit");
          if (!form.valid()) {
              $('#IdUpdatedUser').show();
              $('#btn_User_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdUpdatedUser').show();
            $('#btn_User_loading').hide();
        }
          $('#btn_User_loading').hide();
    });



