@model App.Data.ViewModels.ForgotViewModel
@{
    ViewBag.Title = "ResetUserPassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h4 class="headline resetpass">
            Reset Password
            @*<ul class="tool-bar"></ul>*@
        </h4>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("ResEditUserPassword", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", role = "form", id= "IdResEditUserPassword" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            <div class="row">
                <div class="col-sm-5">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Email, new { @class = "col-sm-4 control" })
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control input-sm", placeholder = "Email", @readonly = "readonly" })

                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <button type="button" class="btn btn-success px-5 height buttonreset" title="Please Wait While We Process Your Request" id="btn_ResetUserPassword_loading"><i class="fa fa-spinner fa-spin"></i> Processing</button>
                    <button type="submit" id="IdResetEdit" class="btn btn-success height px-5"><i class="fa fa-key fa-rotate-180"></i> Reset</button>
                    <a href="/Account/ResetPassword" class="btn btn-primary border-radius"><i class="fa fa-reply"> </i> Back to List</a>
                    @*@Html.ActionLink("Cancel", "ResetPassword", "Account", null, new { @class = "btn btn-primary" })*@
                </div>
            </div>
        }
    </div>
</div>
@section scripts{

    <script src="~/Scripts/Master.js"></script>
    <script nonce="@ViewBag.StyleNonce">
        $(document).ready(function () {
      $('form').submit(function () {
          $('#IdResetEdit').hide();
          $('#btn_ResetUserPassword_loading').show();
          var form = $("#IdResEditUserPassword");
          if (!form.valid()) {
              $('#IdResetEdit').show();
              $('#btn_ResetUserPassword_loading').hide();
              return false;
          }
      });
        var error = '@TempData["error"]';
        if (error && error.length > 0) {
            $('#IdResetEdit').show();
            $('#btn_ResetUserPassword_loading').hide();
        }
            $('#btn_ResetUserPassword_loading').hide();
    });

        //$("#IdReset").on('click', function () {
        //    $("i.fa-spinner").show();
        //});

    </script>

}
