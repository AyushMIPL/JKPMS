Content-Type: text/html; charset=utf-8

<p class="p-top-xs" style="color:">Dear @ViewBag.Name,</p>
<br />
<p class="p-top-xs">Your password has been reset, following are your account details</p>
<p class="p-top-xs"><b>Userame:</b> @ViewBag.Name</p>
<p class="p-top-xs"><b>Password:</b> @ViewBag.Password</p>
<br />
<p class="p-top-xs">Please click <b><a href="@ViewBag.ConfirmLink"> here</a></b> and login with provided credentials.</p>
<p class="p-top-xs">If you have any questions or trouble logging on please contact to site administrator</p>
<br />

<p class="p-top-xs">Thanks,</p>
<p class="p-top-xs">JKPS Management</p>



