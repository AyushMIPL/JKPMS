@model App.Data.Entities.UserProfile
@using App.Web.Helper
@{
  ViewBag.Title = "UserDetails";
}


<div class="panel panel-default">
  <div class="panel-heading clearfix">
    <h4 class="headline" style="margin:0px;padding:0px;border:none;">
      User Profile
      @*<ul class="tool-bar">
          
        </ul>*@
    </h4>
  </div>
  <div class="panel-body">
    <div class="row">
      <div class="col-sm-4">
        <dl class="dl-horizontal">
          <dt>
            @Html.DisplayNameFor(model => model.FullName)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.FullName)
          </dd>
          <dt>
            @Html.DisplayNameFor(model => model.EmployeeCode)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.EmployeeCode)
          </dd>
          <dt>
            @Html.DisplayNameFor(model => model.DOB)
          </dt>

          <dd>
            @Html.FormatDate(Model.DOB)
          </dd>
          <dt>
            @Html.DisplayNameFor(model => model.HireDate)
          </dt>

          <dd>
            @Html.FormatDate(Model.HireDate)
          </dd>
          <dt>
            @Html.DisplayNameFor(model => model.Email)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.Email)
          </dd>
          <dt>
            @Html.DisplayNameFor(model => model.SocialSecurityNumber)
          </dt>

          <dd>
            @Html.DisplayFor(model => model.SocialSecurityNumber)
          </dd>
          <dt>
            @Html.DisplayNameFor(model => model.Gender)
          </dt>

          <dd>
            @Html.FormatGender(Model.Gender)
          </dd>
        </dl>
      </div>

    </div>
  </div>
  <div class="panel-footer">
    <a href='/Account/ChangeUserPassword/@ViewBag.Id' class="btn btn-success" title="Change Password">Change Password</a>
    @*@Html.ActionLink("Change Password", "ChangeUserPassword", "Account", new { @class = "btn btn-success", Id = @ViewBag.Id })*@
    @Html.ActionLink("Back to Dashboard", "Index", "Dashboard", null, new { @class = "btn btn-primary" })
  </div>
</div>
